:host { display:block; }
.doctor-review-banner.consultation-message-banner { border-color:#b9d0f0; background:#f2f7ff; }
.consultation-message-banner { position:fixed; top:18rpx; left:24rpx; right:24rpx; z-index:900; display:flex; align-items:center; gap:18rpx; padding:20rpx 24rpx; border:1rpx solid #c9daf3; border-radius:22rpx; background:#f8fbff; box-shadow:0 6rpx 24rpx rgba(31,65,112,.13); color:#2e568c; }
.consultation-banner-icon { flex:none; width:54rpx; height:54rpx; display:flex; align-items:center; justify-content:center; border-radius:16rpx; background:#e5effe; font-size:32rpx; }
.consultation-banner-copy { flex:1; min-width:0; }
.consultation-banner-title { display:block; font-size:26rpx; font-weight:600; }
.consultation-banner-name { display:block; margin-top:4rpx; overflow:hidden; white-space:nowrap; text-overflow:ellipsis; font-size:22rpx; color:#7389a7; }
.consultation-banner-count { flex:none; min-width:32rpx; padding:3rpx 8rpx; border-radius:20rpx; background:#dc6658; color:#fff; font-size:20rpx; text-align:center; }
.consultation-banner-open { flex:none; font-size:24rpx; }
