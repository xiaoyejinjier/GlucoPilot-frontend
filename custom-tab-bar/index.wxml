<wxs module="i18n" src="/utils/i18n.wxs" />
<view wx:if="{{consultationNotice && !guideActive}}" class="consultation-message-banner" bindtap="onConsultationNotice" aria-role="button" hover-class="ui-pressed">
  <view class="consultation-banner-icon">✉</view><view class="consultation-banner-copy"><text class="consultation-banner-title">{{i18n.t('问诊新消息',locale)}}</text><text class="consultation-banner-name">{{consultationNotice.peerName}}</text></view>
  <text class="consultation-banner-count">{{consultationNotice.unreadCount > 99 ? '99+' : consultationNotice.unreadCount}}</text><text class="consultation-banner-open">{{i18n.t('查看',locale)}} ›</text>
</view>
<bottom-navigation selected="{{selected}}" unread-count="{{unreadCount}}" consultation-unread-count="{{consultationUnread}}" brand-color="{{selectedColor}}" guide-active="{{guideActive}}"
  bind:guidecomplete="onGuideComplete" bind:tabchange="onTabChange"></bottom-navigation>
