.wallet-page{min-height:100vh;box-sizing:border-box;background:#f3f6fb;padding:28rpx 28rpx calc(48rpx + env(safe-area-inset-bottom));color:#223d63;font-size:28rpx}.wallet-card{background:#fff;border:1rpx solid #e4ebf5;border-radius:28rpx;padding:32rpx;margin-bottom:24rpx}.wallet-title{font-size:32rpx;font-weight:600;color:#213b62}.wallet-muted{color:#8190a7;font-size:24rpx}.wallet-block{display:block;margin-top:12rpx}.wallet-between{display:flex;align-items:center;justify-content:space-between;gap:16rpx}.wallet-balance{position:relative;background:#254675;color:#fff;padding:36rpx;border-radius:32rpx;box-shadow:0 16rpx 32rpx rgba(34,68,115,.12)}.wallet-chip{display:inline-block;background:rgba(170,207,255,.18);border:1rpx solid rgba(170,207,255,.25);border-radius:24rpx;padding:7rpx 20rpx;font-size:23rpx}.wallet-balance-caption{display:block;color:#c3d6f0;font-size:24rpx;margin-top:36rpx}.wallet-balance-value{display:block;font-size:76rpx;font-weight:600;margin:6rpx 0 20rpx}.wallet-balance-note{color:#c3d6f0;font-size:24rpx}.wallet-shortcuts{display:flex;gap:20rpx;margin:24rpx 0}.wallet-shortcuts>view{flex:1;display:flex;align-items:center;gap:14rpx;background:#fff;border:1rpx solid #e4ebf5;border-radius:22rpx;padding:25rpx 20rpx}.wallet-shortcuts>view>text:last-child{margin-left:auto;color:#93a5c0}.wallet-shortcut-icon{background:#e9f2ff;color:#417bd1;border-radius:12rpx;padding:4rpx 13rpx;font-weight:600}.wallet-amounts{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18rpx;margin:28rpx 0 22rpx}.wallet-amount{border:2rpx solid #e6edf7;background:#f8faff;border-radius:20rpx;padding:24rpx 8rpx;display:flex;align-items:center;flex-direction:column;gap:8rpx;transition:background .18s,border-color .18s,transform .18s}.wallet-amount>text:first-child{font-size:36rpx;font-weight:600}.wallet-amount>text:last-child{font-size:22rpx;color:#8190a7}.wallet-amount.selected,.wallet-custom.selected{background:#eaf3ff;border-color:#6f9fe2;color:#235ca5}.wallet-custom{display:flex;align-items:center;gap:18rpx;padding:24rpx 20rpx;border:2rpx solid #e6edf7;border-radius:18rpx;font-size:26rpx}.wallet-custom input{flex:1;min-width:0;text-align:right;font-size:30rpx;height:44rpx}.wallet-custom>text:last-child{color:#8190a7}.wallet-channel{display:flex;align-items:center;gap:20rpx;margin:30rpx 0}.wallet-channel>view:nth-child(2){flex:1}.wallet-channel-icon{background:#e8f2ff;color:#337bd7;border-radius:14rpx;width:64rpx;height:64rpx;display:flex;align-items:center;justify-content:center;font-size:36rpx;font-weight:600}.wallet-primary{background:#29578f;color:#fff;border-radius:20rpx;font-size:29rpx;font-weight:600;margin-top:12rpx}.wallet-primary::after{border:0}.wallet-primary[disabled]{background:#dfe8f4;color:#7c90ac}.wallet-note{background:#eaf1fb;border:1rpx solid #dce7f6;border-radius:22rpx;padding:26rpx;color:#7489a6;font-size:24rpx;line-height:1.8}.wallet-note>text{display:block}.wallet-note>.wallet-title{font-size:27rpx;margin-bottom:12rpx}.wallet-error{background:#fff2ed;color:#a55d44;padding:28rpx;border-radius:20rpx;margin-bottom:24rpx;line-height:1.6}.wallet-order-hero{padding:12rpx 4rpx 28rpx}.wallet-tabs{display:flex;background:#e5edf9;border-radius:22rpx;padding:7rpx;gap:8rpx}.wallet-tabs>view{flex:1;text-align:center;padding:20rpx 10rpx;border-radius:17rpx;color:#7a8eae;transition:background .18s,color .18s}.wallet-tabs>view.active{background:#fff;color:#294f82;font-weight:600;box-shadow:0 4rpx 12rpx rgba(33,65,108,.06)}.wallet-status-scroll{width:100%;margin:24rpx 0}.wallet-statuses{display:flex;gap:16rpx;white-space:nowrap}.wallet-statuses>view{padding:12rpx 22rpx;border-radius:30rpx;color:#8090a8;background:#fff;font-size:24rpx}.wallet-statuses>view.active{background:#dceaff;color:#356bb1;font-weight:600}.wallet-order-card .wallet-title{font-size:28rpx}.wallet-order-status{font-size:23rpx;color:#8b96a6;flex-shrink:0}.wallet-order-status.paid{color:#356bb1}.wallet-order-bottom{margin-top:32rpx}.wallet-price{font-size:36rpx;font-weight:600}.wallet-detail-link{text-align:right;margin-top:22rpx;border-top:1rpx solid #edf1f7;padding-top:22rpx;color:#6388bc;font-size:24rpx}.wallet-empty{min-height:420rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:24rpx;color:#8a99b0;font-size:25rpx;text-align:center}.wallet-empty-icon{width:104rpx;height:110rpx;border:3rpx solid #c9d8ec;color:#b2c7e2;border-radius:18rpx;font-size:76rpx;line-height:96rpx;margin-bottom:12rpx}.wallet-end{display:block;text-align:center;color:#9ba9bd;font-size:23rpx;margin:20rpx 0 32rpx}.wallet-detail-head{text-align:center;padding:34rpx 12rpx 46rpx;color:#6a83a6}.wallet-detail-head .wallet-chip{background:#e4edfa;border-color:#d5e2f3;color:#3d669d}.wallet-detail-amount{display:block;font-size:72rpx;font-weight:600;color:#244675;margin:26rpx 0 16rpx}.wallet-info-row{display:flex;justify-content:space-between;gap:24rpx;padding:28rpx 0;border-bottom:1rpx solid #edf1f7;font-size:25rpx}.wallet-info-row>text:first-child{color:#8997ac;flex-shrink:0}.wallet-info-row>text:last-child{text-align:right;word-break:break-all}.wallet-info-row:last-child{border-bottom:0;padding-bottom:0}.wallet-copy{color:#5f85b7}.wallet-loading{width:36rpx;height:36rpx;border:4rpx solid #dce6f4;border-top-color:#628ecb;border-radius:50%;animation:wallet-spin .8s linear infinite}@keyframes wallet-spin{to{transform:rotate(360deg)}}
