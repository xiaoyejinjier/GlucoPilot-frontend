<view class="notice-entry {{alerts.length ? 'has-alerts' : ''}}" bindtap="openNotice" hover-class="notice-entry-pressed" aria-role="button" aria-label="提醒与回复，血糖提醒{{alerts.length}}条，管理端回复{{replyTotal}}条，点击查看">
  <view class="notice-entry-label">
    <view class="notice-entry-icon" aria-hidden="true"><view class="message-icon"></view></view>
    <text class="notice-entry-title">提醒与回复</text>
  </view>
  <view class="notice-entry-summary">
    <text wx:if="{{alerts.length}}" class="notice-alert-badge">血糖提醒 {{alerts.length}}</text>
    <text wx:if="{{replyTotal}}" class="notice-reply-badge">回复 {{replyTotal}}</text>
    <text wx:elif="{{repliesError}}" class="notice-entry-status">待重试</text>
    <view class="notice-entry-arrow" aria-hidden="true"></view>
  </view>
</view>

<view wx:if="{{noticeVisible}}" class="notice-overlay">
  <view class="notice-mask" bindtap="closeNotice" catchtouchmove="onNoticeContentTap"></view>
  <view class="notice-dialog" catchtap="onNoticeContentTap" catchtouchmove="onNoticeContentTap">
    <view class="notice-handle" aria-hidden="true"></view>
    <view class="notice-dialog-heading">
      <view class="notice-dialog-intro">
        <text class="notice-dialog-title">提醒与回复</text>
        <text class="notice-dialog-subtitle">查看血糖提醒，了解跟进回复</text>
      </view>
      <view class="notice-close" bindtap="closeNotice" hover-class="notice-close-pressed" aria-role="button" aria-label="关闭提醒与回复"><view class="close-icon" aria-hidden="true"></view></view>
    </view>
    <scroll-view class="notice-scroll" scroll-y="{{true}}" catchtouchmove="onNoticeContentTap">
      <view class="notice-content">
        <view class="alert-card">
          <view class="alert-heading">
            <view class="notice-section-label"><view class="section-mark alert-mark" aria-hidden="true">!</view><text class="alert-title">血糖提醒</text></view>
            <text class="section-count">今日 {{alerts.length}} 条</text>
          </view>
          <view wx:for="{{alerts}}" wx:key="id" class="alert-item {{item.type}}">
            <view class="alert-item-label"><text class="alert-node-name">{{item.name}}</text><text class="alert-badge">{{item.label}}</text></view>
            <view class="alert-reading"><text class="alert-value">{{item.value}}</text><text class="alert-unit">mmol/L</text></view>
          </view>
          <view wx:if="{{!alerts.length}}" class="notice-empty"><text class="empty-title">暂无异常提醒</text><text>今日暂无已记录的异常实测血糖提醒。</text></view>
          <text wx:else class="alert-tip">以上为当日已记录的实测值，请核对测量结果并留意身体状况。如有明显不适或数值持续异常，请及时寻求专业帮助。</text>
        </view>
        <view class="reply-card">
          <view class="reply-heading">
            <view class="notice-section-label"><view class="section-mark reply-mark" aria-hidden="true"><view class="message-icon"></view></view><text>管理端回复</text></view>
            <view class="reply-action reply-refresh" catchtap="refreshReplies" hover-class="reply-action-pressed" aria-role="button" aria-label="刷新管理端回复"><text class="refresh-icon" aria-hidden="true">↻</text><text>{{repliesLoading ? '刷新中…' : '刷新回复'}}</text></view>
          </view>
          <view wx:for="{{replies}}" wx:key="id" class="reply-item">
            <view class="reply-item-heading"><text class="reply-author">管理端</text><text class="reply-time">{{item.repliedAtText}}</text></view>
            <text class="reply-content">{{item.userReply}}</text>
            <view class="reply-record">
              <text class="reply-record-label">关联测量</text>
              <text class="reply-context">{{item.recordDate}} · {{item.nodeName}} · {{item.glucoseValue}} mmol/L</text>
              <text class="reply-measurement">测量时间：{{item.recordedAtText}}</text>
            </view>
          </view>
          <view wx:if="{{!replies.length && !repliesLoading && !repliesError}}" class="notice-empty"><text class="empty-title">暂无管理端回复</text><text>有跟进回复时，会在这里展示。</text></view>
          <view wx:if="{{repliesError}}" class="reply-error"><text>{{repliesError}}</text><text class="reply-action" bindtap="onRetryReplies">重试</text></view>
          <text wx:if="{{repliesLoading}}" class="reply-loading">正在读取回复…</text>
          <text wx:elif="{{hasMoreReplies}}" class="reply-more" bindtap="loadMoreReplies">查看更多回复</text>
        </view>
      </view>
    </scroll-view>
  </view>
</view>
