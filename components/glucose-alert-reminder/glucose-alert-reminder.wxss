@import "../../utils/motion.wxss";
:host { display:block; }
view, text { box-sizing:border-box; }

/* 页面只保留轻量入口，消息数量不是未读数量。 */
.notice-entry { display:flex; align-items:center; justify-content:space-between; gap:12rpx; margin:16rpx 20rpx; padding:14rpx 20rpx; min-height:76rpx; border:1rpx solid #e8edea; border-radius:18rpx; background:#fff; }
.notice-entry-pressed { background:#f7f9f8; }
.notice-entry { transition:background-color .16s ease; }
.has-notices .notice-entry-icon::after { animation:ui-icon-pop .24s ease-out; }
.notice-reply-badge, .notice-alert-badge { animation:ui-icon-pop .2s ease-out; }
.refresh-icon.is-loading { display:inline-block; animation:ui-spin .85s linear infinite; }
.notice-entry-label { display:flex; align-items:center; gap:12rpx; flex-shrink:0; }
.notice-entry-icon { display:flex; align-items:center; justify-content:center; width:42rpx; height:42rpx; border-radius:13rpx; background:var(--brand-soft,#ddf4ff); color:var(--brand-dark,#0550ae); }
.message-icon { position:relative; width:23rpx; height:18rpx; border:2rpx solid currentColor; border-radius:6rpx; }
.message-icon::before { content:''; position:absolute; left:4rpx; right:4rpx; top:6rpx; border-top:2rpx solid currentColor; }
.message-icon::after { content:''; position:absolute; left:3rpx; bottom:-5rpx; height:6rpx; border-left:2rpx solid currentColor; transform:skewY(-35deg); }
.notice-entry-title { color:#293b33; font-size:var(--fs-small,22rpx); font-weight:600; }
.notice-entry-summary { display:flex; justify-content:flex-end; align-items:center; flex-wrap:wrap; gap:10rpx; min-width:0; font-size:var(--fs-tiny,20rpx); }
.notice-alert-badge, .notice-reply-badge { padding:5rpx 12rpx; border-radius:20rpx; line-height:1.4; white-space:nowrap; }
.notice-alert-badge { color:#b34a36; background:#fff0eb; font-weight:600; }
.notice-reply-badge { color:var(--brand-dark,#0550ae); background:var(--brand-soft,#ddf4ff); }
.notice-entry-status { color:#8a7563; }
.notice-entry-idle { color:var(--muted,#8994a3); }
.notice-entry-arrow { flex-shrink:0; width:12rpx; height:12rpx; margin:0 4rpx 0 6rpx; border-top:2rpx solid #a3afa8; border-right:2rpx solid #a3afa8; transform:rotate(45deg); }
.has-notices .notice-entry-icon { position:relative; }
.has-notices .notice-entry-icon::after { content:''; position:absolute; top:-3rpx; right:-3rpx; width:12rpx; height:12rpx; border:3rpx solid #fff; border-radius:50%; background:#dc6450; }

/* 弹窗固定标题与关闭入口，正文独立滚动。 */
.notice-overlay { position:fixed; inset:0; z-index:10001; }
.notice-mask { position:absolute; inset:0; background:rgba(24,38,31,.38); animation:notice-mask-in .18s ease-out; }
.notice-dialog { position:absolute; left:0; right:0; bottom:0; border-radius:36rpx 36rpx 0 0; background:#f5f7f6; padding-bottom:env(safe-area-inset-bottom); overflow:hidden; box-shadow:0 -12rpx 64rpx rgba(20,40,30,.08); animation:notice-sheet-in .2s ease-out; }
.notice-handle { width:64rpx; height:7rpx; margin:16rpx auto 4rpx; border-radius:8rpx; background:#d8dfdb; }
.notice-dialog-heading { display:flex; justify-content:space-between; align-items:center; gap:24rpx; padding:22rpx 32rpx 26rpx; }
.notice-dialog-intro { min-width:0; }
.notice-dialog-title { display:block; color:#20372b; font-size:var(--fs-title,34rpx); line-height:1.4; font-weight:700; }
.notice-dialog-subtitle { display:block; margin-top:8rpx; color:#818c85; font-size:var(--fs-small,22rpx); line-height:1.5; }
.notice-close { display:flex; align-items:center; justify-content:center; flex-shrink:0; width:64rpx; height:64rpx; border-radius:50%; background:#e9eeeb; color:#64776b; }
.notice-close-pressed { background:#dfe7e2; }
.close-icon { position:relative; width:24rpx; height:24rpx; }
.close-icon::before, .close-icon::after { content:''; position:absolute; left:11rpx; top:0; height:24rpx; width:2rpx; border-radius:2rpx; background:currentColor; transform:rotate(45deg); }
.close-icon::after { transform:rotate(-45deg); }
.notice-scroll { height:62vh; }
.notice-content { padding:0 24rpx 36rpx; }
.alert-card, .reply-card { padding:26rpx; border:1rpx solid #e9eeeb; border-radius:24rpx; background:#fff; }
.alert-card { margin-bottom:22rpx; }
.alert-heading, .reply-heading { display:flex; justify-content:space-between; align-items:center; gap:16rpx; min-height:50rpx; margin-bottom:22rpx; }
.notice-section-label { display:flex; align-items:center; gap:12rpx; min-width:0; color:#2d4035; font-size:var(--fs-body,28rpx); font-weight:600; }
.section-mark { display:flex; align-items:center; justify-content:center; flex-shrink:0; width:40rpx; height:40rpx; border-radius:12rpx; font-size:26rpx; font-weight:700; }
.alert-mark { color:#b98134; background:#fff4e4; }
.reply-mark { color:var(--brand-dark,#0550ae); background:var(--brand-soft,#ddf4ff); }
.section-count { flex-shrink:0; font-size:var(--fs-small,22rpx); color:#87938b; }
.notice-empty { display:flex; flex-direction:column; align-items:center; gap:10rpx; padding:28rpx 8rpx 32rpx; color:#89948d; text-align:center; font-size:var(--fs-small,22rpx); line-height:1.7; }
.empty-title { color:#5a6f61; font-size:var(--fs-body,28rpx); font-weight:500; }

/* 只有具体异常行使用浅色底，实测数值与单位区分层级。 */
.alert-item { display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:14rpx 20rpx; padding:22rpx; margin-bottom:14rpx; border:1rpx solid #f5e8cf; border-radius:18rpx; background:#fffbf3; color:#9b6927; }
.alert-item.low { border-color:#f8e0da; background:#fff6f3; color:#bf5544; }
.alert-item-label { display:flex; flex-direction:column; align-items:flex-start; gap:8rpx; }
.alert-node-name { color:#3d4d43; font-size:var(--fs-body,28rpx); font-weight:500; }
.alert-badge { color:inherit; font-size:var(--fs-small,22rpx); line-height:1.4; }
.alert-reading { display:flex; align-items:baseline; gap:8rpx; white-space:nowrap; }
.alert-value { font-size:var(--fs-metric,36rpx); line-height:1.2; font-weight:700; font-variant-numeric:tabular-nums; }
.alert-unit { color:#8f978c; font-size:var(--fs-small,22rpx); font-weight:400; }
.alert-tip { display:block; margin-top:20rpx; padding-top:18rpx; border-top:1rpx solid #eef1ee; color:#89928c; font-size:var(--fs-small,22rpx); line-height:1.8; }

/* 回复正文优先，关联实测与回复时间作为次级信息。 */
.reply-action { padding:10rpx 14rpx; border-radius:20rpx; color:var(--brand-dark,#0550ae); font-size:var(--fs-small,22rpx); }
.reply-refresh { display:flex; align-items:center; justify-content:center; flex-shrink:0; gap:6rpx; min-height:52rpx; background:var(--brand-soft,#ddf4ff); line-height:1.4; white-space:nowrap; }
.reply-action-pressed { opacity:.7; }
.refresh-icon { font-size:28rpx; line-height:1; }
.reply-item { margin-top:16rpx; padding:22rpx; border:1rpx solid #ecf0ed; border-radius:18rpx; background:#f8faf9; }
.reply-item-heading { display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:8rpx 16rpx; }
.reply-author { color:#5f7567; font-size:var(--fs-small,22rpx); font-weight:600; }
.reply-time { color:#8b978f; font-size:var(--fs-tiny,20rpx); line-height:1.6; }
.reply-content { display:block; margin-top:16rpx; color:#2b3c31; font-size:var(--fs-body,28rpx); line-height:1.85; white-space:pre-wrap; word-break:break-all; }
.reply-record { margin-top:20rpx; padding-top:16rpx; border-top:1rpx dashed #dfe6e1; font-size:var(--fs-small,22rpx); line-height:1.8; }
.reply-record-label { display:block; color:#98a39b; font-size:var(--fs-tiny,20rpx); margin-bottom:4rpx; }
.reply-context { display:block; color:#748278; word-break:break-all; }
.reply-measurement { display:block; color:#98a198; word-break:break-all; }
.reply-more { display:block; margin-top:20rpx; padding:18rpx; border-radius:14rpx; background:#f4f7f5; text-align:center; color:var(--brand-dark,#0550ae); font-size:var(--fs-small,22rpx); }
.reply-loading { display:block; padding:20rpx 0; color:#8b978f; text-align:center; font-size:var(--fs-small,22rpx); }
.reply-error { display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:12rpx; padding-top:18rpx; color:#a67b45; font-size:var(--fs-small,22rpx); line-height:1.8; }

@keyframes notice-mask-in { from { opacity:0; } to { opacity:1; } }
@keyframes notice-sheet-in { from { transform:translateY(32rpx); opacity:.6; } to { transform:translateY(0); opacity:1; } }
@media (prefers-reduced-motion: reduce) {
  .notice-entry { transition:none; }
  .notice-mask, .notice-dialog, .has-notices .notice-entry-icon::after, .notice-reply-badge, .notice-alert-badge, .refresh-icon.is-loading { animation:none; }
}

.social-notice-row{display:flex;justify-content:space-between;align-items:center;gap:24rpx;padding:24rpx 0;border-top:1rpx solid var(--surface-subtle);color:#516b88;font-size:var(--fs-body,28rpx)}.social-notice-count{display:inline-block;padding:2rpx 14rpx;border-radius:20rpx;background:var(--brand-soft);color:var(--brand);font-size:24rpx}
