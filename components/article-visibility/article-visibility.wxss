@import "../../utils/motion.wxss";
:host{display:block}view,text,button,input{box-sizing:border-box}.visibility-overlay{position:fixed;inset:0;z-index:20010}.visibility-mask{position:absolute;inset:0;background:rgba(28,48,39,.38)}.visibility-sheet{position:absolute;bottom:0;left:0;right:0;max-height:90vh;display:flex;flex-direction:column;overflow:hidden;padding:30rpx 30rpx calc(28rpx + env(safe-area-inset-bottom));border-radius:36rpx 36rpx 0 0;background:#fff;color:var(--ink,#1f2328)}.visibility-heading{display:flex;align-items:center;justify-content:space-between;gap:20rpx;font-size:var(--fs-title,36rpx);font-weight:650;margin-bottom:20rpx}.visibility-close{font-size:var(--fs-small,24rpx);font-weight:400;color:var(--muted,#59636e);padding:14rpx 0 14rpx 20rpx}.visibility-option{display:flex;align-items:center;gap:20rpx;padding:22rpx 20rpx;border:2rpx solid transparent;border-radius:22rpx;flex-shrink:0}.visibility-option.selected{background:var(--brand-soft,#ddf4ff);border-color:var(--brand-line,#b6d7fb)}.visibility-symbol{width:48rpx;text-align:center;font-size:38rpx;color:var(--brand-dark,#0550ae);flex:none}.visibility-copy{flex:1;min-width:0}.visibility-copy>text:first-child{display:block;font-size:var(--fs-body,28rpx);font-weight:600}.visibility-copy>text:last-child{display:block;font-size:var(--fs-small,24rpx);color:var(--muted,#59636e);margin-top:6rpx;line-height:1.5}.visibility-check{width:36rpx;height:36rpx;border:2rpx solid var(--line,#d1d9e0);border-radius:50%;display:flex;align-items:center;justify-content:center;flex:none;font-size:24rpx;color:transparent}.selected .visibility-check,.visibility-check.checked{color:#fff;border-color:transparent;background:var(--brand,#0969da)}.friends-heading{display:flex;justify-content:space-between;gap:16rpx;font-size:var(--fs-small,24rpx);color:var(--muted,#59636e);margin:24rpx 8rpx 14rpx}.friends-heading>text:last-child{color:var(--brand-dark,#0550ae)}.friends-search{display:flex;align-items:center;gap:18rpx;border-radius:18rpx;background:var(--bg,#f6f8fa);padding:16rpx 20rpx;font-size:var(--fs-small,24rpx);flex:none}.friends-search input{flex:1;min-width:0;height:44rpx;font-size:var(--fs-small,24rpx)}.friends-search>text{flex:none;color:var(--brand-dark,#0550ae)}.friends-scroll{height:300rpx;min-height:100rpx;flex:0 1 300rpx;margin-top:12rpx}.friend-row{display:flex;align-items:center;gap:18rpx;padding:18rpx 8rpx;border-bottom:1rpx solid var(--line,#d1d9e0)}.friend-avatar{width:64rpx;height:64rpx;border-radius:20rpx;overflow:hidden;flex:none}.friend-name{flex:1;min-width:0;font-size:var(--fs-body,28rpx);overflow-wrap:anywhere}.friends-state{padding:30rpx 12rpx;text-align:center;color:var(--muted,#59636e);font-size:var(--fs-small,24rpx);line-height:1.7}.visibility-confirm{flex:none;display:flex;align-items:center;justify-content:center;min-height:84rpx;margin:24rpx 0 0;background:var(--brand,#0969da);color:#fff;border-radius:24rpx;font-size:var(--fs-body,28rpx);line-height:1.5;padding:16rpx}.visibility-confirm::after{border:0}.visibility-confirm[disabled]{opacity:.5}
