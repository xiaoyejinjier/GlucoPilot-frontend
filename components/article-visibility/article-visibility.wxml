<wxs module="i18n" src="/utils/i18n.wxs" />
<view wx:if="{{visible}}" class="visibility-overlay" style="{{displayStyle}}" catchtouchmove="stopTouch">
  <view class="visibility-mask" bindtap="close"></view>
  <view class="visibility-sheet" aria-role="dialog" aria-label="{{i18n.t('文章可见范围', locale)}}">
    <view class="visibility-heading"><text>{{i18n.t("谁可以看", locale)}}</text><text class="visibility-close ui-interactive" bindtap="close" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}">{{i18n.t("取消", locale)}}</text></view>
    <view wx:for="{{options}}" wx:key="value" class="visibility-option {{mode === item.value ? 'selected' : ''}} ui-interactive" data-value="{{item.value}}" bindtap="onMode" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}"><text class="visibility-symbol">{{i18n.t((item.symbol), locale)}}</text><view class="visibility-copy"><text>{{i18n.t((item.title), locale)}}</text><text>{{i18n.t((item.note), locale)}}</text></view><view class="visibility-check">{{i18n.t((mode === item.value ? '✓' : ''), locale)}}</view></view>
    <block wx:if="{{mode === 'FRIENDS'}}">
      <view class="friends-heading"><text>{{i18n.t("已选 " + (selectedIds.length) + " / 50 位好友", locale)}}</text><text class="ui-interactive" bindtap="onClear" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}">{{i18n.t("清空选择", locale)}}</text></view>
      <view class="friends-search"><input value="{{keyword}}" bindinput="onKeyword" bindconfirm="onSearch" maxlength="32" placeholder="{{i18n.t('搜索好友昵称', locale)}}" confirm-type="search" /><text class="ui-interactive" bindtap="onSearch" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}">{{i18n.t("搜索", locale)}}</text></view>
      <scroll-view class="friends-scroll" scroll-y bindscrolltolower="onMore">
        <view wx:for="{{friends}}" wx:key="userId" class="friend-row ui-interactive" data-id="{{item.userId}}" bindtap="onFriend" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}"><view class="friend-avatar"><avatar-image src="{{item.avatarUrl}}" text="友"></avatar-image></view><text class="friend-name">{{item.nickname}}</text><view class="visibility-check {{item.selected ? 'checked' : ''}}">{{i18n.t((item.selected ? '✓' : ''), locale)}}</view></view>
        <view wx:if="{{loading}}" class="friends-state">{{i18n.t("正在加载好友…", locale)}}</view><view wx:elif="{{error}}" class="friends-state ui-interactive" bindtap="onRetry" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}">{{i18n.t((error) + " · 点击重试", locale)}}</view><view wx:elif="{{!friends.length}}" class="friends-state">{{i18n.t((keyword ? '没有找到这位好友' : '还没有互相关注的好友'), locale)}}</view><view wx:elif="{{hasMore}}" class="friends-state ui-interactive" bindtap="onMore" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}">{{i18n.t("加载更多", locale)}}</view>
      </scroll-view>
    </block>
    <button class="visibility-confirm ui-interactive" bindtap="confirm" disabled="{{busy}}" loading="{{busy}}" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}">{{i18n.t((busy ? '正在保存' : '确定'), locale)}}</button>
  </view>
</view>
