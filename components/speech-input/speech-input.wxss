:host { display:block; }
view, text, button, textarea { box-sizing:border-box; }
.speech-mask { position:fixed; top:0; right:0; bottom:0; left:0; z-index:20000; display:flex; align-items:flex-end; background:rgba(33,43,61,.4); }
.speech-sheet { display:flex; flex-direction:column; width:100%; min-height:0; max-height:100%; padding:32rpx 32rpx calc(24rpx + env(safe-area-inset-bottom)); border-radius:40rpx 40rpx 0 0; background:#f8faff; color:#2e3544; }
.speech-header { display:flex; flex-shrink:0; justify-content:space-between; align-items:flex-start; gap:24rpx; }
.speech-title { display:block; font-size:var(--fs-title,36rpx); font-weight:600; }
.speech-subtitle { display:block; margin-top:8rpx; font-size:var(--fs-small,22rpx); color:#8892a5; }
.speech-close { flex:none; display:flex; justify-content:center; align-items:center; width:56rpx; height:56rpx; border-radius:50%; background:#eaf0f8; color:#6d7e98; font-size:40rpx; line-height:1; }
.speech-orb { display:flex; align-items:center; justify-content:center; width:144rpx; height:144rpx; margin:38rpx auto 26rpx; border:16rpx solid #e6eefc; border-radius:50%; background:#d6e5ff; color:#4c83dc; }
.speech-orb.listening { animation:speech-pulse 1.2s ease-in-out infinite; }
@keyframes speech-pulse { 50% { box-shadow:0 0 0 14rpx rgba(100,151,230,.12); } }
.speech-mic { position:relative; width:28rpx; height:44rpx; border:4rpx solid currentColor; border-radius:18rpx; }
.speech-mic::before { content:''; position:absolute; top:15rpx; left:-13rpx; width:46rpx; height:39rpx; border:4rpx solid currentColor; border-top:0; border-radius:0 0 26rpx 26rpx; }
.speech-mic::after { content:''; position:absolute; left:8rpx; bottom:-24rpx; width:4rpx; height:15rpx; background:currentColor; }
.speech-status,.speech-error,.speech-tip { display:block; text-align:center; line-height:1.6; }
.speech-status { font-size:var(--fs-body,28rpx); }
.speech-error { color:#c06a5e; font-size:var(--fs-body,28rpx); }
.speech-tip { margin:12rpx 0 30rpx; font-size:var(--fs-small,22rpx); color:#8b96aa; }
.speech-review-label { display:block; margin:28rpx 0 14rpx; font-size:var(--fs-small,22rpx); color:#7a89a0; }
.speech-result { flex:0 1 200rpx; width:100%; height:200rpx; min-height:80rpx; padding:20rpx; border:2rpx solid #dbe5f3; border-radius:20rpx; background:#fff; color:#33435b; font-size:var(--fs-body,28rpx); line-height:1.6; }
.speech-actions { display:flex; flex-shrink:0; gap:20rpx; margin-top:24rpx; }
.speech-button { flex:1; margin:0; min-height:84rpx; padding:20rpx 16rpx; border-radius:44rpx; font-size:var(--fs-body,28rpx); font-weight:500; line-height:1.5; }
.speech-button::after { border:0; }
.speech-button.primary { color:#fff; background:#4f8be5; }
.speech-button.secondary { color:#5681bb; background:#e7effb; }
.speech-button.full { width:100%; }
.speech-button[disabled] { color:#96a4bc; background:#e4ebf6; }
.speech-cancel { display:block; flex-shrink:0; margin-top:20rpx; padding:8rpx; text-align:center; color:#8c99ad; font-size:var(--fs-small,22rpx); }
