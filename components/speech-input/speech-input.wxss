@import "../../utils/motion.wxss";
:host { display:block; }
view, text, button, textarea { box-sizing:border-box; }
.speech-mask { position:fixed; top:0; right:0; bottom:0; left:0; z-index:20000; display:flex; align-items:flex-end; background:rgba(33,43,61,.4); }
.speech-sheet { display:flex; flex-direction:column; width:100%; min-height:0; max-height:100%; padding:32rpx 32rpx calc(24rpx + env(safe-area-inset-bottom)); border-radius:40rpx 40rpx 0 0; background:var(--voice-subtle,var(--surface-subtle)); color:var(--voice-ink,var(--ink)); }
.speech-header { display:flex; flex-shrink:0; justify-content:space-between; align-items:flex-start; gap:24rpx; }
.speech-title { display:block; font-size:var(--fs-title,36rpx); font-weight:600; }
.speech-subtitle { display:block; margin-top:8rpx; font-size:var(--fs-small,22rpx); color:var(--voice-muted,var(--muted)); }
.speech-close { flex:none; display:flex; justify-content:center; align-items:center; width:56rpx; height:56rpx; border-radius:50%; background:var(--voice-subtle,var(--surface-subtle)); color:var(--voice-muted,var(--muted)); font-size:40rpx; line-height:1; }
.speech-orb { display:flex; align-items:center; justify-content:center; width:144rpx; height:144rpx; margin:38rpx auto 26rpx; border:16rpx solid var(--voice-brand-soft,var(--brand-soft)); border-radius:50%; background:var(--voice-brand-soft,var(--brand-soft)); color:var(--voice-brand,var(--brand)); }
.speech-orb.listening { animation:speech-pulse 1.2s ease-in-out infinite; }
@keyframes speech-pulse { 50% { box-shadow:0 0 0 14rpx var(--voice-pulse,rgba(35,136,116,.12)); } }
.speech-mic { position:relative; width:28rpx; height:44rpx; border:4rpx solid currentColor; border-radius:18rpx; }
.speech-mic::before { content:''; position:absolute; top:15rpx; left:-13rpx; width:46rpx; height:39rpx; border:4rpx solid currentColor; border-top:0; border-radius:0 0 26rpx 26rpx; }
.speech-mic::after { content:''; position:absolute; left:8rpx; bottom:-24rpx; width:4rpx; height:15rpx; background:currentColor; }
.speech-status,.speech-error,.speech-tip { display:block; text-align:center; line-height:1.6; }
.speech-status { font-size:var(--fs-body,28rpx); }
.speech-error { color:#c06a5e; font-size:var(--fs-body,28rpx); }
.speech-tip { margin:12rpx 0 30rpx; font-size:var(--fs-small,22rpx); color:var(--voice-muted,var(--muted)); }
.speech-review-label { display:block; margin:28rpx 0 14rpx; font-size:var(--fs-small,22rpx); color:var(--voice-muted,var(--muted)); }
.speech-result { flex:0 1 200rpx; width:100%; height:200rpx; min-height:80rpx; padding:20rpx; border:2rpx solid var(--voice-line,var(--line)); border-radius:20rpx; background:#fff; color:var(--voice-ink,var(--ink)); font-size:var(--fs-body,28rpx); line-height:1.6; }
.speech-actions { display:flex; flex-shrink:0; gap:20rpx; margin-top:24rpx; }
.speech-button { flex:1; margin:0; min-height:84rpx; padding:20rpx 16rpx; border-radius:44rpx; font-size:var(--fs-body,28rpx); font-weight:500; line-height:1.5; }
.speech-button::after { border:0; }
.speech-button.primary { color:#fff; background:var(--voice-brand,var(--brand)); }
.speech-button.secondary { color:var(--voice-brand,var(--brand)); background:var(--voice-brand-soft,var(--brand-soft)); }
.speech-button.full { width:100%; }
.speech-button[disabled] { color:var(--voice-hint,var(--hint)); background:var(--voice-subtle,var(--surface-subtle)); }
.speech-cancel { display:block; flex-shrink:0; margin-top:20rpx; padding:8rpx; text-align:center; color:var(--voice-muted,var(--muted)); font-size:var(--fs-small,22rpx); }
