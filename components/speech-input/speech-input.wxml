<wxs module="i18n" src="/utils/i18n.wxs" />
<view wx:if="{{visible}}" class="speech-mask" style="{{viewportHeight ? 'height:' + viewportHeight + 'px;bottom:auto;' : ''}}" catchtouchmove="preventTouch">
  <view class="speech-sheet" aria-role="dialog" aria-label="{{i18n.t('语音输入', locale)}}">
    <view class="speech-header">
      <view><text class="speech-title">{{i18n.t("语音输入", locale)}}</text><text class="speech-subtitle">{{i18n.t("转成文字，确认后再发送", locale)}}</text></view>
      <view class="speech-close ui-interactive" bindtap="close" aria-role="button" aria-label="{{i18n.t('关闭语音输入', locale)}}" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}">×</view>
    </view>
    <block wx:if="{{phase === 'review'}}">
      <text class="speech-review-label">{{i18n.t("识别结果 · 可以修改", locale)}}</text>
      <textarea class="speech-result" value="{{text}}" bindinput="edit" maxlength="{{maxLength}}"
        placeholder="{{i18n.t('请检查识别文字', locale)}}" adjust-position="{{false}}" cursor-spacing="16"></textarea>
      <view class="speech-actions">
        <button class="speech-button secondary ui-interactive" bindtap="retry" disabled="{{disabled}}" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}">{{i18n.t("重新录音", locale)}}</button>
        <button class="speech-button primary ui-interactive" bindtap="confirm" disabled="{{disabled || !text}}" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}">{{i18n.t("确认发送", locale)}}</button>
      </view>
    </block>
    <block wx:else>
      <view class="speech-orb {{phase === 'recording' ? 'listening' : ''}}"><view class="speech-mic"></view></view>
      <text wx:if="{{phase === 'recording'}}" class="speech-status">{{i18n.t("正在录音… " + (seconds) + "s / 60s", locale)}}</text>
      <text wx:elif="{{phase === 'authorizing'}}" class="speech-status">{{i18n.t("正在准备麦克风…", locale)}}</text>
      <text wx:elif="{{phase === 'stopping' || phase === 'transcribing'}}" class="speech-status">{{i18n.t("正在转成文字，请稍候…", locale)}}</text>
      <text wx:elif="{{phase === 'error'}}" class="speech-error">{{i18n.t((error), locale)}}</text>
      <text wx:else class="speech-status">{{i18n.t("请按住下方“按住说话”开始录音", locale)}}</text>
      <text class="speech-tip">{{i18n.t((phase === 'recording' || phase === 'authorizing' ? '松开结束，识别后确认发送' : '每次最多60秒，不会自动发送'), locale)}}</text>
      <button wx:if="{{phase === 'stopping' || phase === 'transcribing'}}" class="speech-button primary full" disabled>{{i18n.t("请稍候", locale)}}</button>
      <button wx:elif="{{permissionDenied}}" class="speech-button primary full ui-interactive" bindtap="openSettings" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}">{{i18n.t("开启麦克风权限", locale)}}</button>
      <button wx:elif="{{phase === 'error' || phase === 'ready'}}" class="speech-button primary full ui-interactive" bindtap="retry" disabled="{{disabled}}" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}">{{i18n.t("重新录音", locale)}}</button>
    </block>
    <text wx:if="{{phase !== 'recording' && phase !== 'authorizing'}}" class="speech-cancel ui-interactive" bindtap="close" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}">{{i18n.t("取消", locale)}}</text>
  </view>
</view>
