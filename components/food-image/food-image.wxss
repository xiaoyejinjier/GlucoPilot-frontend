:host{display:block;width:100%;height:100%;border-radius:inherit;overflow:hidden}
.food-image,.food-placeholder{display:block;width:100%;height:100%;border-radius:inherit}
.food-placeholder{display:flex;align-items:center;justify-content:center;background:var(--surface-subtle,#f0f4fa);color:var(--muted,#586b83)}
.food-spinner{width:24rpx;height:24rpx;border:3rpx solid var(--line,#dce5f0);border-top-color:var(--brand,#2770cf);border-radius:50%;animation:food-image-spin 850ms linear infinite}
.food-retry text{font-size:34rpx;line-height:1}
@keyframes food-image-spin{to{transform:rotate(360deg)}}
