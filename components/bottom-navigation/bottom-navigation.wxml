<view class="bottom-navigation" style="--brand: {{brandColor}};">
  <view id="nav-assistant" class="assistant-entry" bindtap="openAssistant"
    hover-class="navigation-pressed" aria-role="button" aria-label="小语，语音助手">
    <assistant-mascot variant="nav"></assistant-mascot>
    <text class="assistant-name">{{assistant.text}}</text>
  </view>
  <view class="navigation-pill">
    <view wx:for="{{items}}" wx:key="pagePath"
      id="nav-item-{{item.index}}" class="navigation-item {{selected === item.index ? 'navigation-active' : ''}}"
      data-path="{{item.pagePath}}" data-index="{{item.index}}" bindtap="switchTab"
      hover-class="navigation-pressed" aria-role="button" aria-label="{{item.text}}">
      <app-icon name="{{item.icon}}" active="{{selected === item.index}}"
        color="{{selected === item.index ? brandColor : '#545c66'}}" size="lg"></app-icon>
      <text class="navigation-label">{{item.text}}</text>
      <view wx:if="{{item.index === 2 && unreadCount > 0}}" class="navigation-unread"></view>
    </view>
  </view>
</view>
<view wx:if="{{guideActive}}" class="navigation-guide {{guideReady ? '' : 'guide-measuring'}}"
  catchtap="stopGuideTouch" catchtouchmove="stopGuideTouch">
  <view wx:if="{{guideReady}}" class="guide-focus" style="{{focusStyle}}"></view>
  <view class="guide-card" aria-role="dialog" aria-label="新手引导">
    <view class="guide-heading">
      <text class="guide-title">{{guideSteps[guideIndex].title}}</text>
      <text class="guide-count">{{guideIndex + 1}} / {{guideSteps.length}}</text>
    </view>
    <text class="guide-description">{{guideSteps[guideIndex].description}}</text>
    <view class="guide-footer">
      <view class="guide-dots">
        <view wx:for="{{guideSteps}}" wx:key="target" class="guide-dot {{guideIndex === index ? 'guide-dot-active' : ''}}"></view>
      </view>
      <button class="guide-next" bindtap="nextGuide" disabled="{{!guideReady}}"
        hover-class="navigation-pressed">{{guideIndex === guideSteps.length - 1 ? '开始使用' : '下一步'}}</button>
    </view>
    <view wx:if="{{guideReady}}" class="guide-arrow" style="{{arrowStyle}}"></view>
  </view>
</view>
