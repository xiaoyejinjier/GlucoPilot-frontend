:host{display:block;width:100%}.meal-photo{overflow:hidden;border-radius:18rpx;background:#f6f8fa}.meal-photo image{display:block;width:100%;height:360rpx}.photo-state{display:flex;min-height:180rpx;align-items:center;justify-content:center;flex-direction:column;gap:16rpx;color:var(--muted);font-size:var(--fs-small);line-height:1.5;padding:24rpx}.photo-action{color:var(--brand)}.photo-caption{display:block;padding:14rpx;text-align:center;color:var(--brand);font-size:var(--fs-small)}
