@import "/utils/motion.wxss";

.search-panel {
  display: flex;
  flex-direction: column;
  height: 100%;
  min-height: 0;
  background: #f5f7fb;
  box-sizing: border-box;
}

.search-panel.page-mode {
  min-height: 100vh;
  padding: 20rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
}

.search-panel.embedded {
  padding: calc(20rpx + env(safe-area-inset-top)) 24rpx calc(24rpx + env(safe-area-inset-bottom));
}

.search-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 28rpx;
  flex: none;
}

.search-back {
  flex: none;
  width: 48rpx;
  text-align: center;
  font-size: 36rpx;
  line-height: 1;
  color: var(--ink-soft);
}

.search-field {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 14rpx 20rpx;
  border-radius: 999rpx;
  background: #eceff3;
  color: #5b6b7c;
}

.search-icon {
  font-size: 32rpx;
  line-height: 1;
}

.search-input {
  flex: 1;
  min-width: 0;
  height: 44rpx;
  font-size: var(--fs-body);
  color: var(--ink);
}

.search-clear {
  width: 36rpx;
  height: 36rpx;
  line-height: 34rpx;
  text-align: center;
  border-radius: 50%;
  background: #c5ced8;
  color: #fff;
  font-size: 28rpx;
}

.search-submit {
  flex: none;
  padding: 10rpx 8rpx;
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--brand);
}

.search-body {
  flex: 1;
  min-height: 0;
  height: 0;
}

.search-panel.page-mode .search-body {
  height: auto;
  flex: none;
  min-height: 60vh;
}

.section {
  margin-bottom: 32rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
  padding: 0 4rpx;
}

.section-title {
  font-size: var(--fs-body);
  font-weight: 700;
  color: var(--ink-soft);
}

.section-action {
  font-size: var(--fs-small);
  color: var(--hint);
}

.history-list {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.history-chip {
  max-width: 100%;
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  background: #e8edf3;
  color: #4d5f73;
  font-size: var(--fs-small);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hot-grid {
  display: flex;
  gap: 18rpx;
}

.hot-col {
  flex: 1;
  min-width: 0;
}

.hot-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 4rpx;
}

.hot-rank {
  flex: none;
  width: 36rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 700;
  color: #9aa8b8;
}

.hot-rank.top {
  color: #1f2937;
}

.hot-title {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-small);
  color: var(--ink-soft);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.suggest-list {
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  border: 1rpx solid #e2e8f0;
}

.suggest-row {
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid #eef2f6;
}

.suggest-row:last-child {
  border-bottom: 0;
}

.suggest-text {
  font-size: var(--fs-body);
  color: var(--ink);
  line-height: 1.5;
}

.suggest-match {
  color: #e11d8c;
  font-weight: 600;
}

.result-card {
  display: flex;
  gap: 18rpx;
  margin-bottom: 18rpx;
  padding: 22rpx;
  border-radius: 22rpx;
  background: #fff;
  border: 1rpx solid #d9e4f2;
}

.result-cover {
  width: 160rpx;
  height: 120rpx;
  flex: none;
  border-radius: 14rpx;
  background: #e8eef6;
}

.result-copy {
  flex: 1;
  min-width: 0;
}

.result-title {
  display: block;
  font-size: var(--fs-body);
  font-weight: 700;
  color: var(--navy);
  line-height: 1.45;
}

.result-summary {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  margin-top: 10rpx;
  font-size: var(--fs-small);
  color: var(--muted);
  line-height: 1.6;
}

.result-meta {
  display: block;
  margin-top: 12rpx;
  font-size: 20rpx;
  color: var(--hint);
}

.state {
  text-align: center;
  padding: 36rpx 16rpx;
  color: var(--hint);
  font-size: var(--fs-small);
}

.state.action {
  color: var(--brand);
}

.feed-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 64rpx 28rpx;
  background: #fff;
  border-radius: 22rpx;
  text-align: center;
}

.empty-title {
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--ink-soft);
}

.empty-copy {
  margin-top: 12rpx;
  font-size: var(--fs-small);
  color: var(--muted);
  line-height: 1.7;
}

.feed-empty button {
  margin-top: 28rpx;
  font-size: var(--fs-small);
  color: var(--brand);
  background: var(--brand-soft);
  border: 0;
  border-radius: 28rpx;
  padding: 0 28rpx;
}

.feed-empty button::after {
  border: 0;
}
