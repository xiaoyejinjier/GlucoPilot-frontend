.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: calc(96rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  display: flex;
  flex-direction: row;
  border-top: 1rpx solid #e5e7eb;
  background: #fafafa;
  z-index: 9999;
}

.tab-item {
  flex: 1;
  width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  color: #7a7a7a;
}

.tab-item.active {
  color: var(--brand, #07c160);
  font-weight: 700;
}

.tab-text {
  font-size: var(--fs-tiny);
  line-height: 1;
}
