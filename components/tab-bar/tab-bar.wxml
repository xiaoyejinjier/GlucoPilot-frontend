<view class="tab-bar" style="--brand: {{brandColor}};">
  <view
    wx:for="{{list}}"
    wx:key="index"
    class="tab-item {{selected === index ? 'active' : ''}}"
    style="{{selected === index ? 'color:' + brandColor : ''}}"
    data-path="{{item.pagePath}}"
    data-index="{{index}}"
    bindtap="switchTab"
  >
    <app-icon
      name="{{item.icon}}"
      active="{{selected === index}}"
      color="{{selected === index ? brandColor : ''}}"
      size="md"
    ></app-icon>
    <text class="tab-text">{{item.text}}</text>
  </view>
</view>
