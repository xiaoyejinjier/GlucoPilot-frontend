.report-page{padding:24rpx 26rpx calc(40rpx + env(safe-area-inset-bottom));background:var(--bg);min-height:100vh;padding-bottom:calc(40rpx + env(safe-area-inset-bottom))}.report-intro{padding:14rpx 4rpx 32rpx}.report-eyebrow{display:block;font-size:var(--fs-small);color:var(--muted);margin-bottom:16rpx}.report-title{display:block;font-size:40rpx;font-weight:700;line-height:1.5;color:var(--ink)}.report-description{display:block;font-size:var(--fs-small);line-height:1.9;color:var(--muted);margin-top:16rpx}.reasons-card{background:white;border-radius:26rpx;overflow:hidden;padding:0 28rpx}.reason-row{display:flex;align-items:center;gap:22rpx;padding:30rpx 0;border-bottom:1rpx solid var(--surface-subtle)}.reason-row:last-child{border-bottom:0}.reason-copy{flex:1;min-width:0}.reason-title{display:block;font-size:var(--fs-body);color:var(--ink-soft)}.reason-description{display:block;font-size:20rpx;color:#a0aea5;line-height:1.7;margin-top:9rpx}.reason-radio{width:35rpx;height:35rpx;border-radius:50%;border:2rpx solid var(--line);flex-shrink:0;display:flex;align-items:center;justify-content:center;color:white;font-size:22rpx}.selected .reason-radio{background:var(--brand);border-color:var(--brand)}.selected .reason-title{color:var(--brand)}.report-extra{margin-top:24rpx;background:white;border-radius:26rpx;padding:28rpx}.extra-title{display:block;color:var(--muted);font-size:var(--fs-body)}.extra-title>text{font-size:20rpx;color:var(--muted);margin-left:16rpx}.report-extra textarea{height:190rpx;width:100%;font-size:var(--fs-body);line-height:1.8;margin-top:24rpx;color:var(--ink-soft)}.extra-count{text-align:right;display:block;color:var(--hint);font-size:20rpx}.report-privacy{display:block;font-size:20rpx;color:var(--hint);line-height:1.8;margin:22rpx 8rpx 28rpx}.report-submit{font-size:var(--fs-body);border-radius:20rpx;background:var(--brand);color:#fff;line-height:2.9;border:0}.report-submit[disabled]{background:var(--brand-line);color:#f8faf9}.report-submit::after{border:0}.report-success{background:#fff;border-radius:30rpx;text-align:center;padding:60rpx 35rpx;margin-top:50rpx}.success-icon{display:flex;align-items:center;justify-content:center;width:110rpx;height:110rpx;border-radius:50%;margin:0 auto 30rpx;background:var(--brand-soft);color:var(--brand);font-size:50rpx}.report-success button{margin-top:40rpx}
