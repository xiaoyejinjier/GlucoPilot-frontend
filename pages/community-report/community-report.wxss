.report-page{padding:24rpx 26rpx calc(40rpx + env(safe-area-inset-bottom));background:#f5f8f6;min-height:100vh;padding-bottom:calc(40rpx + env(safe-area-inset-bottom))}.report-intro{padding:14rpx 4rpx 32rpx}.report-eyebrow{display:block;font-size:var(--fs-small);color:#92a69a;margin-bottom:16rpx}.report-title{display:block;font-size:40rpx;font-weight:700;line-height:1.5;color:#304939}.report-description{display:block;font-size:var(--fs-small);line-height:1.9;color:#91a095;margin-top:16rpx}.reasons-card{background:white;border-radius:26rpx;overflow:hidden;padding:0 28rpx}.reason-row{display:flex;align-items:center;gap:22rpx;padding:30rpx 0;border-bottom:1rpx solid #eef2ef}.reason-row:last-child{border-bottom:0}.reason-copy{flex:1;min-width:0}.reason-title{display:block;font-size:var(--fs-body);color:#4e6255}.reason-description{display:block;font-size:20rpx;color:#a0aea5;line-height:1.7;margin-top:9rpx}.reason-radio{width:35rpx;height:35rpx;border-radius:50%;border:2rpx solid #d9e3dc;flex-shrink:0;display:flex;align-items:center;justify-content:center;color:white;font-size:22rpx}.selected .reason-radio{background:#4d9469;border-color:#4d9469}.selected .reason-title{color:#397e52}.report-extra{margin-top:24rpx;background:white;border-radius:26rpx;padding:28rpx}.extra-title{display:block;color:#61796a;font-size:var(--fs-body)}.extra-title>text{font-size:20rpx;color:#a1ada6;margin-left:16rpx}.report-extra textarea{height:190rpx;width:100%;font-size:var(--fs-body);line-height:1.8;margin-top:24rpx;color:#53695a}.extra-count{text-align:right;display:block;color:#b0bbb3;font-size:20rpx}.report-privacy{display:block;font-size:20rpx;color:#a3b0a7;line-height:1.8;margin:22rpx 8rpx 28rpx}.report-submit{font-size:var(--fs-body);border-radius:20rpx;background:#358b5c;color:#fff;line-height:2.9;border:0}.report-submit[disabled]{background:#bed4c5;color:#f8faf9}.report-submit::after{border:0}.report-success{background:#fff;border-radius:30rpx;text-align:center;padding:60rpx 35rpx;margin-top:50rpx}.success-icon{display:flex;align-items:center;justify-content:center;width:110rpx;height:110rpx;border-radius:50%;margin:0 auto 30rpx;background:#e6f2e9;color:#50986a;font-size:50rpx}.report-success button{margin-top:40rpx}
