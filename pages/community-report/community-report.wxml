<view class="page-no-tab report-page" style="{{displayStyle}}">
  <view wx:if="{{success}}" class="report-success"><view class="success-icon">✓</view><text class="report-title">举报已提交</text><text class="report-description">感谢你帮助维护社区。管理员将核查你反馈的内容，并根据情况处理。</text><button class="report-submit" bindtap="onBack">返回上一页</button></view>
  <block wx:elif="{{valid}}"><view class="report-intro"><text class="report-eyebrow">一起维护友善的社区</text><text class="report-title">这条{{targetLabel}}有什么问题？</text><text class="report-description">选择最符合的原因，帮助管理员准确核查。</text></view><view class="reasons-card"><view wx:for="{{reasons}}" wx:key="code" class="reason-row {{reason === item.code ? 'selected' : ''}}" data-code="{{item.code}}" bindtap="onReason"><view class="reason-copy"><text class="reason-title">{{item.title}}</text><text class="reason-description">{{item.description}}</text></view><view class="reason-radio">{{reason === item.code ? '✓' : ''}}</view></view></view><view class="report-extra"><text class="extra-title">补充说明<text>{{reason === 'OTHER' ? '必填' : '选填'}}</text></text><textarea maxlength="500" value="{{details}}" bindinput="onDetails" placeholder="具体哪里存在问题？可以描述相关情况，帮助管理员判断。" disabled="{{sending}}" /><text class="extra-count">{{details.length}} / 500</text></view><text class="report-privacy">举报信息仅供管理员核查，请勿提交无关的个人隐私。</text><button class="report-submit" bindtap="onSubmit" loading="{{sending}}" disabled="{{sending || !reason}}">{{sending ? '正在提交…' : '提交举报'}}</button></block>
  <view wx:else class="report-success"><text class="report-title">暂时无法举报此内容</text><button class="report-submit" bindtap="onBack">返回上一页</button></view>
</view>
