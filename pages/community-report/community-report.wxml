<wxs module="i18n" src="/utils/i18n.wxs" />
<view class="page-no-tab report-page" style="{{displayStyle}}">
  <view wx:if="{{success}}" class="report-success"><view class="success-icon">✓</view><text class="report-title">{{i18n.t("举报已提交", locale)}}</text><text class="report-description">{{i18n.t("感谢你帮助维护社区。管理员将核查并反馈结果，可在“我的举报”中查看。", locale)}}</text><button class="report-submit ui-interactive" bindtap="onMyReports" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}">{{i18n.t("查看我的举报", locale)}}</button><text class="report-description ui-interactive" bindtap="onBack" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}">{{i18n.t("返回上一页", locale)}}</text></view>
  <block wx:elif="{{valid}}"><view class="report-intro"><text class="report-eyebrow">{{i18n.t("一起维护友善的社区", locale)}}</text><text class="report-title">{{i18n.t("这条" + (targetLabel) + "有什么问题？", locale)}}</text><text class="report-description">{{i18n.t("选择最符合的原因，帮助管理员准确核查。", locale)}}</text></view><view class="reasons-card"><view wx:for="{{reasons}}" wx:key="code" class="reason-row {{reason === item.code ? 'selected' : ''}} ui-interactive" data-code="{{item.code}}" bindtap="onReason" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}"><view class="reason-copy"><text class="reason-title">{{i18n.t(item.title, locale)}}</text><text class="reason-description">{{i18n.t((item.description), locale)}}</text></view><view class="reason-radio">{{i18n.t((reason === item.code ? '✓' : ''), locale)}}</view></view></view><view class="report-extra"><text class="extra-title">{{i18n.t("补充说明", locale)}}<text>{{i18n.t((reason === 'OTHER' ? '必填' : '选填'), locale)}}</text></text><textarea maxlength="500" value="{{details}}" bindinput="onDetails" placeholder="{{i18n.t('具体哪里存在问题？可以描述相关情况，帮助管理员判断。', locale)}}" disabled="{{sending}}" /><text class="extra-count">{{i18n.t((details.length) + " / 500", locale)}}</text></view><text class="report-privacy">{{i18n.t("举报信息仅供管理员核查，请勿提交无关的个人隐私。", locale)}}</text><button class="report-submit ui-interactive" bindtap="onSubmit" loading="{{sending}}" disabled="{{sending || !reason}}" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}">{{i18n.t((sending ? '正在提交…' : '提交举报'), locale)}}</button></block>
  <view wx:else class="report-success"><text class="report-title">{{i18n.t("暂时无法举报此内容", locale)}}</text><button class="report-submit ui-interactive" bindtap="onBack" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}">{{i18n.t("返回上一页", locale)}}</button></view>
</view>
