<view class="page-no-tab" style="{{displayStyle}}">
  <view class="card">
    <view class="section-title">基础资料</view>
    <view class="kv-list">
      <view class="kv-item"><text class="kv-item-label">糖尿病类型</text><text class="kv-item-value">{{userInfo.diabetesType || '未填写'}}</text></view>
      <view class="kv-item"><text class="kv-item-label">确诊时间</text><text class="kv-item-value">{{userInfo.confirmDate || '未填写'}}</text></view>
      <view class="kv-item"><text class="kv-item-label">用药</text><text class="kv-item-value">{{userInfo.medication || '未填写'}}</text></view>
      <view class="kv-item"><text class="kv-item-label">运动习惯</text><text class="kv-item-value">{{userInfo.exercise || '未填写'}}</text></view>
    </view>
  </view>

  <view class="card">
    <view class="section-title">近期控糖小结</view>
    <text class="summary-text">{{weekSummary}}</text>
  </view>

  <view class="card">
    <view class="section-title">血糖历史</view>
    <view class="kv-list">
      <view class="kv-item"><text class="kv-item-label">今日</text><text class="kv-item-value">{{todayRecords}}</text></view>
      <view class="kv-item"><text class="kv-item-label">昨日</text><text class="kv-item-value">{{yesterdayRecords}}</text></view>
      <view class="kv-item"><text class="kv-item-label">本月达标</text><text class="kv-item-value">{{weekCompliance}}</text></view>
    </view>
  </view>
</view>
