<wxs module="i18n" src="/utils/i18n.wxs" />
<view class="page-no-tab" style="{{displayStyle}}">
  <view class="card ui-interactive" bindtap="onEditProfile" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}">
    <view class="section-title">{{i18n.t("基础资料", locale)}}<text class="section-edit">{{i18n.t("编辑 ›", locale)}}</text></view>
    <view class="kv-list">
      <view class="kv-item"><text class="kv-item-label">{{i18n.t("身高", locale)}}</text><text class="kv-item-value">{{i18n.t((userInfo.height ? userInfo.height + ' cm' : '--'), locale)}}</text></view>
      <view class="kv-item"><text class="kv-item-label">{{i18n.t("体重", locale)}}</text><text class="kv-item-value">{{i18n.t((userInfo.weight ? userInfo.weight + ' kg' : '--'), locale)}}</text></view>
      <view class="kv-item"><text class="kv-item-label">{{i18n.t("糖尿病类型", locale)}}</text><text class="kv-item-value">{{i18n.t((userInfo.diabetesType || '未填写'), locale)}}</text></view>
      <view class="kv-item"><text class="kv-item-label">{{i18n.t("确诊时间", locale)}}</text><text class="kv-item-value">{{i18n.t((userInfo.confirmDate || '未填写'), locale)}}</text></view>
      <view class="kv-item"><text class="kv-item-label">{{i18n.t("用药", locale)}}</text><text class="kv-item-value">{{userInfo.medication || i18n.t('未填写', locale)}}</text></view>
      <view class="kv-item"><text class="kv-item-label">{{i18n.t("运动习惯", locale)}}</text><text class="kv-item-value">{{userInfo.exercise || i18n.t('未填写', locale)}}</text></view>
    </view>
  </view>

  <view class="card">
    <view class="section-title">{{i18n.t("近期控糖小结", locale)}}</view>
    <text class="summary-text">{{i18n.t((weekSummary), locale)}}</text>
  </view>

  <view class="card">
    <view class="section-title">{{i18n.t("血糖历史", locale)}}</view>
    <view class="kv-list">
      <view class="kv-item"><text class="kv-item-label">{{i18n.t("今日", locale)}}</text><text class="kv-item-value">{{i18n.t((todayRecords), locale)}}</text></view>
      <view class="kv-item"><text class="kv-item-label">{{i18n.t("昨日", locale)}}</text><text class="kv-item-value">{{i18n.t((yesterdayRecords), locale)}}</text></view>
      <view class="kv-item"><text class="kv-item-label">{{i18n.t("本月达标", locale)}}</text><text class="kv-item-value">{{i18n.t((weekCompliance), locale)}}</text></view>
    </view>
  </view>
</view>
