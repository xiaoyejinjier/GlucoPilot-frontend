.dm-page { height:100vh; display:flex; flex-direction:column; overflow:hidden; background:var(--bg); }
.dm-scroll-shell { position:relative; height:0; flex:1; min-height:0; width:100%; overflow:hidden; }
.dm-list { height:100%; width:100%; }
.dm-content { min-height:100%; }
.dm-content.edge-returning { transition:transform 320ms cubic-bezier(.2,.8,.2,1); }
.dm-refresh-indicator { width:100%; height:52px; display:flex; align-items:center; justify-content:center; gap:12rpx; background:var(--bg); pointer-events:none; }
.dm-refresh-indicator view { width:10rpx; height:10rpx; border-radius:50%; background:var(--muted); opacity:.55; }
.dm-refresh-indicator.is-loading view { animation:dm-dot-pulse 850ms ease-in-out infinite; }
.dm-refresh-indicator.is-loading view:nth-child(2) { animation-delay:140ms; }
.dm-refresh-indicator.is-loading view:nth-child(3) { animation-delay:280ms; }
@keyframes dm-dot-pulse { 0%,70%,100% { opacity:.35; transform:translateY(0); } 35% { opacity:1; transform:translateY(-5rpx); } }
.dm-item { padding:16rpx 28rpx; display:flex; flex-direction:column; align-items:flex-start; gap:10rpx; }
.dm-item.mine { align-items:flex-end; }
.dm-time { align-self:center; font-size:var(--fs-tiny); color:var(--muted); }
.dm-bubble { max-width:85%; border-radius:24rpx 24rpx 24rpx 6rpx; padding:22rpx 28rpx; background:var(--surface); color:var(--ink); font-size:var(--fs-body); line-height:1.6; overflow-wrap:anywhere; white-space:pre-wrap; box-sizing:border-box; }
.mine .dm-bubble { border-radius:24rpx 24rpx 6rpx 24rpx; background:var(--brand-soft); }
.dm-read { color:var(--muted); font-size:var(--fs-tiny); }
.dm-state { text-align:center; padding:28rpx; color:var(--muted); font-size:var(--fs-small); }
.dm-error { color:var(--brand-dark); }
.dm-compose-area { flex:none; background:var(--surface); padding-bottom:env(safe-area-inset-bottom); border-top:1rpx solid var(--line); }
.dm-composer { display:flex; align-items:center; gap:14rpx; padding:20rpx 18rpx; }
.dm-composer input { flex:1; min-width:0; height:80rpx; border-radius:20rpx; padding:0 20rpx; background:var(--bg); font-size:var(--fs-body); }
.dm-composer button { flex:none; width:auto; margin:0; padding:0 22rpx; height:76rpx; line-height:76rpx; color:white; background:var(--brand); font-size:var(--fs-small); border-radius:18rpx; }
.dm-tool { flex:none; width:52rpx; height:72rpx; display:flex; align-items:center; justify-content:center; color:var(--ink); }
.dm-composer button[disabled] { background:var(--surface-subtle); color:var(--hint); }
.dm-tool.active { color:var(--brand); }
.dm-hold { flex:1; min-width:0; height:80rpx; line-height:80rpx; border-radius:20rpx; text-align:center; background:var(--bg); color:var(--ink); font-weight:600; font-size:var(--fs-body); }
.dm-hold.holding { color:var(--brand); background:var(--brand-soft); }
.voice-symbol { display:flex; gap:5rpx; align-items:center; height:40rpx; border:3rpx solid currentColor; border-radius:50%; padding:7rpx; box-sizing:border-box; }
.voice-symbol view { width:3rpx; height:12rpx; background:currentColor; border-radius:3rpx; }
.voice-symbol view:nth-child(2),.voice-symbol view:nth-child(3) { height:22rpx; }
.keyboard-symbol { font-size:42rpx; }
.emoji-symbol { position:relative; width:40rpx; height:40rpx; box-sizing:border-box; border:3rpx solid currentColor; border-radius:50%; }
.emoji-symbol::before,.emoji-symbol::after { content:''; position:absolute; top:9rpx; width:5rpx; height:5rpx; border-radius:50%; background:currentColor; }
.emoji-symbol::before { left:8rpx; }.emoji-symbol::after { right:8rpx; }
.emoji-symbol view { position:absolute; left:8rpx; right:8rpx; bottom:7rpx; height:9rpx; border-bottom:3rpx solid currentColor; border-radius:0 0 18rpx 18rpx; }
.emoji-panel { padding:8rpx 24rpx 20rpx; }
.emoji-heading { color:var(--muted); font-size:var(--fs-tiny); }
.emoji-grid { display:grid; grid-template-columns:repeat(7,1fr); margin-top:8rpx; }
.emoji-grid view { height:76rpx; display:flex; align-items:center; justify-content:center; font-size:44rpx; }

.dm-message-row{display:flex;align-items:flex-start;gap:16rpx;width:100%;min-width:0}.mine .dm-message-row{flex-direction:row-reverse}.dm-avatar{width:76rpx;height:76rpx;flex:none;border-radius:22rpx;overflow:hidden;display:flex;align-items:center;justify-content:center;background:var(--brand-soft);color:var(--brand-dark);font-size:var(--fs-body);font-weight:600}.dm-avatar image{width:100%;height:100%}.dm-message-row .dm-bubble{max-width:calc(100% - 100rpx)}.dm-read{padding-right:92rpx}
.dm-avatar > view{width:100%;height:100%}
.dm-permission{display:flex;align-items:center;gap:20rpx;margin:4rpx 24rpx 16rpx;padding:24rpx;border-radius:22rpx;background:var(--brand-soft);color:var(--brand-dark)}.dm-permission-copy{flex:1;min-width:0;font-size:var(--fs-small);line-height:1.7;overflow-wrap:anywhere}.dm-permission-copy text{display:block}.dm-follow{flex:none;margin:0;padding:0 20rpx;font-size:var(--fs-small);line-height:2.6;border-radius:28rpx;background:var(--brand);color:#fff}.dm-follow::after{border:0}
.dm-follow.is-followed{background:var(--line);color:var(--muted)}
