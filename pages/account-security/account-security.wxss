.tip-card .tip-line {
  font-size: var(--fs-small);
  color: var(--muted);
  line-height: 1.5;
}

/* 换绑手机号浮层，样式与登录页保持一致 */
.phone-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 20;
}

.phone-panel {
  position: fixed;
  left: 32rpx;
  right: 32rpx;
  bottom: calc(48rpx + env(safe-area-inset-bottom));
  z-index: 30;
  background: var(--bg);
  border-radius: 24rpx;
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.18);
}

.phone-title {
  font-size: var(--fs-title);
  font-weight: 700;
  text-align: center;
}

.phone-input {
  height: 80rpx;
  padding: 0 24rpx;
  border-radius: 16rpx;
  background: var(--card, #f5f5f5);
  font-size: var(--fs-body);
}

.sms-row {
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.sms-input {
  flex: 1;
}

.sms-btn {
  flex-shrink: 0;
  margin: 0;
}
