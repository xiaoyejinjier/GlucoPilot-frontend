<view class="page-no-tab" style="{{displayStyle}}">
  <view class="card menu-list">
    <view class="menu-item">
      <text>登录方式</text>
      <text class="menu-arrow">微信 / 手机号 / 邮箱</text>
    </view>
    <view class="menu-item" bindtap="onBindPhone">
      <text>绑定手机号</text>
      <text class="menu-arrow">{{phone}} ›</text>
    </view>
    <view class="menu-item" bindtap="onBindEmail">
      <text>绑定邮箱</text>
      <text class="menu-arrow">{{email}} ›</text>
    </view>
  </view>

  <view class="card tip-card">
    <text class="tip-line">换绑手机号需短信验证码（开发环境见后端日志）；换绑邮箱需邮箱验证码（需配置 SMTP）。</text>
  </view>

  <view class="phone-mask" wx:if="{{panel}}" bindtap="onClosePanel"></view>
  <view class="phone-panel" wx:if="{{panel}}">
    <text class="phone-title">绑定手机号</text>
    <input class="phone-input" type="number" maxlength="11" placeholder="新手机号" value="{{newPhone}}" bindinput="onPhoneInput" />
    <view class="sms-row">
      <input class="phone-input sms-input" type="number" maxlength="6" placeholder="验证码" value="{{smsCode}}" bindinput="onSmsInput" />
      <button class="btn-ghost sms-btn" size="mini" disabled="{{smsCooldown > 0}}" bindtap="onSendSms">
        {{smsCooldown > 0 ? smsCooldown + 's' : '获取验证码'}}
      </button>
    </view>
    <button class="btn-primary btn-block" disabled="{{submitting}}" bindtap="onConfirmBind">确认绑定</button>
    <button class="btn-ghost btn-block btn-sm" bindtap="onClosePanel">取消</button>
  </view>

  <view class="phone-mask" wx:if="{{emailPanel}}" bindtap="onCloseEmailPanel"></view>
  <view class="phone-panel" wx:if="{{emailPanel}}">
    <text class="phone-title">绑定邮箱</text>
    <input class="phone-input" type="text" maxlength="128" placeholder="新邮箱" value="{{newEmail}}" bindinput="onEmailInput" />
    <view class="sms-row">
      <input class="phone-input sms-input" type="number" maxlength="6" placeholder="验证码" value="{{emailCode}}" bindinput="onEmailCodeInput" />
      <button class="btn-ghost sms-btn" size="mini" disabled="{{emailCooldown > 0}}" bindtap="onSendEmailCode">
        {{emailCooldown > 0 ? emailCooldown + 's' : '获取验证码'}}
      </button>
    </view>
    <button class="btn-primary btn-block" disabled="{{submitting}}" bindtap="onConfirmBindEmail">确认绑定</button>
    <button class="btn-ghost btn-block btn-sm" bindtap="onCloseEmailPanel">取消</button>
  </view>
</view>
