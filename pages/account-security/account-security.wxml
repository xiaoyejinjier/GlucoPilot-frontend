<wxs module="i18n" src="/utils/i18n.wxs" />
<view class="page-no-tab" style="{{displayStyle}}">
  <view class="card menu-list">
    <view class="menu-item">
      <text>{{i18n.t("登录方式", locale)}}</text>
      <text class="menu-arrow">{{i18n.t("微信 / 手机号 / 邮箱", locale)}}</text>
    </view>
    <view class="menu-item ui-interactive" bindtap="onBindPhone" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}">
      <text>{{i18n.t("绑定手机号", locale)}}</text>
      <text class="menu-arrow">{{i18n.t((phone) + " ›", locale)}}</text>
    </view>
    <view class="menu-item ui-interactive" bindtap="onBindEmail" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}">
      <text>{{i18n.t("绑定邮箱", locale)}}</text>
      <text class="menu-arrow">{{i18n.t((email) + " ›", locale)}}</text>
    </view>
  </view>

  <view class="card tip-card">
    <text class="tip-line">{{i18n.t("换绑手机号需短信验证码（开发环境见后端日志）；换绑邮箱需邮箱验证码（需配置 SMTP）。", locale)}}</text>
  </view>

  <!-- 注销入口固定在页面最下方，点击进入独立说明页 -->
  <view class="card menu-list cancel-entry">
    <view class="menu-item" bindtap="onOpenCancel">
      <text class="danger-text">注销账号</text>
      <text class="menu-arrow danger-text">{{recoverable ? '申请处理中 ›' : '›'}}</text>
    </view>
  </view>

  <view class="phone-mask" wx:if="{{panel}}" bindtap="onClosePanel"></view>
  <view class="phone-panel" wx:if="{{panel}}">
    <text class="phone-title">{{i18n.t("绑定手机号", locale)}}</text>
    <input class="phone-input" type="number" maxlength="11" placeholder="{{i18n.t('新手机号', locale)}}" value="{{newPhone}}" bindinput="onPhoneInput" />
    <view class="sms-row">
      <input class="phone-input sms-input" type="number" maxlength="6" placeholder="{{i18n.t('验证码', locale)}}" value="{{smsCode}}" bindinput="onSmsInput" />
      <button class="btn-ghost sms-btn ui-interactive" size="mini" disabled="{{smsCooldown > 0}}" bindtap="onSendSms" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}">
        {{i18n.t((smsCooldown > 0 ? smsCooldown + 's' : '获取验证码'), locale)}}
      </button>
    </view>
    <button class="btn-primary btn-block ui-interactive" disabled="{{submitting}}" bindtap="onConfirmBind" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}">{{i18n.t("确认绑定", locale)}}</button>
    <button class="btn-ghost btn-block btn-sm ui-interactive" bindtap="onClosePanel" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}">{{i18n.t("取消", locale)}}</button>
  </view>

  <view class="phone-mask" wx:if="{{emailPanel}}" bindtap="onCloseEmailPanel"></view>
  <view class="phone-panel" wx:if="{{emailPanel}}">
    <text class="phone-title">{{i18n.t("绑定邮箱", locale)}}</text>
    <input class="phone-input" type="text" maxlength="128" placeholder="{{i18n.t('新邮箱', locale)}}" value="{{newEmail}}" bindinput="onEmailInput" />
    <view class="sms-row">
      <input class="phone-input sms-input" type="number" maxlength="6" placeholder="{{i18n.t('验证码', locale)}}" value="{{emailCode}}" bindinput="onEmailCodeInput" />
      <button class="btn-ghost sms-btn ui-interactive" size="mini" disabled="{{emailCooldown > 0}}" bindtap="onSendEmailCode" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}">
        {{i18n.t((emailCooldown > 0 ? emailCooldown + 's' : '获取验证码'), locale)}}
      </button>
    </view>
    <button class="btn-primary btn-block ui-interactive" disabled="{{submitting}}" bindtap="onConfirmBindEmail" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}">{{i18n.t("确认绑定", locale)}}</button>
    <button class="btn-ghost btn-block btn-sm ui-interactive" bindtap="onCloseEmailPanel" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}">{{i18n.t("取消", locale)}}</button>
  </view>
</view>
