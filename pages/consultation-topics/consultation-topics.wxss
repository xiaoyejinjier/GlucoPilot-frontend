page { background:#f4f7fc; }
.topics-page { padding:28rpx 28rpx calc(40rpx + env(safe-area-inset-bottom)); color:#263e65; }
.topics-intro { padding:12rpx 4rpx 28rpx; }
.topics-title { display:block; font-size:36rpx; font-weight:600; margin-bottom:14rpx; }
.topics-note { display:block; color:#8190a9; font-size:24rpx; line-height:1.65; }
.topics-card { padding:28rpx; background:#fff; border:1rpx solid #e5ecf7; border-radius:26rpx; }
.topics-heading { display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:12rpx 16rpx; margin-bottom:12rpx; }
.topics-heading-actions { display:flex; align-items:center; justify-content:flex-end; gap:12rpx; flex:0 0 auto; min-width:0; max-width:100%; margin-left:auto; }
.topics-section { flex:0 0 auto; white-space:nowrap; font-size:30rpx; font-weight:600; }
/* mini避开原生按钮的整行宽度，显式尺寸防止操作区把标题挤成竖排。 */
.topics-heading-actions .topics-edit { display:inline-flex; flex:0 0 104rpx; align-items:center; justify-content:center; box-sizing:border-box; width:104rpx; min-width:104rpx; max-width:104rpx; height:56rpx; margin:0; padding:0 16rpx; background:#edf3ff; color:#3864a8; border-radius:28rpx; white-space:nowrap; line-height:1.4; font-size:24rpx; }
.topics-edit::after,.topics-reset::after { border:0; }
.topics-chips { display:flex; flex-wrap:wrap; gap:16rpx; margin-top:22rpx; }
.topics-chip { position:relative; display:flex; align-items:center; gap:12rpx; padding:12rpx 22rpx; border:1rpx solid #dbe6f6; border-radius:30rpx; color:#526f9a; font-size:25rpx; line-height:1.5; }
.topic-chip-icon { flex:none; display:block; width:40rpx; height:40rpx; border-radius:12rpx; }
.chosen { background:#e9f1ff; border-color:#9fbff0; color:#285fa9; }
.chip-remove { position:absolute; top:-10rpx; right:-10rpx; display:flex; align-items:center; justify-content:center; width:30rpx; height:30rpx; border:3rpx solid #fff; border-radius:50%; font-size:24rpx; line-height:1; color:#fff; background:#aab8cc; }
.topics-heading-actions .topics-reset { display:inline-flex; flex:0 0 auto; align-items:center; justify-content:center; box-sizing:border-box; width:auto; min-width:0; max-width:240rpx; height:56rpx; margin:0; padding:0 8rpx; background:transparent; color:#7c8da9; white-space:nowrap; font-size:23rpx; line-height:1.4; }
.topics-reset.is-hidden { visibility:hidden; pointer-events:none; }
.catalog-heading { margin:32rpx 4rpx 18rpx; justify-content:flex-start; }
.topics-total { padding:2rpx 14rpx; background:#e6edfa; color:#6b85ad; font-size:23rpx; border-radius:20rpx; }
.topics-search { display:flex; align-items:center; gap:20rpx; padding:18rpx 24rpx; background:#fff; border:1rpx solid #e0e8f5; border-radius:20rpx; margin-bottom:24rpx; }
.search-symbol { position:relative; flex:none; width:22rpx; height:22rpx; border:3rpx solid #9aabc3; border-radius:50%; }
.search-symbol::after { content:''; position:absolute; width:12rpx; height:3rpx; background:#9aabc3; right:-9rpx; bottom:-4rpx; transform:rotate(45deg); }
.topics-search-input { flex:1; min-width:0; font-size:25rpx; height:46rpx; }
.topic-group { margin-bottom:22rpx; }
.group-title { display:block; font-size:27rpx; font-weight:600; margin-bottom:24rpx; }
.topics-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:20rpx 16rpx; }
.topic-tile { position:relative; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:14rpx; min-height:148rpx; padding:16rpx 8rpx; border:1rpx solid #edf1f8; border-radius:20rpx; background:#fafcff; box-sizing:border-box; }
.topic-tile.chosen { background:#edf4ff; border-color:#abc7ef; }
.topic-icon { flex:none; display:block; width:84rpx; height:84rpx; border-radius:22rpx; }
.tile-name { font-size:24rpx; line-height:1.5; text-align:center; overflow-wrap:break-word; }
.tile-action { position:absolute; top:-10rpx; right:-8rpx; display:flex; align-items:center; justify-content:center; width:34rpx; height:34rpx; border:3rpx solid #fff; border-radius:50%; color:#fff; background:#4e79b8; font-size:26rpx; line-height:1; }
.tile-action.added { background:#aab8cc; }
.topics-state { text-align:center; padding:48rpx 20rpx; color:#8293ae; font-size:26rpx; }
