<wxs module="i18n" src="/utils/i18n.wxs" />
<view class="wallet-page" style="{{displayStyle}}">
  <view wx:if="{{loading}}" class="wallet-empty"><view class="wallet-loading"></view><text>{{i18n.t('正在加载订单…',locale)}}</text></view>
  <view wx:elif="{{error}}" class="wallet-error" bindtap="onRetry">{{i18n.t(error,locale)}} · {{i18n.t('重试',locale)}}</view>
  <block wx:elif="{{order}}">
    <view class="wallet-detail-head"><text class="wallet-chip">{{i18n.t(order.statusLabel,locale)}}</text><text class="wallet-detail-amount">¥{{order.price}}</text><text>{{i18n.t(order.title,locale)}}</text></view>
    <view wx:if="{{order.showBalanceAfter}}" class="wallet-card wallet-between"><text class="wallet-muted">{{i18n.t(order.balanceAfterLabel,locale)}}</text><text class="wallet-title">{{order.balanceAfter !== null ? '¥' + order.balanceAfter : i18n.t('未记录',locale)}}</text></view>
    <view class="wallet-card"><text class="wallet-title">{{i18n.t('订单信息',locale)}}</text><view class="wallet-info-row" bindtap="onCopy"><text>{{i18n.t('订单编号',locale)}}</text><text class="wallet-copy">{{order.orderNo}} ⧉</text></view><view class="wallet-info-row"><text>{{i18n.t('创建时间',locale)}}</text><text>{{order.time}}</text></view><view class="wallet-info-row" wx:if="{{order.paidTime}}"><text>{{i18n.t('支付时间',locale)}}</text><text>{{order.paidTime}}</text></view><view class="wallet-info-row" wx:if="{{order.closedTime}}"><text>{{i18n.t('关闭时间',locale)}}</text><text>{{order.closedTime}}</text></view><view wx:if="{{type === 'RECHARGE'}}" class="wallet-info-row"><text>{{i18n.t('入账时间',locale)}}</text><text>{{order.creditedTime || i18n.t('尚未入账',locale)}}</text></view><block wx:else><view class="wallet-info-row"><text>{{i18n.t('问诊单编号',locale)}}</text><text>{{order.reportId}}</text></view><view class="wallet-info-row"><text>{{i18n.t('出单医生编号',locale)}}</text><text>{{order.doctorUserId}}</text></view><view class="wallet-info-row"><text>{{i18n.t('费用归属',locale)}}</text><text>{{i18n.t('出具问诊单的医生',locale)}}</text></view></block></view>
    <button wx:if="{{type === 'RECHARGE' && order.status === 'PENDING'}}" class="wallet-primary" bindtap="onPay">{{i18n.t('继续沙箱付款',locale)}}</button>
    <button wx:if="{{type === 'CONSULTATION' && order.status === 'PENDING'}}" class="wallet-primary" bindtap="onPay">{{i18n.t('继续支付问诊单',locale)}}</button>
    <button wx:if="{{type === 'CONSULTATION' && order.status === 'PAID'}}" class="wallet-primary" bindtap="onReport">{{i18n.t('查看完整问诊单',locale)}}</button>
    <view class="wallet-note">{{i18n.t(type === 'RECHARGE' ? '本订单为沙箱充值，仅计入测试余额，不涉及真实资金。' : '问诊费用使用沙箱钱包余额支付，付款成功后可查看问诊单。',locale)}}</view>
  </block>
</view>
