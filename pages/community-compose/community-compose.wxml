<wxs module="i18n" src="/utils/i18n.wxs" />
<!-- Keep scrolling independent of the native page-container used for back protection. -->
<scroll-view class="compose-scroll" scroll-y="{{true}}" style="{{displayStyle}}">
<view class="page-no-tab compose-page">
  <block wx:if="{{!submitted}}"><view class="draft-box-entry ui-interactive" bindtap="onDraftBox" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}"><text>{{i18n.t((draftSaved ? '已保存草稿' : '随时保存，稍后继续'), locale)}}</text><text>{{i18n.t("草稿箱 ›", locale)}}</text></view><view class="compose-intro"><text class="intro-label">{{i18n.t("分享，让控糖多一份陪伴", locale)}}</text><text class="intro-title">{{i18n.t("写下你的真实经历", locale)}}</text><text class="intro-copy">{{i18n.t("一餐怎么搭配，一次新的尝试，或一个想交流的问题。", locale)}}</text></view>
    <view wx:if="{{loading}}" class="compose-state">{{i18n.t("正在加载文章…", locale)}}</view><view wx:elif="{{loadError}}" class="compose-state ui-interactive" bindtap="load" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}">{{i18n.t((loadError) + " · 点击重试", locale)}}</view>
    <view wx:else class="compose-form"><input class="article-title-input" value="{{title}}" maxlength="80" placeholder="{{i18n.t('给文章起个标题', locale)}}" bindinput="onTitle" disabled="{{posting}}" /><text class="word-count">{{i18n.t((title.length) + " / 80", locale)}}</text><view class="compose-divider"></view><textarea class="article-body-input" value="{{body}}" maxlength="8000" auto-height="{{true}}" cursor-spacing="{{24}}" placeholder="{{i18n.t('分享你的控糖日常，请勿包含个人联系方式、他人隐私或未经核实的用药建议。', locale)}}" bindinput="onBody" disabled="{{posting}}" /><text class="word-count">{{i18n.t((body.length) + " / 8000", locale)}}</text></view>
    <view class="compose-images"><view class="topic-heading"><text>{{i18n.t("正文配图", locale)}}</text><text class="topic-limit">{{i18n.t((images.length) + " / 6", locale)}}</text></view><text class="topic-description">{{i18n.t("图片按选择顺序展示在正文下方，点击可放大", locale)}}</text><view class="compose-image-grid"><view wx:for="{{images}}" wx:key="mediaId" class="compose-image-item"><article-photo media-id="{{item.mediaId}}" mode="aspectFill"></article-photo><view class="remove-image ui-interactive" data-id="{{item.mediaId}}" catchtap="onRemoveImage" aria-role="button" aria-label="{{i18n.t('删除配图', locale)}}" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}">×</view><text class="image-number">{{i18n.t((index + 1), locale)}}</text></view><view wx:if="{{6 > images.length}}" class="add-image ui-interactive" bindtap="onAddImage" aria-role="button" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}"><text>＋</text><text>{{i18n.t((uploading ? '上传中…' : '添加图片'), locale)}}</text></view></view><text class="image-hint">{{i18n.t("支持相册或拍照 · 每张不超过5MB", locale)}}</text></view>
    <view class="compose-videos"><view class="topic-heading"><text>{{i18n.t("添加视频", locale)}}</text><text class="topic-limit">{{i18n.t((videos.length) + " / 1", locale)}}</text></view><text class="topic-description">{{i18n.t("文字、图片或视频都可以分享；有图片或视频时正文可不填", locale)}}</text><view wx:for="{{videos}}" wx:key="mediaId"><article-video media-id="{{item.mediaId}}"></article-video><view class="remove-video ui-interactive" bindtap="onRemoveVideo" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}">{{i18n.t("移除视频", locale)}}</view></view><view wx:if="{{!videos.length}}" class="add-video ui-interactive" bindtap="onAddVideo" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}"><text>▷</text><text>{{i18n.t((uploading ? '正在上传…' : '从相册或拍摄添加视频'), locale)}}</text></view><text class="image-hint">{{i18n.t("支持 MP4 · 60秒以内 · 不超过20MB", locale)}}</text></view>
    <view class="topic-section"><view class="topic-heading"><text>{{i18n.t("给文章加上标签", locale)}}</text><text class="topic-limit">{{i18n.t("已选 " + (tagCount) + " / 3", locale)}}</text></view><text class="topic-description">{{i18n.t("点＋查看全部标签，选择或删除不想要的", locale)}}</text><text wx:if="{{tagsLoading}}" class="topic-description">{{i18n.t('正在加载标签…', locale)}}</text><view wx:elif="{{tagsError}}" class="tag-catalog-error" bindtap="loadTagOptions">{{i18n.t(tagsError, locale)}}</view><text wx:if="{{tagNotice}}" class="tag-catalog-error">{{i18n.t(tagNotice, locale)}}</text><view class="compose-tags"><view wx:for="{{selectedTags}}" wx:key="code" class="compose-tag selected custom-tag ui-interactive" data-code="{{item.code}}" bindtap="onTag" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}"># {{i18n.tag(item, locale)}} <text>×</text></view><view wx:for="{{customTags}}" wx:key="*this" class="compose-tag selected custom-tag ui-interactive" data-name="{{item}}" bindtap="onRemoveCustomTag" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}"># {{item}} <text>×</text></view><view class="compose-tag plus-tag ui-interactive" bindtap="onOpenMyTags" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}">＋</view></view></view>
    <view class="compose-visibility ui-interactive" bindtap="onVisibility" aria-role="button" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}"><view><text>{{i18n.t("谁可以看", locale)}}</text><text>{{i18n.t((visibilityLabel) + (visibility === 'FRIENDS' ? ' · 已选' + viewerIds.length + '位好友' : ''), locale)}}</text></view><text>{{i18n.t("修改 ›", locale)}}</text></view>
    <view class="review-note"><text class="review-symbol">✓</text><view><text class="review-note-title">{{i18n.t("分享之前，多一份认真", locale)}}</text><text class="review-note-copy">{{i18n.t("发布后先经 AI 初审，再由管理员终审，通过后按选择的可见范围展示。", locale)}}</text><text wx:if="{{originalState === 'PUBLISHED'}}" class="review-note-copy">{{i18n.t("修改已发布文章后，文章将暂时撤下并重新审核。", locale)}}</text></view></view>
    <view class="compose-bottom"><view class="compose-buttons"><button class="compose-save ui-interactive" bindtap="onSaveDraft" disabled="{{posting || uploading || loading || !!loadError}}" loading="{{savingDraft}}" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}">{{i18n.t("存草稿", locale)}}</button><button class="compose-submit ui-interactive" bindtap="onSubmit" disabled="{{posting || uploading || loading || !!loadError}}" loading="{{posting && !savingDraft}}" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}">{{i18n.t("发布", locale)}}</button></view><text>{{i18n.t("审核通过后按可见范围展示，草稿仅自己可见", locale)}}</text></view>
  </block>
  <view wx:else class="submitted-card"><view class="submitted-icon">✓</view><text class="submitted-title">{{i18n.t("发布申请已提交", locale)}}</text><text class="submitted-summary">{{submitted.title}}</text><view class="progress-track"><view class="done"><view class="progress-dot"></view><text>{{i18n.t("提交成功", locale)}}</text></view><view class="{{statusInfo.step >= 2 ? 'done' : 'current'}}"><view class="progress-dot"></view><text>{{i18n.t("AI 初审", locale)}}</text></view><view class="{{statusInfo.step >= 3 ? 'done' : ''}}"><view class="progress-dot"></view><text>{{i18n.t("管理员终审", locale)}}</text></view><view class="{{submitted.state === 'PUBLISHED' ? 'done' : ''}}"><view class="progress-dot"></view><text>{{i18n.t("按范围展示", locale)}}</text></view></view><text class="progress-status">{{i18n.t((statusInfo.label), locale)}}</text><text class="submitted-copy">{{i18n.t((statusInfo.hint), locale)}}</text><button class="compose-submit ui-interactive" bindtap="onMyArticles" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}">{{i18n.t("查看我的文章", locale)}}</button><button class="back-button ui-interactive" bindtap="onBackCommunity" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}">{{i18n.t("返回社区", locale)}}</button></view>
</view>
</scroll-view>

<article-visibility visible="{{visibilityOpen}}" value="{{visibility}}" viewer-ids="{{viewerIds}}" display-style="{{displayStyle}}" bind:close="onVisibilityClose" bind:confirm="onVisibilityConfirm"></article-visibility>
<page-container show="{{leaveGuardActive}}" overlay="{{false}}" duration="{{0}}" close-on-slide-down="{{false}}" custom-style="height:0;min-height:0;background:transparent;" bindbeforeleave="onGuardBeforeLeave" bindafterleave="onGuardAfterLeave"></page-container>
