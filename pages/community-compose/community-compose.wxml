<!-- Keep scrolling independent of the native page-container used for back protection. -->
<scroll-view class="compose-scroll" scroll-y="{{true}}" style="{{displayStyle}}">
<view class="page-no-tab compose-page">
  <block wx:if="{{!submitted}}"><view class="draft-box-entry" bindtap="onDraftBox"><text>{{draftSaved ? '已保存草稿' : '随时保存，稍后继续'}}</text><text>草稿箱 ›</text></view><view class="compose-intro"><text class="intro-label">分享，让控糖多一份陪伴</text><text class="intro-title">写下你的真实经历</text><text class="intro-copy">一餐怎么搭配，一次新的尝试，或一个想交流的问题。</text></view>
    <view wx:if="{{loading}}" class="compose-state">正在加载文章…</view><view wx:elif="{{loadError}}" class="compose-state" bindtap="load">{{loadError}} · 点击重试</view>
    <view wx:else class="compose-form"><input class="article-title-input" value="{{title}}" maxlength="80" placeholder="给文章起个标题" bindinput="onTitle" disabled="{{posting}}" /><text class="word-count">{{title.length}} / 80</text><view class="compose-divider"></view><textarea class="article-body-input" value="{{body}}" maxlength="8000" auto-height="{{true}}" cursor-spacing="{{24}}" placeholder="分享你的控糖日常，请勿包含个人联系方式、他人隐私或未经核实的用药建议。" bindinput="onBody" disabled="{{posting}}" /><text class="word-count">{{body.length}} / 8000</text></view>
    <view class="compose-images"><view class="topic-heading"><text>正文配图</text><text class="topic-limit">{{images.length}} / 6</text></view><text class="topic-description">图片按选择顺序展示在正文下方，点击可放大</text><view class="compose-image-grid"><view wx:for="{{images}}" wx:key="mediaId" class="compose-image-item"><article-photo media-id="{{item.mediaId}}" mode="aspectFill"></article-photo><view class="remove-image" data-id="{{item.mediaId}}" catchtap="onRemoveImage" aria-role="button" aria-label="删除配图">×</view><text class="image-number">{{index + 1}}</text></view><view wx:if="{{6 > images.length}}" class="add-image" bindtap="onAddImage" aria-role="button"><text>＋</text><text>{{uploading ? '上传中…' : '添加图片'}}</text></view></view><text class="image-hint">支持相册或拍照 · 每张不超过5MB</text></view>
    <view class="compose-videos"><view class="topic-heading"><text>添加视频</text><text class="topic-limit">{{videos.length}} / 1</text></view><text class="topic-description">文字、图片或视频都可以分享；有图片或视频时正文可不填</text><view wx:for="{{videos}}" wx:key="mediaId"><article-video media-id="{{item.mediaId}}"></article-video><view class="remove-video" bindtap="onRemoveVideo">移除视频</view></view><view wx:if="{{!videos.length}}" class="add-video" bindtap="onAddVideo"><text>▷</text><text>{{uploading ? '正在上传…' : '从相册或拍摄添加视频'}}</text></view><text class="image-hint">支持 MP4 · 60秒以内 · 不超过20MB</text></view>
    <view class="topic-section"><view class="topic-heading"><text>给文章加上标签</text><text class="topic-limit">已选 {{tagCount}} / 3</text></view><text class="topic-description">选择分类，也可以写下自己的标签</text><view class="compose-tags"><view wx:for="{{tags}}" wx:key="code" class="compose-tag {{item.selected ? 'selected' : ''}}" data-code="{{item.code}}" bindtap="onTag">{{item.selected ? '✓' : '#'}} {{item.name}}</view><view wx:for="{{customTags}}" wx:key="*this" class="compose-tag selected custom-tag" data-name="{{item}}" bindtap="onRemoveCustomTag"># {{item}} <text>×</text></view></view><view wx:if="{{recentTags.length}}" class="recent-tags"><text class="topic-description">常用标签 · 点选即可添加</text><view class="compose-tags"><view wx:for="{{recentTags}}" wx:key="*this" class="compose-tag" data-name="{{item}}" bindtap="onRecentTag"># {{item}}</view></view></view><view class="custom-tag-entry"><input value="{{customTagInput}}" maxlength="32" placeholder="自定义标签，最多16字" bindinput="onCustomTagInput" bindconfirm="onAddCustomTag" confirm-type="done" disabled="{{posting}}" /><button bindtap="onAddCustomTag" disabled="{{posting || !customTagInput}}">添加</button></view></view>
    <view class="review-note"><text class="review-symbol">✓</text><view><text class="review-note-title">分享之前，多一份认真</text><text class="review-note-copy">发布后先经 AI 初审，再由管理员终审，通过后在社区公开展示。</text><text wx:if="{{originalState === 'PUBLISHED'}}" class="review-note-copy">修改已发布文章后，文章将暂时撤下并重新审核。</text></view></view>
    <view class="compose-bottom"><view class="compose-buttons"><button class="compose-save" bindtap="onSaveDraft" disabled="{{posting || uploading || loading || !!loadError}}" loading="{{savingDraft}}">存草稿</button><button class="compose-submit" bindtap="onSubmit" disabled="{{posting || uploading || loading || !!loadError}}" loading="{{posting && !savingDraft}}">发布</button></view><text>审核通过后公开展示，草稿仅自己可见</text></view>
  </block>
  <view wx:else class="submitted-card"><view class="submitted-icon">✓</view><text class="submitted-title">发布申请已提交</text><text class="submitted-summary">{{submitted.title}}</text><view class="progress-track"><view class="done"><view class="progress-dot"></view><text>提交成功</text></view><view class="{{statusInfo.step >= 2 ? 'done' : 'current'}}"><view class="progress-dot"></view><text>AI 初审</text></view><view class="{{statusInfo.step >= 3 ? 'done' : ''}}"><view class="progress-dot"></view><text>管理员终审</text></view><view class="{{submitted.state === 'PUBLISHED' ? 'done' : ''}}"><view class="progress-dot"></view><text>公开展示</text></view></view><text class="progress-status">{{statusInfo.label}}</text><text class="submitted-copy">{{statusInfo.hint}}</text><button class="compose-submit" bindtap="onMyArticles">查看我的文章</button><button class="back-button" bindtap="onBackCommunity">返回社区</button></view>
</view>
</scroll-view>

<page-container show="{{leaveGuardActive}}" overlay="{{false}}" duration="{{0}}" close-on-slide-down="{{false}}" custom-style="height:0;min-height:0;background:transparent;" bindbeforeleave="onGuardBeforeLeave" bindafterleave="onGuardAfterLeave"></page-container>
