.compose-page{padding:24rpx 26rpx 30rpx;background:var(--bg);min-height:100vh}.compose-intro{padding:12rpx 6rpx 30rpx}.intro-label{font-size:var(--fs-small);color:var(--muted);display:block}.intro-title{display:block;font-weight:800;font-size:42rpx;color:var(--ink);margin:14rpx 0}.intro-copy{font-size:var(--fs-small);line-height:1.8;color:var(--muted);display:block}.compose-form{background:#fff;padding:30rpx;border-radius:26rpx}.article-title-input{font-size:var(--fs-title);font-weight:600;height:80rpx;color:var(--ink);width:100%}.word-count{font-size:20rpx;color:var(--hint);display:block;text-align:right}.compose-divider{height:1rpx;background:var(--line);margin:22rpx 0}.article-body-input{width:100%;min-height:410rpx;font-size:var(--fs-body);line-height:1.85;color:var(--muted)}.topic-section{background:#fff;border-radius:26rpx;padding:28rpx 30rpx;margin-top:20rpx}.topic-heading{display:flex;align-items:center;justify-content:space-between;font-size:var(--fs-body);font-weight:600;color:var(--ink-soft);gap:16rpx}.topic-limit{font-size:var(--fs-small);color:var(--muted);font-weight:400}.topic-description{display:block;font-size:var(--fs-small);color:var(--hint);margin:12rpx 0 24rpx}.compose-tags{display:flex;flex-wrap:wrap;gap:16rpx}.compose-tag{padding:14rpx 22rpx;background:var(--surface-subtle);color:var(--muted);border-radius:26rpx;font-size:var(--fs-small);border:1rpx solid transparent}.compose-tag.selected{background:var(--brand-soft);color:var(--brand);border-color:var(--brand-line)}.review-note{display:flex;gap:18rpx;margin:30rpx 10rpx}.review-symbol{display:flex;align-items:center;justify-content:center;background:var(--brand-soft);color:var(--brand);width:40rpx;height:40rpx;border-radius:50%;flex-shrink:0}.review-note-title{display:block;font-size:var(--fs-small);color:var(--muted);font-weight:600}.review-note-copy{display:block;font-size:20rpx;color:var(--muted);line-height:1.9;margin-top:8rpx}.compose-bottom{padding:0 0 calc(28rpx + env(safe-area-inset-bottom))}.compose-submit{background:var(--brand);color:#fff;border-radius:22rpx;font-size:var(--fs-body);line-height:2.9;border:0;font-weight:600}.compose-submit[disabled]{background:var(--brand-line);color:var(--surface-subtle)}.compose-bottom>text{display:block;text-align:center;color:var(--hint);font-size:20rpx;margin-top:18rpx}.compose-submit::after,.back-button::after{border:0}.compose-state{text-align:center;padding:40rpx;color:var(--muted);font-size:var(--fs-small)}.submitted-card{background:white;border-radius:30rpx;padding:52rpx 30rpx;margin-top:35rpx;text-align:center}.submitted-icon{width:110rpx;height:110rpx;margin:0 auto 28rpx;border-radius:50%;background:var(--brand-soft);display:flex;align-items:center;justify-content:center;color:var(--brand);font-size:54rpx}.submitted-title{display:block;font-size:42rpx;font-weight:700;color:var(--ink-soft)}.submitted-summary{display:block;font-size:var(--fs-body);margin:20rpx 0 40rpx;color:var(--muted)}.progress-track{display:flex;margin:30rpx 0 36rpx;gap:6rpx}.progress-track>view{flex:1;position:relative;color:var(--hint);font-size:18rpx}.progress-track .progress-dot{display:block;width:14rpx;height:14rpx;background:var(--line);border-radius:50%;margin:0 auto 16rpx}.progress-track .done .progress-dot{background:var(--brand)}.progress-track .done{color:var(--brand)}.progress-track .current{color:var(--brand)}.progress-track .current .progress-dot{background:var(--brand-line)}.progress-status{display:block;color:var(--brand);font-size:var(--fs-body);font-weight:600}.submitted-copy{display:block;color:var(--hint);line-height:1.8;font-size:var(--fs-small);margin:16rpx 0 44rpx}.back-button{color:var(--muted);background:transparent;font-size:var(--fs-body);margin-top:18rpx}
.custom-tag-entry{display:flex;align-items:center;gap:18rpx;margin-top:24rpx;padding:12rpx 14rpx 12rpx 24rpx;border:1rpx solid var(--brand-line);border-radius:20rpx;background:#fafcfb}.custom-tag-entry input{flex:1;min-width:0;font-size:24rpx;height:64rpx;color:var(--ink-soft)}.custom-tag-entry button{margin:0;padding:0 24rpx;line-height:2.4;font-size:24rpx;background:var(--brand-soft);color:var(--brand);border-radius:14rpx}.custom-tag-entry button::after{border:0}.custom-tag-entry button[disabled]{background:var(--surface-subtle);color:var(--hint)}.custom-tag text{margin-left:10rpx;color:var(--muted)}

.compose-images { margin:28rpx 0; padding:30rpx; background:var(--surface); border:1rpx solid var(--line); border-radius:28rpx; }
.compose-image-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:18rpx; margin-top:24rpx; }
.compose-image-item,.add-image { position:relative; height:176rpx; border-radius:20rpx; overflow:hidden; }
.compose-image-item article-photo { height:100%; }
.remove-image { position:absolute; top:0; right:0; width:48rpx; height:48rpx; background:rgba(32,43,56,.72); color:#fff; text-align:center; line-height:44rpx; border-radius:0 0 0 18rpx; font-size:36rpx; }
.image-number { position:absolute; left:10rpx; bottom:10rpx; border-radius:10rpx; padding:2rpx 10rpx; background:rgba(32,43,56,.6); color:white; font-size:20rpx; }
.add-image { display:flex; flex-direction:column; align-items:center; justify-content:center; gap:8rpx; background:var(--brand-soft); color:var(--brand); border:2rpx dashed var(--brand-line); box-sizing:border-box; font-size:24rpx; }
.add-image text:first-child { font-size:48rpx; line-height:1; }.image-hint { display:block; margin-top:18rpx; color:var(--muted); font-size:22rpx; }

.draft-box-entry{display:flex;align-items:center;justify-content:space-between;gap:20rpx;padding:8rpx 6rpx 24rpx;color:var(--muted);font-size:var(--fs-small)}.draft-box-entry text:last-child{color:var(--brand);font-weight:600}.compose-buttons{display:flex;width:100%;gap:20rpx}.compose-buttons button{margin:0;min-width:0;flex:1}.compose-buttons .compose-submit{flex:1.6}.compose-save{border:2rpx solid var(--brand-line);background:#fff;color:var(--brand);border-radius:28rpx;font-size:var(--fs-body);font-weight:600}.compose-save::after{border:0}

.compose-videos{padding:32rpx;margin-bottom:24rpx;border-radius:28rpx;background:var(--surface)}.add-video{margin:22rpx 0;padding:30rpx;border:2rpx dashed var(--line);border-radius:24rpx;display:flex;align-items:center;gap:20rpx;color:var(--brand-dark);font-size:var(--fs-body)}.add-video>text:first-child{font-size:48rpx}.remove-video{padding:16rpx;text-align:right;color:var(--muted);font-size:var(--fs-small)}.recent-tags{margin-top:18rpx}

.compose-buttons button{height:104rpx;line-height:normal;display:flex;align-items:center;justify-content:center;padding:0 24rpx;box-sizing:border-box;text-align:center}.compose-save{border-radius:22rpx}
.compose-scroll{height:100vh;background:var(--bg)}

.compose-visibility{display:flex;align-items:center;justify-content:space-between;gap:20rpx;padding:26rpx 4rpx;border-top:1rpx solid var(--line);border-bottom:1rpx solid var(--line);margin-top:24rpx;color:var(--ink);font-size:var(--fs-body)}.compose-visibility>view{display:flex;flex-direction:column;gap:10rpx}.compose-visibility>view>text:last-child{color:var(--brand-dark);font-size:var(--fs-small)}.compose-visibility>text{flex:none;color:var(--muted);font-size:var(--fs-small)}

.plus-tag{min-width:72rpx;justify-content:center;text-align:center;font-size:36rpx;line-height:1;font-weight:600;color:var(--brand);background:var(--brand-soft);border:1rpx dashed var(--brand-line)}.picked-tags{display:flex;flex-wrap:wrap;gap:16rpx;margin-top:20rpx;padding-top:20rpx;border-top:1rpx solid var(--line)}.tag-catalog-error{display:block;color:#ad7241;font-size:var(--fs-small);padding:14rpx 0}.custom-tag text{margin-left:10rpx;color:var(--muted)}
