<wxs module="i18n" src="/utils/i18n.wxs" />
<view class="page-no-tab" style="{{displayStyle}}">
  <view class="page-intro">
    <text class="page-intro-text">{{i18n.t("您的每一条建议都会被认真查看，处理进度将在本页更新", locale)}}</text>
  </view>

  <view class="card">
    <view class="section-title">{{i18n.t("反馈类型", locale)}}</view>
    <view class="type-row">
      <view
        wx:for="{{types}}"
        wx:key="*this"
        class="type-item {{activeTypeIndex === index ? 'on' : ''}} ui-interactive"
        data-index="{{index}}"
        bindtap="onTypeTap"
       hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}">{{i18n.t((item), locale)}}</view>
    </view>
  </view>

  <view class="card">
    <view class="section-title">{{i18n.t("留言内容", locale)}}</view>
    <view class="textarea-box">
      <textarea
        class="feedback-textarea"
        placeholder="{{i18n.t('请尽量描述清楚遇到的问题或您的建议', locale)}}"
        value="{{content}}"
        bindinput="onInput"
        maxlength="500"
      />
      <view class="textarea-footer">
        <text class="char-count">{{i18n.t((content.length) + "/500", locale)}}</text>
      </view>
    </view>
    <view class="submit-actions">
      <button
        class="clear-button ui-interactive"
        disabled="{{!content.length || submitting}}"
        bindtap="onClear"
       hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}"><text class="action-button-text">{{i18n.t("清空内容", locale)}}</text></button>
      <button
        class="submit-button ui-interactive"
        disabled="{{submitting}}"
        bindtap="onSubmit"
       hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}"><text class="action-button-text">{{i18n.t((submitting ? '提交中…' : '提交反馈'), locale)}}</text></button>
    </view>
    <text class="submit-hint">{{i18n.t("提交成功后，新反馈会立即显示在下方。", locale)}}</text>
  </view>

  <view class="history-header">
    <view class="history-title-wrap">
      <text class="history-title">{{i18n.t("我的反馈", locale)}}</text>
      <text wx:if="{{total > 0}}" class="history-count">{{i18n.t((total), locale)}}</text>
    </view>
    <view class="refresh-action {{loading ? 'disabled' : ''}} ui-interactive" bindtap="onRefreshTap" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}">
      <text class="refresh-icon">↻</text>
      <text>{{i18n.t((loading && list.length ? '更新中' : '刷新'), locale)}}</text>
    </view>
  </view>

  <view wx:if="{{!loading && loadFailed && list.length === 0}}" class="card state-card">
    <text class="state-title">{{i18n.t("暂时无法加载反馈", locale)}}</text>
    <text class="state-desc">{{i18n.t("请检查网络后点击刷新", locale)}}</text>
    <button class="retry-button ui-interactive" bindtap="onRefreshTap" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}">{{i18n.t("重新加载", locale)}}</button>
  </view>

  <view wx:elif="{{!loading && !loadFailed && list.length === 0}}" class="card state-card">
    <view class="empty-icon">✦</view>
    <text class="state-title">{{i18n.t("还没有反馈记录", locale)}}</text>
    <text class="state-desc">{{i18n.t("提交第一条留言后，会立即显示在这里", locale)}}</text>
  </view>

  <view wx:if="{{list.length > 0}}" class="feedback-timeline">
    <view wx:for="{{list}}" wx:key="id" class="timeline-item">
      <view class="timeline-rail">
        <view class="timeline-dot {{index === 0 ? 'latest' : ''}}"></view>
        <view wx:if="{{index < list.length - 1}}" class="timeline-line"></view>
      </view>

      <view class="feedback-card">
        <view class="feedback-head">
          <view class="feedback-tags">
            <text class="type-tag">{{i18n.t((item.type), locale)}}</text>
            <text wx:if="{{index === 0}}" class="latest-tag">{{i18n.t("最新", locale)}}</text>
          </view>
          <text class="status-tag status-{{item.statusCode}}">{{i18n.t((item.status), locale)}}</text>
        </view>
        <text class="feedback-time">{{i18n.t((item.time), locale)}}</text>
        <text class="feedback-content">{{item.content}}</text>

        <view wx:if="{{item.officialReply}}" class="official-reply">
          <view class="official-head">
            <text class="official-badge">{{i18n.t("官方回复", locale)}}</text>
            <text wx:if="{{item.replyTime}}" class="official-time">{{i18n.t((item.replyTime), locale)}}</text>
          </view>
          <text class="official-text">{{i18n.t((item.officialReply), locale)}}</text>
        </view>
        <view wx:else class="pending-reply">
          <text class="pending-dot"></text>
          <text>{{i18n.t((item.statusHint), locale)}}</text>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{loading}}" class="list-footer">{{i18n.t("正在加载反馈…", locale)}}</view>
  <view wx:elif="{{list.length > 0 && hasMore}}" class="list-footer list-footer-action ui-interactive" bindtap="onReachBottom" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}">{{i18n.t("继续加载", locale)}}</view>
  <view wx:elif="{{list.length > 0}}" class="list-footer">{{i18n.t("已展示全部反馈", locale)}}</view>

  <view class="privacy-tip">
    <text>{{i18n.t("请勿在留言中填写密码、验证码等敏感信息。", locale)}}</text>
  </view>
</view>
