.voice-page {
  --voice-brand: #0969da;
  --voice-brand-dark: #0550ae;
  --voice-brand-soft: #ddf4ff;
  --voice-brand-line: rgba(84,174,255,.4);
  --voice-bg: #f6f8fa;
  --voice-subtle: #ffffff;
  --voice-ink: #1f2328;
  --voice-ink-soft: #59636e;
  --voice-muted: #59636e;
  --voice-hint: #818b98;
  --voice-line: #d1d9e0;
  --voice-chat-bubble: #ddf4ff;
  --voice-pulse: rgba(9,105,218,.12);
  display: flex;
  flex-direction: column;
  /* 页面高度由可见窗口与键盘共同决定，必须覆盖 .page-no-tab 的最小高度。 */
  min-height: 0;
  height: 100vh;
  overflow: hidden;
  color: var(--voice-ink);
  background: var(--voice-bg);
}

.wx-body {
  flex: 1;
  height: 0;
  min-height: 0;
  overflow: hidden;
  box-sizing: border-box;
}
.wx-messages { padding:0 0 24rpx; }
.voice-page.keyboard-open { padding-bottom:0; }
.keyboard-open .wx-foot { padding-top:16rpx; padding-bottom:16rpx; }

.welcome-stage { padding:24rpx 24rpx 32rpx; }
.welcome-hero {
  position:relative;
  margin-top:100rpx;
  padding:100rpx 28rpx 38rpx;
  border:1rpx solid var(--voice-line);
  border-radius:42rpx;
  background:#fff;
  box-shadow:0 3rpx 10rpx rgba(31,35,40,.04);
  text-align:center;
}
.welcome-mascot { position:absolute; top:-96rpx; left:50%; width:180rpx; height:166rpx; transform:translateX(-50%); }
.welcome-title { display:block; color:var(--voice-ink); font-size:var(--fs-title); font-weight:700; line-height:1.4; }
.welcome-description { display:block; margin-top:18rpx; color:var(--voice-muted); font-size:var(--fs-body); line-height:1.8; }
.welcome-description text { display:block; }
.welcome-suggestions { margin-top:28rpx; padding:30rpx 24rpx 28rpx; border:1rpx solid var(--voice-line); border-radius:40rpx; background:#fff; box-shadow:0 3rpx 10rpx rgba(31,35,40,.04); }
.suggestions-title { display:block; margin:0 8rpx 22rpx; color:var(--voice-ink); font-size:var(--fs-title); font-weight:700; line-height:1.4; }
.suggestion-item { display:flex; align-items:center; gap:16rpx; min-height:80rpx; margin-top:16rpx; padding:18rpx 20rpx; border:1rpx solid var(--voice-line); border-radius:30rpx; background:var(--voice-bg); }
.suggestion-icon { flex:none; width:38rpx; height:38rpx; border-radius:50%; background:var(--voice-brand-soft); color:var(--voice-brand); font-size:24rpx; font-weight:600; line-height:38rpx; text-align:center; }
.suggestion-text { min-width:0; color:var(--voice-ink-soft); font-size:var(--fs-body); line-height:1.5; word-break:normal; overflow-wrap:break-word; }
.suggestion-pressed { background:var(--voice-brand-soft); }

.wx-time {
  display: block;
  text-align: center;
  font-size: var(--fs-tiny);
  color: var(--voice-muted);
  margin: 12rpx 0 20rpx;
}

.wx-row {
  display: flex;
  gap: 12rpx;
  margin: 0 20rpx 20rpx;
  align-items: flex-start;
}

.wx-row.user {
  flex-direction: row-reverse;
}

.wx-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  background: var(--voice-brand);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-tiny);
  font-weight: 700;
  flex-shrink: 0;
}

.wx-row.user .wx-avatar {
  background: var(--voice-brand);
}

.assistant-avatar { background:var(--voice-brand-soft); border:1rpx solid var(--voice-brand-line); border-radius:20rpx; }

.wx-bubble {
  max-width: 72%;
  padding: 16rpx 20rpx;
  border: 1rpx solid var(--voice-line);
  border-radius: 8rpx 24rpx 24rpx 24rpx;
  font-size: var(--fs-body);
  line-height: 1.5;
  background: #fff;
  box-shadow: 0 2rpx 6rpx rgba(31,35,40,.03);
}

.wx-row.user .wx-bubble {
  background: var(--voice-chat-bubble);
  border-color: var(--voice-brand-line);
  border-radius: 24rpx 8rpx 24rpx 24rpx;
}

.wx-msg-img {
  width: 320rpx;
  max-width: 100%;
  border-radius: 12rpx;
  display: block;
}

.wx-foot {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 22rpx 24rpx 28rpx;
  flex-shrink: 0;
  background: var(--voice-bg);
}

.composer-row { display:flex; align-items:center; gap:18rpx; }
.composer-pill {
  display:flex;
  flex:1;
  align-items:center;
  gap:12rpx;
  min-width:0;
  min-height:104rpx;
  padding:12rpx 14rpx;
  border:2rpx solid var(--voice-line);
  border-radius:999rpx;
  background:#fff;
  box-shadow:0 4rpx 16rpx rgba(31,35,40,.06);
}
.composer-mode { display:flex; flex:none; align-items:center; justify-content:center; width:56rpx; height:64rpx; color:var(--voice-ink-soft); }
.voice-symbol { position:relative; width:48rpx; height:48rpx; border:3rpx solid currentColor; border-radius:50%; }
.sound-dot { position:absolute; left:10rpx; top:19rpx; width:6rpx; height:6rpx; border-radius:50%; background:currentColor; }
.sound-wave { position:absolute; top:50%; border-right:3rpx solid currentColor; border-radius:50%; transform:translateY(-50%); }
.wave-inner { left:12rpx; width:12rpx; height:18rpx; }
.wave-outer { left:15rpx; width:17rpx; height:28rpx; }

.wx-input {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  padding: 0;
  color: var(--voice-ink);
  font-size: var(--fs-body);
}
.composer-placeholder { color:var(--voice-hint); }

.composer-send {
  display:flex;
  flex:none;
  align-items:center;
  justify-content:center;
  width:64rpx;
  height:64rpx;
  border-radius:50%;
  background:var(--voice-brand);
  box-shadow:0 3rpx 8rpx rgba(9,105,218,.15);
}
.send-symbol { position:relative; width:0; height:0; margin-left:5rpx; border-top:13rpx solid transparent; border-bottom:13rpx solid transparent; border-left:32rpx solid #fff; transform:rotate(-45deg); }
.send-symbol::after { content:''; position:absolute; left:-32rpx; top:-3rpx; width:0; height:0; border-top:3rpx solid transparent; border-bottom:3rpx solid transparent; border-left:20rpx solid var(--voice-brand); }
.send-spinner { width:28rpx; height:28rpx; border:3rpx solid rgba(255,255,255,.45); border-top-color:#fff; border-radius:50%; animation:composer-spin .8s linear infinite; }

.composer-add { display:flex; flex:none; align-items:center; justify-content:center; width:64rpx; height:64rpx; border:2rpx solid var(--voice-line); border-radius:50%; background:#fff; }
.add-symbol { position:relative; width:30rpx; height:30rpx; }
.add-symbol::before, .add-symbol::after { content:''; position:absolute; border-radius:3rpx; background:var(--voice-ink-soft); }
.add-symbol::before { left:0; right:0; top:13rpx; height:4rpx; }
.add-symbol::after { top:0; bottom:0; left:13rpx; width:4rpx; }
.composer-pressed { opacity:.65; }
.keyboard-symbol { position:relative; width:44rpx; height:32rpx; border:3rpx solid currentColor; border-radius:6rpx; }
.keyboard-symbol::before { content:''; position:absolute; left:5rpx; right:5rpx; top:5rpx; height:9rpx; background:repeating-linear-gradient(90deg,currentColor 0,currentColor 4rpx,transparent 4rpx,transparent 9rpx); }
.keyboard-symbol::after { content:''; position:absolute; left:8rpx; right:8rpx; bottom:5rpx; height:3rpx; border-radius:2rpx; background:currentColor; }
.composer-hold { flex:1; min-width:0; min-height:76rpx; display:flex; align-items:center; justify-content:center; border-radius:42rpx; color:var(--voice-brand-dark); background:var(--voice-brand-soft); font-size:var(--fs-body); font-weight:500; user-select:none; }
.composer-hold.is-holding { background:var(--voice-brand-line); color:var(--voice-brand-dark); }
.is-sending { opacity:.6; }
.composer-notice { display:block; color:var(--voice-muted); font-size:var(--fs-tiny); line-height:1.5; text-align:center; }
@keyframes composer-spin { to { transform:rotate(360deg); } }

/* 流式进行中：还没有内容时显示占位 */
.wx-typing {
  color: var(--voice-muted);
}

/* 失败后的重试入口 */
.wx-retry {
  margin-top: 12rpx;
  font-size: var(--fs-small);
  color: var(--voice-brand);
  text-decoration: underline;
}
.history-status {
  text-align: center;
  color: var(--voice-muted);
  font-size: 24rpx;
  padding: 12rpx 24rpx;
}
.history-action { color: var(--voice-brand); padding: 16rpx; display: inline-block; }

/* 已结束/已归档会话的输入区替代提示 */
.wx-locked {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 20rpx;
  background: #fdecea;
  border-top: 1rpx solid var(--voice-line);
  flex-shrink: 0;
}

.wx-locked-text {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-small);
  color: var(--danger);
  line-height: 1.4;
}

.wx-input[disabled] {
  color: var(--voice-muted);
  background: var(--surface);
}
