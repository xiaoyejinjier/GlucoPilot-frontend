.voice-page {
  display: flex;
  flex-direction: column;
  /*
   * 关键：必须给"确定高度"，不能让 .page 的 min-height:100vh 兜底。
   * 原因：.wx-body 用的是 flex:1 + height:0（标准聊天布局），它要求父容器高度确定；
   * 若父容器只有 min-height，高度会由内容决定 → scroll-view 被撑到等于自身内容高度
   * → 内部无可滚动空间，同时它又会吃掉落在它身上的滑动手势 → 表现为「内容超出屏幕却滑不动」。
   * box-sizing 由 .page 提供（border-box），因此这里 100vh 已包含底部 TabBar 的留白。
   */
  height: 100vh;
  overflow: hidden;
  background: var(--bg);
}

.wx-body {
  flex: 1;
  height: 0;
  padding: 16rpx 20rpx;
  box-sizing: border-box;
}

.wx-time {
  display: block;
  text-align: center;
  font-size: var(--fs-tiny);
  color: var(--muted);
  margin: 12rpx 0 20rpx;
}

.wx-row {
  display: flex;
  gap: 12rpx;
  margin-bottom: 20rpx;
  align-items: flex-start;
}

.wx-row.user {
  flex-direction: row-reverse;
}

.wx-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 12rpx;
  background: var(--brand);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-tiny);
  font-weight: 700;
  flex-shrink: 0;
}

.wx-row.user .wx-avatar {
  background: #576b95;
}

.wx-bubble {
  max-width: 72%;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  font-size: var(--fs-body);
  line-height: 1.5;
  background: var(--surface);
  box-shadow: 0 2rpx 8rpx rgba(28, 28, 28, 0.04);
}

.wx-row.user .wx-bubble {
  background: var(--wx-green);
}

.wx-msg-img {
  width: 320rpx;
  max-width: 100%;
  border-radius: 12rpx;
  display: block;
}

.wx-foot {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 16rpx calc(12rpx + env(safe-area-inset-bottom));
  background: var(--surface);
  border-top: 1rpx solid var(--line);
  flex-shrink: 0;
}

.wx-input {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  border-radius: 12rpx;
  border: 1rpx solid var(--line);
  background: var(--bg);
  padding: 0 16rpx;
  font-size: var(--fs-body);
}

.wx-btn {
  min-height: 72rpx;
  min-width: 72rpx;
  padding: 0 20rpx;
  border-radius: 12rpx;
  font-size: var(--fs-small);
  font-weight: 700;
  border: 1rpx solid var(--line);
  background: var(--bg);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.wx-btn.send {
  background: var(--brand);
  color: #fff;
  border: none;
}

.wx-hold {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  border-radius: 12rpx;
  background: var(--bg);
  border: 1rpx solid var(--line);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-body);
  font-weight: 700;
  color: var(--ink);
}

.wx-hold.on {
  background: var(--brand);
  color: #fff;
  border-color: var(--brand);
}

/* 流式进行中：还没有内容时显示占位 */
.wx-typing {
  color: var(--muted);
}

/* 失败后的重试入口 */
.wx-retry {
  margin-top: 12rpx;
  font-size: var(--fs-small);
  color: var(--brand);
  text-decoration: underline;
}

/* 回复中或会话不可发送时禁用按钮，避免重复提交 */
.wx-btn.disabled {
  opacity: 0.55;
}

.wx-btn.send.disabled {
  opacity: 0.55;
}

/* 会话操作条：标题 + 状态标记 + 「历史对话 / 新对话」 */
.wx-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 20rpx;
  background: var(--surface);
  border-bottom: 1rpx solid var(--line);
  flex-shrink: 0;
}

.wx-head-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
}

.wx-head-title {
  font-size: var(--fs-body);
  font-weight: 700;
  color: var(--ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  min-width: 0;
}

.wx-head-status {
  flex-shrink: 0;
  padding: 4rpx 12rpx;
  border-radius: 10rpx;
  font-size: var(--fs-tiny);
  font-weight: 700;
  background: var(--brand-soft);
  color: var(--brand-dark);
}

/* 已结束/已归档：状态标记与提示条同色，一眼能对上 */
.wx-head-status.locked {
  background: #fdecea;
  color: var(--danger);
}

.wx-head-actions {
  display: flex;
  flex-direction: row;
  gap: 12rpx;
  flex-shrink: 0;
}

.wx-head-btn {
  min-height: 60rpx;
  padding: 0 20rpx;
  border-radius: 12rpx;
  font-size: var(--fs-small);
  font-weight: 700;
  color: var(--ink);
  background: var(--bg);
  border: 1rpx solid var(--line);
  display: flex;
  align-items: center;
  justify-content: center;
}

.wx-head-btn.primary {
  background: var(--brand);
  color: #fff;
  border: none;
}

/* 会话内历史的"查看更早"，同时也是加载中的占位 */
.wx-more {
  margin: 4rpx auto 16rpx;
  padding: 12rpx 24rpx;
  width: fit-content;
  border-radius: 24rpx;
  font-size: var(--fs-small);
  color: var(--muted);
  background: var(--surface);
  border: 1rpx solid var(--line);
}

/* 已结束/已归档会话的输入区替代提示 */
.wx-locked {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 20rpx;
  background: #fdecea;
  border-top: 1rpx solid var(--line);
  flex-shrink: 0;
}

.wx-locked-text {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-small);
  color: var(--danger);
  line-height: 1.4;
}

.wx-locked-btn {
  flex-shrink: 0;
  min-height: 60rpx;
  padding: 0 20rpx;
  border-radius: 12rpx;
  background: var(--danger);
  color: #fff;
  font-size: var(--fs-small);
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.wx-input[disabled] {
  color: var(--muted);
  background: var(--surface);
}
