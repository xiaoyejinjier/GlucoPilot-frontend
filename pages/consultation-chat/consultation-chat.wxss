page { height:100%; overflow:hidden; background:#f3f7fc; }
.consult-chat-page { position:fixed; top:0; left:0; right:0; bottom:0; display:flex; flex-direction:column; box-sizing:border-box; padding-bottom:calc(120rpx + env(safe-area-inset-bottom)); overflow:hidden; background:#f3f7fc; color:#203b64; }
.consult-chat-context { flex:none; display:flex; align-items:center; gap:20rpx; padding:22rpx 28rpx; background:#fff; border-bottom:1rpx solid #e0e8f2; }
.consult-chat-context-copy { flex:1; min-width:0; }
.consult-chat-title { display:block; overflow:hidden; white-space:nowrap; text-overflow:ellipsis; font-size:var(--fs-body,28rpx); font-weight:600; }
.consult-chat-note { display:block; margin-top:8rpx; font-size:var(--fs-tiny,20rpx); color:#899ab0; }
.consult-chat-details { flex:none; font-size:var(--fs-small,22rpx); color:#426da8; }
.consult-chat-scroll-shell { position:relative; flex:1; min-height:0; height:0; width:100%; overflow:hidden; }
.consult-chat-list { height:100%; width:100%; }
.consult-chat-state { text-align:center; padding:28rpx; color:#8a9ab0; font-size:var(--fs-small,22rpx); }
.consult-chat-message { padding:16rpx 26rpx; }
.consult-chat-time { display:block; text-align:center; color:#99a6b8; font-size:var(--fs-tiny,20rpx); margin-bottom:18rpx; }
.consult-chat-message-row { display:flex; align-items:flex-start; gap:16rpx; }
.mine .consult-chat-message-row { flex-direction:row-reverse; }
.consult-chat-avatar { flex:none; width:66rpx; height:66rpx; display:flex; justify-content:center; align-items:center; border-radius:20rpx; background:#e3edfb; color:#446b9c; font-size:var(--fs-small,22rpx); }
.mine .consult-chat-avatar { background:#315b95; color:#fff; }
.consult-chat-bubble { max-width:calc(100% - 100rpx); padding:20rpx 24rpx; border-radius:6rpx 22rpx 22rpx; background:#fff; color:#345174; white-space:pre-wrap; overflow-wrap:anywhere; font-size:var(--fs-body,28rpx); line-height:1.7; }
.mine .consult-chat-bubble { background:#dfeafb; border-radius:22rpx 6rpx 22rpx 22rpx; color:#244979; }
.consult-chat-new { align-self:center; padding:12rpx 24rpx; margin:8rpx; background:#fff; border:1rpx solid #d5e2f5; border-radius:28rpx; color:#426da8; font-size:var(--fs-small,22rpx); }
.consult-chat-error { flex:none; padding:14rpx 24rpx; background:#fff2e8; color:#a06040; font-size:var(--fs-small,22rpx); }
.consult-chat-composer { position:absolute; left:0; right:0; bottom:0; z-index:20; box-sizing:border-box; padding-bottom:env(safe-area-inset-bottom); background:#fff; border-top:1rpx solid #e0e8f2; }
.consult-chat-composer.keyboard-open { padding-bottom:0; }
.consult-chat-input-row { display:flex; align-items:center; gap:14rpx; padding:20rpx 18rpx; }
.consult-chat-input { flex:1; width:0; min-width:0; height:80rpx; padding:0 20rpx; box-sizing:border-box; border:0; border-radius:20rpx; background:#f1f5fb; color:#304b70; font-size:var(--fs-body,28rpx); }
.consult-chat-input-row .consult-chat-send { flex:0 0 112rpx; width:112rpx !important; min-width:112rpx; max-width:112rpx; margin:0 !important; padding:0; height:72rpx; line-height:72rpx; border-radius:16rpx; background:#315b95; color:#fff; font-size:26rpx; white-space:nowrap; }
.consult-chat-send::after { border:0; }
.consult-chat-send[disabled] { background:#e6edf6; color:#9aa9bc; }
