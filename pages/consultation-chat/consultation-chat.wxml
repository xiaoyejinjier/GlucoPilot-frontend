<wxs module="i18n" src="/utils/i18n.wxs" />
<view class="consult-chat-page" style="{{displayStyle}}; bottom:{{keyboardOffset}}px; {{composerHeight ? 'padding-bottom:' + composerHeight + 'px;' : ''}}">
  <view class="consult-chat-context" bindtap="onDetails" aria-role="button">
    <view class="consult-chat-context-copy"><text class="consult-chat-title">{{i18n.content(contentTranslations, 'CONSULTATION_PREVIEW', item.id, 'title', item.title, locale)}}</text><text class="consult-chat-note">{{i18n.t('仅患者本人和接诊医生可见',locale)}}</text></view>
    <text class="consult-chat-details">{{i18n.t('问诊详情',locale)}} ›</text>
  </view>
  <view class="consult-chat-scroll-shell">
  <scroll-view class="consult-chat-list" scroll-y enhanced="{{true}}" scroll-into-view="{{scrollTarget}}" bindscroll="onScroll" bindscrolltolower="onLower" bindscrolltoupper="onUpper" lower-threshold="40">
    <view wx:if="{{hasMore}}" class="consult-chat-state" bindtap="onOlder">{{i18n.t(loading ? '正在加载…' : '查看更早的交流',locale)}}</view>
    <view wx:if="{{!messages.length}}" class="consult-chat-state">{{i18n.t(loading ? '正在加载消息…' : '可以在这里补充情况或回复对方。',locale)}}</view>
    <view wx:for="{{messages}}" wx:key="id" id="consult-msg-{{item.id}}" class="consult-chat-message {{item.mine ? 'mine' : ''}}">
      <text wx:if="{{item.showTime}}" class="consult-chat-time">{{item.timeLabel}}</text>
      <view class="consult-chat-message-row"><view class="consult-chat-avatar">{{i18n.t(item.mine ? '我' : item.senderRole === 'DOCTOR' ? '医' : '患',locale)}}</view><text class="consult-chat-bubble" selectable>{{item.content}}</text></view>
    </view>
  </scroll-view>
  </view>
  <view wx:if="{{newMessages}}" class="consult-chat-new" bindtap="scrollToBottom">{{i18n.t('有新消息，点击查看',locale)}} ↓</view>
  <view wx:if="{{error || readError}}" class="consult-chat-error" bindtap="onRetry">{{i18n.t(error || readError,locale)}} · {{i18n.t('点击重试',locale)}}</view>
  <view class="consult-chat-composer {{keyboardHeight ? 'keyboard-open' : ''}}">
    <view wx:if="{{item.status === 'CLOSED'}}" class="consult-chat-state">{{i18n.t('问诊已结束，不能继续发送',locale)}}</view>
    <view class="consult-chat-input-row">
      <input class="consult-chat-input" value="{{input}}" bindinput="onInput" bindfocus="onFocus" bindblur="onBlur" bindkeyboardheightchange="onFocusKeyboard" bindconfirm="onSend" confirm-type="send" adjust-position="{{false}}" maxlength="2000" disabled="{{!ready || !canSend || sending}}" placeholder="{{i18n.t('发送消息…',locale)}}"/>
      <button class="consult-chat-send ui-interactive" bindtap="onSend" hover-class="ui-pressed" loading="{{sending}}" disabled="{{!ready || !canSend || sending || !input}}">{{i18n.t('发送',locale)}}</button>
    </view>
  </view>
</view>
