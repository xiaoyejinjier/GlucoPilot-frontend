<wxs module="i18n" src="/utils/i18n.wxs" />
<view class="page-no-tab" style="{{displayStyle}}">
  <view class="card about-hero">
    <view class="logo">{{i18n.t("糖", locale)}}</view>
    <text class="app-name">{{i18n.t("AI 控糖助手", locale)}}</text>
    <text class="app-ver">{{i18n.t("版本 " + (version), locale)}}</text>
  </view>

  <view class="card menu-list">
    <view class="menu-item">
      <text>{{i18n.t("版本号", locale)}}</text>
      <text class="menu-arrow">{{i18n.t((version), locale)}}</text>
    </view>
    <view class="menu-item ui-interactive" bindtap="onCheckUpdate" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}">
      <text>{{i18n.t("检查更新", locale)}}</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <view class="card">
    <text class="company">{{i18n.t("贵州慧科未来科技有限公司", locale)}}</text>
    <text class="desc">{{i18n.t("移动互联网 + 健康管理。本应用为健康管理工具，不提供医疗诊断。", locale)}}</text>
  </view>
</view>
