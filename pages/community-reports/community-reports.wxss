.reports-page{padding:30rpx 28rpx calc(44rpx + env(safe-area-inset-bottom));background:var(--bg);min-height:100vh;color:var(--ink)}.reports-intro{display:flex;align-items:center;gap:22rpx;padding:14rpx 4rpx 32rpx}.report-shield{display:flex;align-items:center;justify-content:center;width:80rpx;height:88rpx;flex-shrink:0;border-radius:24rpx 24rpx 36rpx 36rpx;background:var(--brand-soft);color:var(--muted);font-size:38rpx}.reports-title{display:block;font-size:38rpx;font-weight:700;line-height:1.5}.reports-subtitle{display:block;font-size:var(--fs-small);color:var(--muted);margin-top:8rpx;line-height:1.7}.feedback-card{padding:30rpx;background:#fff;border:1rpx solid var(--line);border-radius:26rpx;margin-bottom:22rpx}.report-top{display:flex;align-items:center;justify-content:space-between;gap:16rpx;flex-wrap:wrap}.report-kind{font-size:var(--fs-tiny);color:var(--hint)}.report-status-wrap{display:flex;align-items:center;gap:12rpx}.report-status{font-size:var(--fs-tiny);padding:6rpx 16rpx;border-radius:12rpx;background:var(--brand-soft);color:var(--muted)}.report-status.pending{background:#fbf4e1;color:#b09a5d}.unread-dot{width:12rpx;height:12rpx;border-radius:50%;background:#e28c79}.report-target{display:block;margin-top:22rpx;font-size:var(--fs-body);font-weight:650;line-height:1.7;overflow-wrap:anywhere}.report-reason,.report-time{display:block;font-size:var(--fs-small);color:var(--muted);margin-top:12rpx;line-height:1.7}.report-result{background:var(--brand-soft);padding:20rpx;border-radius:16rpx;margin-top:22rpx;font-size:var(--fs-small);color:var(--muted);line-height:1.8}.result-preview{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;color:var(--hint);margin-top:6rpx;overflow-wrap:anywhere}.report-bottom{display:flex;justify-content:space-between;gap:12rpx;margin-top:24rpx;padding-top:20rpx;border-top:1rpx solid var(--surface-subtle);font-size:var(--fs-tiny);color:var(--hint);flex-wrap:wrap}.report-open{color:var(--muted)}.feedback-timeline{padding:34rpx 0 18rpx}.timeline-step{display:flex;align-items:flex-start;gap:20rpx;color:var(--hint)}.timeline-dot{display:flex;align-items:center;justify-content:center;width:40rpx;height:40rpx;flex-shrink:0;border-radius:50%;border:1rpx solid var(--line);font-size:22rpx;background:var(--surface-subtle)}.done .timeline-dot{background:var(--brand-soft);border-color:var(--brand-line);color:var(--muted)}.timeline-title{display:block;font-size:var(--fs-body);font-weight:600;line-height:1.5;color:var(--muted)}.timeline-copy{display:block;font-size:var(--fs-small);color:var(--hint);line-height:1.8;margin-top:8rpx;overflow-wrap:anywhere}.timeline-line{width:1rpx;height:35rpx;background:var(--line);margin:6rpx 0 6rpx 20rpx}.admin-feedback{padding:24rpx;border-radius:18rpx;background:var(--brand-soft);margin-top:16rpx}.feedback-label{display:block;color:var(--muted);font-size:var(--fs-small);font-weight:600}.feedback-note,.original-note{display:block;white-space:pre-wrap;overflow-wrap:anywhere;font-size:var(--fs-body);line-height:1.9;color:var(--muted);margin-top:16rpx}.original-reason{display:block;font-size:var(--fs-small);margin-top:22rpx;color:var(--muted)}.original-note{font-size:var(--fs-small);color:var(--hint)}.report-id{display:block;font-size:var(--fs-tiny);color:var(--hint);margin-top:24rpx}.read-retry{display:block;margin-top:18rpx;color:#b3945b;font-size:var(--fs-small);line-height:1.8}.report-empty{display:flex;flex-direction:column;align-items:center;text-align:center;gap:24rpx;padding:60rpx 32rpx;color:var(--brand);font-size:var(--fs-body);line-height:1.8}.empty-symbol{width:80rpx;height:80rpx;line-height:80rpx;border-radius:26rpx;background:var(--brand-soft);color:var(--brand);font-size:38rpx}.empty-title{font-weight:600}.empty-copy{font-size:var(--fs-small);color:var(--hint)}.report-empty button{margin:0;border-radius:18rpx;background:var(--brand-soft);color:var(--muted);padding:12rpx 30rpx;font-size:var(--fs-small);line-height:1.5}.report-empty button::after{border:0}.report-state{text-align:center;padding:28rpx;color:var(--hint);font-size:var(--fs-small)}.reports-footnote{display:block;text-align:center;color:var(--hint);font-size:var(--fs-tiny);line-height:1.9;padding:10rpx 12rpx}
