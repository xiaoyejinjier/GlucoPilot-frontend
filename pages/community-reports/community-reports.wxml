<wxs module="i18n" src="/utils/i18n.wxs" />
<view class="page-no-tab reports-page" style="{{displayStyle}}">
  <view class="reports-intro"><view class="report-shield">✓</view><view><text class="reports-title">{{i18n.t((detailMode ? '你的反馈，有了回应' : '我的举报'), locale)}}</text><text class="reports-subtitle">{{i18n.t("一起维护友善、真实的交流环境", locale)}}</text></view></view>
  <block wx:if="{{selected}}">
    <view class="feedback-card"><view class="report-top"><text class="report-kind">{{i18n.t((selected.typeLabel) + "举报", locale)}}</text><text class="report-status {{selected.state === 'OPEN' ? 'pending' : ''}}">{{i18n.t((selected.statusLabel), locale)}}</text></view><text class="report-target">{{selected.targetLabel}}</text><text class="report-time">{{i18n.t("提交于 " + (selected.timeLabel), locale)}}</text>
      <view class="feedback-timeline"><view class="timeline-step done"><view class="timeline-dot">✓</view><view><text class="timeline-title">{{i18n.t("举报已提交", locale)}}</text><text class="timeline-copy">{{i18n.t((selected.reasonLabel), locale)}}</text></view></view><view class="timeline-line"></view><view class="timeline-step {{selected.state !== 'OPEN' ? 'done' : ''}}"><view class="timeline-dot">{{i18n.t((selected.state !== 'OPEN' ? '✓' : '2'), locale)}}</view><view><text class="timeline-title">{{i18n.t((selected.state === 'OPEN' ? '等待管理员核查' : selected.resultLabel), locale)}}</text><text class="timeline-copy">{{i18n.t((selected.resolvedLabel || '处理完成后，会在提醒与回复中通知你。'), locale)}}</text></view></view></view>
      <view wx:if="{{selected.state !== 'OPEN'}}" class="admin-feedback"><text class="feedback-label">{{i18n.t("管理员回复", locale)}}</text><text class="feedback-note">{{selected.resolutionNote || i18n.t('已完成核查。', locale)}}</text></view><text wx:if="{{readError}}" class="read-retry ui-interactive" bindtap="markRead" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}">{{i18n.t("反馈已加载，未读状态同步失败 · 点击重试", locale)}}</text>
    </view><view class="feedback-card original-details"><text class="feedback-label">{{i18n.t("我的举报说明", locale)}}</text><text class="original-reason">{{i18n.t((selected.reasonLabel), locale)}}</text><text class="original-note">{{selected.details || i18n.t('未补充其他说明', locale)}}</text><text class="report-id">{{i18n.t("举报编号 #" + (selected.id), locale)}}</text></view>
  </block>
  <block wx:elif="{{!detailMode}}"><view wx:for="{{list}}" wx:key="id" class="feedback-card report-list-card ui-interactive" data-id="{{item.id}}" bindtap="onOpen" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}"><view class="report-top"><text class="report-kind">{{i18n.t((item.typeLabel) + "举报 · #" + (item.id), locale)}}</text><view class="report-status-wrap"><view wx:if="{{item.unread}}" class="unread-dot"></view><text class="report-status {{item.state === 'OPEN' ? 'pending' : ''}}">{{i18n.t((item.statusLabel), locale)}}</text></view></view><text class="report-target">{{item.targetLabel}}</text><text class="report-reason">{{i18n.t((item.reasonLabel), locale)}}</text><view wx:if="{{item.state !== 'OPEN'}}" class="report-result"><text>{{i18n.t((item.resultLabel), locale)}}</text><text class="result-preview">{{item.resolutionNote}}</text></view><view class="report-bottom"><text>{{i18n.t((item.timeLabel), locale)}}</text><text class="report-open">{{i18n.t((item.state === 'OPEN' ? '查看进度' : '查看反馈') + " ›", locale)}}</text></view></view></block>
  <view wx:if="{{loading}}" class="report-state">{{i18n.t("正在加载…", locale)}}</view><view wx:elif="{{error}}" class="feedback-card report-empty"><text class="empty-symbol">!</text><text>{{i18n.t((error), locale)}}</text><button class="ui-interactive" bindtap="onRetry" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}">{{i18n.t("重新加载", locale)}}</button></view><view wx:elif="{{!detailMode && !list.length}}" class="feedback-card report-empty"><text class="empty-symbol">✓</text><text class="empty-title">{{i18n.t("还没有举报记录", locale)}}</text><text class="empty-copy">{{i18n.t("提交举报后，可在这里查看核查进度和处理反馈。", locale)}}</text></view><view wx:elif="{{hasMore}}" class="report-state ui-interactive" bindtap="onMore" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}">{{i18n.t("查看更多 ↓", locale)}}</view>
  <text class="reports-footnote">{{i18n.t("举报说明仅用于核查，请共同保护个人隐私。", locale)}}</text>
</view>
