<view class="page-no-tab reports-page" style="{{displayStyle}}">
  <view class="reports-intro"><view class="report-shield">✓</view><view><text class="reports-title">{{detailMode ? '你的反馈，有了回应' : '我的举报'}}</text><text class="reports-subtitle">一起维护友善、真实的交流环境</text></view></view>
  <block wx:if="{{selected}}">
    <view class="feedback-card"><view class="report-top"><text class="report-kind">{{selected.typeLabel}}举报</text><text class="report-status {{selected.state === 'OPEN' ? 'pending' : ''}}">{{selected.statusLabel}}</text></view><text class="report-target">{{selected.targetLabel}}</text><text class="report-time">提交于 {{selected.timeLabel}}</text>
      <view class="feedback-timeline"><view class="timeline-step done"><view class="timeline-dot">✓</view><view><text class="timeline-title">举报已提交</text><text class="timeline-copy">{{selected.reasonLabel}}</text></view></view><view class="timeline-line"></view><view class="timeline-step {{selected.state !== 'OPEN' ? 'done' : ''}}"><view class="timeline-dot">{{selected.state !== 'OPEN' ? '✓' : '2'}}</view><view><text class="timeline-title">{{selected.state === 'OPEN' ? '等待管理员核查' : selected.resultLabel}}</text><text class="timeline-copy">{{selected.resolvedLabel || '处理完成后，会在提醒与回复中通知你。'}}</text></view></view></view>
      <view wx:if="{{selected.state !== 'OPEN'}}" class="admin-feedback"><text class="feedback-label">管理员回复</text><text class="feedback-note">{{selected.resolutionNote || '已完成核查。'}}</text></view><text wx:if="{{readError}}" class="read-retry" bindtap="markRead">反馈已加载，未读状态同步失败 · 点击重试</text>
    </view><view class="feedback-card original-details"><text class="feedback-label">我的举报说明</text><text class="original-reason">{{selected.reasonLabel}}</text><text class="original-note">{{selected.details || '未补充其他说明'}}</text><text class="report-id">举报编号 #{{selected.id}}</text></view>
  </block>
  <block wx:elif="{{!detailMode}}"><view wx:for="{{list}}" wx:key="id" class="feedback-card report-list-card" data-id="{{item.id}}" bindtap="onOpen"><view class="report-top"><text class="report-kind">{{item.typeLabel}}举报 · #{{item.id}}</text><view class="report-status-wrap"><view wx:if="{{item.unread}}" class="unread-dot"></view><text class="report-status {{item.state === 'OPEN' ? 'pending' : ''}}">{{item.statusLabel}}</text></view></view><text class="report-target">{{item.targetLabel}}</text><text class="report-reason">{{item.reasonLabel}}</text><view wx:if="{{item.state !== 'OPEN'}}" class="report-result"><text>{{item.resultLabel}}</text><text class="result-preview">{{item.resolutionNote}}</text></view><view class="report-bottom"><text>{{item.timeLabel}}</text><text class="report-open">{{item.state === 'OPEN' ? '查看进度' : '查看反馈'}} ›</text></view></view></block>
  <view wx:if="{{loading}}" class="report-state">正在加载…</view><view wx:elif="{{error}}" class="feedback-card report-empty"><text class="empty-symbol">!</text><text>{{error}}</text><button bindtap="onRetry">重新加载</button></view><view wx:elif="{{!detailMode && !list.length}}" class="feedback-card report-empty"><text class="empty-symbol">✓</text><text class="empty-title">还没有举报记录</text><text class="empty-copy">提交举报后，可在这里查看核查进度和处理反馈。</text></view><view wx:elif="{{hasMore}}" class="report-state" bindtap="onMore">查看更多 ↓</view>
  <text class="reports-footnote">举报说明仅用于核查，请共同保护个人隐私。</text>
</view>
