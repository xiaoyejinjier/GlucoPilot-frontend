page{background:#f3f7fc;color:#213758}.reply-page{padding:28rpx 24rpx 64rpx}.reply-card,.measurement-card{padding:30rpx;border:1rpx solid #e1eafb;border-radius:26rpx;background:#fff;margin-bottom:24rpx}.reply-meta{display:flex;justify-content:space-between;gap:16rpx;color:#8c9bb1;font-size:var(--fs-small,24rpx)}.reply-author{font-weight:600;color:#3667a4}.reply-body{display:block;white-space:pre-wrap;word-break:break-word;margin-top:28rpx;line-height:1.9;font-size:var(--fs-body,30rpx)}.measurement-title,.measurement-date,.measurement-note{display:block}.measurement-title{font-weight:600;font-size:var(--fs-body,28rpx)}.measurement-date{margin-top:18rpx;color:#6e829d;font-size:var(--fs-small,24rpx)}.measurement-value{font-size:48rpx;font-weight:700;margin:20rpx 0;color:#325d98}.measurement-value text{font-size:24rpx;font-weight:400}.measurement-note{color:#8997a9;font-size:var(--fs-small,24rpx);line-height:1.8}button{font-size:var(--fs-small,26rpx);background:#edf4ff;color:#3269b5;margin-top:24rpx;border-radius:18rpx}button::after{border:0}.reply-state{padding:36rpx 24rpx;text-align:center;color:#8997a9;line-height:1.8}.reply-state text{display:block}
