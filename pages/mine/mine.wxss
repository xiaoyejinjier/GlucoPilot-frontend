.mine-page{padding:24rpx 28rpx calc(var(--tab-bar-h) + env(safe-area-inset-bottom) + 24rpx);background:var(--bg);min-height:100vh;color:var(--ink)}.mine-hero{position:relative;overflow:hidden;border-radius:32rpx;background:var(--navy);color:#fff;border:1rpx solid var(--navy);padding:28rpx 30rpx 0;box-shadow:0 10rpx 26rpx rgba(40,75,120,.06)}.mine-heading{position:relative;z-index:1;display:flex;align-items:center;justify-content:space-between;gap:20rpx;color:#c5d8ef;font-size:var(--fs-tiny);letter-spacing:2rpx}.mine-settings{display:flex;align-items:center;gap:10rpx;background:#2b4d78;padding:10rpx 16rpx;border-radius:22rpx;font-size:var(--fs-tiny);letter-spacing:0}.settings-symbol{width:22rpx;height:22rpx;border:2rpx solid #bed2eb;border-radius:7rpx;position:relative;transform:rotate(15deg)}.settings-symbol::after{content:'';position:absolute;width:6rpx;height:6rpx;left:5rpx;top:5rpx;border:2rpx solid #bed2eb;border-radius:50%}.mine-hero-ring{position:absolute;width:300rpx;height:300rpx;border:1rpx solid rgba(190,215,245,.2);border-radius:50%;right:-88rpx;top:-130rpx;box-shadow:0 0 0 50rpx rgba(190,215,245,.04)}.mine-hero-leaf{position:absolute;width:62rpx;height:110rpx;border-radius:100% 0 100% 0;right:44rpx;bottom:68rpx;background:rgba(190,215,245,.1);transform:rotate(42deg)}.mine-profile{position:relative;z-index:1;display:flex;align-items:center;gap:24rpx;margin:28rpx 0 30rpx}.mine-avatar{width:124rpx;height:124rpx;border-radius:50%;border:6rpx solid rgba(255,255,255,.7);background:var(--brand-line);overflow:hidden;flex-shrink:0}.mine-avatar avatar-image{display:block;width:100%;height:100%}.mine-identity{flex:1;min-width:0}.mine-name{display:block;font-size:38rpx;font-weight:650;line-height:1.5;overflow-wrap:anywhere}.mine-community-key{display:block;font-size:var(--fs-tiny);line-height:1.7;color:#c5d8ef;margin-top:8rpx;overflow-wrap:anywhere}.mine-community-key>text{color:#c5d8ef}.mine-profile-copy{display:block;font-size:var(--fs-small);line-height:1.8;color:#c5d8ef;margin-top:8rpx}.mine-hero-actions{position:relative;display:flex;border-top:1rpx solid #36577f;padding:22rpx 0;gap:24rpx}.mine-hero-actions>view{flex:1;display:flex;align-items:center;justify-content:space-between;font-size:var(--fs-small);color:#e1edfc;padding:0 14rpx;gap:12rpx}.mine-hero-actions>view+view{border-left:1rpx solid #36577f;padding-left:34rpx}.mine-hero-actions>view>text:last-child{color:#c5d8ef;font-size:28rpx}
.mine-overview,.mine-section,.mine-service{background:#fff;border:1rpx solid var(--line);border-radius:28rpx;margin-top:24rpx;padding:28rpx}.mine-section-heading{display:flex;align-items:center;justify-content:space-between;gap:16rpx;flex-wrap:wrap;font-size:var(--fs-body);font-weight:650;color:var(--brand-dark)}.mine-section-hint{font-size:var(--fs-tiny);font-weight:400;color:var(--muted)}.mine-metrics{display:flex;gap:10rpx;padding:28rpx 0 6rpx}.mine-metrics>view{flex:1;min-width:0;text-align:center}.mine-metrics>view+view{border-left:1rpx solid var(--surface-subtle)}.mine-metric-value{display:block;font-size:44rpx;font-weight:650;color:var(--brand);line-height:1.4;font-variant-numeric:tabular-nums}.mine-metric-value>text{font-size:var(--fs-tiny);margin-left:6rpx;font-weight:400;color:var(--muted)}.mine-metric-label{display:block;margin-top:12rpx;font-size:var(--fs-small);line-height:1.7;color:var(--muted)}.mine-metric-label>text{font-size:18rpx;display:block;color:var(--hint)}
.mine-community-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12rpx;margin:28rpx -6rpx 20rpx}.mine-community-grid>view{display:flex;align-items:center;flex-direction:column;gap:16rpx;font-size:var(--fs-small);color:var(--muted);text-align:center;line-height:1.6;min-width:0}.mine-icon{display:flex;align-items:center;justify-content:center;width:80rpx;height:80rpx;border-radius:26rpx}.icon-article{background:var(--brand-soft);color:var(--brand-dark)}.icon-collection{background:#fbf3df;color:#c9ae71}.icon-follow{background:#f0edf6;color:#b2a1c6}.icon-draft{background:var(--surface-subtle);color:var(--muted)}.mine-icon image{width:38rpx;height:38rpx}.paper-symbol{width:30rpx;height:38rpx;border:2rpx solid currentColor;border-radius:5rpx;padding:8rpx 5rpx}.paper-symbol>view{height:2rpx;background:currentColor;margin:4rpx 0}.person-symbol{position:relative;width:37rpx;height:19rpx;border:2rpx solid currentColor;border-radius:22rpx 22rpx 6rpx 6rpx;margin-top:19rpx}.person-symbol::before{content:'';position:absolute;width:17rpx;height:17rpx;border:2rpx solid currentColor;border-radius:50%;left:7rpx;top:-25rpx}.folder-symbol{position:relative;width:38rpx;height:29rpx;border:2rpx solid currentColor;border-radius:5rpx}.folder-symbol::before{content:'';position:absolute;left:-2rpx;top:-9rpx;width:18rpx;height:7rpx;border:2rpx solid currentColor;border-bottom:0;border-radius:5rpx 5rpx 0 0}
.mine-menu-row{display:flex;align-items:center;gap:18rpx;border-top:1rpx solid var(--surface-subtle);padding:26rpx 0}.mine-menu-row:last-child{padding-bottom:0}.mine-row-icon{display:flex;align-items:center;justify-content:center;width:62rpx;height:62rpx;border-radius:20rpx;flex-shrink:0}.message-row-icon{background:var(--brand-soft);color:var(--brand)}.report-row-icon{background:#f8f0df;color:#b8a575}.bubble-symbol{width:28rpx;height:23rpx;border:2rpx solid currentColor;border-radius:8rpx 8rpx 8rpx 2rpx;position:relative}.bubble-symbol::after{content:'';position:absolute;left:5rpx;right:5rpx;top:8rpx;border-top:2rpx solid currentColor}.shield-symbol{width:27rpx;height:32rpx;display:flex;align-items:center;justify-content:center;border:2rpx solid currentColor;border-radius:6rpx 6rpx 12rpx 12rpx;font-size:18rpx}.mine-menu-copy{flex:1;min-width:0;line-height:1.6}.mine-menu-copy>text:first-child{display:block;font-size:var(--fs-body);color:var(--brand-dark);font-weight:500}.mine-menu-copy>text:last-child{display:block;font-size:var(--fs-tiny);color:var(--muted);margin-top:4rpx;overflow-wrap:anywhere}.mine-menu-arrow{font-size:30rpx;color:var(--hint);flex-shrink:0}.report-new-badge{display:flex;align-items:center;justify-content:center;min-width:30rpx;height:30rpx;line-height:30rpx;padding:0 8rpx;border-radius:20rpx;background:#c1874c;color:#fff;font-size:20rpx;flex-shrink:0}.message-unread-badge{flex-shrink:0}
.mine-tools-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:28rpx 18rpx;margin-top:28rpx}.mine-tools-grid>view{display:flex;align-items:center;gap:14rpx;min-width:0;padding:4rpx 0}.tool-symbol{display:flex;align-items:center;justify-content:center;width:52rpx;height:52rpx;border-radius:16rpx;flex-shrink:0;font-size:30rpx}.tool-health{background:#f7ede7;color:#c0a18a}.tool-food{background:var(--brand-soft);color:var(--brand)}.tool-export{background:var(--surface-subtle);color:var(--muted)}.tool-feedback{background:#f3edf5;color:#b6a5bf}.mine-tools-grid>view>view:nth-child(2){flex:1;min-width:0}.mine-tools-grid>view>view>text:first-child{display:block;font-size:var(--fs-small);color:var(--muted);line-height:1.7}.mine-tools-grid>view>view>text:last-child{display:block;font-size:var(--fs-tiny);color:var(--hint);margin-top:3rpx;line-height:1.7}.tool-arrow{display:none}.food-leaf{width:24rpx;height:30rpx;border-radius:90% 0 90% 0;border:2rpx solid currentColor;transform:rotate(15deg)}.mine-service{padding:0 28rpx}.mine-service-row{display:flex;justify-content:space-between;align-items:center;gap:20rpx;padding:27rpx 0;font-size:var(--fs-small);color:var(--muted);border-bottom:1rpx solid var(--surface-subtle)}.mine-service-row:last-child{border-bottom:0}.mine-service-row>text:last-child{font-size:28rpx;color:var(--hint)}.mine-logout{padding:30rpx 0 18rpx;text-align:center}.mine-logout-button{display:block;width:100%;margin:0;background:#fff;border:1rpx solid var(--line);border-radius:22rpx;font-size:var(--fs-body);line-height:1.6;padding:20rpx;color:var(--muted)}.mine-logout-button::after{border:0}.mine-logout>text{display:block;font-size:var(--fs-tiny);color:var(--hint);margin-top:24rpx;line-height:1.8}
