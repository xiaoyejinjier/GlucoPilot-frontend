<wxs module="i18n" src="/utils/i18n.wxs" />
<view class="page mine-page" style="{{displayStyle}}">
  <view wx:if="{{locale === 'en' && (contentTranslationLoading || contentTranslationError)}}" class="content-translation-notice" bindtap="retryContentTranslations" aria-role="button"><text>{{i18n.t(contentTranslationLoading ? '正在准备英文内容…' : '暂时无法翻译，正在显示原文，点击重试', locale)}}</text></view>
  <view class="mine-hero"><view class="mine-hero-ring"></view><view class="mine-hero-leaf"></view><view class="mine-heading"><text>{{i18n.t("我的健康空间", locale)}}</text><view class="mine-settings ui-interactive" data-url="/pages/settings/settings" bindtap="onMenuTap" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}"><view class="settings-symbol"></view><text>{{i18n.t("设置", locale)}}</text></view></view><view class="mine-profile"><view class="mine-avatar ui-interactive" bindtap="onPublicProfile" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}"><avatar-image src="{{userInfo.avatarUrl}}" text="{{userInfo.avatarText || '友'}}"></avatar-image></view><view class="mine-identity"><text class="mine-name ui-interactive" bindtap="onPublicProfile" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}">{{i18n.name(contentTranslations, userInfo, locale) || i18n.t('糖友', locale)}}</text><text wx:if="{{locale === 'en' && i18n.name(contentTranslations, userInfo, locale) !== userInfo.nickname}}" class="content-original-name">{{i18n.t('原名', locale)}}: {{userInfo.nickname}}</text><text class="mine-community-key">{{i18n.t("电话号码：", locale)}}{{userInfo.phone || i18n.t('未绑定', locale)}}</text><text class="mine-profile-copy">{{userInfo.bio || i18n.t('记录点滴，也照顾好自己。', locale)}}</text></view></view><view class="mine-hero-actions"><view class="ui-interactive" bindtap="onPublicProfile" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}"><text>{{i18n.t("我的主页", locale)}}</text><text>↗</text></view><view class="ui-interactive" bindtap="onEditProfile" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}"><text>{{i18n.t("编辑资料", locale)}}</text><text>✎</text></view></view></view>
  <view class="mine-overview"><view class="mine-section-heading"><text>{{i18n.t("今日健康概览", locale)}}</text><text class="mine-section-hint">{{i18n.t("来自你的记录", locale)}}</text></view><view class="mine-metrics"><view><text class="mine-metric-value">{{i18n.t((todayCount), locale)}}</text><text class="mine-metric-label">{{i18n.t("今日记录", locale)}}</text></view><view><text class="mine-metric-value">{{i18n.t((avgGlucose), locale)}}</text><text class="mine-metric-label">{{i18n.t("平均血糖", locale)}} <text>mmol/L</text></text></view><view><text class="mine-metric-value">{{i18n.t((streakDays), locale)}}<text>{{i18n.t("天", locale)}}</text></text><text class="mine-metric-label">{{i18n.t("连续记录", locale)}}</text></view></view></view>
  <view class="mine-section"><view class="mine-section-heading"><text>{{i18n.t("我的社区", locale)}}</text><text class="mine-section-hint">{{i18n.t("分享与回应，都在这里", locale)}}</text></view><view class="mine-community-grid"><view class="ui-interactive" data-url="/pages/community-articles/community-articles" bindtap="onMenuTap" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}"><view class="mine-icon icon-article"><view class="paper-symbol"><view></view><view></view></view></view><text>{{i18n.t("我的文章", locale)}}</text></view><view class="ui-interactive" data-url="/pages/community/community?mode=collections" bindtap="onMenuTap" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}"><view class="mine-icon icon-collection"><image src="/assets/icons/social-collect-active.svg" /></view><text>{{i18n.t("我的收藏", locale)}}</text></view><view class="ui-interactive" data-url="/pages/community/community?mode=following" bindtap="onMenuTap" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}"><view class="mine-icon icon-follow"><view class="person-symbol"></view></view><text>{{i18n.t("我的关注", locale)}}</text></view><view class="ui-interactive" data-url="/pages/community-articles/community-articles?mode=drafts" bindtap="onMenuTap" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}"><view class="mine-icon icon-draft"><view class="folder-symbol"></view></view><text>{{i18n.t("草稿箱", locale)}}</text></view></view>
    <view class="mine-menu-row ui-interactive" data-url="/pages/information/information" bindtap="onMenuTap" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}"><view class="mine-row-icon message-row-icon"><view class="bubble-symbol"></view></view><view class="mine-menu-copy"><text>{{i18n.t("我的信息", locale)}}</text><text>{{i18n.t("私信、点赞、收藏与评论", locale)}}</text></view><text wx:if="{{unreadCount > 0}}" class="message-unread-badge">{{i18n.t((unreadLabel), locale)}}</text><text class="mine-menu-arrow">›</text></view>
    <view class="mine-menu-row ui-interactive" data-url="/pages/community-reports/community-reports" bindtap="onMenuTap" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}"><view class="mine-row-icon report-row-icon"><view class="shield-symbol">✓</view></view><view class="mine-menu-copy"><text>{{i18n.t("我的举报", locale)}}</text><text>{{i18n.t((informationCounts.reports > 0 ? '管理员已回复，查看处理反馈' : '查看举报进度与处理反馈'), locale)}}</text></view><text wx:if="{{informationCounts.reports > 0}}" class="report-new-badge">{{i18n.t((informationCounts.reports > 99 ? '99+' : informationCounts.reports), locale)}}</text><text class="mine-menu-arrow">›</text></view>
  </view>
  <view class="mine-section"><view class="mine-section-heading"><text>{{i18n.t("健康与工具", locale)}}</text><text class="mine-section-hint">{{i18n.t("让日常管理更方便", locale)}}</text></view><view class="mine-tools-grid"><view class="ui-interactive" data-url="/pages/health-archive/health-archive" bindtap="onMenuTap" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}"><view class="tool-symbol tool-health">＋</view><view><text>{{i18n.t("健康档案", locale)}}</text><text>{{i18n.t("档案与管理目标", locale)}}</text></view><text class="tool-arrow">›</text></view><view class="ui-interactive" data-url="/pages/nutrition/nutrition" bindtap="onMenuTap" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}"><view class="tool-symbol tool-food"><view class="food-leaf"></view></view><view><text>{{i18n.t("食物营养", locale)}}</text><text>{{i18n.t("查询碳水与热量", locale)}}</text></view><text class="tool-arrow">›</text></view><view class="ui-interactive" data-url="/pages/export-data/export-data" bindtap="onMenuTap" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}"><view class="tool-symbol tool-export">↗</view><view><text>{{i18n.t("数据导出", locale)}}</text><text>{{i18n.t("保存自己的记录", locale)}}</text></view><text class="tool-arrow">›</text></view><view class="ui-interactive" data-url="/pages/feedback/feedback" bindtap="onMenuTap" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}"><view class="tool-symbol tool-feedback">✎</view><view><text>{{i18n.t("留言反馈", locale)}}</text><text>{{i18n.t("建议与使用问题", locale)}}</text></view><text class="tool-arrow">›</text></view></view></view>
  <view class="mine-service"><view class="mine-service-row ui-interactive" data-url="/pages/account-security/account-security" bindtap="onMenuTap" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}"><text>{{i18n.t("账号与安全", locale)}}</text><text>›</text></view><view class="mine-service-row ui-interactive" data-url="/pages/disclaimer/disclaimer" bindtap="onMenuTap" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}"><text>{{i18n.t("免责声明", locale)}}</text><text>›</text></view><view class="mine-service-row ui-interactive" data-url="/pages/about/about" bindtap="onMenuTap" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}"><text>{{i18n.t("关于我们", locale)}}</text><text>›</text></view></view>
  <view class="mine-logout"><button class="mine-logout-button ui-interactive" bindtap="onLogout" disabled="{{loggingOut}}" loading="{{loggingOut}}" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}">{{i18n.t("退出登录", locale)}}</button><text>{{i18n.t("慢慢来，每一天的认真都算数。", locale)}}</text></view>
</view>
