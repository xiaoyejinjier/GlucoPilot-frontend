<view class="page" style="{{displayStyle}}">
  <view class="card profile-card">
    <image
      wx:if="{{userInfo.avatarUrl}}"
      class="profile-avatar profile-avatar-img"
      src="{{userInfo.avatarUrl}}"
      mode="aspectFill"
    />
    <view wx:else class="profile-avatar">{{userInfo.avatarText}}</view>
    <view class="profile-info">
      <text class="profile-name">{{userInfo.nickname}}</text>
      <text class="profile-desc">{{userInfo.diabetesType}} · {{userInfo.age}} 岁</text>
    </view>
    <text class="profile-edit" bindtap="onEditProfile">编辑资料</text>
  </view>

  <view class="card">
    <view class="section-title">今日概览</view>
    <view class="metric-row">
      <view class="metric-box">
        <text class="metric-val">{{todayCount}}</text>
        <text class="metric-label">已记录</text>
      </view>
      <view class="metric-box">
        <text class="metric-val">{{avgGlucose}}</text>
        <text class="metric-label">均糖</text>
      </view>
      <view class="metric-box">
        <text class="metric-val">{{streakDays}}</text>
        <text class="metric-label">连续天</text>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="section-title">快捷入口</view>
    <view class="quick-grid">
      <view class="quick-item" data-url="/pages/health-archive/health-archive" bindtap="onMenuTap">
        <text class="quick-title">健康档案</text>
        <text class="quick-desc">类型 · 用药</text>
      </view>
      <view class="quick-item" data-url="/pages/nutrition/nutrition" bindtap="onMenuTap">
        <text class="quick-title">营养库</text>
        <text class="quick-desc">查碳水热量</text>
      </view>
      <view class="quick-item" data-url="/pages/export-data/export-data" bindtap="onMenuTap">
        <text class="quick-title">导出数据</text>
        <text class="quick-desc">生成摘要</text>
      </view>
      <view class="quick-item" data-url="/pages/feedback/feedback" bindtap="onMenuTap">
        <text class="quick-title">留言反馈</text>
        <text class="quick-desc">意见建议</text>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="section-title">控糖提醒</view>
    <view class="tip-list">
      <text class="tip-item">· 餐后 2 小时建议复测一次血糖</text>
      <text class="tip-item">· 今日目标：完成 9 时段中至少 6 次记录</text>
      <text class="tip-item">· 低 GI 主食替换可减少餐后波动</text>
    </view>
  </view>

  <view class="card menu-list">
    <view class="menu-item" data-url="/pages/health-archive/health-archive" bindtap="onMenuTap">
      <text>健康档案</text><text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" data-url="/pages/nutrition/nutrition" bindtap="onMenuTap">
      <text>食物营养查询</text><text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" data-url="/pages/feedback/feedback" bindtap="onMenuTap">
      <text>留言反馈</text><text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" data-url="/pages/disclaimer/disclaimer" bindtap="onMenuTap">
      <text>免责声明</text><text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" data-url="/pages/settings/settings" bindtap="onMenuTap">
      <text>设置</text><text class="menu-arrow">›</text>
    </view>
  </view>
</view>
