<view class="page-no-tab" style="{{displayStyle}}">
  <view class="page-intro">
    <text class="page-intro-text">二级列表 · 每 100g 参考值</text>
  </view>

  <view class="card">
    <view wx:if="{{list.length === 0}}" class="empty">该类暂无示例数据</view>
    <view
      wx:for="{{list}}"
      wx:key="index"
      class="food-row"
      data-index="{{index}}"
      bindtap="onFoodTap"
    >
      <image
        class="food-thumb"
        src="{{item.image}}"
        mode="aspectFill"
        data-index="{{index}}"
        binderror="onImageError"
      />
      <view class="food-main">
        <text class="food-name">{{item.name}}</text>
        <text class="food-val">{{item.carbs}}克碳水/100g</text>
      </view>
    </view>
  </view>
</view>
