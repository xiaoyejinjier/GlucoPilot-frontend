<view class="confirm-shot-page" style="{{displayStyle}}">
  <image
    wx:if="{{imagePath}}"
    class="full-photo"
    src="{{imagePath}}"
    mode="{{isMeal ? 'aspectFill' : 'aspectFit'}}"
    show-menu-by-longpress="{{false}}"
    binderror="onImgError"
    bindload="onImgLoad"
  />
  <view wx:else class="photo-missing">照片无法读取，请点击左下角重新拍摄</view>

  <view class="bottom-actions">
    <view class="circle-btn retake {{busy ? 'disabled' : ''}}" bindtap="onRetake" aria-role="button" aria-label="重新拍摄">
      <view class="icon-undo"></view>
    </view>
    <view class="circle-btn ok {{busy ? 'disabled' : ''}}" bindtap="onConfirm" aria-role="button" aria-label="确认照片并识别">
      <view class="icon-check"></view>
    </view>
  </view>
</view>
