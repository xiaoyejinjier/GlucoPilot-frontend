.chip-row {
  display: flex;
  flex-direction: row;
}

.chip {
  flex: 1;
  height: 72rpx;
  margin-right: 12rpx;
  border-radius: 12rpx;
  background: var(--line);
  font-size: var(--fs-body);
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #444;
}

.chip:last-child {
  margin-right: 0;
}

.chip.on {
  background: var(--brand);
  color: #fff;
}

.preview-title {
  display: block;
  margin-top: 24rpx;
  font-size: var(--fs-title);
  font-weight: 700;
  color: var(--ink);
}

.preview-body {
  display: block;
  margin-top: 8rpx;
  font-size: var(--fs-body);
  color: var(--muted);
  line-height: 1.5;
}

.theme-demo {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.demo-btn {
  flex: 1;
  height: 72rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-body);
  font-weight: 700;
}

.demo-btn.primary {
  background: var(--brand);
  color: #fff;
}

.demo-btn.ghost {
  background: var(--brand-soft);
  color: var(--brand-dark);
}

.tip-card .tip-line {
  display: block;
  font-size: var(--fs-small);
  color: var(--muted);
  line-height: 1.5;
}

.tip-card .tip-line + .tip-line {
  margin-top: 8rpx;
}
