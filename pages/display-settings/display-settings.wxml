<view class="page-no-tab" style="{{displayStyle}}">
  <view class="card">
    <view class="section-title">字号</view>
    <view class="chip-row">
      <view
        wx:for="{{fontSizes}}"
        wx:key="*this"
        class="chip {{fontSize === item ? 'on' : ''}}"
        data-val="{{item}}"
        bindtap="onFont"
      >{{item}}</view>
    </view>
    <text class="preview-title">标题预览 · 控糖助手</text>
    <text class="preview-body">正文预览：餐后血糖建议控制在合理范围。</text>
  </view>

  <view class="card">
    <view class="section-title">主题色</view>
    <view class="chip-row">
      <view
        wx:for="{{themes}}"
        wx:key="id"
        class="chip {{theme === item.id ? 'on' : ''}}"
        data-val="{{item.id}}"
        bindtap="onTheme"
      >{{item.label}}</view>
    </view>
    <view class="theme-demo">
      <view class="demo-btn primary">主按钮</view>
      <view class="demo-btn ghost">次按钮</view>
    </view>
  </view>

  <view class="card tip-card">
    <text class="tip-line">当前：字号 {{fontSize}} · 主题 {{themeLabel}}</text>
    <text class="tip-line">切换后立即生效，返回其他页面即可看到。</text>
  </view>
</view>
