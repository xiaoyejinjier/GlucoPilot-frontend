.profile-page{padding:24rpx 28rpx calc(44rpx + env(safe-area-inset-bottom));background:var(--bg);min-height:100vh;color:var(--ink)}
.profile-cover{position:relative;overflow:hidden;min-height:224rpx;border-radius:32rpx 32rpx 16rpx 16rpx;padding:30rpx 32rpx 86rpx;background:linear-gradient(118deg,var(--brand-line),var(--brand-soft) 68%,#f6f8fa)}
.cover-heading{position:relative;z-index:1;display:flex;align-items:center;justify-content:space-between;gap:20rpx}.cover-label{font-size:var(--fs-small);letter-spacing:2rpx;color:var(--muted)}.profile-report{padding:8rpx 18rpx;border-radius:24rpx;background:rgba(255,255,255,.55);color:var(--muted);font-size:var(--fs-tiny)}
.cover-copy{position:relative;z-index:1;display:block;max-width:82%;margin-top:24rpx;font-size:var(--fs-body);font-weight:500;line-height:1.65;color:var(--muted)}.cover-orbit{position:absolute;width:240rpx;height:240rpx;border:1rpx solid rgba(110,145,113,.14);border-radius:50%;right:-50rpx;top:-62rpx}.orbit-two{width:178rpx;height:178rpx;right:-20rpx;top:-30rpx}.cover-leaf{position:absolute;width:64rpx;height:116rpx;border-radius:100% 0 100% 0;background:rgba(128,159,111,.16);right:54rpx;bottom:18rpx;transform:rotate(24deg)}.leaf-two{width:48rpx;height:90rpx;right:7rpx;bottom:38rpx;transform:rotate(68deg);background:rgba(145,169,121,.2)}
.profile-panel{position:relative;margin-top:-60rpx;background:#fff;border:2rpx solid rgba(255,255,255,.9);border-radius:32rpx;padding:32rpx;box-shadow:0 12rpx 36rpx rgba(49,78,57,.04)}.profile-top{display:flex;align-items:center;justify-content:space-between;gap:24rpx}.profile-avatar{width:136rpx;height:136rpx;border-radius:50%;border:8rpx solid #fff;background:var(--brand-soft);box-shadow:0 6rpx 24rpx rgba(65,102,71,.1);flex-shrink:0;overflow:hidden;margin-top:-52rpx}.profile-avatar avatar-image{display:block;width:100%;height:100%}.profile-identity{display:flex;align-items:center;gap:10rpx;color:var(--muted);font-size:var(--fs-tiny);background:var(--brand-soft);padding:9rpx 16rpx;border-radius:24rpx;margin-top:-8rpx}.identity-dot{width:8rpx;height:8rpx;background:var(--brand);border-radius:50%;flex-shrink:0}
.profile-name{display:block;margin-top:24rpx;font-size:44rpx;font-weight:750;line-height:1.4;letter-spacing:1rpx;overflow-wrap:anywhere}.profile-bio{display:block;margin-top:14rpx;font-size:var(--fs-body);color:var(--muted);line-height:1.8;overflow-wrap:anywhere}.profile-community-id{display:inline-flex;max-width:100%;align-items:center;gap:14rpx;margin-top:22rpx;background:var(--surface-subtle);border-radius:14rpx;padding:10rpx 16rpx;color:var(--hint);font-size:var(--fs-tiny);flex-wrap:wrap}.community-id-value{color:var(--muted);font-variant-numeric:tabular-nums;overflow-wrap:anywhere}.community-id-copy{color:var(--brand);padding-left:12rpx;border-left:1rpx solid var(--line)}
.profile-buttons{display:flex;gap:18rpx;margin-top:32rpx}.profile-buttons button{display:flex;align-items:center;justify-content:center;gap:12rpx;flex:1;min-width:0;width:0;min-height:84rpx;margin:0;padding:16rpx 14rpx;border-radius:20rpx;font-size:var(--fs-body);font-weight:600;line-height:1.5;border:1rpx solid transparent}.profile-buttons button::after,.profile-retry::after{border:0}.profile-primary{background:var(--brand-dark);color:#fff;box-shadow:0 6rpx 16rpx rgba(50,102,70,.1)}.profile-primary.is-followed{background:var(--brand-soft);color:var(--muted);box-shadow:none}.profile-secondary{background:#fff;color:var(--ink-soft);border-color:var(--line)!important}.profile-buttons button[disabled]{opacity:.6}.button-symbol{font-size:32rpx;line-height:1;font-weight:400}.message-symbol{width:27rpx;height:22rpx;border:2rpx solid currentColor;border-radius:8rpx 8rpx 8rpx 2rpx;position:relative;flex-shrink:0}.message-symbol::after{content:'';position:absolute;left:6rpx;right:6rpx;top:8rpx;border-top:2rpx solid currentColor}.profile-footer{display:flex;align-items:center;justify-content:center;gap:10rpx;border-top:1rpx solid var(--line);margin-top:28rpx;padding-top:24rpx;color:var(--hint);font-size:var(--fs-tiny);line-height:1.7;text-align:center}.footer-dot{width:6rpx;height:6rpx;flex-shrink:0;border-radius:50%;background:#afbea7}
.profile-section-heading{display:flex;align-items:flex-end;justify-content:space-between;gap:24rpx;margin:42rpx 4rpx 26rpx}.profile-section-kicker{display:block;color:var(--hint);font-size:var(--fs-tiny);letter-spacing:1rpx}.profile-section-title{display:flex;align-items:center;gap:14rpx;margin-top:10rpx;font-size:var(--fs-title);font-weight:700;line-height:1.4}.profile-work-count{font-size:var(--fs-small);font-weight:500;background:var(--brand-soft);color:var(--muted);border-radius:12rpx;padding:3rpx 12rpx}.section-line{width:68rpx;height:4rpx;border-radius:4rpx;background:var(--brand-line);margin-bottom:12rpx;flex-shrink:0}
.profile-article{padding:28rpx;background:#fff;border:1rpx solid var(--brand-soft);border-radius:28rpx;margin-bottom:22rpx;box-shadow:0 5rpx 20rpx rgba(56,80,52,.025)}.profile-article-body{display:flex;align-items:center;gap:24rpx}.profile-article-copy{flex:1;min-width:0}.work-category{display:flex;align-items:center;gap:8rpx;font-size:var(--fs-tiny);color:var(--hint);margin-bottom:12rpx}.work-category-dot{width:7rpx;height:7rpx;border-radius:50%;background:#a1b79a}.profile-article-title{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;font-size:var(--fs-body);font-weight:700;line-height:1.65;color:var(--ink);overflow-wrap:anywhere}.profile-article-summary{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;margin-top:10rpx;font-size:var(--fs-small);color:var(--muted);line-height:1.7;overflow-wrap:anywhere}.profile-article-cover{flex-shrink:0;width:160rpx;height:172rpx;overflow:hidden;border-radius:20rpx;background:var(--brand-soft)}.profile-article-cover article-photo{display:block;width:100%;height:100%}.video-cover{display:flex;align-items:center;justify-content:center;flex-direction:column;gap:14rpx;color:var(--muted);font-size:var(--fs-tiny);background:linear-gradient(135deg,var(--brand-soft),#f2f0df)}.video-play{width:0;height:0;border-top:18rpx solid transparent;border-bottom:18rpx solid transparent;border-left:27rpx solid var(--brand);margin-left:6rpx}.profile-article-tags{display:flex;flex-wrap:wrap;gap:12rpx;margin-top:20rpx}.profile-article-tags text{font-size:var(--fs-tiny);padding:7rpx 13rpx;background:var(--brand-soft);color:var(--muted);border-radius:10rpx;max-width:100%;overflow-wrap:anywhere}.profile-article-bottom{display:flex;align-items:center;justify-content:space-between;gap:12rpx;flex-wrap:wrap;margin-top:22rpx;padding-top:20rpx;border-top:1rpx solid var(--surface-subtle);color:var(--hint);font-size:var(--fs-tiny)}.profile-article-metrics{display:flex;align-items:center;gap:22rpx}.profile-article-metrics>view{display:flex;align-items:center;gap:7rpx}.profile-article-metrics image{display:block;width:24rpx;height:24rpx;opacity:.8}.article-arrow{font-size:29rpx;color:var(--brand);margin-left:2rpx}.profile-list-state{padding:30rpx;text-align:center;font-size:var(--fs-small);color:var(--muted);line-height:1.7;overflow-wrap:anywhere}.profile-list-state text{display:block}.state-link{color:var(--brand)}.profile-list-end{display:flex;align-items:center;justify-content:center;gap:18rpx;padding:24rpx 0;font-size:var(--fs-tiny);color:var(--hint)}.profile-list-end>view{height:1rpx;width:40rpx;background:var(--line);flex-shrink:0}
.profile-empty{display:flex;flex-direction:column;align-items:center;text-align:center;gap:20rpx;padding:56rpx 30rpx}.profile-empty-symbol{width:78rpx;height:78rpx;display:flex;align-items:center;justify-content:center;font-size:36rpx;border-radius:50%;background:var(--brand-soft);color:#9daf8b}.empty-title{font-size:var(--fs-body);font-weight:600;color:var(--ink-soft);line-height:1.6}.empty-description{font-size:var(--fs-small);line-height:1.9;color:var(--muted);overflow-wrap:anywhere}.profile-retry{margin:10rpx 0 0;padding:16rpx 32rpx;line-height:1.5;border-radius:24rpx;background:var(--brand-soft);color:var(--brand);font-size:var(--fs-small)}.empty-paper{width:70rpx;height:90rpx;border:2rpx solid var(--brand-line);border-radius:10rpx;background:#f3f7ee;padding:18rpx 14rpx;transform:rotate(-8deg);margin:4rpx 0 16rpx;box-shadow:10rpx 8rpx 0 var(--brand-soft)}.empty-paper>view{height:3rpx;background:var(--brand-line);border-radius:3rpx;margin:10rpx 0}.empty-paper>view:last-child{width:60%}
.profile-skeleton{padding-top:36rpx;padding-bottom:44rpx}.skeleton-circle{width:112rpx;height:112rpx;border-radius:50%;margin-top:-62rpx;margin-bottom:30rpx;background:#e9efe5}.skeleton-line{height:24rpx;margin:18rpx 0;border-radius:8rpx;background:linear-gradient(90deg,var(--surface-subtle),var(--line),var(--surface-subtle));background-size:200% 100%;animation:profile-shimmer 1.6s ease-in-out infinite}.skeleton-name{width:38%;height:36rpx}.skeleton-short{width:62%}.article-skeleton{padding-top:32rpx;padding-bottom:32rpx}@keyframes profile-shimmer{0%{background-position:100% 0}100%{background-position:-100% 0}}
