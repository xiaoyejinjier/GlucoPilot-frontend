<wxs module="i18n" src="/utils/i18n.wxs" />
<view class="page-no-tab profile-page" style="{{displayStyle}}">
  <view wx:if="{{locale === 'en' && (contentTranslationLoading || contentTranslationError)}}" class="content-translation-notice" bindtap="retryContentTranslations" aria-role="button"><text>{{i18n.t(contentTranslationLoading ? '正在准备英文内容…' : '暂时无法翻译，正在显示原文，点击重试', locale)}}</text></view>
  <view class="profile-cover">
    <view class="cover-orbit orbit-one"></view><view class="cover-orbit orbit-two"></view><view class="cover-leaf leaf-one"></view><view class="cover-leaf leaf-two"></view>
    <view class="cover-heading"><text class="cover-label">{{i18n.t((profile.isSelf ? '我的社区主页' : '糖友的社区主页'), locale)}}</text><text wx:if="{{profile.userId && !profile.isSelf}}" class="profile-report ui-interactive" bindtap="onReport" aria-role="button" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}">{{i18n.t("举报", locale)}}</text></view>
    <text class="cover-copy">{{i18n.t("分享日常，让每一份认真都有回响。", locale)}}</text>
  </view>
  <view wx:if="{{loading && !profile}}" class="profile-panel profile-skeleton"><view class="skeleton-circle"></view><view class="skeleton-line skeleton-name"></view><view class="skeleton-line"></view><view class="skeleton-line skeleton-short"></view></view>
  <view wx:elif="{{error}}" class="profile-panel profile-empty"><view class="profile-empty-symbol">!</view><text class="empty-title">{{i18n.t("暂时没能加载资料", locale)}}</text><text class="empty-description">{{i18n.t((error), locale)}}</text><button class="profile-retry ui-interactive" bindtap="load" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}">{{i18n.t("重新加载", locale)}}</button></view>
  <view wx:elif="{{profile}}" class="profile-panel profile-card">
    <view class="profile-top"><view class="profile-avatar"><avatar-image src="{{profile.avatarUrl}}" text="{{avatarText}}"></avatar-image></view><view class="profile-identity"><view class="identity-dot"></view><text>{{i18n.t((profile.isSelf ? '我的公开名片' : profile.userId ? '社区糖友' : '社区发布者'), locale)}}</text></view></view>
    <text class="profile-name">{{i18n.name(contentTranslations, profile, locale) || i18n.t('糖友', locale)}}</text><text wx:if="{{locale === 'en' && i18n.name(contentTranslations, profile, locale) !== profile.nickname}}" class="content-original-name">{{i18n.t('原名', locale)}}: {{profile.nickname}}</text><text class="profile-bio">{{profile.bio || i18n.t('在这里，记录生活，也和糖友们分享点滴。', locale)}}</text>
    <view wx:if="{{!profile.isSelf}}" class="profile-buttons"><button class="profile-primary {{profile.followed ? 'is-followed' : ''}} ui-interactive" bindtap="onFollow" disabled="{{busy}}" loading="{{busy}}" aria-label="{{i18n.t((profile.followed ? '取消关注' : '关注'), locale)}}" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}"><text class="button-symbol">{{i18n.t((profile.followed ? '✓' : '+'), locale)}}</text>{{i18n.t((profile.followed ? '已关注' : '关注'), locale)}}</button><button wx:if="{{profile.userId}}" class="profile-secondary ui-interactive" bindtap="onMessage" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}"><view class="message-symbol"></view>{{i18n.t("发私信", locale)}}</button></view>
    <view wx:else class="profile-buttons"><button class="profile-primary ui-interactive" bindtap="onMyArticles" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}"><text class="button-symbol">✎</text>{{i18n.t("我的文章", locale)}}</button><button class="profile-secondary ui-interactive" bindtap="onEditProfile" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}">{{i18n.t("编辑资料", locale)}}</button></view>
    <view class="profile-footer"><view class="footer-dot"></view><text>{{i18n.t((profile.isSelf ? '其他糖友也会看到这张公开名片' : !profile.userId ? '该发布者暂未开通私信' : profile.followed ? '已关注，再次点击可取消关注' : '从一次分享开始，认识同行的糖友'), locale)}}</text></view>
  </view>
  <view wx:if="{{profile}}" class="profile-articles">
    <view class="profile-section-heading"><view><text class="profile-section-kicker">{{i18n.t("生活里的点滴，值得被看见", locale)}}</text><view class="profile-section-title"><text>{{i18n.t((profile.isSelf ? '我的公开分享' : '发布的内容'), locale)}}</text><text wx:if="{{articleTotal !== ''}}" class="profile-work-count">{{i18n.t((articleTotal), locale)}}</text></view></view><view class="section-line"></view></view>
    <view wx:for="{{articles}}" wx:key="id" class="profile-article ui-interactive" data-id="{{item.id}}" bindtap="onArticle" aria-role="button" aria-label="{{i18n.t('查看文章：' + (i18n.content(contentTranslations, 'ARTICLE_PREVIEW', item.id, 'title', item.title, locale)), locale)}}" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}">
      <view class="profile-article-body"><view class="profile-article-copy"><view class="work-category"><view class="work-category-dot"></view><text>{{i18n.t((item.videos.length ? '视频分享' : item.images.length ? '图文分享' : '日常分享'), locale)}}</text></view><text class="profile-article-title">{{i18n.content(contentTranslations, 'ARTICLE_PREVIEW', item.id, 'title', item.title, locale)}}</text><text wx:if="{{i18n.content(contentTranslations, 'ARTICLE_PREVIEW', item.id, 'summary', item.summary, locale)}}" class="profile-article-summary">{{i18n.content(contentTranslations, 'ARTICLE_PREVIEW', item.id, 'summary', item.summary, locale)}}</text></view><view wx:if="{{item.images.length}}" class="profile-article-cover"><article-photo media-id="{{item.images[0].mediaId}}" mode="aspectFill" preview-enabled="{{false}}"></article-photo></view><view wx:elif="{{item.videos.length}}" class="profile-article-cover video-cover"><view class="video-play"></view><text>{{i18n.t("视频分享", locale)}}</text></view></view>
      <view wx:if="{{item.tags.length}}" class="profile-article-tags"><text wx:for="{{item.tags}}" wx:for-item="tag" wx:key="code"># {{tag.name}}</text></view>
      <view class="profile-article-bottom"><text>{{i18n.t((item.timeLabel) + " · " + (item.viewCount || 0) + "次浏览", locale)}}</text><view class="profile-article-metrics"><view><image src="/assets/icons/social-like.svg" />{{i18n.t((item.likeCount || 0), locale)}}</view><view><image src="/assets/icons/social-comment.svg" />{{i18n.t((item.commentCount || 0), locale)}}</view><text class="article-arrow">↗</text></view></view>
    </view>
    <view wx:if="{{articlesLoading && !articles.length}}" class="profile-article article-skeleton"><view class="skeleton-line"></view><view class="skeleton-line"></view><view class="skeleton-line skeleton-short"></view></view>
    <view wx:elif="{{articlesError}}" class="profile-list-state ui-interactive" bindtap="onRetryArticles" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}"><text>{{i18n.t((articlesError), locale)}}</text><text class="state-link">{{i18n.t("点击重试 ↻", locale)}}</text></view>
    <view wx:elif="{{!articles.length && !articlesLoading}}" class="profile-empty profile-article"><view class="empty-paper"><view></view><view></view><view></view></view><text class="empty-title">{{i18n.t((profile.isSelf ? '给你的第一篇分享留个位置' : '分享还在酝酿中'), locale)}}</text><text class="empty-description">{{i18n.t((profile.isSelf ? '写下生活里的发现，让更多糖友看到。' : '这里会展示对方公开发布的文章与视频。'), locale)}}</text><button wx:if="{{profile.isSelf}}" class="profile-retry ui-interactive" bindtap="onMyArticles" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}">{{i18n.t("去创作", locale)}}</button></view>
    <view wx:elif="{{articlesLoading}}" class="profile-list-state">{{i18n.t("正在加载更多…", locale)}}</view><view wx:elif="{{articleHasMore}}" class="profile-list-state state-link ui-interactive" bindtap="onMoreArticles" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}">{{i18n.t("查看更多分享 ↓", locale)}}</view><view wx:elif="{{articles.length}}" class="profile-list-end"><view></view><text>{{i18n.t("每一份分享，都有它的意义", locale)}}</text><view></view></view>
  </view>
  <social-feedback id="social-feedback"></social-feedback>
</view>
