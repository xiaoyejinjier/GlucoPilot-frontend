@import "../../styles/wallet.wxss";
.wallet-shortcuts { gap:16rpx; }
.wallet-shortcuts > view { position:relative; min-width:0; flex-direction:column; justify-content:center; padding:24rpx 12rpx; gap:12rpx; text-align:center; }
.wallet-shortcuts > view > text:nth-child(2) { min-width:0; font-size:24rpx; line-height:1.5; overflow-wrap:anywhere; }
.wallet-shortcuts > view > text:last-child { position:absolute; top:12rpx; right:14rpx; }
.wallet-shortcuts .wallet-shortcut-icon { display:flex; align-items:center; justify-content:center; width:48rpx; height:48rpx; padding:0; }
.wallet-card .wallet-primary {
  display: block;
  width: 100%;
  box-sizing: border-box;
  min-height: 88rpx;
  padding: 20rpx 24rpx;
  line-height: 1.5;
}
.wallet-activation{text-align:center;padding:40rpx 32rpx}.wallet-activation-icon{display:block;width:100rpx;height:100rpx;line-height:100rpx;border-radius:28rpx;background:#eaf2ff;color:#5585c5;font-size:58rpx;margin:0 auto 28rpx}.wallet-activation .wallet-muted{line-height:1.8;margin:18rpx 0 30rpx}
