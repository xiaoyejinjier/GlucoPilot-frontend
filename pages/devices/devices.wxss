.device-page {
  min-height: 100vh;
  padding: 32rpx 28rpx calc(var(--tab-bar-h) + 36rpx + env(safe-area-inset-bottom));
  background: #f6f8fa;
  color: #245b91;
  box-sizing: border-box;
}

.device-intro { padding: 4rpx 4rpx 28rpx; }
.device-intro-kicker {
  display: block;
  margin-bottom: 10rpx;
  color: #5485ca;
  font-size: var(--fs-small);
  font-weight: 600;
}
.device-intro-title {
  display: block;
  font-size: var(--fs-title);
  font-weight: 700;
  letter-spacing: 1rpx;
}
.device-intro-note {
  display: block;
  margin-top: 12rpx;
  color: #557596;
  font-size: var(--fs-small);
}

.summary-card {
  display: flex;
  gap: 8rpx;
  margin-bottom: 8rpx;
  padding: 24rpx 12rpx;
  border: 1rpx solid #d1d9e0;
  border-radius: 24rpx;
  background: #fff;
}
.summary-item { flex: 1; text-align: center; }
.summary-value {
  display: block;
  color: #334a68;
  font-size: 40rpx;
  font-weight: 700;
}
.summary-label {
  display: block;
  margin-top: 6rpx;
  color: #557596;
  font-size: var(--fs-tiny);
}

.discovery-card {
  padding: 28rpx;
  border: 1rpx solid #d1d9e0;
  border-radius: 28rpx;
  background: #fff;
}
.device-empty { padding: 8rpx 0 30rpx; text-align: center; }
.mascot-placeholder {
  width: 180rpx;
  height: 180rpx;
  margin: 8rpx auto 16rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 50% 42%, #fff 0 28%, transparent 29%),
    radial-gradient(circle at 50% 58%, #e8f1ff 0 46%, transparent 47%),
    linear-gradient(180deg, #f4f8ff, #e3edfb);
}
.empty-heading {
  display: block;
  margin-top: 4rpx;
  color: #3b4c65;
  font-size: var(--fs-body);
  font-weight: 600;
}
.empty-description {
  display: block;
  margin-top: 14rpx;
  color: #7f8da2;
  font-size: var(--fs-small);
  line-height: 1.7;
}
.empty-subtitle {
  display: block;
  margin-top: 6rpx;
  color: #a2acba;
  font-size: var(--fs-tiny);
  line-height: 1.7;
}

button { margin: 0; padding: 0; border: 0; outline: none; line-height: 1.5; box-sizing: border-box; }
button::after { border: 0; }

.search-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 82rpx;
  padding: 18rpx 24rpx;
  border-radius: 18rpx;
  background: #0969da;
  color: #fff;
  font-size: var(--fs-body);
  font-weight: 500;
}
.search-button.secondary {
  background: #fff;
  border: 1rpx solid #d1d9e0;
  color: #0969da;
}
.search-button.add-another {
  margin-top: 28rpx;
  margin-bottom: 8rpx;
}
.search-button-pressed { background: #0550ae; }
.search-button.secondary.search-button-pressed { background: #ddf4ff; }
.search-footnote {
  display: block;
  margin-top: 16rpx;
  color: #a1adbc;
  text-align: center;
  font-size: var(--fs-tiny);
  line-height: 1.6;
}

.section-empty {
  margin-bottom: 8rpx;
  padding: 28rpx 24rpx;
  border: 1rpx dashed #e0e7f1;
  border-radius: 20rpx;
  background: #fff;
  color: #557596;
  font-size: var(--fs-small);
  line-height: 1.7;
  text-align: center;
}

.device-section-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin: 30rpx 4rpx 18rpx;
  font-size: var(--fs-body);
  font-weight: 600;
}
.section-side-note {
  flex-shrink: 0;
  color: #557596;
  font-size: var(--fs-tiny);
  font-weight: 400;
}

.add-methods { display: flex; gap: 20rpx; }
.add-method {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  min-width: 0;
  padding: 28rpx 12rpx 24rpx;
  border: 1rpx solid #d1d9e0;
  border-radius: 24rpx;
  background: #fff;
}
.method-pressed { background: #ddf4ff; }
.method-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 66rpx;
  height: 66rpx;
  margin-bottom: 18rpx;
  border-radius: 18rpx;
  background: #ddf4ff;
  color: #4d86d6;
}
.method-title { color: #384d6a; font-size: var(--fs-body); font-weight: 600; }
.method-description {
  margin-top: 8rpx;
  color: #97a4b6;
  font-size: var(--fs-tiny);
  white-space: normal;
  text-align: center;
}
.sn-icon { font-family: Arial, sans-serif; font-size: 27rpx; font-weight: 700; letter-spacing: 1rpx; }

.manage-item {
  padding: 24rpx;
  margin-bottom: 16rpx;
  border: 1rpx solid #d1d9e0;
  border-radius: 20rpx;
  background: #fff;
}
.manage-top { display: flex; align-items: flex-start; gap: 16rpx; }
.nearby-device-icon {
  display: flex;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
  width: 50rpx;
  height: 64rpx;
  border: 2rpx solid #9cb6d9;
  border-radius: 12rpx;
  background: #f1f6fd;
}
.mini-device-screen {
  width: 28rpx;
  height: 24rpx;
  margin-top: -12rpx;
  border-radius: 5rpx;
  background: #c6dcf6;
}
.manage-main { flex: 1; min-width: 0; }
.manage-name-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}
.manage-name {
  font-size: var(--fs-body);
  font-weight: 600;
  word-break: break-all;
}
.status-badge {
  flex-shrink: 0;
  padding: 5rpx 12rpx;
  border-radius: 10rpx;
  font-size: var(--fs-tiny);
}
.badge-ok { background: #ddf4ff; color: #0969da; }
.badge-offline { background: #f1f4f8; color: #8190a4; }
.badge-pending { background: #f1f4f8; color: #8190a4; }
.manage-meta {
  display: block;
  margin-top: 10rpx;
  color: #8191a7;
  font-size: var(--fs-small);
  word-break: normal;
  overflow-wrap: anywhere;
  line-height: 1.6;
}
.manage-sync {
  display: block;
  margin-top: 6rpx;
  color: #557596;
  font-size: var(--fs-tiny);
}
.manage-actions {
  display: flex;
  gap: 12rpx;
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #eef2f7;
}
.action-btn {
  flex: 1;
  min-height: 60rpx;
  padding: 10rpx 8rpx;
  border-radius: 24rpx;
  background: #ddf4ff;
  color: #0969da;
  font-size: var(--fs-small);
}
.action-btn.ghost { background: #f5f7fa; color: #7f94b0; }
.action-btn.danger { background: #fff1ef; color: #bd6658; }
.action-btn[disabled] { opacity: 0.45; }

.device-preparation-note {
  margin: 28rpx 6rpx 0;
  color: #557596;
  font-size: var(--fs-tiny);
  line-height: 1.9;
}
.preparation-title {
  display: block;
  margin-bottom: 6rpx;
  color: #8393a8;
  font-weight: 500;
}

.serial-overlay { position: fixed; inset: 0; z-index: 10002; }
.serial-mask { position: absolute; inset: 0; background: rgba(27, 42, 63, 0.36); }
.serial-panel {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  max-height: 85vh;
  overflow-y: auto;
  padding: 30rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  border-radius: 30rpx 30rpx 0 0;
  background: #fff;
}
.serial-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  font-size: var(--fs-title);
  font-weight: 600;
}
.serial-close {
  flex-shrink: 0;
  padding: 12rpx 0 12rpx 20rpx;
  color: #8899af;
  font-size: var(--fs-small);
  font-weight: 400;
}
.serial-note {
  display: block;
  margin: 14rpx 0 20rpx;
  color: #557596;
  font-size: var(--fs-small);
  line-height: 1.7;
}
.detail-line {
  display: block;
  margin-bottom: 12rpx;
  color: #53667f;
  font-size: var(--fs-small);
  line-height: 1.7;
  word-break: break-all;
}
.input-label {
  display: block;
  margin: 24rpx 0 14rpx;
  color: #53667f;
  font-size: var(--fs-small);
}
.required-mark { color: #cb735e; }
.optional-label { color: #557596; }
.serial-input {
  height: 88rpx;
  padding: 0 22rpx;
  border: 1rpx solid #d1d9e0;
  border-radius: 16rpx;
  background: #f8faff;
  color: #344c6b;
  font-size: var(--fs-body);
}
.provider-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.provider-chip {
  padding: 12rpx 18rpx;
  border: 1rpx solid #d1d9e0;
  border-radius: 999rpx;
  background: #fff;
  color: #6484b0;
  font-size: var(--fs-tiny);
}
.provider-chip.on {
  border-color: #0969da;
  background: #ddf4ff;
  color: #0550ae;
  font-weight: 600;
}
.serial-error {
  display: block;
  margin-top: 16rpx;
  color: #bd6658;
  font-size: var(--fs-small);
  line-height: 1.7;
}
.serial-save { margin-top: 32rpx; }
.serial-footnote {
  display: block;
  margin-top: 18rpx;
  text-align: center;
  color: #557596;
  font-size: var(--fs-tiny);
  line-height: 1.7;
}
.serial-placeholder { color:#557596; }

/* Animate the controls and newly opened sheet, keeping form fields stationary. */
.search-button, .action-btn, .add-method, .provider-chip { transition:transform .16s ease, background-color .18s ease, border-color .18s ease, color .18s ease, opacity .16s ease; }
.action-btn.method-pressed, .add-method.method-pressed, .search-button-pressed { transform:scale(.98); }
.serial-mask { animation:ui-backdrop-in .18s ease-out; }
.serial-panel { animation:ui-surface-in .22s cubic-bezier(.2,.8,.2,1); }
@media (prefers-reduced-motion: reduce) {
  .serial-mask, .serial-panel { animation:none; }
  .search-button, .action-btn, .add-method, .provider-chip { transition:none; }
  .action-btn.method-pressed, .add-method.method-pressed, .search-button-pressed { transform:none; }
}
