.devices-page { padding-top:48rpx; background:linear-gradient(160deg,#f2f7ff,var(--bg) 65%); }
.device-placeholder { display:flex; flex-direction:column; align-items:center; margin:0 24rpx; padding:72rpx 30rpx 64rpx; border:2rpx solid #fff; border-radius:36rpx; background:rgba(255,255,255,.8); text-align:center; }
.device-placeholder-illustration { display:flex; align-items:center; justify-content:center; width:160rpx; height:160rpx; margin-bottom:36rpx; border:12rpx solid #f0f6ff; border-radius:50%; background:#e7f0ff; transform:scale(1.1); }
.device-placeholder-title { display:block; color:var(--ink); font-size:var(--fs-title); font-weight:700; line-height:1.5; }
.device-placeholder-description { display:block; margin-top:18rpx; color:var(--muted); font-size:var(--fs-body); line-height:1.8; }
.device-placeholder-tag { margin-top:36rpx; padding:10rpx 24rpx; border-radius:999rpx; background:#edf4ff; color:#6990b6; font-size:var(--fs-small); }
