<wxs module="i18n" src="/utils/i18n.wxs" />
<view class="device-page" style="{{displayStyle}}">
  <view class="device-intro">
    <text class="device-intro-kicker">{{i18n.t("设备管理", locale)}}</text>
    <text class="device-intro-title">{{i18n.t("管理你的血糖设备", locale)}}</text>
    <text class="device-intro-note">{{i18n.t("查看同步状态，必要时可解绑或重新添加", locale)}}</text>
  </view>

  <view class="summary-card">
    <view class="summary-item">
      <text class="summary-value">{{i18n.t((boundCount), locale)}}</text>
      <text class="summary-label">{{i18n.t("已绑定", locale)}}</text>
    </view>
    <view class="summary-item">
      <text class="summary-value">{{i18n.t((drafts.length), locale)}}</text>
      <text class="summary-label">{{i18n.t("待适配", locale)}}</text>
    </view>
    <view class="summary-item">
      <text class="summary-value">{{i18n.t((lastSyncLabel), locale)}}</text>
      <text class="summary-label">{{i18n.t("距上次同步", locale)}}</text>
    </view>
  </view>

  <view class="device-section-heading">
    <text>{{i18n.t("已绑定设备", locale)}}</text>
    <text class="section-side-note">{{i18n.t((boundDevices.length) + " 台", locale)}}</text>
  </view>
  <view wx:if="{{loading}}" class="section-empty ui-loading-line"><view class="ui-loading-dots" aria-hidden="true"><view></view><view></view><view></view></view><text>{{i18n.t("正在加载设备…", locale)}}</text></view>
  <view wx:elif="{{loadError}}" class="section-empty ui-interactive" bindtap="refresh" aria-role="button" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}">{{i18n.t((loadError) + " · 点击重试", locale)}}</view>
  <view wx:elif="{{!boundDevices.length}}" class="section-empty">
    <text>{{i18n.t("暂无已绑定设备，可通过下方按钮添加", locale)}}</text>
  </view>
  <view wx:for="{{boundDevices}}" wx:key="id" class="manage-item">
    <view class="manage-top">
      <view class="nearby-device-icon"><view class="mini-device-screen"></view></view>
      <view class="manage-main">
        <view class="manage-name-row">
          <text class="manage-name">{{item.deviceName}}</text>
          <text class="status-badge {{item.online ? 'badge-ok' : 'badge-offline'}}">{{i18n.t((item.statusText), locale)}}</text>
        </view>
        <text class="manage-meta">{{i18n.t((item.providerName) + " · SN：" + (item.deviceSn), locale)}}</text>
        <text class="manage-sync">{{i18n.t((item.syncText), locale)}}</text>
      </view>
    </view>
    <view class="manage-actions">
      <button class="action-btn" data-id="{{item.id}}" catchtap="onSync" disabled="{{loading}}" hover-class="method-pressed">{{i18n.t((item.syncActionText), locale)}}</button>
      <button class="action-btn ghost" data-id="{{item.id}}" catchtap="onDetail" hover-class="method-pressed">{{i18n.t("详情", locale)}}</button>
      <button class="action-btn danger" data-id="{{item.id}}" catchtap="onUnbind" disabled="{{unbinding}}" hover-class="method-pressed">{{i18n.t("解绑", locale)}}</button>
    </view>
  </view>

  <view class="device-section-heading">
    <text>{{i18n.t("待适配设备", locale)}}</text>
    <text class="section-side-note">{{i18n.t("会话内临时 · " + (drafts.length) + " 台", locale)}}</text>
  </view>
  <view wx:if="{{!drafts.length}}" class="section-empty">
    <text>{{i18n.t("暂无待适配设备；扫码 / SN / 蓝牙登记后会出现在此", locale)}}</text>
  </view>
  <view wx:for="{{drafts}}" wx:key="id" class="manage-item">
    <view class="manage-top">
      <view class="nearby-device-icon"><view class="mini-device-screen"></view></view>
      <view class="manage-main">
        <view class="manage-name-row">
          <text class="manage-name">{{item.name}}</text>
          <text class="status-badge badge-pending">{{i18n.t("待适配 · 未绑定", locale)}}</text>
        </view>
        <text class="manage-meta">{{i18n.t("SN：" + (item.sn || '未填写') + " · 来源：" + (item.sourceText), locale)}}</text>
        <text class="manage-sync">{{i18n.t("仅本地会话登记，暂无设备读数", locale)}}</text>
      </view>
    </view>
    <view class="manage-actions">
      <button
        wx:if="{{item.sn}}"
        class="action-btn"
        data-id="{{item.id}}"
        bindtap="onConfirmBind"
        hover-class="method-pressed"
      >{{i18n.t("确认绑定", locale)}}</button>
      <button
        wx:else
        class="action-btn ghost"
        data-id="{{item.id}}"
        bindtap="onSupplementSn"
        hover-class="method-pressed"
      >{{i18n.t("补充 SN", locale)}}</button>
      <button class="action-btn danger" data-id="{{item.id}}" bindtap="onRemoveDraft" hover-class="method-pressed">{{i18n.t("移除", locale)}}</button>
    </view>
  </view>

  <button class="search-button add-another" bindtap="onOpenSim" hover-class="search-button-pressed">{{i18n.t("生成模拟数据", locale)}}</button>
  <button class="search-button secondary add-another" bindtap="onAddDevice" hover-class="search-button-pressed">{{i18n.t("添加另一台设备", locale)}}</button>

  <view class="device-preparation-note">
    <text class="preparation-title">{{i18n.t("状态说明", locale)}}</text>
    <text>{{i18n.t("绑定后可查看设备详情、同步演示读数与近 10 次同步流水。待适配设备仅临时登记；「生成模拟数据」会按厂商自动绑定并写入随机血糖（演示用）。", locale)}}</text>
  </view>

  <view wx:if="{{detailVisible}}" class="serial-overlay">
    <view class="serial-mask" bindtap="onCloseDetail"></view>
    <view class="serial-panel" catchtap="noop">
      <view class="serial-heading">
        <text>{{i18n.t("设备详情", locale)}}</text>
        <text class="serial-close ui-interactive" bindtap="onCloseDetail" aria-role="button" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}">{{i18n.t("关闭", locale)}}</text>
      </view>
      <text class="serial-note">{{detail.deviceName}}</text>
      <text class="detail-line">{{i18n.t("序列号：" + (detail.deviceSn), locale)}}</text>
      <text class="detail-line">{{i18n.t("设备来源：" + (detail.providerName), locale)}}</text>
      <text class="detail-line">{{i18n.t("状态：" + (detail.statusText), locale)}}</text>
      <text class="detail-line">{{i18n.t("最近同步：" + (detail.lastSyncDisplay), locale)}}</text>
      <view class="sync-log-toggle" catchtap="onToggleSyncLogs">
        <text>{{i18n.t("同步记录（近 10 次）", locale)}}</text>
        <text wx:if="{{syncLogsExpanded}}" class="sync-log-arrow">{{i18n.t("收起", locale)}}</text>
        <text wx:else class="sync-log-arrow">{{i18n.t("展开", locale)}}</text>
      </view>
      <view wx:if="{{syncLogsExpanded}}" class="sync-log-panel">
        <text wx:if="{{syncLogsLoading}}" class="sync-log-empty">{{i18n.t("加载中…", locale)}}</text>
        <block wx:elif="{{syncLogs.length}}">
          <view wx:for="{{syncLogs}}" wx:key="id" class="sync-log-item">
            <text class="sync-log-time">{{item.syncedAt}}</text>
            <text class="sync-log-meta">{{item.provider}} · {{i18n.t("样本", locale)}} {{item.sampleCount}} · {{i18n.t("新建", locale)}} {{item.createdCount}}</text>
            <text wx:if="{{item.remark}}" class="sync-log-remark">{{item.remark}}</text>
          </view>
        </block>
        <text wx:else class="sync-log-empty">{{i18n.t("暂无同步记录（仅记录本功能上线后的同步）", locale)}}</text>
      </view>
    </view>
  </view>

  <view wx:if="{{snVisible}}" class="serial-overlay">
    <view class="serial-mask" bindtap="onCloseSn"></view>
    <view class="serial-panel" catchtap="noop">
      <view class="serial-heading">
        <text>{{i18n.t("补充 SN", locale)}}</text>
        <text class="serial-close ui-interactive" bindtap="onCloseSn" aria-role="button" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}">{{i18n.t("取消", locale)}}</text>
      </view>
      <text class="serial-note">{{i18n.t("填写机身或包装上的序列号，写入本条待适配记录后即可确认绑定。", locale)}}</text>
      <text class="input-label">{{i18n.t("设备 SN", locale)}} <text class="required-mark">*</text></text>
      <input class="serial-input" value="{{snInput}}" maxlength="64" placeholder="{{i18n.t('请输入设备 SN 码', locale)}}" placeholder-class="serial-placeholder" bindinput="onSnInput" />
      <text wx:if="{{snError}}" class="serial-error">{{i18n.t((snError), locale)}}</text>
      <button class="search-button serial-save ui-interactive" bindtap="onSaveSn" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}">{{i18n.t("保存序列号", locale)}}</button>
    </view>
  </view>

  <view wx:if="{{bindVisible}}" class="serial-overlay">
    <view class="serial-mask" bindtap="onCloseBind"></view>
    <view class="serial-panel" catchtap="noop">
      <view class="serial-heading">
        <text>{{i18n.t("确认绑定", locale)}}</text>
        <text wx:if="{{!binding}}" class="serial-close ui-interactive" bindtap="onCloseBind" aria-role="button" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}">{{i18n.t("取消", locale)}}</text>
      </view>
      <text class="serial-note">{{i18n.t("确认设备来源和序列号后，绑定到当前账号：" + (bindDraft.sn), locale)}}</text>
      <text class="input-label">{{i18n.t("设备名称", locale)}} <text class="optional-label">{{i18n.t("（选填）", locale)}}</text></text>
      <input class="serial-input" value="{{bindName}}" maxlength="40" placeholder="{{i18n.t('例如：我的血糖仪', locale)}}" placeholder-class="serial-placeholder" bindinput="onBindNameInput" disabled="{{binding}}" />
      <text class="input-label">{{i18n.t("设备来源", locale)}} <text class="required-mark">*</text></text>
      <view class="provider-grid">
        <view
          wx:for="{{providers}}"
          wx:key="code"
          class="provider-chip {{bindProvider === item.code ? 'on' : ''}} ui-interactive"
          data-provider="{{item.code}}"
          bindtap="onPickProvider"
         hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}">{{item.name}}</view>
      </view>
      <button class="search-button serial-save ui-interactive" loading="{{binding}}" disabled="{{binding}}" bindtap="onSubmitBind" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}">{{i18n.t("确认绑定到账号", locale)}}</button>
      <text class="serial-footnote">{{i18n.t("绑定成功后可查看详情、刷新状态或解绑", locale)}}</text>
    </view>
  </view>

  <view wx:if="{{simVisible}}" class="serial-overlay">
    <view class="serial-mask" bindtap="onCloseSim"></view>
    <view class="serial-panel" catchtap="noop">
      <view class="serial-heading">
        <text>{{i18n.t("生成模拟数据", locale)}}</text>
        <text wx:if="{{!simCreating}}" class="serial-close ui-interactive" bindtap="onCloseSim" aria-role="button" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}">{{i18n.t("取消", locale)}}</text>
      </view>
      <text class="serial-note">{{i18n.t("将自动绑定一台该厂商模拟设备，并随机生成血糖演示数据写入账号。非真表、非厂家云。", locale)}}</text>
      <text class="input-label">{{i18n.t("厂商", locale)}} <text class="required-mark">*</text></text>
      <view class="provider-grid">
        <view
          wx:for="{{providers}}"
          wx:key="code"
          class="provider-chip {{simProvider === item.code ? 'on' : ''}} ui-interactive"
          data-provider="{{item.code}}"
          bindtap="onPickSimProvider"
          hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}"
        >{{item.name}}</view>
      </view>
      <button class="search-button serial-save ui-interactive" loading="{{simCreating}}" disabled="{{simCreating}}" bindtap="onSubmitSim" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}">{{i18n.t("生成并同步", locale)}}</button>
      <text class="serial-footnote">{{i18n.t("每次生成新 SN，可多次创建多台模拟设备", locale)}}</text>
    </view>
  </view>
</view>
