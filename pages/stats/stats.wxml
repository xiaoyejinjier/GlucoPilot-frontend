<view class="page stats-page" style="{{displayStyle}}">
  <view class="view-nav">
    <view
      class="view-nav-btn {{activeView === 'calendar' ? 'on' : ''}}"
      data-view="calendar"
      bindtap="onSwitchView"
    >
      <text class="view-nav-text">日历视图</text>
    </view>
    <view
      class="view-nav-btn {{activeView === 'glucose' ? 'on' : ''}}"
      data-view="glucose"
      bindtap="onSwitchView"
    >
      <text class="view-nav-text">血糖视图</text>
    </view>
  </view>

  <!-- 顶部月度指标（两视图共用） -->
  <view class="card">
    <view class="section-title">本月指标</view>
    <view class="metric-row">
      <view class="metric-box">
        <text class="metric-val">{{monthRecordDays}}</text>
        <text class="metric-label">打卡天数</text>
      </view>
      <view class="metric-box">
        <text class="metric-val">{{monthTotal}}</text>
        <text class="metric-label">记录次数</text>
      </view>
      <view class="metric-box">
        <text class="metric-val">{{compliance}}%</text>
        <text class="metric-label">达标率</text>
      </view>
    </view>
  </view>

  <view wx:if="{{activeView === 'calendar'}}" class="card">
    <view class="section-title">
      <view class="month-nav">
        <text class="month-btn" bindtap="onPrevMonth">‹</text>
        <text>{{year}} 年 {{month}} 月</text>
        <text class="month-btn" bindtap="onNextMonth">›</text>
      </view>
      <view class="calendar-tools">
        <text class="tool-item {{viewMode === 'month' ? 'on' : ''}}" data-mode="month" bindtap="onViewMode">月</text>
        <text class="tool-item {{viewMode === 'day' ? 'on' : ''}}" data-mode="day" bindtap="onViewMode">日</text>
        <text class="tool-item export" bindtap="onExport">导出</text>
      </view>
    </view>

    <view class="weekdays">
      <text wx:for="{{weekdays}}" wx:key="*this">{{item}}</text>
    </view>

    <view class="calendar">
      <view wx:for="{{calendarDays}}" wx:key="index" class="cal-cell">
        <view
          wx:if="{{item.day}}"
          class="cal-day {{item.level}} {{selectedDay === item.day ? 'selected' : ''}}"
          data-day="{{item.day}}"
          bindtap="onDayTap"
        >
          <text class="cal-num">{{item.day}}</text>
          <text wx:if="{{item.count}}" class="cal-count">{{item.count}}</text>
        </view>
      </view>
    </view>

    <view class="legend">
      <text class="legend-item"><text class="legend-dot c"></text>1–3 次</text>
      <text class="legend-item"><text class="legend-dot b"></text>4–6 次</text>
      <text class="legend-item"><text class="legend-dot a"></text>7 次以上</text>
    </view>
  </view>

  <view wx:if="{{activeView === 'calendar' && selectedDay}}" class="card">
    <view class="section-title">{{month}}月{{selectedDay}}日明细</view>
    <view wx:if="{{dayRecords.length === 0}}" class="empty-tip">当日暂无记录，去 AI 页补记</view>
    <view wx:for="{{dayRecords}}" wx:key="id" class="day-row">
      <text class="day-name">{{item.name}}</text>
      <text class="day-val">{{item.text}}</text>
    </view>
    <view class="actions-row" style="margin-top: 20rpx;">
      <button class="btn-ghost btn-sm" bindtap="onGoAi">去补记</button>
      <button class="btn-primary btn-sm" bindtap="onSwitchToGlucose">血糖趋势</button>
    </view>
  </view>

  <block wx:if="{{activeView === 'glucose'}}">
    <view class="card">
      <view class="section-title">
        <text>血糖一周曲线</text>
        <text class="chart-label">按日均值</text>
      </view>
      <canvas type="2d" id="weekChart" class="chart-canvas"></canvas>
      <view class="legend">
        <text class="legend-item"><text class="legend-dot a"></text>日均血糖（无记录日断开）</text>
      </view>
    </view>

    <view class="card">
      <view class="section-title">本周摘要</view>
      <view class="metric-row">
        <view class="metric-box">
          <text class="metric-val">{{weekAvg}}</text>
          <text class="metric-label">平均血糖</text>
        </view>
        <view class="metric-box">
          <text class="metric-val">{{weekMax}}</text>
          <text class="metric-label">最高值</text>
        </view>
        <view class="metric-box">
          <text class="metric-val">{{weekMin}}</text>
          <text class="metric-label">最低值</text>
        </view>
      </view>
    </view>

    <view class="card">
      <view class="section-title">时段分布</view>
      <view class="dist-row" wx:for="{{slotStats}}" wx:key="name">
        <text class="dist-name">{{item.name}}</text>
        <view class="dist-bar-bg">
          <view class="dist-bar" style="width: {{item.pct}}%;"></view>
        </view>
        <text class="dist-num">{{item.count}}</text>
      </view>
      <view class="actions-row" style="margin-top: 20rpx;">
        <button class="btn-ghost btn-sm" bindtap="onExport">导出</button>
        <button class="btn-primary btn-sm" bindtap="onSwitchToCalendar">看日历</button>
      </view>
    </view>
  </block>
</view>
