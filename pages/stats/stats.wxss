@import "../../utils/glucose-chart.wxss";

/* 视图导航：一排两个按钮铺满 */
.view-nav {
  display: flex;
  flex-direction: row;
  flex-wrap: nowrap;
  margin: 20rpx 20rpx 0;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 8rpx;
  box-shadow: 0 4rpx 16rpx rgba(28, 28, 28, 0.04);
}

.view-nav-btn {
  flex: 1;
  width: 0;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  background: transparent;
}

.view-nav-btn.on {
  background: var(--brand);
}

.view-nav-text {
  font-size: var(--fs-body);
  font-weight: 700;
  color: var(--muted);
  white-space: nowrap;
}

.view-nav-btn.on .view-nav-text {
  color: #ffffff;
}

.month-nav {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-width: 0;
  flex: 1;
}

.month-nav > text:nth-child(2) {
  flex-shrink: 1;
  min-width: 0;
  white-space: nowrap;
}

.month-btn {
  width: 44rpx;
  height: 44rpx;
  border-radius: 12rpx;
  background: var(--line);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-title);
  font-weight: 700;
  color: #444;
  text-align: center;
  line-height: 44rpx;
  flex-shrink: 0;
}

.calendar-tools {
  display: flex;
  flex-direction: row;
  align-items: center;
  flex-shrink: 0;
}

.tool-item {
  padding: 8rpx 14rpx;
  border-radius: 10rpx;
  background: var(--line);
  font-size: var(--fs-small);
  font-weight: 700;
  margin-left: 8rpx;
  color: #444;
  white-space: nowrap;
}

.tool-item.on {
  background: var(--brand);
  color: #fff;
}

.tool-item.export {
  background: #fff4e5;
  color: #a65d00;
}

.weekdays {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 8rpx;
  margin-bottom: 12rpx;
  text-align: center;
  font-size: var(--fs-small);
  color: var(--muted);
  font-weight: 600;
}

.calendar {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 8rpx;
}

.cal-cell {
  aspect-ratio: 1;
}

.cal-day {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #eee;
  font-size: var(--fs-small);
  font-weight: 700;
}

.cal-day.a {
  background: #ddf4ff;
  color: #0550ae;
}

.cal-day.b {
  background: #ffe8c2;
  color: #8a5608;
}

.cal-day.c {
  background: #fad7d2;
  color: #8f2f24;
}

.cal-day.selected {
  outline: 2rpx solid var(--brand);
}

.cal-num {
  line-height: 1.2;
}

.cal-count {
  font-size: 18rpx;
  margin-top: 2rpx;
}

.calendar-tip {
  margin-top: 18rpx;
  color: var(--muted);
  font-size: var(--fs-small);
  text-align: center;
}

.month-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20rpx; margin-top: 24rpx; }
.calendar-heading .month-nav { flex: 1 1 100%; justify-content: space-between; }
.calendar-heading .month-nav > text:nth-child(2) { flex: 1; text-align: center; }
.calendar-heading .calendar-tools { width: 100%; justify-content: flex-end; margin-top: 8rpx; }
.month-tile { min-height: 130rpx; padding: 20rpx 12rpx; box-sizing: border-box; border: 1rpx solid #d1d9e0; border-radius: 18rpx; background: var(--bg); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 12rpx; }
.month-tile.selected { background: var(--brand-soft); border-color: var(--brand); }
.month-tile-title { font-size: var(--fs-title); font-weight: 700; color: var(--ink); }
.month-tile.selected .month-tile-title { color: var(--brand-dark); }
.month-tile-hint { font-size: var(--fs-small); color: var(--muted); }
.day-detail-nav { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin: 20rpx 0 24rpx; }
.day-detail-date { flex: 1; min-width: 0; text-align: center; font-size: var(--fs-body); font-weight: 700; line-height: 1.5; color: var(--ink); }
.day-detail-metrics { margin-bottom: 24rpx; }
.calendar-retry { margin: 20rpx auto 0 !important; }

.day-date-nav > text:nth-child(2) {
  text-align: center;
}

.legend {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 20rpx;
  font-size: var(--fs-small);
  color: var(--muted);
}

.legend-item {
  display: flex;
  align-items: center;
}

.legend-dot {
  display: inline-block;
  width: 16rpx;
  height: 16rpx;
  border-radius: 4rpx;
  margin-right: 8rpx;
}

.legend-dot.a {
  background: #ddf4ff;
  border: 1rpx solid #b6d7fb;
}

.legend-dot.b {
  background: #ffe8c2;
  border: 1rpx solid #e8c07a;
}

.legend-dot.c {
  background: #fad7d2;
  border: 1rpx solid #e3a79e;
}

.legend-dot.pred {
  background: #576b95;
}

.empty-tip {
  font-size: var(--fs-small);
  color: var(--muted);
  text-align: center;
  padding: 16rpx 0;
}

.day-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #e8ecf0;
  min-width: 0;
}

.day-row:last-child {
  border-bottom: none;
}

.day-name-wrap {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 210rpx;
}

.day-status-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #818b98;
  flex-shrink: 0;
}

.day-row.recorded .day-status-dot {
  background: var(--brand);
  box-shadow: 0 0 0 6rpx var(--brand-soft);
}

.day-kind {
  padding: 3rpx 10rpx;
  border-radius: 999rpx;
  background: #edf4fa;
  color: var(--brand-dark);
  font-size: 18rpx;
  white-space: nowrap;
}

.day-row-meal .day-kind {
  background: #fff4e5;
  color: #a65d00;
}

.day-row.missing .day-val {
  color: #818b98;
}

.day-name {
  font-size: var(--fs-body);
  font-weight: 700;
  color: var(--ink);
  flex-shrink: 0;
}

.day-val {
  display: block;
  font-size: var(--fs-small);
  color: var(--muted);
  text-align: right;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.day-value-wrap { flex: 1; min-width: 0; text-align: right; }
.meal-detail-toggle { display: block; margin-top: 8rpx; color: var(--brand-dark); font-size: var(--fs-small); font-weight: 700; }
.meal-clickable { min-height: 80rpx; }
.meal-detail-panel { margin: 12rpx 0 24rpx; padding: 24rpx; border-radius: 16rpx; background: #f6f8fa; border: 1rpx solid #d1d9e0; }
.meal-detail-heading { margin-bottom: 24rpx; color: var(--ink); font-size: var(--fs-body); font-weight: 700; line-height: 1.6; }
.meal-detail-label { display: block; margin-top: 20rpx; margin-bottom: 10rpx; color: var(--muted); font-size: var(--fs-small); }
.meal-detail-full-text { display: block; color: var(--ink); font-size: var(--fs-body); line-height: 1.8; white-space: pre-wrap; word-break: break-all; }
.meal-food-list { margin-top: 24rpx; }
.meal-food-item { padding: 20rpx 0; border-bottom: 1rpx solid #d1d9e0; }
.meal-food-heading { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 12rpx; }
.meal-food-name { min-width: 0; color: var(--ink); font-size: var(--fs-body); font-weight: 600; line-height: 1.6; word-break: break-all; }
.meal-food-weight { color: var(--muted); font-size: var(--fs-small); }
.meal-food-nutrients { display: block; margin-top: 8rpx; color: var(--muted); font-size: var(--fs-small); line-height: 1.8; }
.meal-detail-meta { display: flex; flex-direction: column; gap: 12rpx; margin-top: 24rpx; color: var(--ink); font-size: var(--fs-small); line-height: 1.8; }
.meal-detail-meta > text { word-break: break-all; }
.meal-photo-wrap { margin-top: 24rpx; }
.meal-detail-photo { display: block; width: 100%; height: 280rpx; border-radius: 12rpx; }
.meal-photo-tip { display: block; margin-top: 12rpx; text-align: center; color: var(--brand-dark); font-size: var(--fs-small); }

.chart-canvas {
  display: block;
  width: 100%;
  max-width: 100%;
  min-width: 0;
  height: 280rpx;
  box-sizing: border-box;
}

.chart-label {
  font-size: var(--fs-small);
  color: var(--brand);
  font-weight: 600;
}

.week-selector {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  margin: 8rpx 0 20rpx;
  background: var(--brand-soft);
  border: 1rpx solid #b6d7fb;
  border-radius: 16rpx;
}

.week-selector-main { flex: 1; min-width: 0; }
.week-selector-title { display: block; font-size: var(--fs-body); font-weight: 700; color: var(--brand-dark); line-height: 1.5; }
.week-selector-hint { display: block; margin-top: 6rpx; font-size: var(--fs-small); color: var(--muted); }
.week-selector-arrow { flex-shrink: 0; font-size: 36rpx; color: var(--brand-dark); }
.week-chart-status { min-height: 240rpx; display: flex; align-items: center; justify-content: center; flex-direction: column; gap: 20rpx; }
.week-retry { margin: 0 !important; }

.week-picker-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 1000;
  background: rgba(0, 0, 0, 0.4);
  display: flex;
  align-items: flex-end;
}

.week-picker-sheet {
  width: 100%;
  box-sizing: border-box;
  max-height: 90vh;
  padding: 32rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
  border-radius: 28rpx 28rpx 0 0;
  background: #fff;
}

.week-picker-close { color: var(--muted); font-size: var(--fs-small); padding: 8rpx 12rpx; }
.week-picker-month-nav { display: flex; align-items: center; gap: 16rpx; padding: 16rpx 0; }
.week-picker-month { flex: 1; min-width: 0; text-align: center; font-size: var(--fs-body); font-weight: 700; color: var(--ink); }
.week-picker-month-hint { margin-left: 8rpx; color: var(--muted); }
.week-picker-tip { display: block; margin: 12rpx 0; font-size: var(--fs-small); color: var(--muted); line-height: 1.5; }
.week-picker-options { height: 42vh; }
.week-picker-option { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; min-height: 84rpx; box-sizing: border-box; padding: 20rpx; margin-bottom: 12rpx; border: 1rpx solid #e5e7eb; border-radius: 14rpx; color: var(--ink); font-size: var(--fs-body); line-height: 1.5; }
.week-picker-option.selected { border-color: var(--brand); background: var(--brand-soft); color: var(--brand-dark); font-weight: 700; }
.week-picker-check { flex-shrink: 0; color: var(--brand-dark); font-size: var(--fs-small); }
.week-follow-button { margin-top: 16rpx; }

.metric-row {
  display: flex;
  flex-direction: row;
}

.metric-box {
  flex: 1;
  width: 0;
  margin-right: 12rpx;
  background: #f6f8fa;
  border: 1rpx solid var(--line);
  border-radius: 16rpx;
  padding: 20rpx 8rpx;
  text-align: center;
}

.metric-box:last-child {
  margin-right: 0;
}

.metric-val {
  display: block;
  font-size: var(--fs-metric);
  font-weight: 800;
  color: var(--brand-dark);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.metric-label {
  display: block;
  margin-top: 8rpx;
  font-size: var(--fs-small);
  color: var(--muted);
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dist-row {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
  min-width: 0;
}

.dist-name {
  width: 100rpx;
  font-size: var(--fs-small);
  color: #444;
  flex-shrink: 0;
}

.dist-bar-bg {
  flex: 1;
  min-width: 0;
  height: 16rpx;
  background: var(--line);
  border-radius: 999rpx;
  overflow: hidden;
  margin: 0 12rpx;
}

.dist-bar {
  height: 100%;
  background: var(--brand);
  border-radius: 999rpx;
}

.dist-num {
  width: 48rpx;
  text-align: right;
  font-size: var(--fs-small);
  font-weight: 700;
  color: var(--ink);
}
