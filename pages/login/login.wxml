<wxs module="i18n" src="/utils/i18n.wxs" />
<view class="login-screen" style="{{displayStyle}}">
  <view class="login-hero">
    <view class="login-logo">{{i18n.t("糖", locale)}}</view>
    <text class="login-title">{{i18n.t("AI 控糖助手", locale)}}</text>
    <text class="login-desc">{{i18n.t("记录 · 分析 · 建议 · 追踪", locale)}}</text>
  </view>
  <view class="login-panel">
    <button class="btn-primary btn-block ui-interactive" bindtap="onWechatLogin" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}">{{i18n.t("微信一键登录", locale)}}</button>
    <button class="btn-ghost btn-block ui-interactive" bindtap="onPhoneLogin" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}">{{i18n.t("手机号登录", locale)}}</button>
    <button class="btn-ghost btn-block ui-interactive" bindtap="onEmailLogin" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}">{{i18n.t("邮箱登录", locale)}}</button>
    <text class="login-agree">{{i18n.t("登录即表示同意《用户协议》《隐私政策》《免责声明》", locale)}}</text>
  </view>

  <view class="phone-mask" wx:if="{{phonePanel}}" bindtap="onClosePhonePanel"></view>
  <view class="phone-panel" wx:if="{{phonePanel}}">
    <text class="phone-title">{{i18n.t("手机号登录", locale)}}</text>
    <input class="phone-input" type="number" maxlength="11" placeholder="{{i18n.t('手机号', locale)}}" value="{{phone}}" bindinput="onPhoneInput" />
    <view class="sms-row">
      <input class="phone-input sms-input" type="number" maxlength="6" placeholder="{{i18n.t('验证码', locale)}}" value="{{smsCode}}" bindinput="onSmsInput" />
      <button class="btn-ghost sms-btn ui-interactive" size="mini" disabled="{{smsCooldown > 0}}" bindtap="onSendSms" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}">
        {{i18n.t((smsCooldown > 0 ? smsCooldown + 's' : '获取验证码'), locale)}}
      </button>
    </view>
    <button class="btn-primary btn-block ui-interactive" bindtap="onConfirmPhoneLogin" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}">{{i18n.t("登录", locale)}}</button>
    <button class="btn-ghost btn-block btn-sm ui-interactive" bindtap="onClosePhonePanel" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}">{{i18n.t("取消", locale)}}</button>
  </view>

  <view class="phone-mask" wx:if="{{emailPanel}}" bindtap="onCloseEmailPanel"></view>
  <view class="phone-panel" wx:if="{{emailPanel}}">
    <text class="phone-title">{{i18n.t("邮箱登录", locale)}}</text>
    <input class="phone-input" type="text" maxlength="128" placeholder="{{i18n.t('邮箱', locale)}}" value="{{email}}" bindinput="onEmailInput" />
    <view class="sms-row">
      <input class="phone-input sms-input" type="number" maxlength="6" placeholder="{{i18n.t('验证码', locale)}}" value="{{emailCode}}" bindinput="onEmailCodeInput" />
      <button class="btn-ghost sms-btn ui-interactive" size="mini" disabled="{{emailCooldown > 0}}" bindtap="onSendEmailCode" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}">
        {{i18n.t((emailCooldown > 0 ? emailCooldown + 's' : '获取验证码'), locale)}}
      </button>
    </view>
    <button class="btn-primary btn-block ui-interactive" bindtap="onConfirmEmailLogin" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}">{{i18n.t("登录", locale)}}</button>
    <button class="btn-ghost btn-block btn-sm ui-interactive" bindtap="onCloseEmailPanel" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}">{{i18n.t("取消", locale)}}</button>
  </view>
</view>
