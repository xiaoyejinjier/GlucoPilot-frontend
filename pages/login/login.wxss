.login-screen{min-height:100vh;display:flex;flex-direction:column;background:var(--bg);padding-top:32rpx;padding-bottom:env(safe-area-inset-bottom)}
.login-hero{position:relative;overflow:hidden;display:flex;flex-direction:column;flex:none;min-height:0;padding:var(--login-header-space,calc(env(safe-area-inset-top) + 112rpx)) 48rpx 94rpx;background:#e9f1fc;border-radius:0 0 60rpx 60rpx;color:var(--navy)}
.login-brand{display:flex;align-items:center;gap:14rpx;max-width:66%;font-size:26rpx;font-weight:700;letter-spacing:1rpx}
.login-logo{width:54rpx;height:54rpx;flex:none;display:flex;align-items:center;justify-content:center;border-radius:17rpx;background:var(--navy);color:#fff;font-size:30rpx;font-weight:700}
.login-intro{margin-top:0;padding-top:36rpx}
.login-title{display:block;font-size:var(--fs-hero);font-weight:750;line-height:1.35;letter-spacing:1rpx}
.login-desc{display:block;margin-top:14rpx;font-size:var(--fs-body);color:#536f96;line-height:1.65}
.login-illustration{position:relative;flex:none;min-height:206rpx;margin:26rpx 0 18rpx;display:flex;align-items:center;justify-content:center}
.login-orbit{position:absolute;width:380rpx;height:150rpx;border:1rpx solid #c5d7ed;border-radius:50%;transform:rotate(-14deg)}
.login-journal{position:relative;width:370rpx;height:190rpx;padding:24rpx 30rpx;border:1rpx solid #cfdeee;border-radius:28rpx;background:#fff;box-shadow:0 16rpx 36rpx rgba(30,69,114,.07);transform:rotate(-4deg)}
.journal-heading{display:flex;align-items:center;gap:12rpx;height:20rpx}
.journal-mark{width:16rpx;height:16rpx;flex:none;border:4rpx solid #6396d4;border-radius:5rpx}
.journal-line{height:7rpx;width:90rpx;border-radius:5rpx;background:#d6e3f3}
.journal-dot{margin-left:auto;width:7rpx;height:7rpx;background:#8fa9c9;border-radius:50%}
.journal-chart{position:relative;height:85rpx;margin-top:12rpx}
.chart-guide{position:absolute;left:0;right:0;height:1rpx;background:#edf2f8}
.guide-one{top:24rpx}.guide-two{top:60rpx}
.journal-curve{position:relative;width:100%;height:85rpx}
.journal-bars{display:flex;gap:12rpx;margin-top:12rpx}
.journal-bars view{height:7rpx;width:46rpx;background:#dce8f5;border-radius:5rpx}
.journal-bars view:nth-child(2){width:70rpx;background:#c4d9f0}
.login-check{position:absolute;right:calc(50% - 220rpx);top:calc(50% + 22rpx);width:66rpx;height:66rpx;display:flex;align-items:center;justify-content:center;border:6rpx solid #e9f1fc;border-radius:22rpx;background:var(--navy)}
.login-check view{width:23rpx;height:13rpx;border-left:3rpx solid #fff;border-bottom:3rpx solid #fff;transform:translateY(-3rpx) rotate(-45deg)}
.login-features{display:block;margin-top:0;padding-top:18rpx;text-align:center;font-size:var(--fs-small);color:#536f96;letter-spacing:3rpx;line-height:1.6}
.login-panel{position:relative;flex:none;margin:-34rpx 32rpx 0;padding:28rpx 32rpx 46rpx;background:#fff;border:1rpx solid var(--line);border-radius:32rpx;box-shadow:0 14rpx 36rpx rgba(30,69,114,.04)}
.login-panel-title{display:block;font-size:var(--fs-title);font-weight:700;color:var(--navy);line-height:1.5}
.login-panel-desc{display:block;margin-top:6rpx;color:var(--muted);font-size:var(--fs-small);line-height:1.6}
.login-wechat{margin-top:56rpx;background:var(--navy);border:1rpx solid transparent;border-radius:20rpx}
.login-alternatives{display:flex;flex-direction:column;gap:42rpx;margin-top:42rpx}
.login-alternatives button{border:1rpx solid #cfdef1;border-radius:20rpx;background:#f0f5fc;color:#305c94}
.login-alternatives button:first-child{background:#fff}
.login-panel button{display:flex;align-items:center;justify-content:space-between;gap:18rpx;width:100%;min-width:0;min-height:88rpx;padding:20rpx 26rpx;font-size:var(--fs-body);font-weight:700;line-height:1.5;text-align:left}
.login-panel button>text:not(.login-button-arrow){flex:1;min-width:0}
.login-button-icon{position:relative;display:block;width:32rpx;height:32rpx;flex:none;color:currentColor}
.login-button-arrow{flex:none;font-size:32rpx;line-height:1;opacity:.65}
.phone-icon{width:25rpx;height:34rpx;border:2rpx solid currentColor;border-radius:6rpx;margin:0 4rpx 0 3rpx}
.phone-icon::after{content:'';position:absolute;left:6rpx;right:6rpx;bottom:4rpx;height:2rpx;background:currentColor;border-radius:2rpx}
.email-icon{height:25rpx;border:2rpx solid currentColor;border-radius:5rpx;margin:4rpx 0 3rpx}
.email-icon::after{content:'';position:absolute;left:5rpx;top:-4rpx;width:17rpx;height:17rpx;border-right:2rpx solid currentColor;border-bottom:2rpx solid currentColor;transform:rotate(45deg);border-radius:2rpx}
.wechat-icon>view{position:absolute;left:0;top:2rpx;width:25rpx;height:21rpx;border:2rpx solid currentColor;border-radius:50%}
.wechat-icon>view:last-child{left:11rpx;top:14rpx;width:21rpx;height:17rpx;background:var(--navy)}
.login-agree{display:block;margin-top:68rpx;color:var(--hint);font-size:var(--fs-tiny);text-align:left;line-height:1.8;overflow-wrap:anywhere}
.login-footer{display:flex;flex:none;align-items:center;justify-content:center;gap:18rpx;padding:26rpx 32rpx 32rpx;color:var(--muted);font-size:var(--fs-tiny);line-height:1.6;text-align:center}
.login-footer>view{height:1rpx;width:32rpx;background:#cddbeb;flex:none}
.phone-mask{position:fixed;inset:0;background:rgba(19,42,72,.38);z-index:20}
.phone-panel{position:fixed;left:32rpx;right:32rpx;top:50%;transform:translateY(-50%);max-height:calc(100vh - 144rpx - env(safe-area-inset-top) - env(safe-area-inset-bottom));overflow-y:auto;z-index:21;background:#fff;border:1rpx solid var(--line);border-radius:32rpx;padding:36rpx 28rpx;display:flex;flex-direction:column;gap:22rpx;box-shadow:0 24rpx 64rpx rgba(24,59,104,.14)}
.phone-title{font-size:var(--fs-title);font-weight:700;color:var(--navy);line-height:1.5;margin-bottom:6rpx}
.phone-input{height:92rpx;min-height:92rpx;flex-shrink:0;border:1rpx solid #d5e2f1;border-radius:18rpx;padding:0 22rpx;font-size:var(--fs-body);background:#f4f7fc;color:var(--ink)}
.sms-row{display:flex;align-items:center;gap:14rpx;flex-shrink:0}
.sms-input{flex:1;width:0;min-width:0}
.sms-btn{flex:none;margin:0;padding:0 20rpx;height:92rpx;line-height:1.5;max-width:48%;font-size:var(--fs-small)}
.phone-panel .btn-primary{background:var(--navy);flex-shrink:0}
.phone-panel .btn-ghost{flex-shrink:0}
@media(max-height:740px){.login-screen{padding-top:16rpx}.login-hero{padding-bottom:68rpx}.login-intro{padding-top:28rpx}.login-illustration{min-height:158rpx;margin:20rpx 0 14rpx}.login-journal{height:158rpx;padding:18rpx 26rpx}.journal-chart,.journal-curve{height:68rpx}.journal-bars{margin-top:6rpx}.login-panel{padding-top:42rpx;padding-bottom:36rpx}.login-wechat{margin-top:32rpx}.login-alternatives{gap:18rpx;margin-top:18rpx}.login-footer{padding-top:24rpx;padding-bottom:28rpx}}
