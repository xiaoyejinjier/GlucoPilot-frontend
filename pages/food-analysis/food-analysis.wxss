/* 页面底部预留固定保存条 + 底部导航 */
.food-page {
  padding-bottom: calc(var(--tab-bar-h) + env(safe-area-inset-bottom) + 220rpx);
}

.photo-meal,
.photo-meal-img {
  height: 320rpx;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
}

.photo-meal-img {
  width: 100%;
  display: block;
  background: var(--line);
}

.photo-meal {
  background: linear-gradient(160deg, #fff6e8, #e8f5ef);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-body);
  font-weight: 700;
  color: #456;
  border: 1rpx dashed #c5d0c8;
}

/* 卡片头与主卡摘要 */
.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.card-head .section-title {
  flex: 1;
  min-width: 0;
  margin: 0;
}

.meal-hero-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.meal-hero-title {
  font-size: var(--fs-body);
  font-weight: 800;
}

.meal-hero-chip {
  flex-shrink: 0;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: var(--brand-soft);
  color: var(--brand-dark);
  font-size: var(--fs-tiny);
  font-weight: 700;
}

.meal-hero-foods {
  display: block;
  margin-top: 8rpx;
  color: var(--muted);
  font-size: var(--fs-small);
  line-height: 1.5;
}

/* 识别状态与食物列表通用 */
.recognition-summary,
.recognition-tip,
.recognition-warning,
.meal-nutrition {
  display: block;
  font-size: var(--fs-small);
  line-height: 1.6;
}

.recognition-summary { margin-bottom: 8rpx; color: var(--brand-dark); }
.recognition-tip { color: var(--muted); margin: 12rpx 0; }
.recognition-warning { color: #9a5a12; margin-top: 12rpx; }
.recognition-error { border: 1rpx solid #e9b9b9; }
.meal-actions { display: flex; gap: 16rpx; margin-top: 20rpx; }

/* 食物分析卡 */
.analysis-chip {
  flex-shrink: 0;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: #f1f4f2;
  color: var(--muted);
  font-size: var(--fs-tiny);
  font-weight: 600;
}

.meal-verdict {
  padding: 18rpx 20rpx;
  margin-bottom: 16rpx;
  border-radius: 16rpx;
  border-left: 8rpx solid #c9d3ce;
  background: #f4f7f5;
}

.meal-verdict.verdict-LOW { background: #e8f6ec; border-left-color: #1e7d3c; }
.meal-verdict.verdict-MODERATE { background: #fff4e0; border-left-color: #d68a00; }
.meal-verdict.verdict-HIGH { background: #fdeceb; border-left-color: #c0392b; }
.meal-verdict.verdict-UNKNOWN { background: #f1f3f2; border-left-color: #9aa7a2; }

.mv-tier {
  display: block;
  font-size: var(--fs-body);
  font-weight: 800;
  color: #2f3a36;
}

.verdict-LOW .mv-tier { color: #1e7d3c; }
.verdict-MODERATE .mv-tier { color: #9a6200; }
.verdict-HIGH .mv-tier { color: #a52a22; }
.verdict-UNKNOWN .mv-tier { color: #6b7a76; }

.mv-sub {
  display: block;
  margin-top: 6rpx;
  color: #4a5b57;
  font-size: var(--fs-small);
  line-height: 1.5;
}

.rate-sum {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.rate-chip {
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: #f3f5f4;
  color: #4a5b57;
  font-size: var(--fs-small);
  font-weight: 600;
  border: 1rpx solid transparent;
}

.rate-chip.low { background: #e8f6ec; color: #1e7d3c; }
.rate-chip.moderate { background: #fff4e0; color: #9a6200; }
.rate-chip.high { background: #fdeceb; color: #a52a22; }
.rate-chip.unknown { background: #f1f3f2; color: #6b7a76; }
.rate-chip.active { border-color: currentColor; }

.carb-line {
  display: block;
  margin-bottom: 8rpx;
  color: #2f3a36;
  font-size: var(--fs-small);
  font-weight: 600;
}

.carb-note { color: var(--muted); font-weight: 500; }

.advice-panel { border-top: 1rpx dashed #e4eae7; }

.advice-head-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  padding: 14rpx 0;
}

.advice-title {
  display: flex;
  align-items: center;
  gap: 10rpx;
  color: #2f3a36;
  font-size: var(--fs-small);
  font-weight: 700;
}

.at-chev { color: var(--muted); font-weight: 500; }
.at-reset { color: var(--brand-dark); font-size: var(--fs-small); font-weight: 600; }
.advice-body { padding-bottom: 8rpx; }

.advice-row {
  padding: 12rpx 0;
  border-bottom: 1rpx dashed #eef1f0;
}

.advice-row:last-child { border-bottom: none; }

.advice-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.advice-name { font-size: var(--fs-small); font-weight: 700; }

.advice-text {
  display: block;
  margin-top: 4rpx;
  color: #4a5b57;
  font-size: var(--fs-small);
  line-height: 1.5;
}

.basis { border-top: 1rpx dashed #e4eae7; }
.basis-body { padding-bottom: 8rpx; }
.analysis-item-tier { font-size: var(--fs-small); font-weight: 600; flex-shrink: 0; }
.analysis-item-tier.tier-LOW { color: #1e7d3c; }
.analysis-item-tier.tier-MODERATE { color: #9a6200; }
.analysis-item-tier.tier-HIGH { color: #a52a22; }
.analysis-item-tier.tier-UNKNOWN { color: #6b7a76; }
.analysis-rule { display: block; margin-top: 6rpx; font-size: var(--fs-small); color: var(--muted); }
.analysis-disclaimer { display: block; margin-top: 6rpx; font-size: var(--fs-small); color: var(--muted); line-height: 1.5; }

/* 识别的食物与营养 */
.head-actions { display: flex; align-items: center; gap: 12rpx; flex-shrink: 0; }

.icon-btn {
  min-width: 56rpx;
  height: 56rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f1f4f2;
  color: #2f3a36;
  font-size: var(--fs-body);
  font-weight: 800;
  box-sizing: border-box;
}

.icon-btn.on { background: var(--brand); color: #fff; }
.icon-btn.on.danger { background: #c0392b; }
.cancel-link { color: var(--muted); font-size: var(--fs-small); font-weight: 600; }

.meal-food-item {
  margin-top: 16rpx;
  padding: 16rpx 18rpx;
  background: #f7f9f8;
  border: 1rpx solid #edf1ef;
  border-radius: 14rpx;
}

.meal-food-head {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 6rpx;
}

.meal-food-name { flex: 1; min-width: 0; font-weight: 700; font-size: var(--fs-body); }

.nutrition-source {
  flex-shrink: 0;
  padding: 2rpx 10rpx;
  border-radius: 999rpx;
  background: #e8f2ec;
  color: #26794d;
  font-size: var(--fs-tiny);
}

.nutrition-source.estimated { background: #fff1dc; color: #a05b0b; }
.del-btn { flex-shrink: 0; color: #c0392b; font-size: var(--fs-small); font-weight: 700; }

.meal-weight { display: flex; align-items: center; gap: 16rpx; margin: 16rpx 0; font-size: var(--fs-small); }
.meal-weight input { flex: 1; height: 72rpx; line-height: 70rpx; padding: 0 16rpx; box-sizing: border-box; background: #fff; border: 1rpx solid #d8e0dc; border-radius: 10rpx; }
.meal-weight text { flex-shrink: 0; }
.weight-unit { color: var(--muted); font-size: var(--fs-small); }

.portion-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
  margin: 6rpx 0 4rpx;
}

.portion-label { color: var(--muted); font-size: var(--fs-small); }

.step-btn {
  width: 52rpx;
  height: 52rpx;
  line-height: 50rpx;
  text-align: center;
  border-radius: 999rpx;
  background: #fff;
  border: 1rpx solid #cfdad4;
  color: #2f3a36;
  font-size: var(--fs-body);
  font-weight: 700;
  box-sizing: border-box;
}

.step-btn.disabled { color: #b6c0bb; background: #f4f6f5; }

.portion-num {
  min-width: 88rpx;
  text-align: center;
  color: #2f3a36;
  font-size: var(--fs-small);
  font-weight: 700;
}

.portion-weight-input {
  width: 130rpx;
  height: 52rpx;
  line-height: 50rpx;
  padding: 0 10rpx;
  background: #fff;
  border: 1rpx solid #cfdad4;
  border-radius: 8rpx;
  font-size: var(--fs-small);
  text-align: center;
  box-sizing: border-box;
}

.portion-gram { color: var(--brand-dark); font-size: var(--fs-small); }
.portion-hint { display: block; margin-top: 4rpx; color: #9a6200; font-size: var(--fs-tiny); }

.food-nut { display: block; margin-top: 6rpx; color: #4a5b57; font-size: var(--fs-small); }
.nutrition-unknown { color: var(--muted); }

.food-links { display: flex; justify-content: flex-end; gap: 20rpx; margin-top: 6rpx; }
.food-action { color: var(--brand-dark); font-size: var(--fs-small); font-weight: 600; }

.food-list-toggle {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  margin-top: 16rpx;
  padding: 12rpx 0;
  color: #7b8a80;
  font-size: var(--fs-small);
  font-weight: 600;
}

.food-list-toggle-arrow { color: #7b8a80; font-size: var(--fs-body); line-height: 1; }

/* 低置信逐项确认 */
.meal-food-item.low-confidence { background: #fff8e6; border: 1rpx solid #f0c56b; }
.meal-food-item.low-confidence-confirmed { background: #fbfdfb; border: 1rpx solid #d8e0dc; }
.low-confidence-row { display: flex; align-items: center; gap: 8rpx; margin: 8rpx 0; }
.low-confidence-text { color: #8a5a00; font-size: var(--fs-small); }
.confirm-summary { display: block; margin-top: 8rpx; color: #8a5a00; font-size: var(--fs-small); font-weight: 600; }
.save-error { display: block; margin-top: 12rpx; color: var(--danger); font-size: var(--fs-small); line-height: 1.5; }

/* 本餐血糖时间线（只读） */
.glucose-readonly { font-size: var(--fs-small); color: var(--muted); }

.glucose-timeline {
  position: relative;
  display: flex;
  gap: 16rpx;
  padding: 8rpx 0 4rpx;
}

.glucose-track {
  position: absolute;
  left: 25%;
  right: 25%;
  top: 16rpx;
  height: 2rpx;
  background: #dfe7e2;
}

.glucose-node {
  position: relative;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.glucose-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #fff;
  border: 3rpx solid #c2cec8;
  box-sizing: border-box;
  z-index: 1;
}

.glucose-node.done .glucose-dot { background: var(--brand); border-color: var(--brand); }
.glucose-node-label { font-size: var(--fs-tiny); color: var(--muted); }
.glucose-node-value { font-size: var(--fs-metric); font-weight: 800; line-height: 1.1; }
.glucose-node-unit { margin-top: -2rpx; font-size: var(--fs-tiny); color: var(--muted); }
.glucose-node-time { font-size: var(--fs-tiny); color: var(--muted); }
.glucose-node-empty { color: var(--muted); font-size: var(--fs-small); }
.glucose-node-link { margin-top: 4rpx; color: var(--brand-dark); font-size: var(--fs-small); font-weight: 600; }

.glu-foot {
  display: block;
  margin-top: 16rpx;
  padding-top: 12rpx;
  border-top: 1rpx dashed #e4eae7;
  color: var(--muted);
  font-size: var(--fs-small);
  line-height: 1.5;
}

.glu-foot.center { text-align: center; color: #2f3a36; }
.delta-num { font-weight: 800; color: var(--brand-dark); }

/* 餐食备注 */
.voice-head { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-bottom: 12rpx; }
.voice-head .section-title { margin: 0; }
.voice-trigger {
  flex-shrink: 0;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background: var(--brand-soft);
  color: var(--brand-dark);
  font-size: var(--fs-small);
  font-weight: 600;
}

.voice-input {
  width: 100%;
  min-height: 120rpx;
  padding: 16rpx;
  border: none;
  border-radius: 12rpx;
  background: #f7f9f8;
  font-size: var(--fs-body);
  box-sizing: border-box;
}

/* 底部固定保存条 */
.save-bar {
  position: fixed;
  left: 0;
  right: 0;
  z-index: 50;
  bottom: calc(var(--tab-bar-h) + env(safe-area-inset-bottom));
  padding: 14rpx 24rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.9), #fff 45%);
  border-top: 1rpx solid #eef1ef;
}

.save-bar .btn-primary[disabled] {
  background: #b9c9c1;
  color: #f7faf8;
  opacity: 1;
}

.save-bar .confirm-summary,
.save-bar .recognition-tip { margin-top: 8rpx; }

/* 添加食物弹层 */
.sheet-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 10020;
  display: flex;
  align-items: flex-end;
  background: rgba(20, 30, 26, 0.45);
}

.sheet {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 28rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
  border-radius: 24rpx 24rpx 0 0;
  background: #fff;
  box-sizing: border-box;
}

.sheet-title { font-size: var(--fs-body); font-weight: 800; }
.sheet .btn-block { margin: 0; }
.sheet-form .meal-weight input { flex: 1; width: auto; }
