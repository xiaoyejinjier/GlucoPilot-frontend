.photo-meal,
.photo-meal-img {
  height: 180rpx;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
}

.recognition-summary, .recognition-tip, .recognition-warning, .meal-nutrition { display: block; font-size: var(--fs-small); line-height: 1.6; }
.recognition-summary { margin-bottom: 12rpx; color: var(--brand-dark); }
.recognition-tip { color: var(--muted); margin: 12rpx 0; }
.recognition-warning { color: #9a5a12; margin-top: 12rpx; }
.recognition-error { border: 1rpx solid #e9b9b9; }
.meal-actions { display: flex; gap: 16rpx; margin-top: 20rpx; }
.meal-food-item { margin-top: 20rpx; padding: 20rpx; background: #f4f7f5; border-radius: 16rpx; }
.meal-food-head { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; margin-bottom: 10rpx; }
.meal-food-name { font-weight: 700; font-size: var(--fs-body); }
.nutrition-source { font-size: var(--fs-small); color: #26794d; flex-shrink: 0; }
.nutrition-source.estimated { color: #a05b0b; }
.meal-weight { display: flex; align-items: center; gap: 16rpx; margin: 16rpx 0; font-size: var(--fs-small); }
.meal-weight input { flex: 1; height: 72rpx; line-height: 70rpx; padding: 0 16rpx; box-sizing: border-box; background: #fff; border: 1rpx solid #d8e0dc; border-radius: 10rpx; }
.meal-food-item .meal-weight input { flex: none; width: 160rpx; }
.meal-weight text { flex-shrink: 0; }
.food-suggest-group { flex: 1; min-width: 0; display: flex; align-items: center; }
.food-suggest-arrow { flex-shrink: 0; width: 56rpx; margin-left: 24rpx; text-align: center; font-size: var(--fs-body); line-height: 1; }
.arrow-good { color: #2e7d5b; }
.arrow-bad { color: var(--danger); }
.arrow-neutral { color: #333; }
.food-suggest-value { color: #2e7d5b; font-size: var(--fs-small); font-weight: 600; white-space: nowrap; }
.food-suggest-muted { font-size: var(--fs-small); white-space: nowrap; }
.muted-bad { color: var(--danger); }
.muted-neutral { color: #333; }
.predict-card { border: 1rpx solid #cce1d4; }
.predict-compare { display: flex; align-items: stretch; margin: 24rpx 0 8rpx; }
.predict-col { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.predict-divider { flex-shrink: 0; width: 1rpx; background: #d8e6dd; margin: 0 24rpx; }
.predict-col-title { color: #526358; font-size: var(--fs-small); font-weight: 600; }
.predict-value-row { display: flex; align-items: baseline; flex-wrap: wrap; gap: 8rpx; margin-top: 16rpx; }
.predict-value { color: var(--brand-dark); font-size: 64rpx; line-height: 1.2; font-weight: 800; }
.predict-unit { color: #526358; font-size: var(--fs-small); }
.predict-col-label { display: block; margin-top: 8rpx; color: var(--brand-dark); font-size: var(--fs-small); font-weight: 600; }
.predict-carbs { display: block; margin-top: 12rpx; color: var(--muted); font-size: var(--fs-small); }
.glucose-entry-card { border: 1rpx solid #cce1d4; background: #f7faf8; }
.glucose-entry-head { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.glucose-entry-head .section-title { margin: 0; }
.glucose-entry-link { display: flex; align-items: center; gap: 4rpx; padding: 8rpx 0 8rpx 16rpx; color: var(--brand-dark); font-size: var(--fs-small); font-weight: 600; }
.glucose-entry-arrow { color: var(--brand-dark); font-size: var(--fs-body); line-height: 1; }
.glucose-entry-row { margin: 20rpx 0; }
.glucose-entry-card .btn-block { margin-top: 4rpx; }
.food-list-toggle { display: flex; align-items: center; justify-content: center; gap: 6rpx; margin-top: 16rpx; padding: 12rpx 0; color: #7b8a80; font-size: var(--fs-small); font-weight: 600; }
.food-list-toggle-arrow { color: #7b8a80; font-size: var(--fs-body); line-height: 1; }

.photo-meal-img {
  width: 100%;
  display: block;
  background: var(--line);
}

.photo-meal {
  background: linear-gradient(160deg, #fff6e8, #e8f5ef);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-body);
  font-weight: 700;
  color: #456;
  border: 1rpx dashed #c5d0c8;
}

.metrics {
  display: flex;
  flex-direction: row;
}

.metric {
  flex: 1;
  width: 0;
  margin-right: 12rpx;
  background: var(--surface-subtle);
  border-radius: 16rpx;
  padding: 16rpx 8rpx;
  text-align: center;
}

.metric:last-child {
  margin-right: 0;
}

.metric-val {
  display: block;
  font-size: var(--fs-body);
  font-weight: 800;
}

.metric-label {
  font-size: var(--fs-small);
  color: var(--muted);
  font-weight: 600;
}

.result-card {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  background: #f7f7f7;
  border: 1rpx solid #e5e7eb;
  margin-bottom: 12rpx;
}

.result-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 14rpx;
  background: var(--brand-soft);
  color: var(--brand-dark);
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 800;
  font-size: var(--fs-small);
  flex-shrink: 0;
}

.result-card.warn {
  background: #fff6e8;
}

.result-card.warn .result-icon {
  background: #ffe2b8;
  color: #a65d00;
}

.result-card.ok {
  background: var(--brand-soft);
}

.result-body {
  flex: 1;
  min-width: 0;
}

.result-title {
  display: block;
  font-size: var(--fs-body);
  font-weight: 700;
  margin-bottom: 6rpx;
}

.result-desc {
  font-size: var(--fs-small);
  line-height: 1.4;
  color: #333;
}

.result-big {
  font-size: var(--fs-metric);
  font-weight: 800;
}

.result-unit {
  font-size: var(--fs-tiny);
  font-weight: 600;
}

.result-compare {
  display: block;
  color: var(--brand-dark);
  font-weight: 700;
  font-size: var(--fs-small);
  margin-top: 6rpx;
}

.voice-card .section-title {
  margin-bottom: 16rpx;
}

.voice-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-bottom: 12rpx;
}

.voice-btn {
  flex-shrink: 0;
  min-height: 64rpx !important;
  padding: 0 24rpx !important;
  font-size: var(--fs-small) !important;
}

.voice-hint {
  margin-left: 16rpx;
  font-size: var(--fs-small);
  color: #9aa0a6;
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.voice-input {
  width: 100%;
  min-height: 140rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 12rpx;
  padding: 16rpx;
  font-size: var(--fs-body);
  background: #fff;
  margin-bottom: 16rpx;
  box-sizing: border-box;
}
