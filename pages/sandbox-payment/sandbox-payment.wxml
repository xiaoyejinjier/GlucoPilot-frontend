<wxs module="i18n" src="/utils/i18n.wxs" />
<view class="wallet-page" style="{{displayStyle}}">
  <view class="wallet-card sandbox-card">
    <text class="wallet-title">{{i18n.t(paid ? '充值已到账' : closed ? '订单已关闭' : expired ? '付款已过期' : '支付宝付款',locale)}}</text>
    <text class="wallet-detail-amount">¥{{price}}</text>
    <view wx:if="{{loading}}" class="sandbox-state"><view class="wallet-loading"></view><text>{{i18n.t('正在准备付款…',locale)}}</text></view>
    <view wx:elif="{{paid}}" class="sandbox-success">✓</view>
    <view wx:elif="{{expired}}" class="sandbox-expired">{{i18n.t('已过期',locale)}}</view>
    <view wx:elif="{{ready && !closed && !error}}" class="sandbox-web">
      <text class="wallet-muted wallet-block">{{i18n.t('点击下方按钮前往支付宝完成付款。',locale)}}</text>
      <button class="wallet-primary" bindtap="onOpenPayment" disabled="{{opening || checking}}" loading="{{opening}}">{{i18n.t('前往支付宝付款',locale)}}</button>
    </view>
    <view wx:elif="{{legacy && !closed}}" class="wallet-muted wallet-block">{{i18n.t('此订单使用旧付款方式，请重新充值生成网页付款订单。',locale)}}</view>
    <text wx:if="{{ready}}" class="wallet-muted wallet-block">{{i18n.t('有效期至',locale)}} {{expires}}</text>
    <text class="wallet-muted wallet-block">{{i18n.t('订单编号',locale)}}：{{orderNo}}</text>
    <view wx:if="{{error}}" class="wallet-error">{{i18n.t(error,locale)}}</view>
    <button wx:if="{{error && !expired && !paid && !closed}}" class="wallet-primary" disabled="{{loading || checking}}" bindtap="onRetry">{{i18n.t('重新加载付款链接',locale)}}</button>
    <button wx:if="{{(expired || legacy) && !paid && !closed}}" class="wallet-primary" disabled="{{checking}}" bindtap="onRecharge">{{i18n.t('重新充值',locale)}}</button>
    <button wx:if="{{!paid && !closed}}" class="wallet-primary" disabled="{{checking || loading}}" loading="{{checking}}" bindtap="onRefresh">{{i18n.t('我已付款，查询结果',locale)}}</button>
    <button wx:else class="wallet-primary" bindtap="onDetails">{{i18n.t('查看订单',locale)}}</button>
    <text wx:if="{{paused}}" class="wallet-muted wallet-block">{{i18n.t('自动查询已暂停，可手动查询结果',locale)}}</text>
  </view>
  <view class="wallet-note"><text>{{i18n.t('账号与支付密码请在支付宝收银台输入。',locale)}}</text><text>{{i18n.t('支付结果确认后自动更新余额，未更新时可手动查询。',locale)}}</text><text>{{i18n.t('当前为测试环境，不涉及真实资金。',locale)}}</text></view>
</view>
