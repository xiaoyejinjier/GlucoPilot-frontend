.search-input {
  width: 100%;
  height: 72rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 16rpx;
  padding: 0 20rpx;
  background: #f7f7f7;
  font-size: var(--fs-small);
}

.cat-grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  margin: 0 -6rpx;
}

.cat-item {
  width: calc(33.33% - 12rpx);
  margin: 6rpx;
  min-height: 88rpx;
  border-radius: 16rpx;
  background: #eef6f1;
  color: #1f6b4a;
  font-size: var(--fs-small);
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 8rpx;
  box-sizing: border-box;
}

.food-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #eef2f1;
}

.food-item:last-child {
  border-bottom: none;
}

.food-thumb {
  width: 96rpx;
  height: 96rpx;
  border-radius: 14rpx;
  background: #e8eee9;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.food-meta {
  flex: 1;
  min-width: 0;
}

.food-name {
  display: block;
  font-size: var(--fs-body);
  font-weight: 700;
  color: #1c1c1c;
}

.food-info {
  display: block;
  font-size: var(--fs-small);
  color: #6b7280;
  margin-top: 8rpx;
}

.empty-tip {
  font-size: var(--fs-small);
  color: #6b7280;
  text-align: center;
  padding: 24rpx;
}
