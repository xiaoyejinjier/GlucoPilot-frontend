<view class="page-no-tab" style="{{displayStyle}}">
  <view class="page-intro">
    <text class="page-intro-text">按大类浏览 · 点进查看营养成分</text>
  </view>

  <view class="card">
    <input
      class="search-input"
      placeholder="搜索食物，如：米饭、苹果"
      value="{{keyword}}"
      bindinput="onSearch"
      confirm-type="search"
    />
  </view>

  <view class="card">
    <view class="section-title">食物大类</view>
    <view class="cat-grid">
      <view
        wx:for="{{categories}}"
        wx:key="name"
        class="cat-item"
        data-cat="{{item.name}}"
        bindtap="onCategoryTap"
      >
        <image class="cat-icon" src="{{item.icon}}" mode="aspectFit" />
        <text class="cat-name">{{item.name}}</text>
      </view>
    </view>
  </view>

  <view wx:if="{{keyword}}" class="card">
    <view class="section-title">{{keyword}}</view>
    <view wx:if="{{searchResults.length === 0}}" class="empty-tip">未找到相关食物</view>
    <view
      wx:for="{{searchResults}}"
      wx:key="index"
      class="food-item"
      data-index="{{index}}"
      bindtap="onFoodTap"
    >
      <image
        class="food-thumb"
        src="{{item.image}}"
        mode="aspectFill"
        data-index="{{index}}"
        binderror="onImageError"
      />
      <view class="food-meta">
        <text class="food-name">{{item.name}}</text>
        <text class="food-info">{{item.carbs}}克碳水/100g · {{item.cal}}kcal</text>
      </view>
    </view>
  </view>
</view>
