<view class="page-no-tab" style="{{displayStyle}}">
  <view class="page-intro">
    <text class="page-intro-text">修改后点保存即可生效</text>
  </view>

  <view class="card">
    <view class="avatar-block" bindtap="onChooseAvatar">
      <view
        wx:if="{{avatarPreview || form.avatarUrl}}"
        class="avatar-img"
      ><avatar-image src="{{avatarPreview || form.avatarUrl}}" text="{{form.avatarText || '用'}}"></avatar-image></view>
      <view wx:else class="avatar">{{form.avatarText}}</view>
      <text class="avatar-tip">{{uploadingAvatar ? '正在上传头像…' : '点击更换头像'}}</text>
    </view>
    <view wx:if="{{avatarPreview || form.avatarUrl}}" class="avatar-actions">
      <text class="avatar-clear" catchtap="onClearAvatar">恢复默认头像</text>
    </view>

    <view class="form-item">
      <text class="label">昵称</text>
      <input class="input" value="{{form.nickname}}" bindinput="onField" data-key="nickname" maxlength="12" />
    </view>
    <view class="form-item">
      <text class="label">年龄</text>
      <input class="input" type="number" value="{{form.age}}" bindinput="onField" data-key="age" />
    </view>
    <view class="form-item">
      <text class="label">电话号码</text>
      <view class="input">{{form.phone || '未绑定'}}</view>
    </view>
    <view class="form-item">
      <text class="label">个性签名</text>
      <textarea class="bio-input" value="{{form.bio}}" bindinput="onField" data-key="bio" maxlength="160" placeholder="写一句话介绍自己" auto-height />
    </view>
    <view class="form-item">
      <text class="label">身高(cm)</text>
      <input class="input" type="number" value="{{form.height}}" bindinput="onField" data-key="height" placeholder="如 170" />
    </view>
    <view class="form-item">
      <text class="label">体重(kg)</text>
      <input class="input" type="digit" value="{{form.weight}}" bindinput="onField" data-key="weight" placeholder="如 65.5" />
    </view>
    <view class="form-item">
      <text class="label">糖尿病类型</text>
      <picker
        class="input"
        mode="selector"
        range="{{diabetesOptions}}"
        value="{{diabetesIndex}}"
        bindchange="onDiabetesChange"
      >
        <view class="picker-value">{{diabetesOptions[diabetesIndex]}}</view>
      </picker>
    </view>
    <view class="form-item">
      <text class="label">确诊时间</text>
      <input class="input" value="{{form.confirmDate}}" bindinput="onField" data-key="confirmDate" placeholder="如 2021-06" />
    </view>
    <view class="form-item">
      <text class="label">用药</text>
      <input class="input" value="{{form.medication}}" bindinput="onField" data-key="medication" />
    </view>
    <view class="form-item last">
      <text class="label">运动习惯</text>
      <input class="input" value="{{form.exercise}}" bindinput="onField" data-key="exercise" />
    </view>
  </view>

  <view class="card">
    <button class="btn-primary btn-block btn-sm" bindtap="onSave" disabled="{{saving || uploadingAvatar || loading}}" loading="{{saving}}">保存资料</button>
  </view>
</view>
