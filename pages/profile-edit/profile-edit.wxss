.avatar-block {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 0 16rpx;
  border-bottom: 1rpx solid #eef2f1;
  margin-bottom: 8rpx;
}

.avatar,
.avatar-img {
  width: 112rpx;
  height: 112rpx;
  border-radius: 28rpx;
}

.avatar {
  background: var(--brand);
  color: #fff;
  font-size: var(--fs-title);
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-img {
  display: block;
  background: var(--line);
}

.avatar-tip {
  margin-top: 12rpx;
  font-size: var(--fs-small);
  color: var(--brand);
  font-weight: 600;
}

.avatar-actions {
  text-align: center;
  margin-bottom: 8rpx;
}

.avatar-clear {
  font-size: var(--fs-small);
  color: var(--muted);
}

.form-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #eef2f1;
  min-width: 0;
}

.form-item.last {
  border-bottom: none;
}

.label {
  width: 180rpx;
  font-size: var(--fs-body);
  font-weight: 700;
  color: var(--ink);
  flex-shrink: 0;
}

.input {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-body);
  text-align: right;
  color: #333;
}

.picker-value {
  width: 100%;
  text-align: right;
  color: #333;
}
.bio-form-item { align-items:flex-start; }
.bio-form-item .label { line-height:1.6; }
.bio-input { flex:1; min-width:0; width:0; min-height:48rpx; margin:0; padding:0; box-sizing:border-box; text-align:right; font-size:var(--fs-body); line-height:1.6; color:var(--ink); }
.profile-link .input { color:var(--brand); }
.field-arrow { margin-left:14rpx; font-size:36rpx; color:var(--brand); }
.date-picker-value { display:flex; justify-content:flex-end; align-items:center; gap:16rpx; flex-wrap:wrap; color:var(--brand); }
.calendar-icon { position:relative; flex:none; width:30rpx; height:30rpx; border:2rpx solid currentColor; border-radius:5rpx; box-sizing:border-box; }
.calendar-icon::before { content:''; position:absolute; top:6rpx; left:0; right:0; border-top:2rpx solid currentColor; }
.calendar-icon::after { content:''; position:absolute; top:12rpx; left:6rpx; width:5rpx; height:5rpx; background:currentColor; box-shadow:9rpx 0 currentColor,0 9rpx currentColor,9rpx 9rpx currentColor; }
.field-clear { flex:none; margin-left:14rpx; color:var(--muted); font-size:var(--fs-small); }
.medication-field { padding:24rpx 0; border-bottom:1rpx solid #eef2f1; }
.medication-hint { display:block; margin-top:10rpx; color:var(--muted); font-size:var(--fs-small); line-height:1.6; }
.medication-group { margin:20rpx 0; }
.medication-group-title { display:block; margin-bottom:14rpx; color:var(--muted); font-size:var(--fs-small); line-height:1.5; }
.medication-options { display:flex; flex-wrap:wrap; gap:14rpx; }
.medication-option { padding:12rpx 18rpx; border-radius:14rpx; border:1rpx solid var(--line); background:#f6f8fa; color:var(--ink); font-size:var(--fs-small); line-height:1.5; max-width:100%; overflow-wrap:anywhere; }
.medication-option.selected { color:var(--brand); background:var(--brand-soft); border-color:var(--brand-line); }
.other-medication { box-sizing:border-box; width:100%; min-height:84rpx; margin-top:18rpx; padding:18rpx; border-radius:14rpx; background:#f6f8fa; font-size:var(--fs-body); line-height:1.6; }
