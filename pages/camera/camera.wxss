.camera-page {
  min-height: 100vh;
  background: #111;
  color: #fff;
  display: flex;
  flex-direction: column;
}

.camera-view {
  flex: 1;
  position: relative;
  background: #1a1a1a;
  min-height: 500rpx;
  overflow: hidden;
}

.live-camera {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.camera-fallback {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #1c2430;
  padding: 48rpx 40rpx;
  box-sizing: border-box;
}

.fallback-icon {
  width: 96rpx;
  height: 72rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.35);
  border-radius: 12rpx;
  margin-bottom: 28rpx;
  position: relative;
}

.fallback-icon::after {
  content: '';
  position: absolute;
  right: -18rpx;
  top: 18rpx;
  width: 0;
  height: 0;
  border-top: 16rpx solid transparent;
  border-bottom: 16rpx solid transparent;
  border-left: 20rpx solid rgba(255, 255, 255, 0.35);
}

.fallback-title {
  font-size: var(--fs-body);
  font-weight: 700;
  color: #fff;
  text-align: center;
  margin-bottom: 12rpx;
}

.fallback-text {
  color: #aeb6c2;
  font-size: var(--fs-small);
  text-align: center;
  line-height: 1.55;
  max-width: 560rpx;
}

.btn-auth {
  margin-top: 28rpx;
  background: var(--brand);
  color: #fff;
  font-size: var(--fs-body);
  border-radius: 12rpx;
  padding: 0 36rpx;
  line-height: 72rpx;
}

.btn-auth.ghost {
  background: transparent;
  border: 2rpx solid rgba(255, 255, 255, 0.45);
  color: #fff;
}

.camera-overlay {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  pointer-events: none;
  padding: 24rpx;
  box-sizing: border-box;
}

.camera-guide {
  position: absolute;
  top: 12%;
  left: 32rpx;
  right: 32rpx;
  text-align: center;
  font-size: var(--fs-body);
  font-weight: 700;
  color: #fff;
  line-height: 1.4;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.55);
}

.camera-hint {
  position: absolute;
  bottom: 18%;
  left: 32rpx;
  right: 32rpx;
  text-align: center;
  font-size: var(--fs-body);
  font-weight: 700;
  color: #fff;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.45);
}

.camera-node {
  position: absolute;
  bottom: 10%;
  left: 32rpx;
  right: 32rpx;
  text-align: center;
  color: #d0d0d0;
  font-size: var(--fs-small);
}

.camera-bottom {
  flex-shrink: 0;
  background: #2b2b2b;
  padding: 20rpx 24rpx calc(32rpx + env(safe-area-inset-bottom));
  text-align: center;
}

.camera-tip {
  font-size: var(--fs-small);
  color: #ddd;
  margin-bottom: 24rpx;
  display: block;
  line-height: 1.45;
}

.camera-controls {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.camera-side {
  width: 120rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.side-icon {
  width: 56rpx;
  height: 56rpx;
  margin-bottom: 8rpx;
  position: relative;
}

.side-text {
  font-size: var(--fs-small);
  color: #fff;
}

.album-frame {
  position: absolute;
  left: 8rpx;
  right: 8rpx;
  top: 10rpx;
  bottom: 10rpx;
  border: 3rpx solid #fff;
  border-radius: 6rpx;
}

.album-frame::after {
  content: '';
  position: absolute;
  right: -6rpx;
  top: -6rpx;
  width: 70%;
  height: 70%;
  border: 3rpx solid rgba(255, 255, 255, 0.55);
  border-radius: 4rpx;
}

.back-arrow {
  position: absolute;
  left: 18rpx;
  top: 50%;
  width: 22rpx;
  height: 22rpx;
  margin-top: -11rpx;
  border-left: 3rpx solid #fff;
  border-bottom: 3rpx solid #fff;
  transform: rotate(45deg);
}

.camera-shutter {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  border: 8rpx solid #e64340;
  background: #fff;
  flex-shrink: 0;
}

.camera-shutter.disabled {
  opacity: 0.45;
}
