<view class="page-no-tab" style="{{displayStyle}}">
  <view class="page-intro">
    <text class="page-intro-text">按所选日期生成真实血糖与饮食记录文件</text>
  </view>

  <view class="card">
    <view class="section-title">导出范围</view>
    <view class="range-row">
      <view
        wx:for="{{ranges}}"
        wx:key="id"
        class="range-item {{activeRange === item.id ? 'on' : ''}}"
        data-id="{{item.id}}"
        bindtap="onRange"
      >{{item.label}}</view>
    </view>

    <view wx:if="{{activeRange === 'custom' && customStart && customEnd}}" class="custom-range">
      <view class="custom-chip" bindtap="onReopenStart">
        <text class="custom-chip-label">开始</text>
        <text class="custom-chip-val">{{customStart}}</text>
      </view>
      <text class="custom-sep">至</text>
      <view class="custom-chip" bindtap="onReopenEnd">
        <text class="custom-chip-label">结束</text>
        <text class="custom-chip-val">{{customEnd}}</text>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="section-title">导出内容预览</view>
    <view class="preview-box">
      <view class="kv-item">
        <text class="kv-item-label">范围</text>
        <text class="kv-item-value">{{rangeLabel}}</text>
      </view>
      <view class="kv-item">
        <text class="kv-item-label">记录条数</text>
        <text class="kv-item-value">{{previewCount == null ? '生成时统计' : previewCount + ' 条'}}</text>
      </view>
      <view class="kv-item">
        <text class="kv-item-label">格式</text>
        <text class="kv-item-value">Excel（XLSX）</text>
      </view>
    </view>
    <view class="actions-row">
      <button class="btn-ghost btn-sm" bindtap="onBack" disabled="{{exporting}}">取消</button>
      <button class="btn-primary btn-sm" bindtap="onConfirm" disabled="{{exporting}}">生成 XLSX</button>
    </view>
  </view>

  <view wx:if="{{exportText}}" class="card">
    <view class="section-title">导出结果</view>
    <text class="file-path">XLSX 文件已就绪，可在下方下载</text>
    <view class="export-box">
      <text class="export-text">{{exportText}}</text>
    </view>
    <button class="btn-ghost btn-block btn-sm copy-btn" bindtap="onCopy">复制摘要</button>
  </view>

  <view class="card"><view class="section-title">我的导出任务</view><view wx:if="{{tasksLoading}}" class="export-task-state">正在加载…</view><view wx:if="{{tasksError}}" class="export-task-state" bindtap="loadTasks">{{tasksError}} · 点击重试</view><view wx:for="{{tasks}}" wx:key="id" class="export-task-row"><view><text class="export-task-dates">{{item.startDate}} 至 {{item.endDate}}</text><text class="export-task-state">{{item.statusLabel}}{{item.status === 'done' ? ' · 血糖 ' + item.glucoseCount + ' 条 / 饮食 ' + item.mealCount + ' 条' : ''}}</text><text wx:if="{{item.error}}" class="export-task-state">{{item.error}}</text></view><button wx:if="{{item.status === 'done'}}" data-id="{{item.id}}" bindtap="onDownload" disabled="{{!!downloading}}" loading="{{downloading === item.id}}">下载</button><button wx:else data-id="{{item.id}}" bindtap="onRetryTask" disabled="{{exporting}}">{{item.status === 'failed' ? '重试' : '生成'}}</button></view><text wx:if="{{!tasks.length && !tasksLoading && !tasksError}}" class="export-task-state">暂无导出任务</text></view>
  <view class="card tip-card">
    <text class="tip-line">文件包含所选日期内的真实血糖与饮食记录，没有记录时保留空表头。</text>
    <text class="tip-line">生成后可下载 Excel 文件，并在历史任务中再次查看。</text>
  </view>

  <!-- 自定义日期弹窗：‹ 年 › + 左月右日滚动 -->
  <view wx:if="{{showDateSheet}}" class="sheet-mask" bindtap="onCloseSheet">
    <view class="sheet" catchtap="noop">
      <view class="sheet-head">
        <text class="sheet-cancel" bindtap="onCloseSheet">取消</text>
        <text class="sheet-title">{{dateStep === 'start' ? '选择开始日期' : '选择结束日期'}}</text>
        <text class="sheet-ok" bindtap="onConfirmDate">确定</text>
      </view>

      <view class="year-nav">
        <text class="year-btn" bindtap="onPrevYear">‹</text>
        <text class="year-text">{{pickYear}}年</text>
        <text class="year-btn" bindtap="onNextYear">›</text>
      </view>

      <view class="picker-labels">
        <text class="picker-label">月</text>
        <text class="picker-label">日</text>
      </view>

      <view class="roller-box">
        <view class="roller-indicator"></view>
        <scroll-view
          class="roller-col"
          scroll-y
          scroll-top="{{monthScrollTop}}"
          scroll-with-animation="{{false}}"
          show-scrollbar="{{false}}"
          bindscroll="onMonthScroll"
        >
          <view class="roller-pad"></view>
          <view
            wx:for="{{months}}"
            wx:key="*this"
            class="roller-item {{monthIndex === index ? 'on' : ''}}"
          >{{item}}月</view>
          <view class="roller-pad"></view>
        </scroll-view>
        <scroll-view
          class="roller-col"
          scroll-y
          scroll-top="{{dayScrollTop}}"
          scroll-with-animation="{{false}}"
          show-scrollbar="{{false}}"
          bindscroll="onDayScroll"
        >
          <view class="roller-pad"></view>
          <view
            wx:for="{{days}}"
            wx:key="*this"
            class="roller-item {{dayIndex === index ? 'on' : ''}}"
          >{{item}}日</view>
          <view class="roller-pad"></view>
        </scroll-view>
      </view>
    </view>
  </view>
</view>
