.range-row {
  display: flex;
  flex-direction: row;
  flex-wrap: nowrap;
  gap: 12rpx;
}

.range-item {
  flex: 1;
  width: 0;
  min-height: 72rpx;
  border-radius: 12rpx;
  background: var(--line);
  font-size: var(--fs-small);
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--muted);
  box-sizing: border-box;
  padding: 0 8rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.range-item.on {
  background: var(--brand);
  color: #fff;
}

.preview-box {
  background: var(--brand-soft);
  border-radius: 16rpx;
  padding: 8rpx 20rpx;
  margin-bottom: 20rpx;
}

.preview-box .kv-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.04);
  min-width: 0;
}

.preview-box .kv-item:last-child {
  border-bottom: none;
}

.preview-box .kv-item-label {
  font-size: var(--fs-body);
  color: var(--muted);
  flex-shrink: 0;
}

.preview-box .kv-item-value {
  font-size: var(--fs-body);
  font-weight: 700;
  color: var(--ink);
  text-align: right;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.export-box {
  background: var(--brand-soft);
  border-radius: 16rpx;
  padding: 20rpx;
}

.export-text {
  display: block;
  font-size: var(--fs-small);
  color: var(--ink);
  line-height: 1.6;
  white-space: pre-wrap;
  word-break: break-all;
}

.file-path {
  display: block;
  font-size: var(--fs-small);
  color: var(--muted);
  margin-bottom: 12rpx;
  word-break: break-all;
}

.copy-btn {
  margin-top: 16rpx;
}

.tip-card .tip-line {
  display: block;
  font-size: var(--fs-small);
  color: var(--muted);
  line-height: 1.5;
}

.tip-card .tip-line + .tip-line {
  margin-top: 8rpx;
}

.custom-range {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 20rpx;
  min-width: 0;
}

.custom-chip {
  flex: 1;
  width: 0;
  background: var(--brand-soft);
  border-radius: 12rpx;
  padding: 16rpx;
  min-width: 0;
}

.custom-chip-label {
  display: block;
  font-size: var(--fs-tiny);
  color: var(--muted);
  margin-bottom: 4rpx;
}

.custom-chip-val {
  display: block;
  font-size: var(--fs-small);
  font-weight: 700;
  color: var(--ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.custom-sep {
  font-size: var(--fs-small);
  color: var(--muted);
  flex-shrink: 0;
}

.sheet-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
}

.sheet {
  width: 100%;
  background: var(--surface);
  border-radius: 24rpx 24rpx 0 0;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx 8rpx;
}

.sheet-cancel,
.sheet-ok {
  font-size: var(--fs-body);
  font-weight: 700;
  min-width: 80rpx;
}

.sheet-cancel {
  color: var(--muted);
}

.sheet-ok {
  color: var(--brand);
  text-align: right;
}

.sheet-title {
  font-size: var(--fs-body);
  font-weight: 800;
  color: var(--ink);
}

.year-nav {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 32rpx;
  padding: 16rpx 0 8rpx;
}

.year-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 12rpx;
  background: var(--line);
  text-align: center;
  line-height: 56rpx;
  font-size: 36rpx;
  font-weight: 700;
  color: var(--ink);
}

.year-text {
  font-size: var(--fs-title);
  font-weight: 800;
  color: var(--ink);
  min-width: 180rpx;
  text-align: center;
}

.picker-labels {
  display: flex;
  padding: 0 48rpx;
}

.picker-label {
  flex: 1;
  text-align: center;
  font-size: var(--fs-small);
  color: var(--muted);
  font-weight: 700;
}

.roller-box {
  position: relative;
  display: flex;
  height: 360rpx;
  margin: 0 24rpx 8rpx;
}

.roller-indicator {
  position: absolute;
  left: 0;
  right: 0;
  top: 144rpx; /* (360-72)/2 */
  height: 72rpx;
  border-radius: 12rpx;
  background: var(--brand-soft);
  pointer-events: none;
  z-index: 0;
}

.roller-col {
  flex: 1;
  height: 360rpx;
  position: relative;
  z-index: 1;
}

.roller-pad {
  height: 144rpx; /* 2 * 72 */
}

.roller-item {
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--muted);
}

.roller-item.on {
  color: var(--ink);
  font-weight: 800;
}

.export-task-row{display:flex;justify-content:space-between;gap:20rpx;align-items:center;padding:24rpx 0;border-top:1rpx solid var(--line)}.export-task-row>view{flex:1;min-width:0}.export-task-row button{flex:none;margin:0;background:var(--brand-soft);color:var(--brand);font-size:24rpx;border-radius:18rpx}.export-task-dates{font-size:var(--fs-small);display:block}.export-task-state{display:block;font-size:22rpx;color:var(--muted);line-height:1.8;margin-top:8rpx}
.export-task-actions{flex:0 0 auto!important;display:flex;flex-direction:column;gap:10rpx}.export-task-actions button{min-width:104rpx;line-height:2.4}.export-task-actions .export-task-delete{background:transparent;color:var(--muted);border:1rpx solid var(--line)}
