<wxs module="i18n" src="/utils/i18n.wxs" />
<view class="page-no-tab information-page" style="{{displayStyle}}">
  <view wx:if="{{locale === 'en' && (contentTranslationLoading || contentTranslationError)}}" class="content-translation-notice" bindtap="retryContentTranslations" aria-role="button"><text>{{i18n.t(contentTranslationLoading ? '正在准备英文内容…' : '暂时无法翻译，正在显示原文，点击重试', locale)}}</text></view>
  <view class="information-heading"><text class="information-title">{{i18n.t("每一份回应，都在这里", locale)}}</text><text class="information-subtitle">{{i18n.t("和糖友聊聊，看看新的互动", locale)}}</text></view>
  <view wx:if="{{informationCounts.reports > 0}}" class="report-feedback-entry ui-interactive" bindtap="onReports" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}"><view><text>{{i18n.t("举报处理反馈", locale)}}</text><text class="report-feedback-copy">{{i18n.t("管理员已回复，点击查看", locale)}}</text></view><text>{{i18n.t((informationCounts.reports > 99 ? '99+' : informationCounts.reports) + " ›", locale)}}</text></view>
  <scroll-view scroll-x class="information-tabs"><view class="information-tab-row"><view wx:for="{{tabs}}" wx:key="key" class="information-tab {{activeTab === item.key ? 'selected' : ''}} ui-interactive" data-key="{{item.key}}" bindtap="onTab" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}"><view class="information-symbol">{{i18n.t((item.symbol), locale)}}<text wx:if="{{informationCounts[item.key] > 0}}" class="information-badge">{{i18n.t((informationCounts[item.key] > 99 ? '99+' : informationCounts[item.key]), locale)}}</text></view><text>{{i18n.t((item.label), locale)}}</text></view></view></scroll-view>
  <view wx:for="{{list}}" wx:key="rowKey" class="information-row ui-interactive" data-id="{{item.rowKey}}" bindtap="onOpen" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}">
    <block wx:if="{{activeTab === 'messages'}}"><view wx:if="{{item.peer.avatarUrl}}" class="information-avatar"><avatar-image src="{{item.peer.avatarUrl}}" text="友"></avatar-image></view><view wx:else class="information-avatar fallback">{{i18n.t("聊", locale)}}</view><view class="information-copy"><view class="information-line"><text class="information-name">{{i18n.name(contentTranslations, item.peer, locale)}}</text><text class="information-time">{{i18n.t((item.timeLabel), locale)}}</text></view><text class="information-preview">{{item.lastMessage.content}}</text></view><text wx:if="{{item.unreadCount > 0}}" class="information-unread">{{i18n.t((item.unreadLabel), locale)}}</text></block>
    <block wx:else><view wx:if="{{item.actor.avatarUrl}}" class="information-avatar"><avatar-image src="{{item.actor.avatarUrl}}" text="友"></avatar-image></view><view wx:else class="information-avatar fallback">{{i18n.t("友", locale)}}</view><view class="information-copy"><text class="information-name">{{i18n.name(contentTranslations, item.actor, locale)}} <text class="information-action">{{i18n.t((item.action), locale)}}</text></text><text wx:if="{{i18n.content(contentTranslations, 'ARTICLE_PREVIEW', item.newsId, 'title', item.newsTitle, locale)}}" class="information-preview">{{i18n.t("《" + (i18n.content(contentTranslations, 'ARTICLE_PREVIEW', item.newsId, 'title', item.newsTitle, locale)) + "》", locale)}}</text><text wx:if="{{item.content}}" class="information-comment">{{item.content}}</text><text class="information-time">{{i18n.t((item.timeLabel), locale)}}</text></view><view wx:if="{{!item.read}}" class="information-dot"></view></block>
  </view>
  <view wx:if="{{loading}}" class="information-state ui-loading-line"><view class="ui-loading-dots" aria-hidden="true"><view></view><view></view><view></view></view><text>{{i18n.t("正在加载…", locale)}}</text></view><view wx:elif="{{error}}" class="information-state error ui-interactive" bindtap="onRetry" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}">{{i18n.t((error) + " · 点击重试", locale)}}</view><view wx:elif="{{!list.length}}" class="information-empty"><text class="empty-symbol">✉</text><text>{{i18n.t((activeTab === 'messages' ? '还没有私信，去和糖友打个招呼吧' : '暂时没有这类提醒'), locale)}}</text></view><view wx:elif="{{hasMore}}" class="information-state ui-interactive" bindtap="onMore" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}">{{i18n.t("查看更多", locale)}}</view>
</view>
