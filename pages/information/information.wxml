<wxs module="i18n" src="/utils/i18n.wxs" />
<view class="page-no-tab information-page" style="{{displayStyle}}">
  <view wx:if="{{locale === 'en' && (contentTranslationLoading || contentTranslationError)}}" class="content-translation-notice" bindtap="retryContentTranslations" aria-role="button"><text>{{i18n.t(contentTranslationLoading ? '正在准备英文内容…' : '暂时无法翻译，正在显示原文，点击重试', locale)}}</text></view>
  <view class="information-heading"><text class="information-title">{{i18n.t(title, locale)}}</text><text class="information-subtitle">{{i18n.t(subtitle, locale)}}</text></view>
  <scroll-view wx:if="{{tabs.length > 1}}" scroll-x class="information-tabs"><view class="information-tab-row"><view wx:for="{{tabs}}" wx:key="key" class="information-tab {{activeTab === item.key ? 'selected' : ''}} ui-interactive" data-key="{{item.key}}" bindtap="onTab" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}"><view class="information-symbol">{{i18n.t((item.symbol), locale)}}<text wx:if="{{informationCounts[item.key] > 0}}" class="information-badge">{{i18n.t((informationCounts[item.key] > 99 ? '99+' : informationCounts[item.key]), locale)}}</text></view><text>{{i18n.t((item.label), locale)}}</text></view></view></scroll-view>
  <view wx:if="{{searchable}}" class="information-search"><text>⌕</text><input value="{{keyword}}" maxlength="80" placeholder="{{i18n.t(searchPlaceholder,locale)}}" bindinput="onInput" bindconfirm="onSearch" confirm-type="search" /><text wx:if="{{keyword || searchQuery}}" bindtap="onClearSearch">×</text><button bindtap="onSearch">{{i18n.t('搜索',locale)}}</button></view>
  <view wx:for="{{list}}" wx:key="rowKey" class="information-row ui-interactive" data-id="{{item.rowKey}}" bindtap="onOpen" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}">
    <block wx:if="{{item.rowType === 'ARTICLE'}}"><image class="information-cover" src="{{item.cover}}" mode="aspectFill" /><view class="information-copy"><text class="information-name">{{i18n.content(contentTranslations,'ARTICLE_PREVIEW',item.id,'title',item.title,locale)}}</text><text class="information-preview">{{i18n.t(item.channel,locale)}} · {{item.timeLabel}}</text></view><text class="information-time">›</text></block>
    <block wx:elif="{{item.rowType === 'PROFILE'}}"><view class="information-avatar"><avatar-image src="{{item.avatarUrl}}" text="友"></avatar-image></view><view class="information-copy"><text class="information-name">{{i18n.name(contentTranslations,item,locale)}}</text><text class="information-preview">{{item.bio || i18n.t('已关注',locale)}}</text></view><text class="information-time">›</text></block>
    <block wx:elif="{{activeTab === 'messages'}}"><view wx:if="{{item.peer.avatarUrl}}" class="information-avatar"><avatar-image src="{{item.peer.avatarUrl}}" text="友"></avatar-image></view><view wx:else class="information-avatar fallback">{{i18n.t("聊", locale)}}</view><view class="information-copy"><view class="information-line"><text class="information-name">{{i18n.name(contentTranslations, item.peer, locale)}}</text><text class="information-time">{{i18n.t((item.timeLabel), locale)}}</text></view><text class="information-preview">{{item.lastMessage.content}}</text></view><text wx:if="{{item.unreadCount > 0}}" class="information-unread">{{i18n.t((item.unreadLabel), locale)}}</text></block>
    <block wx:elif="{{activeTab === 'myComments'}}"><view class="information-copy"><view class="information-line"><text class="information-name my-comment-article">{{item.articleTitle}}</text><text class="information-time">{{i18n.t((item.timeLabel), locale)}}</text></view><text class="information-comment my-comment-body">{{item.content}}</text><view class="my-comment-meta"><text wx:if="{{item.hidden}}" class="my-comment-hidden">{{i18n.t("已被系统隐藏", locale)}}</text><text wx:if="{{!item.articleAvailable}}" class="information-preview">{{i18n.t("文章已不可查看", locale)}}</text><text wx:if="{{item.replyCount > 0}}">{{item.replyCount}} {{i18n.t("条回复", locale)}}</text><text wx:if="{{item.likeCount > 0}}">{{item.likeCount}} {{i18n.t("个赞", locale)}}</text></view></view></block><block wx:else><view wx:if="{{item.actor.avatarUrl}}" class="information-avatar"><avatar-image src="{{item.actor.avatarUrl}}" text="友"></avatar-image></view><view wx:else class="information-avatar fallback">{{i18n.t("友", locale)}}</view><view class="information-copy"><text class="information-name">{{i18n.name(contentTranslations, item.actor, locale)}} <text class="information-action">{{i18n.t((item.action), locale)}}</text></text><text wx:if="{{i18n.content(contentTranslations, 'ARTICLE_PREVIEW', item.newsId, 'title', item.newsTitle, locale)}}" class="information-preview">{{i18n.t("《" + (i18n.content(contentTranslations, 'ARTICLE_PREVIEW', item.newsId, 'title', item.newsTitle, locale)) + "》", locale)}}</text><text wx:if="{{item.content}}" class="information-comment">{{item.content}}</text><text class="information-time">{{i18n.t((item.timeLabel), locale)}}</text></view><view wx:if="{{!item.read}}" class="information-dot"></view></block>
  </view>
  <view wx:if="{{loading}}" class="information-state ui-loading-line"><view class="ui-loading-dots" aria-hidden="true"><view></view><view></view><view></view></view><text>{{i18n.t("正在加载…", locale)}}</text></view><view wx:elif="{{error}}" class="information-state error ui-interactive" bindtap="onRetry" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}">{{i18n.t((error) + " · 点击重试", locale)}}</view><view wx:elif="{{!list.length}}" class="information-empty"><text class="empty-symbol">✉</text><text>{{i18n.t((searchQuery ? '没有找到匹配的内容，试试其他关键词' : activeTab === 'myComments' ? '还没有发表过评论，去文章下聊两句吧' : activeTab === 'messages' ? '还没有私信，去和糖友打个招呼吧' : activeTab === 'myLikes' ? '还没有点赞，看到喜欢的文章点一下赞吧' : activeTab === 'myCollections' ? '还没有收藏，看到喜欢的文章点一下收藏吧' : activeTab === 'following' ? '还没有关注的博主，去文章或评论区看看吧' : '暂时没有这类提醒'), locale)}}</text></view><view wx:elif="{{hasMore}}" class="information-state ui-interactive" bindtap="onMore" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}">{{i18n.t("查看更多", locale)}}</view>
</view>
