<view class="page-no-tab information-page" style="{{displayStyle}}">
  <view class="information-heading"><text class="information-title">每一份回应，都在这里</text><text class="information-subtitle">和糖友聊聊，看看新的互动</text></view>
  <scroll-view scroll-x class="information-tabs"><view class="information-tab-row"><view wx:for="{{tabs}}" wx:key="key" class="information-tab {{activeTab === item.key ? 'selected' : ''}}" data-key="{{item.key}}" bindtap="onTab"><view class="information-symbol">{{item.symbol}}<text wx:if="{{informationCounts[item.key] > 0}}" class="information-badge">{{informationCounts[item.key] > 99 ? '99+' : informationCounts[item.key]}}</text></view><text>{{item.label}}</text></view></view></scroll-view>
  <view wx:for="{{list}}" wx:key="rowKey" class="information-row" data-id="{{item.rowKey}}" bindtap="onOpen">
    <block wx:if="{{activeTab === 'messages'}}"><image wx:if="{{item.peer.avatarUrl}}" class="information-avatar" src="{{item.peer.avatarUrl}}" mode="aspectFill"/><view wx:else class="information-avatar fallback">聊</view><view class="information-copy"><view class="information-line"><text class="information-name">{{item.peer.nickname}}</text><text class="information-time">{{item.timeLabel}}</text></view><text class="information-preview">{{item.lastMessage.content}}</text></view><text wx:if="{{item.unreadCount > 0}}" class="information-unread">{{item.unreadLabel}}</text></block>
    <block wx:else><image wx:if="{{item.actor.avatarUrl}}" class="information-avatar" src="{{item.actor.avatarUrl}}" mode="aspectFill"/><view wx:else class="information-avatar fallback">友</view><view class="information-copy"><text class="information-name">{{item.actor.nickname}} <text class="information-action">{{item.action}}</text></text><text wx:if="{{item.newsTitle}}" class="information-preview">《{{item.newsTitle}}》</text><text wx:if="{{item.content}}" class="information-comment">{{item.content}}</text><text class="information-time">{{item.timeLabel}}</text></view><view wx:if="{{!item.read}}" class="information-dot"></view></block>
  </view>
  <view wx:if="{{loading}}" class="information-state">正在加载…</view><view wx:elif="{{error}}" class="information-state error" bindtap="onRetry">{{error}} · 点击重试</view><view wx:elif="{{!list.length}}" class="information-empty"><text class="empty-symbol">✉</text><text>{{activeTab === 'messages' ? '还没有私信，去和糖友打个招呼吧' : '暂时没有这类提醒'}}</text></view><view wx:elif="{{hasMore}}" class="information-state" bindtap="onMore">查看更多</view>
</view>
