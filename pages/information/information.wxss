.information-page{padding:28rpx 26rpx 50rpx;background:var(--bg);min-height:100vh;box-sizing:border-box}.information-heading{padding:8rpx 8rpx 28rpx}.information-title{display:block;font-size:38rpx;font-weight:700;color:var(--ink)}.information-subtitle{display:block;margin-top:12rpx;font-size:var(--fs-small);color:var(--muted)}.information-tabs{width:100%;margin-bottom:26rpx}.information-tab-row{display:flex;gap:12rpx}.information-tab{position:relative;flex:1;min-width:112rpx;display:flex;align-items:center;flex-direction:column;gap:14rpx;padding:20rpx 6rpx;color:var(--muted);font-size:22rpx;white-space:nowrap}.information-symbol{position:relative;width:74rpx;height:74rpx;line-height:74rpx;text-align:center;border-radius:24rpx;background:var(--brand-soft);font-size:38rpx;color:var(--muted)}.information-tab.selected{color:var(--brand);font-weight:600}.selected .information-symbol{background:var(--brand-soft);color:var(--brand)}.information-badge{position:absolute;top:-8rpx;right:-12rpx;min-width:30rpx;height:30rpx;line-height:30rpx;padding:0 7rpx;border-radius:18rpx;font-size:19rpx;color:white;background:#ed626c}.information-row{display:flex;align-items:flex-start;gap:20rpx;padding:28rpx 24rpx;background:white;border-radius:24rpx;margin-bottom:16rpx}.information-avatar{flex:none;width:78rpx;height:78rpx;border-radius:26rpx}.fallback{display:flex;align-items:center;justify-content:center;background:var(--brand-soft);color:var(--muted);font-size:32rpx}.information-copy{flex:1;min-width:0;display:flex;flex-direction:column;gap:12rpx}.information-line{display:flex;justify-content:space-between;gap:12rpx}.information-name{font-size:var(--fs-body);font-weight:600;color:var(--ink);overflow-wrap:anywhere}.information-action{font-weight:400;color:var(--muted)}.information-time{font-size:var(--fs-tiny);color:var(--hint);flex:none}.information-preview{font-size:var(--fs-small);line-height:1.7;color:var(--muted);overflow-wrap:anywhere;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.information-comment{font-size:var(--fs-body);color:var(--ink-soft);line-height:1.7;white-space:pre-wrap;overflow-wrap:anywhere}.information-unread{flex:none;min-width:32rpx;height:32rpx;line-height:32rpx;border-radius:20rpx;background:#ed626c;color:white;text-align:center;padding:0 7rpx;font-size:20rpx}.information-dot{flex:none;width:12rpx;height:12rpx;background:#ed626c;border-radius:50%;margin-top:12rpx}.information-state{text-align:center;padding:32rpx;color:var(--muted);font-size:var(--fs-small)}.information-empty{display:flex;flex-direction:column;align-items:center;gap:24rpx;padding:90rpx 26rpx;color:var(--muted);font-size:var(--fs-body);text-align:center}.empty-symbol{font-size:80rpx;color:var(--brand-line)}.error{color:#b8766c}
.report-feedback-entry{display:flex;justify-content:space-between;align-items:center;gap:20rpx;padding:24rpx;border-radius:22rpx;background:var(--brand-soft);color:var(--brand);font-size:var(--fs-body);margin-bottom:24rpx}.report-feedback-copy{display:block;font-size:var(--fs-small);color:var(--brand);margin-top:6rpx}
.information-tab-row { width:max-content; min-width:100%; }
.information-tab { flex:0 0 auto; padding-right:14rpx; padding-left:14rpx; }
.information-tab { transition:color .18s ease,transform .16s ease,opacity .16s ease; }
.information-symbol { transition:background-color .18s ease,color .18s ease; }
.information-tab::after { content:''; position:absolute; left:calc(50% - 18rpx); bottom:2rpx; width:36rpx; height:5rpx; border-radius:4rpx; background:var(--brand); opacity:0; transform:scaleX(.4); transition:opacity .18s ease,transform .18s ease; }
.information-tab.selected::after { opacity:1; transform:scaleX(1); }
.information-tab.selected .information-symbol { animation:ui-icon-pop .24s ease-out; }
@media (prefers-reduced-motion: reduce) {
  .information-tab, .information-symbol, .information-tab::after { transition:none; }
  .information-tab.selected .information-symbol { animation:none; }
}.my-comment-article{display:block;max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.my-comment-body{display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}.my-comment-meta{display:flex;flex-wrap:wrap;align-items:center;gap:16rpx;font-size:var(--fs-tiny);color:var(--hint)}.my-comment-hidden{color:#c1874c}
