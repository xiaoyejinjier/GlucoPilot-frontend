.information-page{padding:28rpx 26rpx 50rpx;background:#f5f8fb;min-height:100vh;box-sizing:border-box}.information-heading{padding:8rpx 8rpx 28rpx}.information-title{display:block;font-size:38rpx;font-weight:700;color:#273c53}.information-subtitle{display:block;margin-top:12rpx;font-size:var(--fs-small);color:#8b9bad}.information-tabs{width:100%;margin-bottom:26rpx}.information-tab-row{display:flex;gap:12rpx}.information-tab{position:relative;flex:1;min-width:112rpx;display:flex;align-items:center;flex-direction:column;gap:14rpx;padding:20rpx 6rpx;color:#8392a2;font-size:22rpx;white-space:nowrap}.information-symbol{position:relative;width:74rpx;height:74rpx;line-height:74rpx;text-align:center;border-radius:24rpx;background:#eaf0f6;font-size:38rpx;color:#7592b5}.information-tab.selected{color:#4285d9;font-weight:600}.selected .information-symbol{background:#e1ecff;color:#4285d9}.information-badge{position:absolute;top:-8rpx;right:-12rpx;min-width:30rpx;height:30rpx;line-height:30rpx;padding:0 7rpx;border-radius:18rpx;font-size:19rpx;color:white;background:#ed626c}.information-row{display:flex;align-items:flex-start;gap:20rpx;padding:28rpx 24rpx;background:white;border-radius:24rpx;margin-bottom:16rpx}.information-avatar{flex:none;width:78rpx;height:78rpx;border-radius:26rpx}.fallback{display:flex;align-items:center;justify-content:center;background:#eaf2fb;color:#7295be;font-size:32rpx}.information-copy{flex:1;min-width:0;display:flex;flex-direction:column;gap:12rpx}.information-line{display:flex;justify-content:space-between;gap:12rpx}.information-name{font-size:var(--fs-body);font-weight:600;color:#30445b;overflow-wrap:anywhere}.information-action{font-weight:400;color:#7b8c9e}.information-time{font-size:var(--fs-tiny);color:#a1aebb;flex:none}.information-preview{font-size:var(--fs-small);line-height:1.7;color:#8191a2;overflow-wrap:anywhere;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.information-comment{font-size:var(--fs-body);color:#4a5e73;line-height:1.7;white-space:pre-wrap;overflow-wrap:anywhere}.information-unread{flex:none;min-width:32rpx;height:32rpx;line-height:32rpx;border-radius:20rpx;background:#ed626c;color:white;text-align:center;padding:0 7rpx;font-size:20rpx}.information-dot{flex:none;width:12rpx;height:12rpx;background:#ed626c;border-radius:50%;margin-top:12rpx}.information-state{text-align:center;padding:32rpx;color:#8d9bab;font-size:var(--fs-small)}.information-empty{display:flex;flex-direction:column;align-items:center;gap:24rpx;padding:90rpx 26rpx;color:#8f9eac;font-size:var(--fs-body);text-align:center}.empty-symbol{font-size:80rpx;color:#bdcfdf}.error{color:#b8766c}
