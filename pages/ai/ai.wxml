<wxs module="i18n" src="/utils/i18n.wxs" />
<view class="page record-page" style="{{displayStyle}}">
  <glucose-alert-reminder nodes="{{nodes}}" social-counts="{{informationCounts}}" bind:visibilitychange="onReminderVisibilityChange"></glucose-alert-reminder>
  <view class="card glucose-chart-card">
    <view class="section-title">
      <text>{{i18n.t("今日血糖曲线图", locale)}}</text>
      <text class="tag tag-ok">{{i18n.t("已记 " + (recordCount) + "/" + (glucoseTotalNodes), locale)}}</text>
    </view>
    <view wx:if="{{noticeVisible || navigationGuideVisible}}" class="chart-canvas"></view>
    <canvas wx:else type="2d" id="glucoseChart" class="chart-canvas"
      bindtouchstart="onChartTouchStart" bindtouchmove="onChartTouchMove"
      bindtouchend="onChartTouchEnd" bindtouchcancel="onChartTouchCancel"></canvas>
    <view class="glucose-series-legend">
      <view class="glucose-series-item"><view class="glucose-series-line"></view><text>{{i18n.t("实测血糖", locale)}}</text></view>
      <view class="glucose-series-item"><view class="glucose-series-line predicted"></view><text>{{i18n.t("餐后预测 · 按推荐吃法", locale)}}</text></view>
    </view>
    <view wx:if="{{chartSelection}}" class="chart-details {{chartSelection.status}}">
      <view class="chart-details-heading">
        <text class="chart-details-name">{{i18n.t((chartSelection.nodeName), locale)}}</text>
        <text class="chart-details-close ui-interactive" bindtap="onCloseChartDetails" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}">{{i18n.t("收起", locale)}}</text>
      </view>
      <view class="chart-details-value">
        <text>{{i18n.t((chartSelection.value), locale)}}</text><text class="chart-details-unit">{{i18n.t(chartSelection.isPrediction ? "mmol/L · 餐后预测" : "mmol/L · 实测血糖", locale)}}</text>
      </view>
      <view wx:if="{{!chartSelection.isPrediction}}" class="chart-details-row"><text>{{i18n.t("记录时间", locale)}}</text><text>{{i18n.t((chartSelection.recordedAtText), locale)}}</text></view>
      <view class="chart-details-row"><text>{{i18n.t(chartSelection.isPrediction ? "预测依据" : "记录来源", locale)}}</text><text>{{i18n.t((chartSelection.sourceText), locale)}}</text></view>
      <view wx:if="{{chartSelection.remark}}" class="chart-details-row chart-details-remark"><text>{{i18n.t("备注", locale)}}</text><text>{{chartSelection.remark}}</text></view>
    </view>
  </view>
  <view class="card daily-record-card">
    <view class="section-title record-section-heading">
      <text>{{i18n.t("今日九时段记录", locale)}}</text>
      <text class="bind-device-link ui-interactive" bindtap="onAddDevice" aria-role="button" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}">{{i18n.t("绑定设备", locale)}}</text>
    </view>
    <view class="time-rule-hint">
      <text class="time-rule-icon">{{i18n.t("时", locale)}}</text>
      <text>{{i18n.t((timeRuleHint), locale)}}</text>
    </view>
    <view class="nodes">
      <view
        wx:for="{{nodes}}"
        wx:key="id"
        class="node {{item.status}} {{item.isMeal ? 'meal' : ''}} {{item.hasRecord ? 'recorded' : ''}} {{item.locked ? 'locked' : ''}} ui-interactive"
        data-id="{{item.id}}"
        bindtap="onNodeTap"
       hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}">
        <view class="node-dot"></view>
        <text class="node-name">{{i18n.t((item.name), locale)}}</text>
        <text wx:if="{{item.value != null}}" class="node-val">{{i18n.t((item.value), locale)}}</text>
        <text wx:elif="{{item.hasRecord}}" class="node-recorded">{{i18n.t(item.isMeal && item.predictionValue != null ? "已存预测" : "已记录", locale)}}</text>
        <text wx:else class="node-empty">{{i18n.t("未记录", locale)}}</text>
        <text wx:if="{{item.isMeal}}" class="meal-tag">{{i18n.t("餐", locale)}}</text>
        <text wx:if="{{item.locked}}" class="lock-tag">{{i18n.t("已截止", locale)}}</text>
      </view>
    </view>
    <view class="status-legend">
      <view class="status-legend-item">
        <text class="status-legend-dot is-empty"></text>
        <text>{{i18n.t("未记录", locale)}}</text>
      </view>
      <view class="status-legend-item">
        <text class="status-legend-dot is-ok"></text>
        <text>{{i18n.t("正常", locale)}}</text>
      </view>
      <view class="status-legend-item">
        <text class="status-legend-dot is-warn"></text>
        <text>{{i18n.t("偏高", locale)}}</text>
      </view>
      <view class="status-legend-item">
        <text class="status-legend-dot is-danger"></text>
        <text>{{i18n.t("异常", locale)}}</text>
      </view>
      <view class="status-legend-item meal-legend-item">
        <text class="status-meal-badge">{{i18n.t("餐", locale)}}</text>
        <text>{{i18n.t("正餐已保存", locale)}}</text>
      </view>
      <view class="status-legend-item">
        <text class="status-lock-badge">{{i18n.t("止", locale)}}</text>
        <text>{{i18n.t("时段截止", locale)}}</text>
      </view>
    </view>
  </view>
  <view class="stats-entry" bindtap="onOpenStats" hover-class="stats-entry-pressed"
    aria-role="button" aria-label="{{i18n.t('查看数据统计和血糖趋势', locale)}}">
    <view class="stats-entry-icon"><app-icon name="stats" size="lg" color="#ffffff"></app-icon></view>
    <view class="stats-entry-copy">
      <text class="stats-entry-title">{{i18n.t("数据统计", locale)}}</text>
      <text class="stats-entry-description">{{i18n.t("回顾每日记录，查看血糖趋势", locale)}}</text>
    </view>
    <view class="stats-entry-arrow" aria-hidden="true"></view>
  </view>
</view>
