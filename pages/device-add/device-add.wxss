.device-page { min-height:100vh; padding:32rpx 28rpx calc(36rpx + env(safe-area-inset-bottom)); background:#f6f8fb; color:#24334a; box-sizing:border-box; }
.device-intro { padding:4rpx 4rpx 28rpx; }
.device-intro-kicker { display:block; margin-bottom:10rpx; color:#5485ca; font-size:var(--fs-small); font-weight:600; }
.device-intro-title { display:block; font-size:var(--fs-title); font-weight:700; letter-spacing:1rpx; }
.device-intro-note { display:block; margin-top:12rpx; color:#8b98a9; font-size:var(--fs-small); }
.discovery-card { padding:28rpx; border:1rpx solid #e9eef6; border-radius:28rpx; background:#fff; }
.discovery-heading, .device-section-heading { display:flex; align-items:center; justify-content:space-between; gap:16rpx; font-size:var(--fs-body); font-weight:600; }
.search-status { display:flex; align-items:center; gap:8rpx; flex-shrink:0; color:#96a1b0; font-size:var(--fs-tiny); font-weight:400; }
.status-dot { width:10rpx; height:10rpx; border-radius:50%; background:#c2cbd6; }
.is-searching { color:#397bda; }
.is-searching .status-dot { background:#5a99ee; animation:device-pulse 1.3s ease-in-out infinite; }
.device-empty { padding:8rpx 0 30rpx; text-align:center; }
.empty-heading { display:block; margin-top:4rpx; color:#3b4c65; font-size:var(--fs-body); font-weight:600; }
.empty-description { display:block; margin-top:14rpx; color:#7f8da2; font-size:var(--fs-small); line-height:1.7; }
.empty-subtitle { display:block; margin-top:6rpx; color:#a2acba; font-size:var(--fs-tiny); line-height:1.7; }
button { margin:0; padding:0; border:0; outline:none; line-height:1.5; box-sizing:border-box; }
button::after { border:0; }
.search-button { display:flex; align-items:center; justify-content:center; width:100%; min-height:82rpx; padding:18rpx 24rpx; border-radius:18rpx; background:#4285e5; color:#fff; font-size:var(--fs-body); font-weight:500; }
.search-button-pressed { background:#3476d5; }
.search-footnote { display:block; margin-top:16rpx; color:#a1adbc; text-align:center; font-size:var(--fs-tiny); line-height:1.6; }
.device-error { display:flex; flex-direction:column; gap:8rpx; padding:18rpx 20rpx; margin:0 0 20rpx; border-radius:14rpx; color:#ad793e; background:#fff8ee; font-size:var(--fs-small); line-height:1.7; }
.settings-link { align-self:flex-end; padding:4rpx 0 4rpx 16rpx; color:#397bda; }
.device-section-heading { margin:30rpx 4rpx 18rpx; }
.section-side-note { flex-shrink:0; color:#9aa7b8; font-size:var(--fs-tiny); font-weight:400; }
.add-methods { display:flex; gap:20rpx; }
.add-method { display:flex; flex:1; flex-direction:column; align-items:center; min-width:0; padding:28rpx 12rpx 24rpx; border:1rpx solid #e8eef7; border-radius:24rpx; background:#fff; }
.method-pressed { background:#eef5ff; }
.method-icon { display:flex; align-items:center; justify-content:center; position:relative; width:66rpx; height:66rpx; margin-bottom:18rpx; border-radius:18rpx; background:#edf4ff; color:#4d86d6; }
.method-title { color:#384d6a; font-size:var(--fs-body); font-weight:600; }
.method-description { margin-top:8rpx; color:#97a4b6; font-size:var(--fs-tiny); white-space:normal; }
.sn-icon { font-family:Arial,sans-serif; font-size:27rpx; font-weight:700; letter-spacing:1rpx; }
.qr-corner { position:absolute; width:13rpx; height:13rpx; border:3rpx solid currentColor; }
.corner-tl { left:15rpx; top:15rpx; border-right:0; border-bottom:0; }.corner-tr { right:15rpx; top:15rpx; border-left:0; border-bottom:0; }
.corner-bl { left:15rpx; bottom:15rpx; border-right:0; border-top:0; }.corner-br { right:15rpx; bottom:15rpx; border-left:0; border-top:0; }
.qr-center { width:12rpx; height:12rpx; border:3rpx solid currentColor; border-radius:2rpx; }
.nearby-list { padding:16rpx 0; }.nearby-warning { display:block; color:#9aa6b5; font-size:var(--fs-tiny); line-height:1.7; }
.nearby-item { display:flex; align-items:center; gap:16rpx; padding:24rpx 0; border-bottom:1rpx solid #eef2f7; }
.nearby-device-icon { display:flex; justify-content:center; align-items:center; flex-shrink:0; width:50rpx; height:64rpx; border:2rpx solid #9cb6d9; border-radius:12rpx; background:#f1f6fd; }
.mini-device-screen { width:28rpx; height:24rpx; margin-top:-12rpx; border-radius:5rpx; background:#c6dcf6; }
.nearby-info { flex:1; min-width:0; }.nearby-name { display:block; font-size:var(--fs-small); word-break:break-all; }.nearby-signal { display:block; margin-top:8rpx; color:#9aa7b9; font-size:var(--fs-tiny); }
.candidate-button { flex-shrink:0; padding:10rpx 22rpx; border-radius:24rpx; background:#edf4ff; color:#427ccf; font-size:var(--fs-small); }
.draft-item { padding:24rpx; margin-bottom:16rpx; border:1rpx solid #e8eef7; border-radius:20rpx; background:#fff; }
.draft-item-heading, .draft-item-footer { display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:12rpx; }
.draft-name { font-size:var(--fs-body); font-weight:500; word-break:break-all; }.pending-badge { padding:5rpx 12rpx; border-radius:10rpx; background:#f1f4f8; color:#8190a4; font-size:var(--fs-tiny); }
.draft-serial { display:block; margin-top:12rpx; color:#8191a7; font-size:var(--fs-small); word-break:break-all; }.draft-item-footer { margin-top:14rpx; color:#a0acbb; font-size:var(--fs-tiny); }
.remove-draft { padding:8rpx 0 8rpx 16rpx; color:#7f94b0; }
.device-preparation-note { margin:28rpx 6rpx 0; color:#a0aaba; font-size:var(--fs-tiny); line-height:1.9; }.preparation-title { display:block; margin-bottom:6rpx; color:#8393a8; font-weight:500; }
.back-to-record { display:block; padding:30rpx 20rpx 8rpx; text-align:center; color:#6484b0; font-size:var(--fs-small); }
.serial-overlay { position:fixed; inset:0; z-index:10002; }.serial-mask { position:absolute; inset:0; background:rgba(27,42,63,.36); }
.serial-panel { position:absolute; left:0; right:0; bottom:0; max-height:85vh; overflow-y:auto; padding:30rpx 32rpx calc(32rpx + env(safe-area-inset-bottom)); border-radius:30rpx 30rpx 0 0; background:#fff; }
.serial-heading { display:flex; align-items:center; justify-content:space-between; gap:20rpx; font-size:var(--fs-title); font-weight:600; }.serial-close { flex-shrink:0; padding:12rpx 0 12rpx 20rpx; color:#8899af; font-size:var(--fs-small); font-weight:400; }
.serial-note { display:block; margin:14rpx 0 28rpx; color:#98a4b5; font-size:var(--fs-small); line-height:1.7; }.input-label { display:block; margin:24rpx 0 14rpx; color:#53667f; font-size:var(--fs-small); }
.required-mark { color:#cb735e; }.optional-label { color:#a5afbd; }.serial-input { height:88rpx; padding:0 22rpx; border:1rpx solid #e3eaf5; border-radius:16rpx; background:#f8faff; color:#344c6b; font-size:var(--fs-body); }
.serial-error { display:block; margin-top:16rpx; color:#bd6658; font-size:var(--fs-small); line-height:1.7; }.serial-save { margin-top:32rpx; }.serial-footnote { display:block; margin-top:18rpx; text-align:center; color:#a0aaba; font-size:var(--fs-tiny); line-height:1.7; }

/* 轻量CSS卡通小助手，无外链图片、额外下载或Canvas图层。 */
.mascot-scene { position:relative; width:330rpx; height:272rpx; margin:6rpx auto 0; }
.mascot-halo { position:absolute; width:226rpx; height:226rpx; top:12rpx; left:52rpx; border-radius:50%; background:#f1f7ff; }
.mascot-shadow { position:absolute; left:104rpx; bottom:20rpx; width:128rpx; height:16rpx; border-radius:50%; background:#dfebfb; filter:blur(3rpx); }
.mascot { position:absolute; left:92rpx; top:32rpx; width:150rpx; height:210rpx; }
.mascot-antenna { position:absolute; top:0; left:73rpx; width:5rpx; height:25rpx; background:#9cbbe7; }.mascot-antenna>view { position:absolute; width:14rpx; height:14rpx; top:-5rpx; left:-5rpx; border:3rpx solid #d7e7ff; border-radius:50%; background:#6ca3ed; }
.mascot-head { position:absolute; z-index:3; top:22rpx; left:6rpx; width:138rpx; height:112rpx; border:3rpx solid #c4d9f5; border-radius:42rpx; background:#fff; box-shadow:inset 0 -8rpx 0 #eef5ff; transform:rotate(-5deg); }
.mascot-face { position:absolute; inset:18rpx 14rpx; border-radius:28rpx; background:#e2f0ff; }.mascot-eyes { display:flex; justify-content:space-between; position:absolute; left:24rpx; right:24rpx; top:23rpx; }.mascot-eye { width:10rpx; height:16rpx; border-radius:8rpx; background:#4777ad; }
.mascot-cheek { position:absolute; top:43rpx; width:16rpx; height:8rpx; border-radius:50%; background:#f7c8c8; }.cheek-left { left:13rpx; }.cheek-right { right:13rpx; }.mascot-smile { position:absolute; left:44rpx; top:41rpx; width:14rpx; height:9rpx; border:2rpx solid #6a91bd; border-top:0; border-radius:0 0 12rpx 12rpx; }
.mascot-ear { position:absolute; z-index:2; top:65rpx; width:16rpx; height:33rpx; border-radius:8rpx; background:#98bceb; }.ear-left { left:-4rpx; }.ear-right { right:-4rpx; }
.mascot-body { position:absolute; z-index:2; top:127rpx; left:31rpx; width:90rpx; height:63rpx; border:3rpx solid #c6dbf6; border-radius:16rpx 16rpx 28rpx 28rpx; background:#fff; box-shadow:inset 0 -7rpx 0 #eef5ff; }.mascot-heart { width:30rpx; height:30rpx; margin:12rpx auto; border-radius:10rpx; background:#dfeeff; color:#7aa5de; font-size:30rpx; line-height:28rpx; font-weight:700; text-align:center; }
.mascot-arm { position:absolute; z-index:1; top:132rpx; width:22rpx; height:44rpx; border:2rpx solid #c6dbf6; border-radius:14rpx; background:#f8fbff; }.arm-left { left:15rpx; transform:rotate(22deg); }.arm-right { right:9rpx; top:115rpx; transform:rotate(-40deg); }
.mascot-foot { position:absolute; top:181rpx; width:27rpx; height:18rpx; border-radius:8rpx; background:#9cbce9; }.foot-left { left:42rpx; }.foot-right { right:38rpx; }
.signal-bubble { position:absolute; right:27rpx; top:18rpx; width:57rpx; height:57rpx; border:3rpx solid #fff; border-radius:19rpx; background:#dfeeff; transform:rotate(10deg); }.signal-mark { position:absolute; left:22rpx; top:12rpx; width:4rpx; height:29rpx; background:#77a4df; }.signal-mark::before,.signal-mark::after { content:''; position:absolute; width:14rpx; height:14rpx; left:-6rpx; border-top:3rpx solid #77a4df; border-right:3rpx solid #77a4df; transform:rotate(45deg); }.signal-mark::before { top:1rpx; }.signal-mark::after { bottom:1rpx; }
.scene-spark { position:absolute; width:10rpx; height:10rpx; border-radius:3rpx; transform:rotate(45deg); }.spark-one { left:36rpx; top:93rpx; background:#b6d5ff; }.spark-two { right:40rpx; bottom:63rpx; width:14rpx; height:14rpx; background:#f5ddba; }
.mascot-searching .signal-bubble { animation:device-float 1.8s ease-in-out infinite; }.mascot-searching .mascot-antenna>view { animation:device-pulse 1.2s ease-in-out infinite; }
@keyframes device-pulse { 50% { opacity:.4; } } @keyframes device-float { 50% { transform:translateY(-8rpx) rotate(5deg); } }
