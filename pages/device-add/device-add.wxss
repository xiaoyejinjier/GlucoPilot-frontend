.device-page {
  --device-brand:#0969da;
  --device-brand-dark:#0550ae;
  --device-brand-soft:#ddf4ff;
  --device-brand-line:rgba(84,174,255,.4);
  --device-bg:#f6f8fa;
  --device-ink:#245b91;
  --device-ink-soft:#315e8e;
  --device-muted:#486b91;
  --device-hint:#557596;
  --device-line:#d1d9e0;
  --device-surface-subtle:#f6f8fa;
  min-height:100vh;
  padding:32rpx 28rpx calc(36rpx + env(safe-area-inset-bottom));
  background:var(--device-bg);
  color:var(--device-ink);
  box-sizing:border-box;
}
.device-intro { padding:4rpx 4rpx 28rpx; }
.device-intro-kicker { display:block; margin-bottom:10rpx; color:var(--device-brand); font-size:var(--fs-small); font-weight:600; }
.device-intro-title { display:block; font-size:var(--fs-title); font-weight:700; letter-spacing:1rpx; }
.device-intro-note { display:block; margin-top:12rpx; color:var(--device-muted); font-size:var(--fs-small); }
.discovery-card { padding:28rpx; border:1rpx solid var(--device-line); border-radius:28rpx; background:#fff; }
.discovery-heading, .device-section-heading { display:flex; align-items:center; justify-content:space-between; gap:16rpx; font-size:var(--fs-body); font-weight:600; }
.search-status { display:flex; align-items:center; gap:8rpx; flex-shrink:0; color:var(--device-hint); font-size:var(--fs-tiny); font-weight:400; }
.status-dot { width:10rpx; height:10rpx; border-radius:50%; background:#c2cbd6; }
.is-searching { color:var(--device-brand); }
.is-searching .status-dot { background:var(--device-brand); animation:device-pulse 1.3s ease-in-out infinite; }
.device-empty { padding:8rpx 0 30rpx; text-align:center; }
.empty-heading { display:block; margin-top:4rpx; color:var(--device-ink-soft); font-size:var(--fs-body); font-weight:600; }
.empty-description { display:block; margin-top:14rpx; color:var(--device-muted); font-size:var(--fs-small); line-height:1.7; }
.empty-subtitle { display:block; margin-top:6rpx; color:var(--device-hint); font-size:var(--fs-tiny); line-height:1.7; }
button { margin:0; padding:0; border:0; outline:none; line-height:1.5; box-sizing:border-box; }
button::after { border:0; }
.search-button { display:flex; align-items:center; justify-content:center; width:100%; min-height:82rpx; padding:18rpx 24rpx; border-radius:18rpx; background:var(--device-brand); color:#fff; font-size:var(--fs-body); font-weight:500; }
.search-button-pressed { background:var(--device-brand-dark); }
.search-footnote { display:block; margin-top:16rpx; color:var(--device-hint); text-align:center; font-size:var(--fs-tiny); line-height:1.6; }
.device-error { display:flex; flex-direction:column; gap:8rpx; padding:18rpx 20rpx; margin:0 0 20rpx; border-radius:14rpx; color:#9a6700; background:#fff8c5; font-size:var(--fs-small); line-height:1.7; }
.settings-link { align-self:flex-end; padding:4rpx 0 4rpx 16rpx; color:var(--device-brand); }
.device-section-heading { margin:30rpx 4rpx 18rpx; }
.section-side-note { flex-shrink:0; color:var(--device-hint); font-size:var(--fs-tiny); font-weight:400; }
.add-methods { display:flex; gap:20rpx; }
.add-method { display:flex; flex:1; flex-direction:column; align-items:center; min-width:0; padding:28rpx 12rpx 24rpx; border:1rpx solid var(--device-line); border-radius:24rpx; background:#fff; }
.method-pressed { background:var(--device-brand-soft); }
.method-icon { display:flex; align-items:center; justify-content:center; position:relative; width:66rpx; height:66rpx; margin-bottom:18rpx; border-radius:18rpx; background:var(--device-brand-soft); color:var(--device-brand); }
.method-title { color:var(--device-ink-soft); font-size:var(--fs-body); font-weight:600; }
.method-description { margin-top:8rpx; color:var(--device-hint); font-size:var(--fs-tiny); white-space:normal; }
.sn-icon { font-family:Arial,sans-serif; font-size:27rpx; font-weight:700; letter-spacing:1rpx; }
.qr-corner { position:absolute; width:13rpx; height:13rpx; border:3rpx solid currentColor; }
.corner-tl { left:15rpx; top:15rpx; border-right:0; border-bottom:0; }.corner-tr { right:15rpx; top:15rpx; border-left:0; border-bottom:0; }
.corner-bl { left:15rpx; bottom:15rpx; border-right:0; border-top:0; }.corner-br { right:15rpx; bottom:15rpx; border-left:0; border-top:0; }
.qr-center { width:12rpx; height:12rpx; border:3rpx solid currentColor; border-radius:2rpx; }
.nearby-list { padding:16rpx 0; }.nearby-warning { display:block; color:var(--device-hint); font-size:var(--fs-tiny); line-height:1.7; }
.nearby-item { display:flex; align-items:center; gap:16rpx; padding:24rpx 0; border-bottom:1rpx solid var(--device-line); }
.nearby-device-icon { display:flex; justify-content:center; align-items:center; flex-shrink:0; width:50rpx; height:64rpx; border:2rpx solid var(--device-brand-line); border-radius:12rpx; background:var(--device-surface-subtle); }
.mini-device-screen { width:28rpx; height:24rpx; margin-top:-12rpx; border-radius:5rpx; background:var(--device-brand-line); }
.nearby-info { flex:1; min-width:0; }.nearby-name { display:block; font-size:var(--fs-small); word-break:break-all; }.nearby-signal { display:block; margin-top:8rpx; color:var(--device-hint); font-size:var(--fs-tiny); }
.candidate-button { flex-shrink:0; padding:10rpx 22rpx; border-radius:24rpx; background:var(--device-brand-soft); color:var(--device-brand); font-size:var(--fs-small); }
.draft-item { padding:24rpx; margin-bottom:16rpx; border:1rpx solid var(--device-line); border-radius:20rpx; background:#fff; }
.draft-item-heading, .draft-item-footer { display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:12rpx; }
.draft-name { font-size:var(--fs-body); font-weight:500; word-break:break-all; }.pending-badge { padding:5rpx 12rpx; border-radius:10rpx; background:var(--device-surface-subtle); color:var(--device-muted); font-size:var(--fs-tiny); }
.draft-serial { display:block; margin-top:12rpx; color:var(--device-muted); font-size:var(--fs-small); word-break:break-all; }.draft-item-footer { margin-top:14rpx; color:var(--device-hint); font-size:var(--fs-tiny); }
.remove-draft { padding:8rpx 0 8rpx 16rpx; color:var(--device-muted); }
.device-preparation-note { margin:28rpx 6rpx 0; color:var(--device-hint); font-size:var(--fs-tiny); line-height:1.9; }.preparation-title { display:block; margin-bottom:6rpx; color:var(--device-muted); font-weight:500; }
.back-to-record { display:block; padding:30rpx 20rpx 8rpx; text-align:center; color:var(--device-muted); font-size:var(--fs-small); }
.serial-overlay { position:fixed; inset:0; z-index:10002; }.serial-mask { position:absolute; inset:0; background:rgba(31,35,40,.4); }
.serial-panel { position:absolute; left:0; right:0; bottom:0; max-height:85vh; overflow-y:auto; padding:30rpx 32rpx calc(32rpx + env(safe-area-inset-bottom)); border-radius:30rpx 30rpx 0 0; background:#fff; }
.serial-heading { display:flex; align-items:center; justify-content:space-between; gap:20rpx; font-size:var(--fs-title); font-weight:600; }.serial-close { flex-shrink:0; padding:12rpx 0 12rpx 20rpx; color:var(--device-muted); font-size:var(--fs-small); font-weight:400; }
.serial-note { display:block; margin:14rpx 0 28rpx; color:var(--device-hint); font-size:var(--fs-small); line-height:1.7; }.input-label { display:block; margin:24rpx 0 14rpx; color:var(--device-muted); font-size:var(--fs-small); }
.required-mark { color:#cf222e; }.optional-label { color:var(--device-hint); }.serial-input { height:88rpx; padding:0 22rpx; border:1rpx solid var(--device-line); border-radius:16rpx; background:var(--device-surface-subtle); color:var(--device-ink-soft); font-size:var(--fs-body); }
.serial-error { display:block; margin-top:16rpx; color:#cf222e; font-size:var(--fs-small); line-height:1.7; }.serial-save { margin-top:32rpx; }.serial-footnote { display:block; margin-top:18rpx; text-align:center; color:var(--device-hint); font-size:var(--fs-tiny); line-height:1.7; }

.serial-placeholder { color:var(--device-hint); }

@keyframes device-pulse { 50% { opacity:.4; } }
