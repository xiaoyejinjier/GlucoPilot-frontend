.disclaimer-scroll {
  max-height: 400rpx;
}

.disclaimer-text {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.disclaimer-para {
  font-size: var(--fs-small);
  line-height: 1.6;
  color: #333;
}

.disclaimer-hint {
  text-align: center;
  color: #6b7280;
  font-size: var(--fs-small);
  margin-top: 16rpx;
}

.btn-primary.disabled {
  background: #ccc !important;
  color: #fff;
}
