.disclaimer-page {
  height: 100vh;
  min-height: 100vh;
  padding: 0 0 env(safe-area-inset-bottom);
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.disclaimer-head {
  flex: none;
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx 32rpx 20rpx;
}

.disclaimer-mark {
  width: 64rpx;
  height: 64rpx;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--brand-soft);
  color: var(--brand-dark);
  font-size: 38rpx;
  line-height: 1;
  font-weight: 800;
}

.disclaimer-head-copy {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.disclaimer-title {
  color: var(--ink);
  font-size: var(--fs-title);
  line-height: 1.3;
  font-weight: 700;
}

.disclaimer-subtitle {
  color: var(--muted);
  font-size: var(--fs-small);
  line-height: 1.5;
}

.disclaimer-card {
  flex: 1;
  min-height: 0;
  margin: 8rpx 24rpx 16rpx;
  padding: 8rpx 8rpx 8rpx 28rpx;
  border: 1rpx solid var(--line);
  box-shadow: 0 8rpx 28rpx rgba(28, 28, 28, 0.05);
  display: flex;
  flex-direction: column;
}

.disclaimer-scroll {
  flex: 1;
  width: 100%;
  height: 0;
  min-height: 0;
}

.disclaimer-text {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
  padding: 26rpx 24rpx 36rpx 0;
}

.disclaimer-para {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  color: var(--ink);
}

.para-index {
  width: 42rpx;
  height: 42rpx;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 3rpx;
  border-radius: 12rpx;
  background: var(--brand-soft);
  color: var(--brand-dark);
  font-size: var(--fs-small);
  line-height: 42rpx;
  text-align: center;
  font-weight: 700;
}

.para-content {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-body);
  line-height: 1.85;
  letter-spacing: 1rpx;
}

.disclaimer-end {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  color: var(--muted);
  font-size: var(--fs-small);
  padding-top: 8rpx;
}

.end-line {
  width: 56rpx;
  height: 1rpx;
  background: var(--line);
}

.disclaimer-footer {
  flex: none;
  padding: 4rpx 24rpx 20rpx;
  background: var(--bg);
}

.scroll-hint {
  display: block;
  margin-bottom: 14rpx;
  color: var(--muted);
  font-size: var(--fs-small);
  line-height: 1.4;
  text-align: center;
}

.agree-button {
  min-height: 92rpx;
  border-radius: 20rpx;
  font-size: var(--fs-body);
}

.btn-primary.disabled {
  background: #c9cecb !important;
  color: #fff;
}
