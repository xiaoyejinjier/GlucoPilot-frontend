<view class="page-no-tab my-articles-page" style="{{displayStyle}}"><view class="articles-heading"><view><text class="articles-title">每一份分享，都值得认真</text><text class="articles-subtitle">文章进度与尚未完成的分享</text></view><text class="new-article" bindtap="onWrite">＋ 写文章</text></view>
  <view class="article-mode-tabs"><text class="{{mode === 'articles' ? 'selected' : ''}}" data-mode="articles" bindtap="onMode">我的文章</text><text class="{{mode === 'drafts' ? 'selected' : ''}}" data-mode="drafts" bindtap="onMode">草稿箱</text></view>
  <view wx:for="{{articles}}" wx:key="id" class="my-article-card"><view class="article-card-top"><text class="status-badge {{item.statusInfo.tone}}">{{item.statusInfo.label}}</text><text class="article-date">{{item.timeLabel}}</text></view><text class="my-article-title" data-id="{{item.id}}" bindtap="onOpen">{{item.title}}</text><text class="my-article-summary">{{item.summary}}</text><view class="my-article-tags"><text wx:for="{{item.tags}}" wx:for-item="tag" wx:key="code"># {{tag.name}}</text></view><view class="article-state-copy"><text>{{item.reviewNote || item.aiReason || item.statusInfo.hint}}</text></view><view class="my-article-actions"><text>第 {{item.revision}} 版</text><view><text wx:if="{{item.state === 'PUBLISHED'}}" data-id="{{item.id}}" bindtap="onOpen">查看文章</text><text wx:if="{{item.state === 'AI_ERROR'}}" data-id="{{item.id}}" bindtap="onRetryAi">{{retrying === item.id ? '提交中…' : '重新初审'}}</text><text wx:if="{{mode === 'drafts'}}" data-id="{{item.id}}" bindtap="onDeleteDraft">删除</text><text data-id="{{item.id}}" bindtap="onEdit">{{mode === 'drafts' ? '继续编辑' : item.state === 'REJECTED' || item.state === 'AI_REJECTED' || item.state === 'HIDDEN' ? '修改并重投' : '编辑文章'}}</text></view></view></view>
  <view wx:if="{{loading}}" class="article-state">正在加载…</view><view wx:elif="{{error}}" class="article-state" bindtap="onRetry">{{error}} · 点击重试</view><view wx:elif="{{!articles.length}}" class="articles-empty"><text class="empty-pencil">✎</text><text>{{mode === 'drafts' ? '草稿箱暂时没有内容' : '你的第一篇分享，从这里开始'}}</text><text class="empty-hint">真实的经历，也能为其他糖友带来帮助。</text><button bindtap="onWrite">写一篇文章</button></view><view wx:elif="{{hasMore}}" class="article-state" bindtap="onMore">加载更多</view>
</view>
