<wxs module="i18n" src="/utils/i18n.wxs" />
<view class="page-no-tab my-articles-page" style="{{displayStyle}}">
  <view wx:if="{{locale === 'en' && (contentTranslationLoading || contentTranslationError)}}" class="content-translation-notice" bindtap="retryContentTranslations" aria-role="button"><text>{{i18n.t(contentTranslationLoading ? '正在准备英文内容…' : '暂时无法翻译，正在显示原文，点击重试', locale)}}</text></view>
  <view class="creator-hero"><view class="creator-orbit"></view><view class="creator-paper paper-back"></view><view class="creator-paper paper-front"><view></view><view></view><view></view><text>✎</text></view><view class="creator-spark"></view><text class="creator-eyebrow">{{i18n.t("我的创作空间", locale)}}</text><text class="articles-title">{{i18n.t("把生活，写成分享", locale)}}</text><text class="articles-subtitle">{{i18n.t("每一份真实的经历，都值得被看见。", locale)}}</text><button class="new-article ui-interactive" bindtap="onWrite" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}"><text>＋</text>{{i18n.t("写文章", locale)}}</button></view>
  <view class="article-mode-tabs"><view class="mode-tab {{mode === 'articles' ? 'selected' : ''}} ui-interactive" data-mode="articles" bindtap="onMode" aria-role="button" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}"><view class="tab-article-symbol"></view><text>{{i18n.t("我的文章", locale)}}</text><text wx:if="{{mode === 'articles' && totalCount !== ''}}" class="mode-count">{{i18n.t((totalCount), locale)}}</text></view><view class="mode-tab {{mode === 'drafts' ? 'selected' : ''}} ui-interactive" data-mode="drafts" bindtap="onMode" aria-role="button" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}"><view class="tab-draft-symbol"></view><text>{{i18n.t("草稿箱", locale)}}</text><text wx:if="{{mode === 'drafts' && totalCount !== ''}}" class="mode-count">{{i18n.t((totalCount), locale)}}</text></view></view>
  <view class="article-list-heading"><text>{{i18n.t((mode === 'drafts' ? '留住还没写完的灵感' : '每一份分享，都在这里'), locale)}}</text><text class="list-heading-note">{{i18n.t((mode === 'drafts' ? '仅自己可见' : '按时间排列'), locale)}}</text></view>
  <view wx:for="{{articles}}" wx:key="id" class="my-article-card">
    <view wx:if="{{mode !== 'drafts'}}" class="article-visibility-row ui-interactive" data-id="{{item.id}}" bindtap="onVisibility" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}"><text>{{i18n.t((item.visibilityLabel), locale)}}</text><text>{{i18n.t("修改可见范围 ›", locale)}}</text></view>
    <view class="article-card-top"><view class="status-badge {{item.statusInfo.tone}}"><view class="status-dot"></view><text>{{i18n.t((item.statusInfo.label), locale)}}</text></view><text class="article-date">{{i18n.t((item.timeLabel), locale)}}</text></view>
    <view class="article-content ui-interactive" data-id="{{item.id}}" bindtap="onArticleCard" aria-role="button" aria-label="{{i18n.t((item.state === 'PUBLISHED' ? '查看' : '编辑') + '文章：' + ((mode === 'drafts' ? item.title : i18n.content(contentTranslations, 'ARTICLE_PREVIEW', item.id, 'title', item.title, locale))), locale)}}" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}"><view class="article-copy"><text class="my-article-title">{{(mode === 'drafts' ? item.title : i18n.content(contentTranslations, 'ARTICLE_PREVIEW', item.id, 'title', item.title, locale))}}</text><text wx:if="{{(mode === 'drafts' ? item.summary : i18n.content(contentTranslations, 'ARTICLE_PREVIEW', item.id, 'summary', item.summary, locale))}}" class="my-article-summary">{{(mode === 'drafts' ? item.summary : i18n.content(contentTranslations, 'ARTICLE_PREVIEW', item.id, 'summary', item.summary, locale))}}</text></view><view wx:if="{{item.videos.length}}" class="article-thumbnail"><article-video-cover media-id="{{item.videos[0].mediaId}}"></article-video-cover></view><view wx:elif="{{item.images.length}}" class="article-thumbnail"><article-photo media-id="{{item.images[0].mediaId}}" mode="aspectFill" preview-enabled="{{false}}"></article-photo></view></view>
    <view wx:if="{{item.tags.length}}" class="my-article-tags"><text wx:for="{{item.tags}}" wx:for-item="tag" wx:key="code"># {{tag.name}}</text></view>
    <view wx:if="{{item.state === 'PUBLISHED'}}" class="article-views">{{i18n.t((item.viewCount || 0) + " 次浏览", locale)}}</view>
    <view wx:if="{{item.state === 'PUBLISHED'}}" class="article-interactions"><view><image src="/assets/icons/social-like.svg" />{{i18n.t((item.likeCount || 0), locale)}}<text>{{i18n.t("点赞", locale)}}</text></view><view><image src="/assets/icons/social-collect.svg" />{{i18n.t((item.collectCount || 0), locale)}}<text>{{i18n.t("收藏", locale)}}</text></view><view><image src="/assets/icons/social-comment.svg" />{{i18n.t((item.commentCount || 0), locale)}}<text>{{i18n.t("评论", locale)}}</text></view></view>
    <view wx:elif="{{mode !== 'drafts'}}" class="article-state-copy {{item.statusInfo.tone}}"><view class="review-note-heading"><view class="review-note-dot"></view><text>{{i18n.t((item.statusInfo.tone === 'danger' ? '修改建议' : item.statusInfo.tone === 'waiting' ? '审核进度' : '审核提示'), locale)}}</text></view><view wx:if="{{item.statusInfo.tone === 'waiting'}}" class="review-steps"><view class="review-step {{item.statusInfo.step >= 1 ? 'current' : ''}}"><text class="review-step-dot">{{i18n.t((item.statusInfo.step > 1 ? '✓' : '1'), locale)}}</text><text>{{i18n.t("AI 初审", locale)}}</text></view><view class="review-connector {{item.statusInfo.step > 1 ? 'completed' : ''}}"></view><view class="review-step {{item.statusInfo.step >= 2 ? 'current' : ''}}"><text class="review-step-dot">2</text><text>{{i18n.t("管理员终审", locale)}}</text></view><view class="review-connector"></view><view class="review-step"><text class="review-step-dot">3</text><text>{{i18n.t("审核完成", locale)}}</text></view></view><text class="review-note">{{i18n.t((item.reviewNote || item.aiReason || item.statusInfo.hint), locale)}}</text></view>
    <view wx:else class="draft-save-hint"><view class="save-dot"></view><text>{{i18n.t("已保存，继续完善后即可发布", locale)}}</text></view>
    <view class="my-article-actions"><text class="article-revision">{{i18n.t((item.revision ? '第 ' + item.revision + ' 版' : mode === 'drafts' ? '草稿' : '文章'), locale)}}</text><view class="article-action-buttons"><button wx:if="{{item.state === 'PUBLISHED'}}" class="article-action secondary ui-interactive" data-id="{{item.id}}" bindtap="onOpen" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}">{{i18n.t("查看文章", locale)}}</button><button wx:if="{{item.state === 'AI_ERROR'}}" class="article-action secondary ui-interactive" data-id="{{item.id}}" bindtap="onRetryAi" disabled="{{!!retrying}}" loading="{{retrying === item.id}}" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}">{{i18n.t("重新初审", locale)}}</button><button wx:if="{{mode === 'drafts'}}" class="article-action draft-delete ui-interactive" data-id="{{item.id}}" bindtap="onDeleteDraft" disabled="{{!!retrying}}" loading="{{retrying === item.id}}" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}">{{i18n.t("删除", locale)}}</button><button class="article-action primary ui-interactive" data-id="{{item.id}}" bindtap="onEdit" disabled="{{!!retrying}}" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}">{{i18n.t((mode === 'drafts' ? '继续编辑' : item.state === 'REJECTED' || item.state === 'AI_REJECTED' || item.state === 'HIDDEN' ? '修改并重投' : '编辑文章'), locale)}}<text> ↗</text></button></view></view>
  </view>
  <view wx:if="{{loading && !articles.length}}" class="my-article-card creator-skeleton"><view class="skeleton-badge"></view><view class="skeleton-title"></view><view class="skeleton-copy"></view><view class="skeleton-copy short"></view></view>
  <view wx:elif="{{error}}" class="articles-empty"><view class="empty-pencil">!</view><text class="empty-title">{{i18n.t("暂时没能加载内容", locale)}}</text><text class="empty-hint">{{i18n.t((error), locale)}}</text><button class="ui-interactive" bindtap="onRetry" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}">{{i18n.t("重新加载", locale)}}</button></view>
  <view wx:elif="{{!articles.length}}" class="articles-empty"><view class="empty-notebook"><view></view><view></view><view></view><text>✎</text></view><text class="empty-title">{{i18n.t((mode === 'drafts' ? '灵感可以慢慢写' : '第一篇分享，等你落笔'), locale)}}</text><text class="empty-hint">{{i18n.t((mode === 'drafts' ? '没写完的文章存为草稿，下次接着写。' : '一段记录、一次发现，都可以成为分享的开始。'), locale)}}</text><button class="ui-interactive" bindtap="onWrite" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}">{{i18n.t("写下第一笔", locale)}} <text>↗</text></button></view>
  <view wx:elif="{{loading}}" class="article-state">{{i18n.t("正在加载更多…", locale)}}</view><view wx:elif="{{hasMore}}" class="article-state article-more ui-interactive" bindtap="onMore" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}">{{i18n.t("查看更多内容 ↓", locale)}}</view><view wx:else class="article-list-end"><view></view><text>{{i18n.t((mode === 'drafts' ? '下一段灵感，随时继续' : '认真分享，也温暖彼此'), locale)}}</text><view></view></view>
</view>

<article-visibility visible="{{visibilityOpen}}" value="{{visibilityArticle.visibility}}" viewer-ids="{{visibilityArticle.viewerIds}}" busy="{{visibilityBusy}}" display-style="{{displayStyle}}" bind:close="onVisibilityClose" bind:confirm="onVisibilityConfirm"></article-visibility>
