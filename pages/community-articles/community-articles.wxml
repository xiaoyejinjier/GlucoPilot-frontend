<view class="page-no-tab my-articles-page" style="{{displayStyle}}">
  <view class="creator-hero"><view class="creator-orbit"></view><view class="creator-paper paper-back"></view><view class="creator-paper paper-front"><view></view><view></view><view></view><text>✎</text></view><view class="creator-spark"></view><text class="creator-eyebrow">我的创作空间</text><text class="articles-title">把生活，写成分享</text><text class="articles-subtitle">每一份真实的经历，都值得被看见。</text><button class="new-article" bindtap="onWrite"><text>＋</text>写文章</button></view>
  <view class="article-mode-tabs"><view class="mode-tab {{mode === 'articles' ? 'selected' : ''}}" data-mode="articles" bindtap="onMode" aria-role="button"><view class="tab-article-symbol"></view><text>我的文章</text><text wx:if="{{mode === 'articles' && totalCount !== ''}}" class="mode-count">{{totalCount}}</text></view><view class="mode-tab {{mode === 'drafts' ? 'selected' : ''}}" data-mode="drafts" bindtap="onMode" aria-role="button"><view class="tab-draft-symbol"></view><text>草稿箱</text><text wx:if="{{mode === 'drafts' && totalCount !== ''}}" class="mode-count">{{totalCount}}</text></view></view>
  <view class="article-list-heading"><text>{{mode === 'drafts' ? '留住还没写完的灵感' : '每一份分享，都在这里'}}</text><text class="list-heading-note">{{mode === 'drafts' ? '仅自己可见' : '按时间排列'}}</text></view>
  <view wx:for="{{articles}}" wx:key="id" class="my-article-card">
    <view wx:if="{{mode !== 'drafts'}}" class="article-visibility-row" data-id="{{item.id}}" bindtap="onVisibility"><text>{{item.visibilityLabel}}</text><text>修改可见范围 ›</text></view>
    <view class="article-card-top"><view class="status-badge {{item.statusInfo.tone}}"><view class="status-dot"></view><text>{{item.statusInfo.label}}</text></view><text class="article-date">{{item.timeLabel}}</text></view>
    <view class="article-content" data-id="{{item.id}}" bindtap="onArticleCard" aria-role="button" aria-label="{{item.state === 'PUBLISHED' ? '查看' : '编辑'}}文章：{{item.title}}"><view class="article-copy"><text class="my-article-title">{{item.title}}</text><text wx:if="{{item.summary}}" class="my-article-summary">{{item.summary}}</text></view><view wx:if="{{item.images.length}}" class="article-thumbnail"><article-photo media-id="{{item.images[0].mediaId}}" mode="aspectFill" preview-enabled="{{false}}"></article-photo></view><view wx:elif="{{item.videos.length}}" class="article-thumbnail video-thumbnail"><view class="video-play"></view><text>视频分享</text></view></view>
    <view wx:if="{{item.tags.length}}" class="my-article-tags"><text wx:for="{{item.tags}}" wx:for-item="tag" wx:key="code"># {{tag.name}}</text></view>
    <view wx:if="{{item.state === 'PUBLISHED'}}" class="article-views">{{item.viewCount || 0}} 次浏览</view>
    <view wx:if="{{item.state === 'PUBLISHED'}}" class="article-interactions"><view><image src="/assets/icons/social-like.svg" />{{item.likeCount || 0}}<text>点赞</text></view><view><image src="/assets/icons/social-collect.svg" />{{item.collectCount || 0}}<text>收藏</text></view><view><image src="/assets/icons/social-comment.svg" />{{item.commentCount || 0}}<text>评论</text></view></view>
    <view wx:elif="{{mode !== 'drafts'}}" class="article-state-copy {{item.statusInfo.tone}}"><view class="review-note-heading"><view class="review-note-dot"></view><text>{{item.statusInfo.tone === 'danger' ? '修改建议' : item.statusInfo.tone === 'waiting' ? '审核进度' : '审核提示'}}</text></view><view wx:if="{{item.statusInfo.tone === 'waiting'}}" class="review-steps"><view class="review-step {{item.statusInfo.step >= 1 ? 'current' : ''}}"><text class="review-step-dot">{{item.statusInfo.step > 1 ? '✓' : '1'}}</text><text>AI 初审</text></view><view class="review-connector {{item.statusInfo.step > 1 ? 'completed' : ''}}"></view><view class="review-step {{item.statusInfo.step >= 2 ? 'current' : ''}}"><text class="review-step-dot">2</text><text>管理员终审</text></view><view class="review-connector"></view><view class="review-step"><text class="review-step-dot">3</text><text>审核完成</text></view></view><text class="review-note">{{item.reviewNote || item.aiReason || item.statusInfo.hint}}</text></view>
    <view wx:else class="draft-save-hint"><view class="save-dot"></view><text>已保存，继续完善后即可发布</text></view>
    <view class="my-article-actions"><text class="article-revision">{{item.revision ? '第 ' + item.revision + ' 版' : mode === 'drafts' ? '草稿' : '文章'}}</text><view class="article-action-buttons"><button wx:if="{{item.state === 'PUBLISHED'}}" class="article-action secondary" data-id="{{item.id}}" bindtap="onOpen">查看文章</button><button wx:if="{{item.state === 'AI_ERROR'}}" class="article-action secondary" data-id="{{item.id}}" bindtap="onRetryAi" disabled="{{!!retrying}}" loading="{{retrying === item.id}}">重新初审</button><button wx:if="{{mode === 'drafts'}}" class="article-action draft-delete" data-id="{{item.id}}" bindtap="onDeleteDraft" disabled="{{!!retrying}}" loading="{{retrying === item.id}}">删除</button><button class="article-action primary" data-id="{{item.id}}" bindtap="onEdit" disabled="{{!!retrying}}">{{mode === 'drafts' ? '继续编辑' : item.state === 'REJECTED' || item.state === 'AI_REJECTED' || item.state === 'HIDDEN' ? '修改并重投' : '编辑文章'}}<text> ↗</text></button></view></view>
  </view>
  <view wx:if="{{loading && !articles.length}}" class="my-article-card creator-skeleton"><view class="skeleton-badge"></view><view class="skeleton-title"></view><view class="skeleton-copy"></view><view class="skeleton-copy short"></view></view>
  <view wx:elif="{{error}}" class="articles-empty"><view class="empty-pencil">!</view><text class="empty-title">暂时没能加载内容</text><text class="empty-hint">{{error}}</text><button bindtap="onRetry">重新加载</button></view>
  <view wx:elif="{{!articles.length}}" class="articles-empty"><view class="empty-notebook"><view></view><view></view><view></view><text>✎</text></view><text class="empty-title">{{mode === 'drafts' ? '灵感可以慢慢写' : '第一篇分享，等你落笔'}}</text><text class="empty-hint">{{mode === 'drafts' ? '没写完的文章存为草稿，下次接着写。' : '一段记录、一次发现，都可以成为分享的开始。'}}</text><button bindtap="onWrite">写下第一笔 <text>↗</text></button></view>
  <view wx:elif="{{loading}}" class="article-state">正在加载更多…</view><view wx:elif="{{hasMore}}" class="article-state article-more" bindtap="onMore">查看更多内容 ↓</view><view wx:else class="article-list-end"><view></view><text>{{mode === 'drafts' ? '下一段灵感，随时继续' : '认真分享，也温暖彼此'}}</text><view></view></view>
</view>

<article-visibility visible="{{visibilityOpen}}" value="{{visibilityArticle.visibility}}" viewer-ids="{{visibilityArticle.viewerIds}}" busy="{{visibilityBusy}}" display-style="{{displayStyle}}" bind:close="onVisibilityClose" bind:confirm="onVisibilityConfirm"></article-visibility>
