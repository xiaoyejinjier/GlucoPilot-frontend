.my-articles-page{padding:24rpx 26rpx calc(32rpx + env(safe-area-inset-bottom));min-height:100vh;background:#f5f8f6}.articles-heading{display:flex;align-items:center;gap:20rpx;justify-content:space-between;margin:14rpx 0 28rpx}.articles-heading>view{flex:1;min-width:0}.articles-title{display:block;font-size:var(--fs-body);font-weight:600;color:#435b4c;line-height:1.6}.articles-subtitle{display:block;font-size:var(--fs-small);color:#9bab9f;margin-top:8rpx}.new-article{font-size:var(--fs-small);color:#4f8962;background:#e7f2ea;padding:16rpx 20rpx;border-radius:24rpx;flex-shrink:0}.my-article-card{padding:28rpx;background:white;border-radius:26rpx;margin-bottom:22rpx}.article-card-top{display:flex;align-items:center;justify-content:space-between;gap:12rpx}.status-badge{font-size:20rpx;padding:8rpx 16rpx;border-radius:10rpx;background:#f3f5f3;color:#95a298}.status-badge.waiting{background:#fff5df;color:#b28d43}.status-badge.success{background:#eaf6ee;color:#4c9564}.status-badge.danger{background:#fff0ed;color:#bf7c6d}.status-badge.warning{background:#fff5e9;color:#b69053}.article-date{color:#afbab2;font-size:18rpx}.my-article-title{display:block;font-size:var(--fs-title);font-weight:600;color:#3d5545;margin-top:24rpx;line-height:1.5}.my-article-summary{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;font-size:var(--fs-body);color:#97a49b;line-height:1.7;margin-top:12rpx}.my-article-tags{display:flex;flex-wrap:wrap;gap:16rpx;margin-top:18rpx;color:#7c9a87;font-size:var(--fs-small)}.article-state-copy{background:#f7f9f7;padding:18rpx 20rpx;border-radius:14rpx;font-size:var(--fs-small);line-height:1.8;color:#8d9f92;margin-top:24rpx;overflow-wrap:anywhere}.my-article-actions{display:flex;justify-content:space-between;gap:16rpx;align-items:center;margin-top:22rpx;font-size:var(--fs-small);color:#b3bdb6}.my-article-actions>view{display:flex;gap:26rpx;color:#5a906b}.article-state{padding:30rpx;text-align:center;color:#96a49a;font-size:var(--fs-small)}.articles-empty{display:flex;align-items:center;text-align:center;flex-direction:column;background:white;border-radius:26rpx;padding:70rpx 30rpx;gap:22rpx;font-size:var(--fs-body);color:#6a8874}.empty-pencil{font-size:70rpx;color:#a4bca9}.empty-hint{font-size:var(--fs-small);line-height:1.8;color:#a1afa5}.articles-empty button{background:#eaf4ed;color:#518865;font-size:var(--fs-small);border-radius:28rpx;padding:0 30rpx}.articles-empty button::after{border:0}

.article-mode-tabs{display:flex;gap:32rpx;margin:0 4rpx 26rpx;color:#9aa99e;font-size:var(--fs-body)}.article-mode-tabs text{padding:12rpx 0;border-bottom:4rpx solid transparent}.article-mode-tabs .selected{color:#4d805d;font-weight:600;border-color:#4d805d}
