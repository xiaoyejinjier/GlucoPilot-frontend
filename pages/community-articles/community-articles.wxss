.my-articles-page{padding:24rpx 28rpx calc(44rpx + env(safe-area-inset-bottom));min-height:100vh;background:var(--bg);color:var(--ink)}
.creator-hero{position:relative;overflow:hidden;padding:34rpx 34rpx 30rpx;border-radius:30rpx;background:linear-gradient(112deg,var(--brand-dark),var(--brand));box-shadow:0 12rpx 30rpx rgba(30,70,120,.1);color:#fff}.creator-eyebrow{position:relative;z-index:1;display:block;font-size:var(--fs-tiny);letter-spacing:3rpx;color:#d7e8fb}.articles-title{position:relative;z-index:1;display:block;max-width:78%;font-size:43rpx;line-height:1.5;font-weight:700;letter-spacing:1rpx;margin-top:14rpx}.articles-subtitle{position:relative;z-index:1;display:block;max-width:72%;font-size:var(--fs-small);color:#d7e8fb;line-height:1.8;margin-top:8rpx}.new-article{position:relative;z-index:1;display:inline-flex;align-items:center;justify-content:center;gap:10rpx;min-height:62rpx;width:auto;margin:24rpx 0 0;padding:10rpx 24rpx;border:0;border-radius:16rpx;background:var(--brand-soft);color:var(--ink-soft);font-size:var(--fs-small);font-weight:600;line-height:1.6}.new-article::after{border:0}.new-article>text{font-size:29rpx;font-weight:400}.creator-orbit{position:absolute;right:-95rpx;top:-70rpx;width:300rpx;height:300rpx;border-radius:50%;border:1rpx solid rgba(210,230,255,.2);box-shadow:0 0 0 44rpx rgba(220,235,255,.05)}.creator-paper{position:absolute;width:104rpx;height:138rpx;right:44rpx;bottom:28rpx;border-radius:12rpx;transform:rotate(12deg);background:#85addd}.paper-back{right:26rpx;bottom:36rpx;transform:rotate(21deg);background:rgba(170,200,235,.35)}.paper-front{background:#ddf4ff;transform:rotate(-11deg);padding:24rpx 17rpx;box-shadow:0 10rpx 24rpx rgba(30,64,39,.12)}.paper-front>view{height:4rpx;border-radius:4rpx;background:#a7c5e7;margin-bottom:14rpx}.paper-front>view:nth-child(2){width:72%}.paper-front>view:nth-child(3){width:87%}.paper-front>text{position:absolute;right:2rpx;bottom:-20rpx;font-size:65rpx;color:#99b7d9;transform:rotate(12deg)}.creator-spark{position:absolute;right:24rpx;top:95rpx;width:13rpx;height:13rpx;background:#bed5ef;border-radius:4rpx;transform:rotate(45deg)}
.article-mode-tabs{display:flex;gap:10rpx;background:var(--line);padding:8rpx;border-radius:22rpx;margin-top:28rpx}.mode-tab{display:flex;align-items:center;justify-content:center;gap:12rpx;flex:1;min-width:0;min-height:78rpx;border-radius:16rpx;padding:14rpx 8rpx;color:var(--hint);font-size:var(--fs-body);line-height:1.5}.mode-tab.selected{background:#fff;color:var(--brand-dark);font-weight:650;box-shadow:0 3rpx 10rpx rgba(31,35,40,.04)}.mode-count{border-radius:10rpx;background:var(--brand-soft);color:var(--muted);font-size:var(--fs-tiny);padding:1rpx 10rpx}.tab-article-symbol{width:22rpx;height:27rpx;border:2rpx solid currentColor;border-radius:4rpx;position:relative;flex-shrink:0}.tab-article-symbol::after{content:'';position:absolute;left:4rpx;right:4rpx;top:8rpx;border-top:2rpx solid currentColor;box-shadow:0 6rpx 0 currentColor}.tab-draft-symbol{width:27rpx;height:22rpx;border:2rpx solid currentColor;border-radius:4rpx;position:relative;flex-shrink:0}.tab-draft-symbol::before{content:'';position:absolute;left:0;top:-7rpx;width:12rpx;height:5rpx;border:2rpx solid currentColor;border-bottom:0;border-radius:4rpx 4rpx 0 0}
.article-list-heading{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12rpx;margin:30rpx 4rpx 24rpx;font-size:var(--fs-small);color:var(--muted)}.list-heading-note{font-size:var(--fs-tiny);color:var(--hint)}.my-article-card{padding:28rpx;background:#fff;border-radius:28rpx;margin-bottom:24rpx;border:1rpx solid var(--line);box-shadow:0 5rpx 20rpx rgba(31,35,40,.025)}.article-card-top{display:flex;align-items:center;justify-content:space-between;gap:14rpx;flex-wrap:wrap}.status-badge{display:flex;align-items:center;gap:8rpx;font-size:var(--fs-tiny);padding:8rpx 14rpx;border-radius:10rpx;background:#f0f3ee;color:var(--hint);line-height:1.5}.status-dot{width:7rpx;height:7rpx;border-radius:50%;background:currentColor;flex-shrink:0}.status-badge.waiting{background:#fbf3e1;color:#b1975c}.status-badge.success{background:var(--brand-soft);color:var(--brand)}.status-badge.danger{background:#fbefec;color:#ba897b}.status-badge.warning{background:#fbf3e6;color:#b89a65}.article-date{color:var(--hint);font-size:var(--fs-tiny);font-variant-numeric:tabular-nums}.article-content{display:flex;align-items:center;gap:24rpx;margin-top:24rpx}.article-copy{flex:1;min-width:0}.my-article-title{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;font-size:var(--fs-title);font-weight:650;line-height:1.55;color:var(--ink);overflow-wrap:anywhere}.my-article-summary{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;font-size:var(--fs-small);color:var(--muted);line-height:1.8;margin-top:12rpx;overflow-wrap:anywhere}.article-thumbnail{width:148rpx;height:152rpx;flex-shrink:0;border-radius:18rpx;overflow:hidden;background:var(--surface-subtle)}.article-thumbnail article-photo,.article-thumbnail article-video-cover{display:block;width:100%;height:100%}.my-article-tags{display:flex;flex-wrap:wrap;gap:12rpx;margin-top:22rpx}.my-article-tags text{padding:6rpx 12rpx;border-radius:8rpx;background:var(--surface-subtle);color:var(--brand);font-size:var(--fs-tiny);max-width:100%;overflow-wrap:anywhere}
.article-interactions{display:flex;gap:30rpx;margin-top:24rpx;color:var(--muted);font-size:var(--fs-small);flex-wrap:wrap}.article-interactions>view{display:flex;align-items:center;gap:8rpx}.article-interactions image{width:25rpx;height:25rpx;opacity:.8}.article-interactions text{font-size:var(--fs-tiny);color:var(--hint);margin-left:2rpx}.article-state-copy{padding:20rpx 22rpx;border-radius:18rpx;background:var(--surface-subtle);margin-top:24rpx;color:var(--muted);overflow-wrap:anywhere}.article-state-copy.waiting{background:#faf7ef}.article-state-copy.danger{background:#fbf4f0}.review-note-heading{display:flex;align-items:center;gap:10rpx;font-size:var(--fs-tiny);font-weight:600;color:#9b9f80}.danger .review-note-heading{color:#b89888}.review-note-dot{width:6rpx;height:6rpx;flex-shrink:0;border-radius:50%;background:currentColor}.review-note{display:block;font-size:var(--fs-small);line-height:1.9;margin-top:10rpx;color:var(--muted)}.danger .review-note{color:#98816f}.review-steps{display:flex;align-items:flex-start;gap:8rpx;margin:20rpx 0 16rpx}.review-step{display:flex;align-items:center;flex-direction:column;gap:8rpx;font-size:var(--fs-tiny);line-height:1.6;color:#c3c4b1;text-align:center;min-width:0;max-width:34%;overflow-wrap:anywhere}.review-step-dot{width:29rpx;height:29rpx;display:flex;align-items:center;justify-content:center;border:1rpx solid #dfdfcf;background:#f4f3ea;border-radius:50%;font-size:17rpx;flex-shrink:0}.review-step.current{color:#9d965f}.review-step.current .review-step-dot{border-color:#c8c5a1;background:#e9e7ca;color:#918d55}.review-connector{flex:1;min-width:6rpx;height:1rpx;background:#e2e2d2;margin-top:14rpx}.review-connector.completed{background:#c7c7a0}.draft-save-hint{display:flex;align-items:center;gap:10rpx;font-size:var(--fs-tiny);color:var(--hint);margin-top:24rpx;line-height:1.7}.save-dot{width:7rpx;height:7rpx;border-radius:50%;background:var(--brand);flex-shrink:0}
.my-article-actions{display:flex;flex-direction:row;flex-wrap:nowrap;justify-content:space-between;gap:16rpx;align-items:center;margin-top:24rpx;padding-top:22rpx;border-top:1rpx solid var(--surface-subtle)}.article-revision{flex-shrink:0;font-size:var(--fs-tiny);color:var(--hint);white-space:nowrap}.article-action-buttons{display:flex;flex-direction:row;flex-wrap:nowrap;justify-content:flex-end;gap:14rpx;flex:1;min-width:0;margin-left:auto}.article-action{display:flex;align-items:center;justify-content:center;flex:1;gap:5rpx;min-height:60rpx;min-width:0!important;max-width:240rpx;width:0!important;margin:0!important;border-radius:14rpx;padding:12rpx;font-size:var(--fs-small);line-height:1.5;font-weight:500;white-space:nowrap}.article-action::after{border:0}.article-action.primary{background:var(--brand-soft);color:var(--muted)}.article-action.secondary{background:var(--surface-subtle);color:var(--hint)}.article-action.draft-delete{background:transparent;color:var(--hint)}.article-action[disabled]{opacity:.6}
.article-state{padding:28rpx;text-align:center;color:var(--hint);font-size:var(--fs-small)}.article-more{color:var(--muted)}.article-list-end{display:flex;align-items:center;justify-content:center;gap:18rpx;padding:20rpx 0;font-size:var(--fs-tiny);color:var(--hint)}.article-list-end>view{width:40rpx;height:1rpx;background:var(--line)}.articles-empty{display:flex;align-items:center;text-align:center;flex-direction:column;background:#fff;border:1rpx solid var(--line);border-radius:28rpx;padding:64rpx 30rpx;gap:22rpx}.empty-title{font-size:var(--fs-body);color:var(--muted);font-weight:600;line-height:1.7}.empty-hint{font-size:var(--fs-small);line-height:1.9;color:var(--hint);overflow-wrap:anywhere}.empty-pencil{display:flex;align-items:center;justify-content:center;width:70rpx;height:70rpx;border-radius:50%;font-size:32rpx;background:var(--surface-subtle);color:var(--hint)}.articles-empty button{display:flex;gap:20rpx;align-items:center;width:auto;min-height:68rpx;background:var(--brand-soft);color:var(--muted);font-size:var(--fs-small);border-radius:18rpx;padding:12rpx 28rpx;line-height:1.5;margin:8rpx 0 0}.articles-empty button::after{border:0}.empty-notebook{position:relative;width:72rpx;height:94rpx;background:var(--brand-soft);border:2rpx solid var(--brand-line);box-shadow:9rpx 7rpx 0 var(--brand-soft);border-radius:9rpx;padding:16rpx 13rpx;transform:rotate(-8deg);margin-bottom:18rpx}.empty-notebook>view{height:3rpx;background:var(--brand-line);margin:10rpx 0;border-radius:3rpx}.empty-notebook>text{position:absolute;right:-20rpx;bottom:-14rpx;font-size:56rpx;color:var(--brand-line);transform:rotate(12deg)}.creator-skeleton{padding-top:32rpx;padding-bottom:36rpx}.skeleton-badge,.skeleton-title,.skeleton-copy{height:20rpx;border-radius:8rpx;background:linear-gradient(90deg,var(--surface-subtle),var(--line),var(--surface-subtle));background-size:200% 100%;animation:creator-shimmer 1.6s ease-in-out infinite;margin-bottom:20rpx}.skeleton-badge{width:25%;height:28rpx}.skeleton-title{width:76%;height:34rpx;margin-top:32rpx}.skeleton-copy.short{width:62%;margin-bottom:0}@keyframes creator-shimmer{0%{background-position:100% 0}100%{background-position:-100% 0}}

.article-visibility-row{display:flex;align-items:center;justify-content:space-between;gap:20rpx;padding-bottom:20rpx;margin-bottom:20rpx;border-bottom:1rpx solid var(--line);font-size:var(--fs-small);color:var(--brand-dark)}.article-visibility-row>text:last-child{color:var(--muted)}.article-views{margin-top:20rpx;color:var(--muted);font-size:var(--fs-tiny)}
@media(prefers-reduced-motion:reduce){.skeleton-badge,.skeleton-title,.skeleton-copy{animation:none}}
