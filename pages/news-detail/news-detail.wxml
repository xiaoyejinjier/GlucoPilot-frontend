<wxs module="i18n" src="/utils/i18n.wxs" />
<view class="page-no-tab" style="{{displayStyle}}">
  <view wx:if="{{locale === 'en' && (contentTranslationLoading || contentTranslationError)}}" class="content-translation-notice" bindtap="retryContentTranslations" aria-role="button"><text>{{i18n.t(contentTranslationLoading ? '正在准备英文内容…' : '暂时无法翻译，正在显示原文，点击重试', locale)}}</text></view>
  <view wx:if="{{loading && !news}}" class="card social-empty">{{i18n.t("正在加载文章…", locale)}}</view>
  <view wx:if="{{error}}" class="card social-empty ui-interactive" bindtap="loadDetail" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}">{{i18n.t((error) + " · 点击重试", locale)}}</view>
  <block wx:if="{{news}}">
  <view wx:if="{{news.author}}" class="card article-author ui-interactive" data-key="{{news.author.key}}" bindtap="onProfile" aria-role="button" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}">
    <view wx:if="{{news.author.avatarUrl}}" class="social-avatar" ><avatar-image src="{{news.author.avatarUrl}}" text="友"></avatar-image></view>
    <view wx:else class="social-avatar avatar-placeholder">{{i18n.t("语", locale)}}</view>
    <view class="author-name"><text>{{i18n.name(contentTranslations, news.author, locale)}}</text><text class="author-hint">{{i18n.t("查看公开资料", locale)}}</text></view><button wx:if="{{!news.author.isSelf}}" class="author-follow ui-interactive" catchtap="onFollowAuthor" disabled="{{followBusy}}" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}">{{i18n.t((news.author.followed ? '已关注' : '+ 关注'), locale)}}</button>
  </view>
  <view wx:if="{{news.videos.length || (news.type === 'video' && news.videoUrl) || (!news.images.length && news.cover)}}" class="card article-media">
    <article-video wx:for="{{news.videos}}" wx:key="mediaId" media-id="{{item.mediaId}}"></article-video>
    <video
      wx:if="{{news.type === 'video' && news.videoUrl}}"
      class="news-video"
      src="{{news.videoUrl}}"
      poster="{{news.cover}}"
      controls
      show-center-play-btn
      object-fit="cover"
    />
    <image
      wx:elif="{{!news.videos.length && !news.images.length && news.cover}}"
      class="news-hero-img"
      src="{{news.cover}}"
      mode="aspectFill"
    />
  </view>

  <view class="card">
    <text class="article-heading">{{i18n.content(contentTranslations, 'ARTICLE_PREVIEW', news.id, 'title', news.title, locale)}}</text>
    <view class="article-tags"><text wx:for="{{news.tags}}" wx:key="code"># {{i18n.tag(item, locale)}}</text></view>
    <text class="news-meta">{{i18n.t((news.channel) + " · " + (news.typeLabel) + " · " + (news.time) + " · " + (news.viewCount || 0) + "次浏览", locale)}}</text>
    <text class="news-lead">{{i18n.content(contentTranslations, 'ARTICLE_PREVIEW', news.id, 'summary', news.summary, locale)}}</text>
    <view class="news-body">
      <rich-text wx:if="{{news.contentHtml}}" class="news-rich" nodes="{{i18n.content(contentTranslations, 'ARTICLE_BODY', news.id, 'body', news.contentBody, locale, news.contentHtml)}}"></rich-text>
      <text wx:elif="{{news.contentBody}}" class="news-para" style="white-space: pre-wrap;">{{i18n.content(contentTranslations, 'ARTICLE_BODY', news.id, 'body', news.contentBody, locale)}}</text>
    </view>
    <view wx:if="{{news.images.length}}" class="article-photos"><article-photo wx:for="{{news.images}}" wx:key="mediaId" media-id="{{item.mediaId}}"></article-photo></view>
    <view class="article-bottom"><text>{{i18n.t("社区分享仅供交流，不替代专业诊疗", locale)}}</text><text class="article-report ui-interactive" bindtap="onReport" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}">{{i18n.t("举报", locale)}}</text></view>
    <view class="news-ops">
      <view class="news-op {{liked ? 'like-on' : ''}} ui-interactive" bindtap="onLike" aria-disabled="{{actionBusy}}" aria-role="button" aria-label="{{i18n.t((liked ? '取消点赞' : '点赞'), locale)}}" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}"><social-action kind="like" active="{{liked}}" pulse="{{likedPulse || 0}}" label="{{liked ? '已赞' : '点赞'}}" count="{{news.likeCount || 0}}"></social-action></view>
      <view class="news-op ui-interactive" bindtap="onComments" aria-role="button" aria-label="{{i18n.t('查看评论', locale)}}" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}"><social-action kind="comment" label="评论" count="{{news.commentCount || 0}}"></social-action></view>
      <view class="news-op {{collected ? 'collect-on' : ''}} ui-interactive" bindtap="onCollect" aria-disabled="{{actionBusy}}" aria-role="button" aria-label="{{i18n.t((collected ? '取消收藏' : '收藏'), locale)}}" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}"><social-action kind="collect" active="{{collected}}" pulse="{{collectedPulse || 0}}" label="{{collected ? '已收藏' : '收藏'}}" count="{{news.collectCount || 0}}"></social-action></view>
    </view>
  </view>
  <view class="card" id="article-comments">
    <view class="section-title">{{i18n.t("评论 " + (news.commentCount), locale)}}</view>
    <text wx:if="{{commentTargetLoading}}" class="social-empty comment-target-state">{{i18n.t("正在定位评论…", locale)}}</text>
    <text wx:if="{{commentTargetError}}" class="social-link ui-interactive" bindtap="onRetryCommentTarget">{{i18n.t(commentTargetError, locale)}}</text>
    <view wx:for="{{comments}}" wx:key="id" class="comment-thread">
      <view id="comment-{{item.id}}" class="comment-row ui-interactive {{highlightedCommentId === item.id ? 'comment-target' : ''}}" data-id="{{item.id}}" bindtap="onReply" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}">
        <view wx:if="{{item.author.avatarUrl && !item.avatarFailed}}" class="comment-avatar ui-interactive" data-id="{{item.id}}" data-key="{{item.author.key}}" catchtap="onProfile"  hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}"><avatar-image src="{{item.author.avatarUrl}}" text="友"></avatar-image></view>
        <view wx:else class="comment-avatar avatar-placeholder ui-interactive" data-key="{{item.author.key}}" catchtap="onProfile" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}">{{i18n.t((item.avatarText), locale)}}</view>
        <view class="comment-main"><text data-key="{{item.author.key}}" catchtap="onProfile" class="comment-name ui-interactive" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}">{{i18n.name(contentTranslations, item.author, locale)}}</text><text class="comment-content">{{item.content}}</text><view class="comment-meta"><text class="comment-time">{{i18n.t((item.timeLabel), locale)}}</text><text wx:if="{{item.mine}}" class="comment-secondary ui-interactive" data-id="{{item.id}}" catchtap="onDeleteComment" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}">{{i18n.t("删除", locale)}}</text><text wx:else class="comment-secondary ui-interactive" data-id="{{item.id}}" catchtap="onReportComment" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}">{{i18n.t("举报", locale)}}</text><text class="comment-reply ui-interactive" data-id="{{item.id}}" catchtap="onReply" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}">{{i18n.t("回复", locale)}}</text></view></view>
      </view>
      <view wx:if="{{item.replies.length}}" class="comment-replies"><view wx:for="{{item.replies}}" wx:for-item="reply" wx:key="id" id="comment-{{reply.id}}" class="reply-row ui-interactive {{highlightedCommentId === reply.id ? 'comment-target' : ''}}" data-id="{{reply.id}}" catchtap="onReply" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}"><view wx:if="{{reply.author.avatarUrl && !reply.avatarFailed}}" class="reply-avatar ui-interactive" data-id="{{reply.id}}" data-key="{{reply.author.key}}" catchtap="onProfile"  hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}"><avatar-image src="{{reply.author.avatarUrl}}" text="友"></avatar-image></view><view wx:else class="reply-avatar avatar-placeholder ui-interactive" data-key="{{reply.author.key}}" catchtap="onProfile" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}">{{i18n.t((reply.avatarText), locale)}}</view><view class="comment-main"><text class="comment-name ui-interactive" data-key="{{reply.author.key}}" catchtap="onProfile" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}">{{i18n.name(contentTranslations, reply.author, locale)}}</text><view class="comment-content"><text wx:if="{{reply.replyToAuthor && reply.replyToCommentId !== item.id}}" class="reply-to">{{i18n.t("回复 ", locale)}}{{i18n.name(contentTranslations, reply.replyToAuthor, locale)}}：</text><text wx:elif="{{!reply.replyToAuthor}}" class="reply-to">{{i18n.t("原评论已删除 ·", locale)}} </text><text>{{reply.content}}</text></view><view class="comment-meta"><text class="comment-time">{{i18n.t((reply.timeLabel), locale)}}</text><text wx:if="{{reply.mine}}" class="comment-secondary ui-interactive" data-id="{{reply.id}}" catchtap="onDeleteComment" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}">{{i18n.t("删除", locale)}}</text><text wx:else class="comment-secondary ui-interactive" data-id="{{reply.id}}" catchtap="onReportComment" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}">{{i18n.t("举报", locale)}}</text><text class="comment-reply ui-interactive" data-id="{{reply.id}}" catchtap="onReply" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}">{{i18n.t("回复", locale)}}</text></view></view></view></view>
      <text wx:if="{{item.replyHasMore}}" class="more-replies ui-interactive" data-id="{{item.id}}" bindtap="onMoreReplies" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}">{{i18n.t((item.repliesLoading ? '正在加载…' : item.repliesError || '展开更多回复'), locale)}}</text>
    </view>
    <text wx:if="{{!comments.length && !commentsLoading && !commentsError}}" class="social-empty">{{i18n.t("还没有评论，来说两句吧", locale)}}</text>
    <text wx:if="{{commentsLoading}}" class="social-empty">{{i18n.t("正在加载评论…", locale)}}</text>
    <text wx:elif="{{commentsError}}" class="social-link ui-interactive" bindtap="onRetryComments" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}">{{i18n.t((commentsError), locale)}}</text>
    <text wx:elif="{{commentHasMore}}" class="social-link ui-interactive" bindtap="onMoreComments" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}">{{i18n.t("查看更多评论", locale)}}</text>
    <view id="comment-composer" class="comment-composer"><view wx:if="{{replyTarget}}" class="reply-context"><text>{{i18n.t("回复 ", locale)}}{{i18n.name(contentTranslations, replyTarget, locale)}}</text><text class="cancel-reply ui-interactive" bindtap="onCancelReply" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}">{{i18n.t("取消回复", locale)}}</text></view><textarea class="comment-input" placeholder="{{i18n.t((replyTarget ? '回复 ' + i18n.name(contentTranslations, replyTarget, locale) + '…' : '写下你的评论…'), locale)}}" maxlength="500" value="{{commentDraft}}" bindinput="onCommentInput" bindblur="onCommentBlur" disabled="{{posting}}" focus="{{commentFocus}}" cursor-spacing="24" auto-height /><button class="social-primary ui-interactive" bindtap="onCommentSend" loading="{{posting}}" disabled="{{posting || !commentDraft}}" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}">{{i18n.t((replyTarget ? '发送回复' : '发表评论'), locale)}}</button></view>
  </view>
  </block>
  <social-feedback id="social-feedback"></social-feedback>
</view>
