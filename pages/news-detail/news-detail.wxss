.news-hero-img,
.news-video {
  width: 100%;
  height: 360rpx;
  border-radius: 20rpx;
  background: #d9ebe3;
  display: block;
}

.news-meta {
  display: block;
  font-size: var(--fs-small);
  color: #6b7280;
  margin-bottom: 12rpx;
}

.news-lead {
  display: block;
  font-size: var(--fs-body);
  font-weight: 600;
  margin-bottom: 20rpx;
  color: var(--ink);
}

.news-body {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.news-para {
  font-size: var(--fs-body);
  line-height: 1.6;
  color: #333;
}

.news-ops {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
  margin-top: 24rpx;
  width: 100%;
  box-sizing: border-box;
}

.news-op {
  flex: 1;
  width: 0;
  min-width: 0;
  min-height: 72rpx;
  border-radius: 16rpx;
  background: #eef0ef;
  font-size: var(--fs-small);
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.news-op.on {
  background: var(--brand-soft);
  color: var(--brand-dark);
}
