<wxs module="i18n" src="/utils/i18n.wxs" />
<view class="consult-page consult-with-footer" style="{{displayStyle}}">
  <view class="consult-heading"><text class="consult-title">{{i18n.t('把你的问题告诉医生',locale)}}</text></view>
  <view class="consult-notice">{{i18n.t('建议描述持续时间、最近变化及希望了解的问题，请勿填写身份证号或联系方式。',locale)}}</view>
  <view class="consult-card">
    <view class="consult-field"><text class="consult-field-title"><text class="consult-required">*</text>{{i18n.t('问题标题',locale)}}</text><input class="consult-input" value="{{form.title}}" data-field="title" bindinput="onInput" maxlength="80" placeholder="{{i18n.t('例如：想了解最近餐后血糖的变化',locale)}}" /></view>
    <view class="consult-field"><text class="consult-field-title">{{i18n.t('问题分类',locale)}}</text><view class="consult-chip-row"><text wx:for="{{topics}}" wx:key="code" class="consult-chip {{form.topic === item.code ? 'selected' : ''}}" data-code="{{item.code}}" bindtap="onTopic">{{i18n.t(item.name,locale)}}</text></view></view>
    <view class="consult-field"><text class="consult-field-title"><text class="consult-required">*</text>{{i18n.t('详细描述',locale)}}</text><textarea class="consult-textarea" value="{{form.symptoms}}" data-field="symptoms" bindinput="onInput" maxlength="3000" cursor-spacing="100" placeholder="{{i18n.t('描述你的困扰、出现多久，以及想请医生解答什么。',locale)}}" /><text class="consult-field-note">{{form.symptoms.length}} / 3000</text></view>
    <view class="consult-field"><text class="consult-field-title">{{i18n.t('相关血糖情况（选填）',locale)}}</text><textarea class="consult-textarea short-input" value="{{form.glucoseNote}}" data-field="glucoseNote" bindinput="onInput" maxlength="300" cursor-spacing="100" placeholder="{{i18n.t('可填写测量时间、餐前或餐后及血糖数值',locale)}}" /></view>
    <view class="consult-field"><text class="consult-field-title">{{i18n.t('当前用药与过敏情况（选填）',locale)}}</text><textarea class="consult-textarea short-input" value="{{form.medicationNote}}" data-field="medicationNote" bindinput="onInput" maxlength="1000" cursor-spacing="100" placeholder="{{i18n.t('填写你正在使用的药品及已知过敏情况',locale)}}" /></view>
    <view class="consult-field"><text class="consult-field-title">{{i18n.t('补充图片（选填）',locale)}}</text><text class="consult-field-note">{{i18n.t('最多6张，每张不超过5MB，仅本人及接诊医生可见。',locale)}}</text><view class="consult-photo-grid"><view wx:for="{{images}}" wx:key="mediaId" class="consult-photo-cell"><image src="{{item.url}}" mode="aspectFill" data-url="{{item.url}}" bindtap="onPreviewImage"/><button class="consult-photo-remove" data-id="{{item.mediaId}}" bindtap="onRemoveImage" disabled="{{saving || uploading}}">×</button></view><button wx:if="{{images.length < 6}}" class="consult-photo-add" bindtap="onAddImage" disabled="{{saving || uploading}}" loading="{{uploading}}"><text>＋</text><text>{{i18n.t('添加图片',locale)}}</text></button></view></view>
    <view class="consult-anonymous"><view><text class="consult-field-title">{{i18n.t('匿名展示求助',locale)}}</text><text class="consult-muted">{{i18n.t('广场不展示你的昵称和联系方式',locale)}}</text></view><switch checked="{{form.anonymous}}" color="#2a61ba" bindchange="onAnonymous" /></view>
  </view>
  <view wx:if="{{error}}" id="consultation-submit-error" class="consult-error">{{i18n.t(error,locale)}}</view>
  <text class="consult-fine-print">{{i18n.t('完整健康资料仅用于本人及获准接诊医生查看。',locale)}}</text>
  <view class="consult-footer"><view class="consult-footer-actions"><button class="consult-button" bindtap="onPreview" disabled="{{saving}}" hover-class="ui-pressed">{{i18n.t('预览求助',locale)}}</button><button class="consult-button primary" bindtap="onSubmit" loading="{{saving}}" disabled="{{saving}}" hover-class="ui-pressed">{{i18n.t('发布求助',locale)}}</button></view><text class="consult-footer-note">{{i18n.t('医生出具问诊单后，再按需支付查看',locale)}}</text></view>
</view>
