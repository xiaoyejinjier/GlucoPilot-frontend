<wxs module="i18n" src="/utils/i18n.wxs" />
<view class="page community-home" style="{{displayStyle}}">
  <view wx:if="{{locale === 'en' && (contentTranslationLoading || contentTranslationError)}}" class="content-translation-notice" bindtap="retryContentTranslations" aria-role="button"><text>{{i18n.t(contentTranslationLoading ? '正在准备英文内容…' : '暂时无法翻译，正在显示原文，点击重试', locale)}}</text></view>
  <view class="community-heading"><view><text class="community-eyebrow">{{i18n.t("一起，把控糖变成日常", locale)}}</text><text class="community-title">{{i18n.t("糖友社区", locale)}}<text class="title-dot">·</text></text></view><view class="my-articles ui-interactive" bindtap="onMyArticles" aria-role="button" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}">{{i18n.t("我的文章 ›", locale)}}</view></view>
  <view class="share-card ui-interactive" bindtap="onWrite" aria-role="button" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}"><view class="share-symbol">✎</view><view class="share-copy"><text class="share-title">{{i18n.t("今天，有什么想分享？", locale)}}</text><text class="share-subtitle">{{i18n.t("记录一餐、分享心得，也可以聊聊困惑", locale)}}</text></view><view class="write-button">{{i18n.t("写文章", locale)}}</view></view>
  <view class="community-shortcuts"><view class="ui-interactive" bindtap="onCommunityEntry" data-mode="following" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}"><view class="shortcut-symbol shortcut-follow"><view></view><text>+</text></view><text>{{i18n.t("关注", locale)}}</text></view><view class="ui-interactive" bindtap="onCommunityEntry" data-mode="likes" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}"><text class="shortcut-symbol">♡</text><text>{{i18n.t("我的点赞", locale)}}</text></view><view class="ui-interactive" bindtap="onCommunityEntry" data-mode="collections" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}"><text class="shortcut-symbol">☆</text><text>{{i18n.t("我的收藏", locale)}}</text></view><view class="ui-interactive" bindtap="onCommunityEntry" data-mode="messages" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}"><text class="shortcut-symbol">✉</text><text>{{i18n.t("信息", locale)}}</text><text wx:if="{{unreadCount > 0}}" class="message-unread-badge">{{i18n.t((unreadLabel), locale)}}</text></view><view class="ui-interactive" bindtap="onCommunityEntry" data-mode="profiles" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}"><text class="shortcut-symbol">⌕</text><text>{{i18n.t("找糖友", locale)}}</text></view></view>
  <view class="feed-heading"><view class="feed-tabs"><text class="feed-tab {{feedMode === 'recommend' ? 'active' : ''}} ui-interactive" data-mode="recommend" bindtap="onMode" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}">{{i18n.t("推荐", locale)}}</text><text class="feed-tab {{feedMode === 'following' ? 'active' : ''}} ui-interactive" data-mode="following" bindtap="onMode" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}">{{i18n.t("关注", locale)}}</text></view><text class="feed-caption">{{i18n.t("分享经验 · 理性交流", locale)}}</text></view>
  <view class="community-search"><text>⌕</text><input placeholder="{{i18n.t('搜索感兴趣的内容', locale)}}" maxlength="80" value="{{keyword}}" bindinput="onSearchInput" bindconfirm="onSearch" confirm-type="search" /><text class="search-action ui-interactive" bindtap="onSearch" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}">{{i18n.t("搜索", locale)}}</text></view>
  <scroll-view scroll-x class="topic-scroll"><view class="topic-list"><text class="topic {{!activeTag ? 'selected' : ''}} ui-interactive" data-code="" bindtap="onTag" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}">{{i18n.t("全部话题", locale)}}</text><text wx:for="{{tags}}" wx:key="code" class="topic {{(activeTag === item.code || (otherSelected && item.code === 'other')) ? 'selected' : ''}} ui-interactive" data-code="{{item.code}}" bindtap="onTag" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}">{{i18n.tag(item, locale)}}</text></view></scroll-view>
  <view wx:if="{{tagsError}}" class="tag-catalog-error" bindtap="loadTags">{{i18n.t(tagsError, locale)}}</view>
  <view wx:if="{{otherSelected && otherTags.length}}" class="other-topic-list"><text class="topic {{activeTag === 'other' ? 'selected' : ''}}" data-code="other" bindtap="onOtherTag">{{i18n.t('全部其他', locale)}}</text><text wx:for="{{otherTags}}" wx:key="code" class="topic {{activeTag === item.code ? 'selected' : ''}}" data-code="{{item.code}}" bindtap="onOtherTag"># {{item.name}}</text></view>
  <view wx:for="{{posts}}" wx:key="id" class="post-card">
    <view class="post-top"><view class="post-author ui-interactive" data-key="{{item.author.key}}" bindtap="onProfile" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}"><view wx:if="{{item.author.avatarUrl}}" class="post-avatar" ><avatar-image src="{{item.author.avatarUrl}}" text="友"></avatar-image></view><view wx:else class="post-avatar avatar-letter">{{i18n.t("友", locale)}}</view><view><text class="post-author-name">{{i18n.name(contentTranslations, item.author, locale) || i18n.t('社区编辑部', locale)}}</text><text class="post-time">{{i18n.t((item.timeLabel) + " · " + (item.viewCount || 0) + "次浏览", locale)}}</text></view></view><text wx:if="{{item.author && !item.author.isSelf}}" class="follow-button {{item.author.followed ? 'followed' : ''}} ui-interactive" data-key="{{item.author.key}}" bindtap="onFollow" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}">{{i18n.t((item.author.followed ? '已关注' : '+ 关注'), locale)}}</text><text wx:if="{{!item.author.isSelf}}" class="post-more ui-interactive" data-id="{{item.id}}" bindtap="onReport" aria-label="{{i18n.t('文章更多操作', locale)}}" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}">···</text></view>
    <view class="ui-interactive" data-id="{{item.id}}" bindtap="onOpen" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}"><text class="post-title">{{i18n.content(contentTranslations, 'ARTICLE_PREVIEW', item.id, 'title', item.title, locale)}}</text><text class="post-summary">{{i18n.content(contentTranslations, 'ARTICLE_PREVIEW', item.id, 'summary', item.summary, locale)}}</text><view wx:if="{{item.videos.length}}" class="post-video-preview"><article-video wx:for="{{item.videos}}" wx:for-item="clip" wx:key="mediaId" media-id="{{clip.mediaId}}" lazy="{{true}}"></article-video></view><view wx:elif="{{item.images.length}}" class="post-photo-entry"><article-photo media-id="{{item.images[0].mediaId}}" mode="aspectFill" preview-enabled="{{false}}"></article-photo></view><image wx:elif="{{item.hasCover}}" src="{{item.cover}}" class="post-cover" mode="aspectFill" /><view class="post-tags"><text wx:for="{{item.tags}}" wx:for-item="tag" wx:key="code"># {{i18n.tag(tag, locale)}}</text></view></view>
    <view class="post-actions"><view class="ui-interactive" data-id="{{item.id}}" data-field="liked" bindtap="onAction" aria-role="button" aria-label="{{i18n.t((item.liked ? '取消点赞' : '点赞'), locale)}}" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}"><social-action kind="like" active="{{item.liked}}" pulse="{{item.likedPulse || 0}}" label="{{item.liked ? '已赞' : '点赞'}}" count="{{item.likeCount || 0}}"></social-action></view><view class="ui-interactive" data-id="{{item.id}}" bindtap="onComments" aria-role="button" aria-label="{{i18n.t('查看评论', locale)}}" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}"><social-action kind="comment" label="评论" count="{{item.commentCount || 0}}"></social-action></view><view class="ui-interactive" data-id="{{item.id}}" data-field="collected" bindtap="onAction" aria-role="button" aria-label="{{i18n.t((item.collected ? '取消收藏' : '收藏'), locale)}}" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}"><social-action kind="collect" active="{{item.collected}}" pulse="{{item.collectedPulse || 0}}" label="{{item.collected ? '已收藏' : '收藏'}}" count="{{item.collectCount || 0}}"></social-action></view></view>
  </view>
  <view wx:if="{{loading}}" class="feed-state">{{i18n.t("正在加载社区内容…", locale)}}</view><view wx:elif="{{error}}" class="feed-empty"><text class="empty-symbol">☁</text><text class="empty-title">{{i18n.t("暂时没能加载内容", locale)}}</text><text class="empty-copy">{{i18n.t((error), locale)}}</text><button class="ui-interactive" bindtap="onRetry" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}">{{i18n.t("重新加载", locale)}}</button></view><view wx:elif="{{!posts.length}}" class="feed-empty"><text class="empty-symbol">✎</text><text class="empty-title">{{i18n.t((feedMode === 'following' ? '这里会出现你关注的动态' : '这个话题，还等你来分享'), locale)}}</text><text class="empty-copy">{{i18n.t((feedMode === 'following' ? '先去关注感兴趣的糖友，慢慢找到同路人。' : '分享真实经历，文章审核通过后会展示在这里。'), locale)}}</text><button class="ui-interactive" bindtap="onWrite" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}">{{i18n.t("写下第一篇分享", locale)}}</button></view><view wx:elif="{{hasMore}}" class="feed-state ui-interactive" bindtap="onMore" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}">{{i18n.t("点击加载更多", locale)}}</view><view wx:else class="feed-state">{{i18n.t("已经看到这里啦", locale)}}</view>
  <text class="community-footnote">{{i18n.t("社区经验仅供交流，健康决策请与医生确认", locale)}}</text>
  <social-feedback id="social-feedback" above-tab="{{true}}"></social-feedback>
</view>
