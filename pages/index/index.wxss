/* Banner */
.banner {
  margin: 20rpx 20rpx 0;
  border-radius: 20rpx;
  height: 260rpx;
  overflow: hidden;
}

.banner-slide {
  position: relative;
  height: 100%;
}

.banner-img {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.banner-inner {
  position: relative;
  z-index: 1;
  height: 100%;
  padding: 36rpx 32rpx;
  color: #fff;
  background: linear-gradient(180deg, rgba(47, 111, 94, 0.15), rgba(47, 111, 94, 0.72));
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  box-sizing: border-box;
}

.banner-badge {
  display: inline-block;
  font-size: var(--fs-small);
  padding: 6rpx 18rpx;
  border-radius: 10rpx;
  background: rgba(255, 255, 255, 0.22);
  margin-bottom: 16rpx;
  font-weight: 700;
  align-self: flex-start;
}

.banner-title {
  font-size: var(--fs-title);
  font-weight: 800;
  line-height: 1.25;
}

.banner-desc {
  margin-top: 12rpx;
  font-size: var(--fs-body);
  opacity: 0.95;
}

/* 资讯卡片 */
.news-card {
  margin-top: 20rpx;
}

.news-card .section-title {
  font-size: var(--fs-title);
  margin-bottom: 20rpx;
}

/* 四频道等分按钮：横向一排铺满 */
.channel-row {
  display: flex;
  flex-direction: row;
  flex-wrap: nowrap;
  align-items: stretch;
  width: 100%;
  margin-bottom: 8rpx;
}

.channel-btn {
  flex: 1;
  width: 0;
  height: 72rpx;
  margin-right: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  background: #eef0ef;
  color: #444;
  font-size: var(--fs-small);
  font-weight: 700;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  box-sizing: border-box;
}

.channel-btn:last-child {
  margin-right: 0;
}

.channel-btn.on {
  background: var(--brand);
  color: #fff;
}

.channel-btn-text {
  font-size: var(--fs-small);
  font-weight: 700;
  white-space: nowrap;
  line-height: 1;
}

/* 资讯列表 */
.news-item {
  display: flex;
  gap: 20rpx;
  padding: 28rpx 0;
  border-top: 1rpx solid #e5e7eb;
}

.news-item:first-of-type {
  border-top: none;
  margin-top: 8rpx;
}

.news-cover-wrap {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  overflow: hidden;
  flex-shrink: 0;
  background: #d9ebe3;
}

.news-cover-img {
  width: 100%;
  height: 100%;
  display: block;
}

.play-mark {
  position: absolute;
  right: 10rpx;
  bottom: 10rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.55);
  color: #fff;
  font-size: var(--fs-small);
  display: flex;
  align-items: center;
  justify-content: center;
}

.news-meta {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.news-title {
  display: block;
  font-size: var(--fs-body);
  font-weight: 700;
  line-height: 1.4;
  color: #1c1c1c;
}

.news-sum {
  display: block;
  margin-top: 10rpx;
  font-size: var(--fs-small);
  color: #666;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.news-footer {
  margin-top: 14rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.news-type {
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background: #eef0ef;
  font-size: var(--fs-small);
  font-weight: 700;
  color: #555;
}

.news-info {
  font-size: var(--fs-small);
  color: #6b7280;
}
