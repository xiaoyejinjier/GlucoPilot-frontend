.community-home{padding:24rpx 26rpx calc(var(--tab-bar-h) + env(safe-area-inset-bottom));background:linear-gradient(180deg,#eef8f2 0,#f4f6f5 400rpx);min-height:100vh}.community-heading{display:flex;justify-content:space-between;align-items:center;padding:12rpx 4rpx 30rpx}.community-eyebrow{display:block;color:#7d9587;font-size:var(--fs-small);letter-spacing:2rpx}.community-title{display:block;font-size:48rpx;line-height:1.5;font-weight:800;color:#233e30;margin-top:8rpx}.title-dot{color:var(--brand);margin-left:8rpx}.my-articles{font-size:var(--fs-small);color:#5d7668;padding:16rpx 0 16rpx 16rpx}.share-card{display:flex;align-items:center;gap:18rpx;background:linear-gradient(110deg,#e4f3e9,#f7fcf8);border:2rpx solid #fff;border-radius:28rpx;padding:28rpx 24rpx;box-shadow:0 6rpx 24rpx rgba(53,95,68,.04)}.share-symbol{display:flex;align-items:center;justify-content:center;width:72rpx;height:72rpx;flex-shrink:0;border-radius:24rpx;background:#d5ebdc;color:#34764e;font-size:40rpx}.share-copy{flex:1;min-width:0}.share-title{display:block;font-size:var(--fs-body);font-weight:600;color:#2a4936}.share-subtitle{display:block;font-size:20rpx;color:#789080;line-height:1.6;margin-top:8rpx}.write-button{padding:16rpx 20rpx;border-radius:30rpx;color:#fff;background:#2c8b5c;font-size:var(--fs-small);flex-shrink:0}.community-shortcuts{display:flex;background:#fff;border-radius:24rpx;margin-top:20rpx;padding:25rpx 0}.community-shortcuts>view{flex:1;display:flex;flex-direction:column;align-items:center;gap:10rpx;color:#66776c;font-size:var(--fs-small)}.shortcut-symbol{font-size:34rpx;line-height:1.2;color:#548467}.feed-heading{display:flex;align-items:center;justify-content:space-between;margin:36rpx 4rpx 24rpx}.feed-tabs{display:flex;gap:34rpx}.feed-tab{font-size:var(--fs-title);font-weight:500;color:#94a198;padding-bottom:8rpx}.feed-tab.active{color:#263e30;font-weight:800;border-bottom:6rpx solid #359866}.feed-caption{font-size:20rpx;color:#96a298}.community-search{display:flex;align-items:center;gap:18rpx;background:white;border:1rpx solid #e7ede9;border-radius:18rpx;padding:16rpx 22rpx;color:#84978b}.community-search>text:first-child{font-size:34rpx}.community-search input{flex:1;min-width:0;font-size:var(--fs-small);height:46rpx}.search-action{font-size:var(--fs-small);color:#4b7b5e;padding-left:12rpx}.topic-scroll{width:100%;margin:24rpx 0 20rpx;white-space:nowrap}.topic-list{display:inline-flex;gap:14rpx;padding-bottom:8rpx}.topic{font-size:var(--fs-small);padding:13rpx 23rpx;border-radius:28rpx;color:#819187;background:#eaf0ec}.topic.selected{background:#dcefe3;color:#26774d;font-weight:600}.post-card{background:white;border-radius:26rpx;padding:28rpx;margin-bottom:22rpx;border:1rpx solid #edf1ee}.post-top{display:flex;align-items:center;gap:16rpx;margin-bottom:24rpx}.post-author{display:flex;align-items:center;gap:15rpx;flex:1;min-width:0}.post-avatar{width:72rpx;height:72rpx;border-radius:50%;flex-shrink:0}.avatar-letter{display:flex;align-items:center;justify-content:center;background:#ecf4ed;color:#7d9d86;font-size:30rpx}.post-author-name{display:block;font-size:var(--fs-small);font-weight:600;color:#41584a}.post-time{display:block;font-size:18rpx;color:#a6afa9;margin-top:7rpx}.follow-button{font-size:var(--fs-small);color:#45815d;background:#eff7f1;border-radius:22rpx;padding:10rpx 18rpx;flex-shrink:0}.follow-button.followed{background:#f4f5f4;color:#9ba49e}.post-more{font-size:30rpx;color:#9baa9f;padding:6rpx 4rpx 6rpx 12rpx}.post-title{display:block;font-size:var(--fs-title);font-weight:700;line-height:1.5;color:#2d4033}.post-summary{display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden;font-size:var(--fs-body);color:#859087;line-height:1.75;margin-top:14rpx}.post-cover{width:100%;height:280rpx;border-radius:18rpx;margin-top:20rpx}.post-tags{display:flex;flex-wrap:wrap;gap:16rpx;margin-top:24rpx}.post-tags text{font-size:var(--fs-small);color:#759581}.post-actions{display:flex;justify-content:space-