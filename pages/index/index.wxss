.community-home{padding:24rpx 26rpx calc(var(--tab-bar-h) + env(safe-area-inset-bottom));background:#edf3fb;min-height:100vh}.community-heading{display:flex;justify-content:space-between;align-items:center;gap:18rpx;padding:28rpx 24rpx;border:1rpx solid var(--navy);border-radius:28rpx;background:var(--navy);margin-bottom:20rpx}.community-heading>view:first-child{flex:1;min-width:0}.community-eyebrow{display:block;color:#c7d9ef;font-size:var(--fs-small);letter-spacing:2rpx}.community-title{display:block;font-size:48rpx;line-height:1.5;font-weight:800;color:#fff;margin-top:8rpx}.title-dot{color:#89b8f2;margin-left:8rpx}.my-articles{flex:none;max-width:34%;font-size:var(--fs-small);line-height:1.5;color:#fff;background:#2d507d;padding:12rpx 18rpx;border:1rpx solid #4a6b95;border-radius:20rpx}.share-card{display:flex;align-items:center;gap:18rpx;background:#fff;border:1rpx solid #c9d9ed;border-radius:28rpx;padding:28rpx 24rpx;box-shadow:0 6rpx 24rpx rgba(31,35,40,.04)}.share-symbol{display:flex;align-items:center;justify-content:center;width:72rpx;height:72rpx;flex-shrink:0;border-radius:24rpx;background:#d1e3fa;color:#245eaa;font-size:40rpx}.share-copy{flex:1;min-width:0}.share-title{display:block;font-size:var(--fs-body);font-weight:600;color:var(--navy)}.share-subtitle{display:block;font-size:20rpx;color:var(--muted);line-height:1.6;margin-top:8rpx}.write-button{padding:16rpx 20rpx;border-radius:30rpx;color:#fff;background:#245eaa;font-size:var(--fs-small);flex-shrink:0}.community-shortcuts{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:12rpx;margin-top:22rpx}.community-shortcuts>view{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:12rpx;min-height:126rpx;padding:20rpx 4rpx 16rpx;border:1rpx solid #b9cfea;border-radius:22rpx;background:#e2edfc;color:#28578e;font-size:var(--fs-small);line-height:1.5;box-shadow:0 4rpx 12rpx rgba(32,70,120,.035)}.community-shortcuts>view:nth-child(2){background:#f0f5ff;border-color:#c8d7ef;color:#3264a5}.community-shortcuts>view:nth-child(3){background:#e8f1ff;border-color:#bfd3ef;color:#315f99}.community-shortcuts>view:nth-child(4){background:#d4e6fc;border-color:#a9c8ec;color:#174c8c}.community-shortcuts>view:nth-child(5){background:#f8fbff;border-color:#cad9ea;color:#436482}.community-shortcuts>view>text:not(.shortcut-symbol):not(.message-unread-badge){max-width:100%;overflow-wrap:anywhere}.shortcut-symbol{display:flex;align-items:center;justify-content:center;height:42rpx;font-size:36rpx;line-height:1;color:inherit}.feed-heading{display:flex;align-items:center;justify-content:space-between;margin:36rpx 4rpx 24rpx}.feed-tabs{display:flex;gap:34rpx}.feed-tab{font-size:var(--fs-title);font-weight:500;color:var(--muted);padding-bottom:8rpx}.feed-tab.active{color:var(--ink);font-weight:800;border-bottom:6rpx solid var(--brand)}.feed-caption{font-size:20rpx;color:var(--hint)}.community-search{display:flex;align-items:center;gap:18rpx;background:white;border:1rpx solid var(--line);border-radius:18rpx;padding:16rpx 22rpx;color:var(--muted)}.community-search>text:first-child{font-size:34rpx}.community-search input{flex:1;min-width:0;font-size:var(--fs-small);height:46rpx}.search-action{font-size:var(--fs-small);color:var(--brand);padding-left:12rpx}.topic-scroll{width:100%;margin:24rpx 0 20rpx;white-space:nowrap}.topic-list{display:inline-flex;gap:14rpx;padding-bottom:8rpx}.topic{font-size:var(--fs-small);padding:13rpx 23rpx;border:1rpx solid #d2dfef;border-radius:28rpx;color:#4d688b;background:#fff}.topic.selected{background:var(--navy);border-color:var(--navy);color:#fff;font-weight:600}.post-card{background:white;border-radius:26rpx;padding:28rpx;margin-bottom:22rpx;border:1rpx solid #cddced}.post-top{display:flex;align-items:center;gap:16rpx;margin-bottom:24rpx}.post-author{display:flex;align-items:center;gap:15rpx;flex:1;min-width:0}.post-avatar{width:72rpx;height:72rpx;border-radius:50%;flex-shrink:0}.avatar-letter{display:flex;align-items:center;justify-content:center;background:var(--brand-soft);color:var(--muted);font-size:30rpx}.post-author-name{display:block;font-size:var(--fs-small);font-weight:600;color:var(--ink-soft)}.post-time{display:block;font-size:18rpx;color:var(--hint);margin-top:7rpx}.follow-button{font-size:var(--fs-small);color:var(--brand);background:var(--brand-soft);border-radius:22rpx;padding:10rpx 18rpx;flex-shrink:0}.follow-button.followed{background:var(--surface-subtle);color:var(--hint)}.post-more{font-size:30rpx;color:var(--hint);padding:6rpx 4rpx 6rpx 12rpx}.post-title{display:block;font-size:var(--fs-title);font-weight:700;line-height:1.5;color:var(--navy)}.post-summary{display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden;font-size:var(--fs-body);color:var(--muted);line-height:1.75;margin-top:14rpx}.post-cover{width:100%;height:280rpx;border-radius:18rpx;margin-top:20rpx}.post-tags{display:flex;flex-wrap:wrap;gap:16rpx;margin-top:24rpx}.post-tags text{font-size:var(--fs-small);color:var(--muted)}.post-actions{display:flex;justify-content:space-between;border-top:1rpx solid var(--line);padding-top:23rpx;margin-top:24rpx;gap:12rpx}.post-actions>view{font-size:var(--fs-small);color:var(--hint);display:flex;align-items:center;gap:9rpx}.action-icon{font-size:30rpx}.post-actions .action-active{color:var(--brand)}.feed-state{text-align:center;padding:28rpx;color:var(--hint);font-size:var(--fs-small)}.feed-empty{display:flex;flex-direction:column;align-items:center;padding:54rpx 28rpx;background:#fff;border-radius:26rpx;margin-top:10rpx;text-align:center}.empty-symbol{font-size:62rpx;color:#92b49c;margin-bottom:20rpx}.empty-title{font-size:var(--fs-body);font-weight:600;color:var(--ink-soft)}.empty-copy{font-size:var(--fs-small);line-height:1.8;color:var(--muted);margin-top:14rpx;overflow-wrap:anywhere}.feed-empty button{font-size:var(--fs-small);color:var(--brand);background:var(--brand-soft);border:0;border-radius:28rpx;margin-top:28rpx;padding:0 28rpx}.feed-empty button::after{border:0}.community-footnote{display:block;text-align:center;color:var(--hint);font-size:20rpx;margin:10rpx 0 30rpx}

.community-shortcuts > view { position:relative; }
.community-shortcuts .message-unread-badge { position:absolute; top:6rpx; right:6rpx; }
.feed-heading { flex-wrap:wrap; gap:16rpx; }
.feed-tabs { flex:none; }
.feed-caption { flex:1; min-width:210rpx; text-align:right; }

.post-video-entry{padding:48rpx 28rpx;margin-top:20rpx;background:var(--brand-soft);color:var(--brand-dark);border-radius:22rpx;text-align:center;font-size:var(--fs-small)}.post-photo-entry{width:100%;height:320rpx;margin-top:20rpx;overflow:hidden;border-radius:22rpx}.post-photo-entry article-photo{display:block;width:100%;height:100%}
.post-video-preview{display:flex;flex-direction:column;gap:20rpx;margin:20rpx 0}

.other-topic-list{display:flex;flex-wrap:wrap;gap:12rpx;padding:10rpx 4rpx 24rpx}.tag-catalog-error{color:var(--brand);font-size:var(--fs-small);padding:18rpx;text-align:center}

.community-shortcuts>view{min-width:0;text-align:center}.shortcut-follow{position:relative;display:flex;align-items:flex-end;width:42rpx;height:41rpx}.shortcut-follow>view{position:relative;width:28rpx;height:15rpx;border:2rpx solid currentColor;border-radius:14rpx 14rpx 4rpx 4rpx;margin-bottom:2rpx}.shortcut-follow>view::before{content:"";position:absolute;left:6rpx;top:-23rpx;width:14rpx;height:14rpx;border:2rpx solid currentColor;border-radius:50%}.shortcut-follow>text{position:absolute;right:-2rpx;top:6rpx;font-size:24rpx;font-weight:600;line-height:1}
