<wxs module="i18n" src="/utils/i18n.wxs" />
<view class="page-no-tab" style="{{displayStyle}}">
  <view wx:if="{{locale === 'en' && (contentTranslationLoading || contentTranslationError)}}" class="content-translation-notice" bindtap="retryContentTranslations" aria-role="button"><text>{{i18n.t(contentTranslationLoading ? '正在准备英文内容…' : '暂时无法翻译，正在显示原文，点击重试', locale)}}</text></view>
  <view wx:if="{{mode === 'profiles' || mode === 'following' || mode === 'collections'}}" class="card search-row"><text class="search-symbol">⌕</text><input placeholder="{{i18n.t(mode === 'collections' ? '搜索收藏的文章标题' : mode === 'following' ? '搜索已关注的昵称' : '输入对方的昵称', locale)}}" maxlength="{{mode === 'collections' ? 80 : 32}}" value="{{keyword}}" bindinput="onInput" bindconfirm="onSearch" confirm-type="search" /><text wx:if="{{keyword || searchQuery}}" class="search-clear ui-interactive" bindtap="onClearSearch" aria-role="button" aria-label="{{i18n.t('清空搜索', locale)}}" hover-class="ui-pressed">×</text><button class="ui-interactive" bindtap="onSearch" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}">{{i18n.t("搜索", locale)}}</button></view>
  <view wx:for="{{list}}" wx:key="rowKey" class="card social-list-row ui-interactive" data-key="{{item.rowKey}}" bindtap="onOpen" aria-role="button" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}">
    <block wx:if="{{mode === 'collections'}}"><image class="collection-cover" src="{{item.cover}}" mode="aspectFill" /><view class="row-copy"><text class="row-title">{{i18n.content(contentTranslations, 'ARTICLE_PREVIEW', item.id, 'title', item.title, locale)}}</text><text class="row-muted">{{i18n.t((item.channel) + " · " + (item.time), locale)}}</text></view></block>
    <block wx:elif="{{mode === 'messages'}}"><view class="avatar">{{i18n.t("聊", locale)}}</view><view class="row-copy"><text class="row-title">{{i18n.name(contentTranslations, item.peer, locale)}}</text><text class="row-preview">{{item.lastMessage.content}}</text><text class="row-muted">{{i18n.t((item.timeLabel), locale)}}</text></view><text wx:if="{{item.unreadCount > 0}}" class="unread">{{i18n.t((item.unreadLabel), locale)}}</text></block>
    <block wx:else><view wx:if="{{item.avatarUrl}}" class="avatar" ><avatar-image src="{{item.avatarUrl}}" text="友"></avatar-image></view><view wx:else class="avatar">{{i18n.t("友", locale)}}</view><view class="row-copy"><text class="row-title">{{i18n.name(contentTranslations, item, locale)}}</text><text class="row-muted">{{item.bio || (item.followed ? i18n.t('已关注', locale) : i18n.t('查看资料，关注或发私信', locale))}}</text></view></block>
    <text class="row-muted">›</text>
  </view>
  <view wx:if="{{loading}}" class="state">{{i18n.t("正在加载…", locale)}}</view>
  <view wx:elif="{{error}}" class="state action ui-interactive" bindtap="onRetry" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}">{{i18n.t((error) + " · 点击重试", locale)}}</view>
  <view wx:elif="{{hasMore}}" class="state action ui-interactive" bindtap="onMore" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="90" hover-stop-propagation="{{true}}">{{i18n.t("加载更多", locale)}}</view>
  <view wx:elif="{{!list.length}}" class="card state">{{i18n.t((searchQuery ? '没有找到匹配的内容，试试其他关键词' : mode === 'following' ? '还没有关注的博主，去文章或评论区看看吧' : mode === 'collections' ? '还没有收藏，看到喜欢的文章点一下收藏吧' : mode === 'messages' ? '还没有私信，可从用户资料页开始聊天' : '按昵称搜索用户，或点击评论区昵称查看资料'), locale)}}</view>
</view>
