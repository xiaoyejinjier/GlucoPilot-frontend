.photo-placeholder {
  height: 240rpx;
  border-radius: 20rpx;
  background: var(--line);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-body);
  font-weight: 700;
  color: #456;
  border: 1rpx dashed #c5d0c8;
}

.photo-preview {
  width: 100%;
  height: 240rpx;
  border-radius: 16rpx;
  display: block;
  background: var(--line);
}

.ocr-result {
  border-radius: 20rpx;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.ocr-result.success {
  border: 2rpx solid var(--brand);
  background: #f2fff6;
}

.ocr-result.failed {
  border: 2rpx solid #e5a33d;
  background: #fff9ee;
}

.ocr-value {
  color: var(--brand);
  font-size: var(--fs-hero);
  font-weight: 800;
}

.ocr-unit {
  color: var(--muted);
  font-size: var(--fs-small);
  font-weight: 700;
  margin-left: 12rpx;
}

.ocr-confidence,
.ocr-raw,
.ocr-message {
  color: #667085;
  font-size: var(--fs-small);
}

.ocr-failed-title {
  color: #9a5b00;
  font-weight: 700;
  font-size: var(--fs-body);
}

.ocr-choice-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 20rpx;
}

.btn-choice {
  flex: 1;
  margin: 0;
  padding: 0 12rpx;
  font-size: var(--fs-small);
}

.value-box {
  display: flex;
  align-items: center;
  gap: 16rpx;
  border: 2rpx solid var(--brand);
  border-radius: 20rpx;
  padding: 12rpx 20rpx;
  background: #f7fff9;
}

.value-num {
  font-size: var(--fs-hero);
  font-weight: 800;
  flex: 1;
}

.value-input {
  font-size: var(--fs-hero);
  font-weight: 800;
  flex: 1;
  height: 72rpx;
}

.value-unit {
  color: var(--muted);
  font-weight: 700;
  font-size: var(--fs-small);
}
