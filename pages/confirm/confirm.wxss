.photo-placeholder {
  height: 240rpx;
  border-radius: 20rpx;
  background: #e8eee9;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-body);
  font-weight: 700;
  color: #456;
  border: 1rpx dashed #c5d0c8;
}

.photo-preview {
  width: 100%;
  height: 240rpx;
  border-radius: 16rpx;
  display: block;
  background: #e8eee9;
}

.manual-check {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: var(--fs-small);
  font-weight: 600;
  margin-bottom: 16rpx;
}

.check-icon {
  color: var(--brand);
}

.value-box {
  display: flex;
  align-items: center;
  gap: 16rpx;
  border: 2rpx solid var(--brand);
  border-radius: 20rpx;
  padding: 12rpx 20rpx;
  background: #f7fff9;
}

.value-num {
  font-size: var(--fs-hero);
  font-weight: 800;
  flex: 1;
}

.value-input {
  font-size: var(--fs-hero);
  font-weight: 800;
  flex: 1;
  height: 72rpx;
}

.value-unit {
  color: #6b7280;
  font-weight: 700;
  font-size: var(--fs-small);
}
