@import "../../styles/consultation.wxss";
.consult-hero-topline { position:relative; z-index:1; display:flex; align-items:center; justify-content:space-between; gap:16rpx; }
.consult-hero-doctor { flex:none; padding:6rpx 16rpx; border:1rpx solid rgba(208,224,246,.3); border-radius:24rpx; background:rgba(255,255,255,.06); color:#d0e0f6; font-size:22rpx; line-height:1.5; }
.consultation-inbox-entry { display:flex; align-items:center; justify-content:space-between; gap:20rpx; padding:18rpx 24rpx; margin:16rpx 0 22rpx; border:1rpx solid #c9daf3; border-radius:20rpx; background:#eaf2ff; }
.consultation-inbox-title { display:block; color:#294e83; font-size:26rpx; font-weight:600; }
.consultation-inbox-end { flex:none; display:flex; align-items:center; gap:16rpx; color:#416a9f; }
.consultation-inbox-count { min-width:34rpx; padding:2rpx 9rpx; border-radius:20rpx; background:#dc6658; color:#fff; font-size:22rpx; text-align:center; }

.square-heading { gap: 16rpx; width: 100%; }
.square-heading .consult-title { flex-shrink: 0; }
.square-heading-actions { display: flex; flex: 0 0 auto; margin-left: auto; justify-content: flex-end; }
/* 右侧紧凑入口，具体条件收进底部面板。 */
.square-filter-trigger { display:flex; align-items:center; gap:10rpx; min-height:64rpx; padding:0 18rpx; border:1rpx solid #d8e4f4; border-radius:30rpx; color:#627d9e; background:#fff; font-size:24rpx; white-space:nowrap; }
.square-filter-trigger.is-active { color:#315f9e; border-color:#adc9f4; background:#eaf2ff; }
.square-filter-icon { display:flex; flex-direction:column; align-items:center; gap:5rpx; width:24rpx; }
.square-filter-icon view { height:3rpx; border-radius:3rpx; background:currentColor; }
.square-filter-icon view:nth-child(1) { width:24rpx; }
.square-filter-icon view:nth-child(2) { width:16rpx; }
.square-filter-icon view:nth-child(3) { width:8rpx; }
.square-filter-count { min-width:28rpx; height:28rpx; padding:0 4rpx; box-sizing:border-box; border-radius:50%; background:#3c69a9; color:#fff; font-size:20rpx; line-height:28rpx; text-align:center; }
.square-filter-summary { display:flex; align-items:center; gap:10rpx; flex-wrap:wrap; margin:-2rpx 0 20rpx; font-size:22rpx; }
.square-filter-tag { padding:4rpx 14rpx; border-radius:12rpx; color:#41699e; background:#e7effc; }
.square-filter-edit { margin-left:auto; color:#788ba5; }
.square-filter-overlay { position:fixed; inset:0; z-index:11000; display:flex; align-items:flex-end; background:rgba(20,39,67,.38); }
.square-filter-sheet { width:100%; max-height:85vh; box-sizing:border-box; padding:12rpx 32rpx calc(28rpx + env(safe-area-inset-bottom)); border-radius:32rpx 32rpx 0 0; background:#fff; color:#203b64; font-size:28rpx; }
.square-filter-handle { width:68rpx; height:7rpx; margin:2rpx auto 12rpx; border-radius:6rpx; background:#dbe4ef; }
.square-filter-header { display:flex; align-items:center; justify-content:space-between; margin-bottom:24rpx; }
.square-filter-title { font-size:32rpx; font-weight:600; }
.square-filter-close { display:flex; align-items:center; justify-content:center; width:64rpx; height:64rpx; color:#7b8da5; font-size:42rpx; }
.square-filter-body { display:block; height:460rpx; max-height:52vh; overflow-y:auto; }
.square-filter-section { display:block; margin:12rpx 0 16rpx; color:#6b7d96; font-size:24rpx; }
.square-filter-options + .square-filter-section { margin-top:26rpx; }
.square-filter-options { display:flex; gap:14rpx; flex-wrap:wrap; }
.square-filter-option { display:flex; align-items:center; justify-content:center; min-height:76rpx; padding:14rpx 22rpx; box-sizing:border-box; max-width:100%; border:1rpx solid #e1e8f1; border-radius:16rpx; background:#f6f8fc; color:#546b8c; font-size:26rpx; line-height:1.5; }
.square-filter-option.selected { color:#2c5d9d; border-color:#a8c7f1; background:#eaf2ff; font-weight:600; }
.square-filter-footer { display:flex; gap:18rpx; margin-top:36rpx; padding-top:24rpx; border-top:1rpx solid #edf1f7; }
.square-filter-reset,.square-filter-apply { display:flex; align-items:center; justify-content:center; min-height:86rpx; box-sizing:border-box; border-radius:18rpx; font-size:28rpx; }
.square-filter-reset { flex:1; background:#f0f4fa; color:#657d9c; }
.square-filter-apply { flex:2; background:#355f9f; color:#fff; font-weight:600; }

.topic-filter-bar { display:flex; align-items:center; gap:12rpx; margin-bottom:20rpx; }
.topic-filter-scroll { flex:1; min-width:0; width:0; margin:0; }
.topic-filter-scroll .consult-topic-chip { display:inline-flex; align-items:center; gap:8rpx; vertical-align:middle; }
.consult-topic-icon { flex:none; display:block; width:32rpx; height:32rpx; border-radius:10rpx; }
.topic-manage { display:flex; align-items:center; justify-content:center; flex:0 0 68rpx; width:68rpx; height:68rpx; margin:0; padding:0; background:#fff; border:1rpx solid #d9e5f5; border-radius:18rpx; }
.topic-manage::after { border:0; }
.topic-grid-icon { display:grid; grid-template-columns:repeat(2,10rpx); gap:5rpx; }
.topic-grid-icon view { width:10rpx; height:10rpx; border:2rpx solid #5477a8; border-radius:3rpx; }
