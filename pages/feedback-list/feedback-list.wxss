.empty-card {
  text-align: center;
  padding: 48rpx 24rpx;
}

.empty-text {
  display: block;
  font-size: var(--fs-body);
  font-weight: 700;
  color: var(--ink);
}

.empty-hint {
  display: block;
  margin-top: 8rpx;
  font-size: var(--fs-small);
  color: var(--muted);
}

.fb-head {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 12rpx;
  min-width: 0;
}

.fb-type {
  font-size: var(--fs-body);
  font-weight: 800;
  color: var(--brand);
  flex-shrink: 0;
}

.fb-time {
  font-size: var(--fs-small);
  color: var(--muted);
  flex-shrink: 0;
}

.fb-content {
  display: block;
  font-size: var(--fs-body);
  line-height: 1.6;
  color: var(--ink);
}

.fb-status-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #eef2f1;
}

.fb-status-label {
  font-size: var(--fs-small);
  color: var(--muted);
  font-weight: 600;
}

.fb-status-val {
  font-size: var(--fs-small);
  font-weight: 700;
  color: var(--brand-dark);
}

.official-reply {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  background: var(--brand-soft);
}

.official-title {
  display: block;
  font-size: var(--fs-small);
  font-weight: 800;
  color: var(--brand-dark);
  margin-bottom: 8rpx;
}

.official-text {
  display: block;
  font-size: var(--fs-small);
  line-height: 1.6;
  color: var(--ink);
}
