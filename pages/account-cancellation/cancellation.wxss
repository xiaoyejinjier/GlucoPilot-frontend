/* 注销说明页（QQ 风格）：说明区 + 表单区 + 危险操作按钮 */
.muted-line {
  font-size: var(--fs-small);
  color: var(--muted);
  text-align: center;
}

.intro-title {
  display: block;
  font-size: var(--fs-body);
  font-weight: 700;
  color: var(--ink);
  margin: 8rpx 0 12rpx;
}

.intro-title:first-child {
  margin-top: 0;
}

.intro-list {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-bottom: 20rpx;
}

.intro-item {
  font-size: var(--fs-small);
  color: var(--muted);
  line-height: 1.6;
}

.intro-warn {
  display: block;
  margin-top: 8rpx;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  background: #fdecea;
  color: var(--danger);
  font-size: var(--fs-small);
  line-height: 1.5;
}

.section-card {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.section-label {
  font-size: var(--fs-small);
  font-weight: 700;
  color: var(--muted);
}

.section-hint {
  font-size: var(--fs-small);
  color: var(--muted);
  line-height: 1.5;
}

.opt-row,
.reason-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.opt-item,
.reason-item {
  padding: 14rpx 24rpx;
  border-radius: 12rpx;
  font-size: var(--fs-small);
  color: var(--ink-soft);
  background: var(--surface-subtle);
  border: 1rpx solid var(--line);
}

.opt-item.active,
.reason-item.active {
  font-weight: 700;
  color: var(--brand-dark);
  background: var(--brand-soft);
  border-color: var(--brand);
}

.sms-row {
  display: flex;
  gap: 16rpx;
  align-items: center;
}

/* 手机/邮箱轻量切换 */
.channel-row {
  display: flex;
  gap: 12rpx;
}

.channel-item {
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  font-size: var(--fs-tiny);
  color: var(--ink-soft);
  background: var(--surface-subtle);
  border: 1rpx solid var(--line);
}

.channel-item.active {
  font-weight: 600;
  color: var(--brand-dark);
  background: var(--brand-soft);
  border-color: var(--brand-line);
}

.hint-warn {
  color: var(--danger);
}

/* 滑动验证浮层 */
.slider-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 99;
  background: rgba(31, 35, 40, 0.45);
  display: flex;
  align-items: flex-end;
}

.slider-panel {
  width: 100%;
  padding: 32rpx 28rpx calc(32rpx + env(safe-area-inset-bottom));
  border-radius: 24rpx 24rpx 0 0;
  background: var(--surface);
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.slider-title {
  font-size: var(--fs-title);
  font-weight: 700;
  color: var(--ink);
}

.slider-sub {
  font-size: var(--fs-small);
  color: var(--muted);
}

.slider-cancel {
  padding: 12rpx 0 4rpx;
  text-align: center;
  font-size: var(--fs-small);
  color: var(--muted);
}

.code-input {
  flex: 1;
  height: 80rpx;
  padding: 0 24rpx;
  border-radius: 16rpx;
  background: var(--card, #f5f5f5);
  font-size: var(--fs-body);
}

.sms-btn {
  flex-shrink: 0;
  margin: 0;
}

.wechat-ok {
  font-size: var(--fs-small);
  color: var(--ok);
  font-weight: 600;
}

.agree-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.agree-box {
  width: 34rpx;
  height: 34rpx;
  border-radius: 8rpx;
  border: 2rpx solid var(--line);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #fff;
  flex-shrink: 0;
}

.agree-box.checked {
  background: var(--danger);
  border-color: var(--danger);
}

.agree-text {
  font-size: var(--fs-small);
  color: var(--muted);
}

.submit-area {
  margin: 16rpx 20rpx 40rpx;
}

.btn-cancel {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 84rpx;
  padding: 0 24rpx;
  border-radius: 20rpx;
  font-size: var(--fs-body);
  font-weight: 700;
  background: var(--danger);
  color: #fff;
  border: none;
  margin: 0;
}

.btn-cancel::after {
  border: none;
}

/* 注销处理中状态卡 */
.status-card {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.status-title {
  font-size: var(--fs-body);
  font-weight: 700;
  color: var(--ink);
}

.status-line {
  font-size: var(--fs-small);
  color: var(--muted);
  line-height: 1.6;
}

.action-card {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
