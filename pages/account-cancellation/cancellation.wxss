/* 注销说明页（QQ 风格）：说明区 + 表单区 + 危险操作按钮 */

/* 说明卡与原因卡：稍放大，左右贴近屏幕边缘、内边距与行距加大 */
.intro-card {
  margin: 20rpx 12rpx;
  padding: 32rpx 28rpx;
}

.reason-card {
  margin: 20rpx 12rpx calc(280rpx + env(safe-area-inset-bottom));
  padding: 32rpx 28rpx;
}

.intro-card .intro-title {
  margin: 12rpx 0 16rpx;
}

.intro-card .intro-list {
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.intro-card .intro-warn {
  margin-top: 12rpx;
  padding: 20rpx 24rpx;
}

.reason-card .reason-row {
  gap: 16rpx;
}

.reason-card .reason-item {
  padding: 18rpx 30rpx;
}

.muted-line {
  font-size: var(--fs-small);
  color: var(--muted);
  text-align: center;
}

.intro-title {
  display: block;
  font-size: var(--fs-body);
  font-weight: 700;
  color: var(--ink);
  margin: 8rpx 0 12rpx;
}

.intro-title:first-child {
  margin-top: 0;
}

.intro-list {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-bottom: 20rpx;
}

.intro-item {
  font-size: var(--fs-small);
  color: var(--muted);
  line-height: 1.6;
}

.intro-warn {
  margin-top: 8rpx;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  background: #fdecea;
  color: var(--danger);
  font-size: var(--fs-small);
  line-height: 1.5;
}

.warn-title {
  display: block;
  font-weight: 700;
  margin-bottom: 6rpx;
}

.warn-item {
  display: block;
  margin-top: 6rpx;
}

.section-card {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.section-label {
  font-size: var(--fs-small);
  font-weight: 700;
  color: var(--muted);
}

.section-hint {
  font-size: var(--fs-small);
  color: var(--muted);
  line-height: 1.5;
}

.opt-row,
.reason-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.opt-item,
.reason-item {
  padding: 14rpx 24rpx;
  border-radius: 12rpx;
  font-size: var(--fs-small);
  color: var(--ink-soft);
  background: var(--surface-subtle);
  border: 1rpx solid var(--line);
}

.opt-item.active,
.reason-item.active {
  font-weight: 700;
  color: var(--brand-dark);
  background: var(--brand-soft);
  border-color: var(--brand);
}

.sms-row {
  display: flex;
  gap: 16rpx;
  align-items: center;
}

/* 手机/邮箱轻量切换 */
.channel-row {
  display: flex;
  gap: 12rpx;
}

.channel-item {
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  font-size: var(--fs-tiny);
  color: var(--ink-soft);
  background: var(--surface-subtle);
  border: 1rpx solid var(--line);
}

.channel-item.active {
  font-weight: 600;
  color: var(--brand-dark);
  background: var(--brand-soft);
  border-color: var(--brand-line);
}

.hint-warn {
  color: var(--danger);
}

/* 滑动验证浮层 */
.slider-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 99;
  background: rgba(31, 35, 40, 0.45);
  display: flex;
  align-items: flex-end;
}

.slider-panel {
  width: 100%;
  padding: 32rpx 28rpx calc(32rpx + env(safe-area-inset-bottom));
  border-radius: 24rpx 24rpx 0 0;
  background: var(--surface);
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.slider-title {
  font-size: var(--fs-title);
  font-weight: 700;
  color: var(--ink);
}

.slider-sub {
  font-size: var(--fs-small);
  color: var(--muted);
}

.slider-cancel {
  padding: 12rpx 0 4rpx;
  text-align: center;
  font-size: var(--fs-small);
  color: var(--muted);
}

.code-input {
  flex: 1;
  height: 80rpx;
  padding: 0 24rpx;
  border-radius: 16rpx;
  background: var(--card, #f5f5f5);
  font-size: var(--fs-body);
}

.sms-btn {
  flex-shrink: 0;
  margin: 0;
}

.wechat-ok {
  font-size: var(--fs-small);
  color: var(--ok);
  font-weight: 600;
}

.agree-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin-top: 24rpx;
}

.agree-line {
  display: flex;
  align-items: center;
}

.agree-box {
  width: 34rpx;
  height: 34rpx;
  border-radius: 8rpx;
  border: 2rpx solid var(--line);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #fff;
  flex-shrink: 0;
}

.agree-box.checked {
  background: var(--brand);
  border-color: var(--brand);
}

.agree-text {
  font-size: var(--fs-small);
  color: var(--muted);
}

.agree-link {
  font-size: var(--fs-small);
  color: var(--brand-dark);
}

.submit-area {
  margin: 16rpx 20rpx 40rpx;
}

/* 身份验证页：与上方验证卡片留出间距，避免拥挤 */
.verify-submit {
  margin-top: 80rpx;
}

/* 申请注销操作区：固定于页面底部（须在 .submit-area 之后覆盖外边距） */
.submit-fixed {
  position: fixed;
  left: 12rpx;
  right: 12rpx;
  bottom: 0;
  margin: 0;
  padding: 20rpx 16rpx calc(24rpx + env(safe-area-inset-bottom));
  background: var(--bg);
  z-index: 10;
}

.btn-cancel {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 84rpx;
  padding: 0 24rpx;
  border-radius: 20rpx;
  font-size: var(--fs-body);
  font-weight: 700;
  background: #fff;
  color: var(--ink);
  border: 1rpx solid var(--line);
  margin: 0;
}

.btn-cancel[disabled] {
  background: var(--surface-subtle);
  color: var(--muted);
}

.btn-cancel::after {
  border: none;
}

/* 注销处理中状态卡 */
.status-card {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.status-title {
  font-size: var(--fs-body);
  font-weight: 700;
  color: var(--ink);
}

.status-line {
  font-size: var(--fs-small);
  color: var(--muted);
  line-height: 1.6;
}

.action-card {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
